            <selectionEntry id="3839-456b-8851-cbab" name="Forge" hidden="false" collective="false" import="true" type="upgrade"><rules><rule id="02469bad-6161-5301-8142" name="Field Forge Repairs" hidden="false"><description>At the end of your Movement phase, one friendly Directorate Vehicle within 3" regains D3 lost Wounds, subject to one repair effect per vehicle per turn. Cannot return a destroyed vehicle.</description></rule></rules></selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
