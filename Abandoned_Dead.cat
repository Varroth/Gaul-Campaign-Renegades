    <selectionEntry id="c36c-1d2f-28d9-9aa4" name="Shadow Operative Cell" hidden="false" collective="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink id="7efd-fe5f-6284-83f4" name="Specialists" hidden="false" targetId="adbd-c48e-4b21-0002" primary="true"/>
      <categoryLink id="db58-f897-c7db-7134" name="DIRECTORATE" hidden="false" targetId="adbd-c48e-4b21-a002" primary="false"/></categoryLinks>
      <constraints>
        <constraint id="dff9-5820-c26a-afcf" type="max" value="3" field="selections" scope="force" shared="false" includeChildSelections="false" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile id="e83e-5e5c-d69f-9fb9" name="Shadow Operative Cell" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic>
            <characteristic name="T" typeId="c2bc-ad63-c63b-5cea">3</characteristic>
            <characteristic name="Sv" typeId="f078-5176-43c6-5f6a">5+</characteristic>
            <characteristic name="W" typeId="ecdc-11e1-15d1-5780">1</characteristic>
            <characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic>
            <characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="bdef-26e9-0f38-7a6f" name="Unit rules / draft status" hidden="false">
          <description>Playtest mortal datasheet. No mandatory Guard-style officer Orders. This unit and all Astartes units belong to ONE Abandoned Dead faction.
5 models; M6, T3, Sv5+, W1, Ld7+, OC1. Suppressed carbines, knives, encrypted communications. Infiltrators; Stealth. Select exactly one mission package at roster creation:

- Sabotage: once per battle, when an enemy finishes a move within 3" of qualifying terrain containing a model of this cell, roll D6; on 4+ inflict D3 mortal wounds on that enemy unit. One test per cell.
- Voxbreaker: once per battle at the start of the opposing Command phase, designate one enemy within 18"; until the end of that opponent's next Shooting phase, it cannot use Hit re-rolls specifically granted by Officer/Command abilities, not other sources.
- Archive Recovery: while the cell is within range of an objective and not Battle-shocked, its total OC increases by +2, nonstacking.
- Extraction: once per battle at the end of your Shooting phase, this unit may embark within an eligible friendly transport within 3" if it did not disembark that turn and ordinary embarkation restrictions allow it.

Role: the hidden half of the army. Embedded agents, liaison cells and false-identity operatives are represented by its models and mission configurations instead of six near-identical datasheets. No automatic Astartes Ghost-Shroud.</description>
        </rule>
      <rule id="a3298da3-3d2e-5af8-a46f" name="Where to find weapons (v1.8)" hidden="false"><description>Open Squad Size / Personnel, then the selected size, then each named model. Five (or ten) required models and their standard weapons now populate automatically. Change each model’s Primary Weapon choice to make legal replacements; optional sixth–ninth models must be added deliberately. Equipment is charged once per selected model; do not add a second separate weapon copy.</description></rule></rules>
      <rules>
        <rule id="3f7a-bc5e-55e7-b6c6" name="Shadow Network" hidden="false">
          <description>Infiltrators, Stealth. Exactly one exclusive mission kit selected below.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="77f8-5e88-b4f9-1617" name="Mission Kit / Deployment Protocol" hidden="false" collective="false" defaultSelectionEntryId="37ee-c881-c2a1-016e">
          <constraints>
            <constraint id="7b80-8657-998a-96bb" type="min" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
            <constraint id="446d-ccab-ced7-794e" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="37ee-c881-c2a1-016e" name="Sabotage" hidden="false" collective="false" import="true" type="upgrade"><rules><rule id="889eeccb-22f0-5fc2-8348" name="Pre-Planted Charges" hidden="false"><description>Once per battle, when an enemy finishes a move within 3" of qualifying terrain containing a model of this cell, roll D6; on 4+, inflict D3 mortal wounds on that enemy unit. One test per cell.</description></rule></rules></selectionEntry>
            <selectionEntry id="dabd-758d-b6b1-9175" name="Voxbreaker" hidden="false" collective="false" import="true" type="upgrade"><rules><rule id="9946351c-8d0c-5d70-b461" name="Voxbreaker Interference" hidden="false"><description>Once per battle at the start of the opposing Command phase, designate one enemy within 18"; until the end of that opponent’s next Shooting phase, it cannot use Hit re-rolls specifically granted by Officer/Command abilities, not other sources.</description></rule></rules></selectionEntry>
            <selectionEntry id="9d65-57d7-7a9a-e402" name="Archive Recovery" hidden="false" collective="false" import="true" type="upgrade"><rules><rule id="f2623e91-3cbb-51cf-894b" name="Archive Recovery Protocol" hidden="false"><description>While this cell is within range of an objective and not Battle-shocked, its total OC increases by +2; nonstacking.</description></rule></rules></selectionEntry>
            <selectionEntry id="8ec5-6bc0-7077-ba23" name="Extraction" hidden="false" collective="false" import="true" type="upgrade"><rules><rule id="339dfb20-d924-542c-85c2" name="Covert Extraction" hidden="false"><description>Once per battle at the end of your Shooting phase, this unit may embark within an eligible friendly transport within 3" if it did not disembark that turn and ordinary embarkation restrictions allow it.</description></rule></rules></selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <rules>
        <rule id="60e2-5cca-7e03-0f3b" name="Faction / keyword boundary" hidden="false">
          <description>FACTION: ABANDONED DEAD. BRANCH: DIRECTORATE. All share one catalogue. No automatic extra active Ghost-Shroud for mortals.</description>
        </rule>
      </rules>
