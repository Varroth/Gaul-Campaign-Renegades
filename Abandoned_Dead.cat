      <categoryLinks>
        <categoryLink id="d4e8-76e8-91d1-8c05" name="Specialists" hidden="false" targetId="adbd-c48e-4b21-0002" primary="true"/>
      <categoryLink id="ccae-8016-2627-9420" name="ASTARTES" hidden="false" targetId="adbd-c48e-4b21-a001" primary="false"/></categoryLinks>
      <constraints>
        <constraint id="ebf8-233c-49d0-e9b1" type="max" value="3" field="selections" scope="force" shared="false" includeChildSelections="false" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile id="e1d2-7bc8-9e73-efd6" name="Phantom Lancers" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="8ffa-8367-2184-5557">12"</characteristic>
            <characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic>
            <characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic>
            <characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic>
            <characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic>
            <characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="51dc-ba99-13b4-15ce" name="Unit rules / draft status" hidden="false">
          <description>7th Company fast mechanized reconnaissance/assault
APPROVED universal passive Ghost-Shroud only. DRAFT Vector Strike: once/battle after Normal Move, one weapon from unit gains Assault for the turn. NO active module: Q34 did not list this formation.</description>
        </rule>
      <rule id="a31f41ed-6358-5105-9dd7" name="Where to find weapons (v1.8)" hidden="false"><description>Open Squad Size / Personnel, then the selected size, then each named model. Five (or ten) required models and their standard weapons now populate automatically. Change each model’s Primary Weapon choice to make legal replacements; optional sixth–ninth models must be added deliberately. Equipment is charged once per selected model; do not add a second separate weapon copy.</description></rule><rule id="e095131f-72c7-5d5b-b035" name="Vector Strike" hidden="false"><description>once/battle after Normal Move, one weapon from unit gains Assault for the turn. NO active module: Q34 did not list this formation.</description></rule></rules>
      <rules>
        <rule id="87fd-cbe9-07fb-9609" name="Ghost-Shroud (passive; approved)" hidden="false">
          <description>Hidden detection 12" instead of 15". When exposed and not fired this or preceding turn and not Advanced/Charged, has Stealth. Does not automatically gain Hidden.</description>
        </rule>
      </rules>
      <rules>
        <rule id="686f-6e44-d4bf-d0d4" name="Ghost-Sight Sergeant Targeting Uplink (approved)" hidden="false">
          <description>Once per your Shooting phase, living Sergeant chooses one enemy visible to them. Other models in own unit re-roll ranged Hit rolls of 1 vs that unit. No illegal targeting or rerolling a die twice.</description>
        </rule>
      </rules>
      <rules>
        <rule id="5f30-8884-3097-43f6" name="Faction / keyword boundary" hidden="false">
          <description>FACTION: ABANDONED DEAD. BRANCH: ASTARTES. All share one catalogue. No automatic extra active Ghost-Shroud for mortals.</description>
        </rule>
      </rules>
