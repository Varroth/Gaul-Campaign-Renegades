    <selectionEntry id="f12f-1412-f450-0a33" name="Blackout Breachers" hidden="false" collective="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink id="e293-3442-c929-427e" name="Specialists" hidden="false" targetId="adbd-c48e-4b21-0002" primary="true"/>
      <categoryLink id="1db0-4012-9fce-599e" name="ASTARTES" hidden="false" targetId="adbd-c48e-4b21-a001" primary="false"/></categoryLinks>
      <constraints>
        <constraint id="0827-83c3-2b82-9212" type="max" value="3" field="selections" scope="force" shared="false" includeChildSelections="false" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile id="fbad-cf44-cbe2-38c4" name="Blackout Breachers" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic>
            <characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic>
            <characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic>
            <characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic>
            <characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic>
            <characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="23dc-948b-c730-e7ec" name="Unit rules / draft status" hidden="false">
          <description>Void boarding and urban assaults; 3rd / 5th Company variants
APPROVED advanced Ghost-Shroud and Sergeant Ghost-Sight. DRAFT Breaching Entry: once per battle add +1 AP to melee attacks against an enemy wholly within terrain during one Fight phase.</description>
        </rule>
      <rule id="b1758a07-86ab-5a9a-b14e" name="Where to find weapons (v1.8)" hidden="false"><description>Open Squad Size / Personnel, then the selected size, then each named model. Five (or ten) required models and their standard weapons now populate automatically. Change each model’s Primary Weapon choice to make legal replacements; optional sixth–ninth models must be added deliberately. Equipment is charged once per selected model; do not add a second separate weapon copy.</description></rule><rule id="46cfd782-1dcf-5f44-aa32" name="Breaching Entry" hidden="false"><description>once per battle add +1 AP to melee attacks against an enemy wholly within terrain during one Fight phase.</description></rule></rules>
      <rules>
        <rule id="3789-3896-65cb-8434" name="Ghost-Shroud (passive; approved)" hidden="false">
          <description>Hidden detection 12" instead of 15". When exposed and not fired this or preceding turn and not Advanced/Charged, has Stealth. Does not automatically gain Hidden.</description>
        </rule>
      </rules>
      <rules>
        <rule id="3597-8edb-8f69-c282" name="Adaptive Specialist Module (approved)" hidden="false">
          <description>Once per battle, at start of opponent Shooting phase: while Hidden activate Spectral Veil for 9" Hidden detection OR while exposed activate Signal Nullifier to worsen enemy ranged BS by 1; one mode only and no stacking.</description>
        </rule>
      </rules>
      <rules>
        <rule id="458b-308a-002f-94dd" name="Ghost-Sight Sergeant Targeting Uplink (approved)" hidden="false">
          <description>Once per your Shooting phase, living Sergeant chooses one enemy visible to them. Other models in own unit re-roll ranged Hit rolls of 1 vs that unit. No illegal targeting or rerolling a die twice.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="7316-66ad-d8d0-c88f" name="Mission Kit / Deployment Protocol" hidden="false" collective="false" defaultSelectionEntryId="5d9f-6528-f206-71f0">
          <constraints>
            <constraint id="7303-afe6-9fad-ac17" type="min" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
            <constraint id="2e6a-c415-4110-a6fe" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="5d9f-6528-f206-71f0" name="Boarding" hidden="false" collective="false" import="true" type="upgrade"><rules><rule id="55b38203-8029-5b76-b1f5" name="Boarding Equipment" hidden="false"><description>Boarding configuration; uses the unit’s published Breaching Entry ability. No additional unwritten bonuses.</description></rule></rules></selectionEntry>
            <selectionEntry id="fa35-31bd-916c-91d4" name="Urban Breach" hidden="false" collective="false" import="true" type="upgrade"><rules><rule id="381f9611-6893-5432-aef3" name="Urban Breach Equipment" hidden="false"><description>Urban breach configuration; uses the unit’s published Breaching Entry ability. No additional unwritten bonuses.</description></rule></rules></selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <rules>
        <rule id="2bae-bdab-f4f1-33b9" name="Faction / keyword boundary" hidden="false">
          <description>FACTION: ABANDONED DEAD. BRANCH: ASTARTES. All share one catalogue. No automatic extra active Ghost-Shroud for mortals.</description>
        </rule>
      </rules>
