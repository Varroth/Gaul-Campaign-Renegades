                                <constraint id="d14f-5c85-77e3-f495" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
                              </constraints>
                              <selectionEntries>
                                <selectionEntry id="301a-3dc9-a8f2-4d46" name="Ghostmark Tracer" hidden="false" collective="false" import="true" type="upgrade">
                                  <rules>
                                    <rule id="7d1d-cca0-682e-dc46" name="Ghostmark Tracer ability" hidden="false">
                                      <description>If this attack scores a Hit, target cannot benefit from Hidden for rest of current Shooting phase; the target must have been legally selectable initially.</description>
                                    </rule>
                                  </rules>
                                </selectionEntry>
                                <selectionEntry id="19b5-649a-4f5d-864c" name="Harrier Suppression" hidden="false" collective="false" import="true" type="upgrade">
                                  <rules>
                                    <rule id="96a5-062f-687c-a33d" name="Harrier Suppression ability" hidden="false">
                                      <description>If one or more shots Hit enemy INFANTRY, subtract 1 from their Advance and Charge rolls until end of their next turn. Does not stack.</description>
                                    </rule>
                                  </rules>
                                </selectionEntry>
                                <selectionEntry id="f809-facb-b445-c2e1" name="Breach-Penetrator" hidden="false" collective="false" import="true" type="upgrade">
                                  <rules>
                                    <rule id="bf47-6552-b502-f7c2" name="Breach-Penetrator ability" hidden="false">
                                      <description>An unmodified Wound roll of 6 improves AP of that attack by 1 (Longshot AP -2 to -3).</description>
                                    </rule>
                                  </rules>
                                </selectionEntry>
                              </selectionEntries>
                            </selectionEntryGroup>
                          </selectionEntryGroups>
                        </selectionEntry>
                      </selectionEntries>
                    </selectionEntryGroup>
                  </selectionEntryGroups>
