    <selectionEntry id="ed34-0f0b-5c8c-63f0" name="Directorate Breach Cell" hidden="false" collective="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink id="ca7e-4f74-fe61-80cc" name="Specialists" hidden="false" targetId="adbd-c48e-4b21-0002" primary="true"/>
      <categoryLink id="b2a9-5cc9-48d0-25bf" name="DIRECTORATE" hidden="false" targetId="adbd-c48e-4b21-a002" primary="false"/></categoryLinks>
      <constraints>
        <constraint id="147a-ebee-3bb9-8727" type="max" value="3" field="selections" scope="force" shared="false" includeChildSelections="false" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile id="0219-d5ff-9ded-1fc2" name="Directorate Breach Cell" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic>
            <characteristic name="T" typeId="c2bc-ad63-c63b-5cea">3</characteristic>
            <characteristic name="Sv" typeId="f078-5176-43c6-5f6a">4+</characteristic>
            <characteristic name="W" typeId="ecdc-11e1-15d1-5780">1</characteristic>
            <characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic>
            <characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="849b-409f-ed7e-4230" name="Unit rules / draft status" hidden="false">
          <description>Playtest mortal datasheet. No mandatory Guard-style officer Orders. This unit and all Astartes units belong to ONE Abandoned Dead faction.
5–10 models; M6, T3, Sv4+, W1, Ld7+, OC1. Shotgun, ballistic shield/breach tools; up to one flamer or meltagun per five. Choose exactly one mission kit in roster editor:

- Breach: once per battle, when attacking an enemy wholly in terrain, melee attacks gain +1 AP for that Fight phase.
- Engineer: while this unit is on an objective you control and is not Battle-shocked, its total OC increases by +2; nonstacking with another total-OC bonus.
- Demolition: once per battle in your Shooting phase, one model makes one demolition shot at a legally selected visible enemy Vehicle or Fortification within 9": BS4+, S9, AP-2, D3; this is not five independent explosives.

Role: breaching, sabotage and reclamation; replaces three redundant v1.1 squad entries.</description>
        </rule>
      <rule id="ccb4a928-8106-5a54-a231" name="Where to find weapons (v1.8)" hidden="false"><description>Open Squad Size / Personnel, then the selected size, then each named model. Five (or ten) required models and their standard weapons now populate automatically. Change each model’s Primary Weapon choice to make legal replacements; optional sixth–ninth models must be added deliberately. Equipment is charged once per selected model; do not add a second separate weapon copy.</description></rule></rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="440e-bed3-dc90-db97" name="Mission Kit / Deployment Protocol" hidden="false" collective="false" defaultSelectionEntryId="b835-27ed-f74f-258b">
          <constraints>
            <constraint id="098e-bae6-26dd-9df3" type="min" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
            <constraint id="c6f5-b3e6-c020-8e44" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="b835-27ed-f74f-258b" name="Breach" hidden="false" collective="false" import="true" type="upgrade"><rules><rule id="2491b5be-d441-5383-8979" name="Breach Protocol" hidden="false"><description>Once per battle, when attacking an enemy wholly in terrain, this unit’s melee attacks gain +1 AP for that Fight phase.</description></rule></rules></selectionEntry>
            <selectionEntry id="ba8b-66a6-80d7-211b" name="Engineer" hidden="false" collective="false" import="true" type="upgrade"><rules><rule id="9dde0394-f8d8-5f1b-a8cd" name="Objective Engineering" hidden="false"><description>While this unit is on an objective you control and is not Battle-shocked, its total OC increases by +2; nonstacking with another total-OC bonus.</description></rule></rules></selectionEntry>
            <selectionEntry id="94ff-218a-bf8e-88c4" name="Demolition" hidden="false" collective="false" import="true" type="upgrade"><rules><rule id="3ac589b0-a654-5f7a-b70e" name="Demolition Charge" hidden="false"><description>Once per battle in your Shooting phase, one model makes one demolition shot at a legally selected visible enemy Vehicle or Fortification within 9": BS4+, S9, AP-2, D3; this is not five independent explosives.</description></rule></rules></selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <rules>
        <rule id="b5a7-90d9-1bce-519e" name="Faction / keyword boundary" hidden="false">
          <description>FACTION: ABANDONED DEAD. BRANCH: DIRECTORATE. All share one catalogue. No automatic extra active Ghost-Shroud for mortals.</description>
        </rule>
