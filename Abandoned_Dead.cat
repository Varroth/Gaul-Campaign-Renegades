        <profile id="4f69-d5f5-c5ee-adf2" name="Field Support Cell" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic>
            <characteristic name="T" typeId="c2bc-ad63-c63b-5cea">3</characteristic>
            <characteristic name="Sv" typeId="f078-5176-43c6-5f6a">5+</characteristic>
            <characteristic name="W" typeId="ecdc-11e1-15d1-5780">1</characteristic>
