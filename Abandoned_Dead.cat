    <selectionEntry id="8355-097e-c288-f590" name="Pallbearer Veterans" hidden="false" collective="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink id="6a9f-1d57-785c-9f55" name="Specialists" hidden="false" targetId="adbd-c48e-4b21-0002" primary="true"/>
      <categoryLink id="f861-924f-903c-32b0" name="ASTARTES" hidden="false" targetId="adbd-c48e-4b21-a001" primary="false"/></categoryLinks>
      <constraints>
        <constraint id="3355-169b-a98c-413e" type="max" value="3" field="selections" scope="force" shared="false" includeChildSelections="false" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile id="13de-4e75-5860-28a7" name="Pallbearer Veterans" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic>
            <characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic>
            <characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic>
            <characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic>
            <characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic>
            <characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="9e8f-f05e-68c5-9e35" name="Unit rules / draft status" hidden="false">
          <description>1st Company elite power-armored assassins
APPROVED advanced Ghost-Shroud and Sergeant Ghost-Sight. DRAFT Elite Exploitation: once per battle re-roll one Wound roll against a unit revealed earlier this phase.</description>
        </rule>
      <rule id="c41e2baf-6ef6-5f82-bf7b" name="Where to find weapons (v1.8)" hidden="false"><description>Open Squad Size / Personnel, then the selected size, then each named model. Five (or ten) required models and their standard weapons now populate automatically. Change each model’s Primary Weapon choice to make legal replacements; optional sixth–ninth models must be added deliberately. Equipment is charged once per selected model; do not add a second separate weapon copy.</description></rule><rule id="b29c274c-326e-51ca-876b" name="Elite Exploitation" hidden="false"><description>once per battle re-roll one Wound roll against a unit revealed earlier this phase.</description></rule></rules>
      <rules>
        <rule id="f6c6-962e-6ded-1f23" name="Ghost-Shroud (passive; approved)" hidden="false">
          <description>Hidden detection 12" instead of 15". When exposed and not fired this or preceding turn and not Advanced/Charged, has Stealth. Does not automatically gain Hidden.</description>
        </rule>
      </rules>
      <rules>
        <rule id="8561-4e33-541f-c29b" name="Adaptive Specialist Module (approved)" hidden="false">
          <description>Once per battle, at start of opponent Shooting phase: while Hidden activate Spectral Veil for 9" Hidden detection OR while exposed activate Signal Nullifier to worsen enemy ranged BS by 1; one mode only and no stacking.</description>
        </rule>
      </rules>
      <rules>
        <rule id="c4d0-8ba9-1d99-5ad8" name="Ghost-Sight Sergeant Targeting Uplink (approved)" hidden="false">
          <description>Once per your Shooting phase, living Sergeant chooses one enemy visible to them. Other models in own unit re-roll ranged Hit rolls of 1 vs that unit. No illegal targeting or rerolling a die twice.</description>
        </rule>
      </rules>
      <rules>
        <rule id="de56-463d-84ce-9012" name="Faction / keyword boundary" hidden="false">
          <description>FACTION: ABANDONED DEAD. BRANCH: ASTARTES. All share one catalogue. No automatic extra active Ghost-Shroud for mortals.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="42a5-4f82-e16f-f33b" name="Squad Size / Personnel" hidden="false" collective="false" defaultSelectionEntryId="7335-dd5d-7a57-3945">
