ve="false" type="unit" import="true"><categoryLinks><categoryLink id="4b2e-f2e2-4a95-ea93" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/><categoryLink id="1fe4-3e14-dd10-3c06" name="ASTARTES" hidden="false" targetId="adbd-c48e-4b21-a001" primary="false"/></categoryLinks><constraints><constraint id="edfd-7b95-66d3-3be1" type="max" value="1" field="selections" scope="roster" shared="false" includeChildSelections="false" includeChildForces="false"/></constraints><costs><cost id="2479-1981-8b0b-7a44" name="pts" typeId="0246-3343-a75c-5ffa" value="110"/></costs><profiles><profile id="9530-6ecf-34b1-f356" name="Amon Veyth, Null" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">5</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">5+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="ad7-7e9a-b2b3-aa99" name="Invulnerable Save" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This model has a 4+ invulnerable save.</characteristic></characteristics></profile><profile id="9fe4-8d8c-4502-d966" name="Modified Bolt Carbine" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">18"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Assault</characteristic></characteristics></profile><profile id="6f6c-3cc7-8795-4e9c" name="Chainsword" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic></characteristics></profile></profiles><rules><rule id="c2ff-153f-76e2-5e18" name="Company and Cover Identity" hidden="false"><description>Amon Veyth is the permanent Captain of the 10th — The Unmarked; Null is his cover identity, NOT a separate selectable character. Equipment and ability are PLAYTEST drafts except established identity and command.</description></rule><rule id="d71a-117b-086b-f590" name="Legal Leader Attachments (manual validation)" hidden="false"><description>May attach to: Unmarked Scout Squad, Unmarked Scout Sniper Squad. Never attach a second Leader except where the codex explicitly permits it. This catalogue does not automate Leader associations.</description></rule><rule id="7f30-4bab-e325-8345" name="The Unmarked Path (PROVISIONAL)" hidden="false"><description>Once per battle at the start of your Movement phase, this model’s attached Scout unit may re-roll one Advance roll; it does not gain Hidden automatically.</description></rule><rule id="febc-4d8b-c56a-75eb" name="Ghost-Shroud (passive)" hidden="false"><description>Astartes passive Ghost-Shroud: when Hidden, detection threshold 12 inches instead of 15. When exposed and not fired this or preceding turn and not Advanced/Charged this turn, benefits from Stealth; no automatic Hidden.</description></rule></rules></selectionEntry></selectionEntries>
  <rules>
    <rule id="f5e9-d382-ae9f-ae03" name="Coordinated Opening — PROVISIONAL" hidden="false">
      <description>Once in YOUR Shooting phase, one friendly non-Battle-shocked Shadow Operative, Pathfinder, Veil Stalker Hunter-Killer, Veil Stalker Sniper or Unmarked Scout unit selects an enemy visible to it within 18". One other friendly Abandoned Dead unit which can legally fire at that target re-rolls one ranged Hit roll against it this phase. One activation per army per phase. This is a v1.4 test rule, not approved Chapter canon.</description>
    </rule>
    <rule id="a1c0-8020-b455-ddce" name="Abandoned Dead Unified Faction" hidden="false">
      <description>All Astartes, Directorate, Shadow Network, Partisan and Cultist units belong to ONE Abandoned Dead faction; no mandatory officer tax or separate ally detachment. The standing Infernal Warriors/Frozen Cogs/Abandoned Dead Unified Forces alliance remains a separate consent-based homebrew option.</description>
    </rule>
  </rules>
</catalogue>