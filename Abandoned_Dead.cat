    <selectionEntry id="5607-441a-3ac3-e51a" name="Pallbearer Terminators" hidden="false" collective="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink id="5d31-ce7a-98ae-076f" name="Specialists" hidden="false" targetId="adbd-c48e-4b21-0002" primary="true"/>
      <categoryLink id="2c13-f9b0-7aca-0b29" name="ASTARTES" hidden="false" targetId="adbd-c48e-4b21-a001" primary="false"/></categoryLinks>
      <constraints>
        <constraint id="c29c-34a0-b409-60f1" type="max" value="3" field="selections" scope="force" shared="false" includeChildSelections="false" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile id="36c3-1da5-b37a-602d" name="Pallbearer Terminators" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="8ffa-8367-2184-5557">5"</characteristic>
            <characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic>
            <characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic>
            <characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic>
            <characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic>
            <characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic>
            </characteristics>
        </profile>
      <profile id="ad7-2136-810f-a67e" name="Invulnerable Save" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This model has a 4+ invulnerable save.</characteristic></characteristics></profile></profiles>
      <rules>
        <rule id="57d9-3148-288c-0af5" name="Unit rules / draft status" hidden="false">
          <description>1st Company elite Terminators; boarding kit selectable
APPROVED advanced Ghost-Shroud and Sergeant Ghost-Sight; elite concealed assault, but no automatic Hidden or repeated relocation. DRAFT Covert Siege +1 OC total when controlling cover; Void Wraith once/battle special embark/disembark rule TBD (not currently active).</description>
        </rule>
      <rule id="22e02d22-a164-502d-8a80" name="Where to find weapons (v1.8)" hidden="false"><description>Open Squad Size / Personnel, then the selected size, then each named model. Five (or ten) required models and their standard weapons now populate automatically. Change each model’s Primary Weapon choice to make legal replacements; optional sixth–ninth models must be added deliberately. Equipment is charged once per selected model; do not add a second separate weapon copy.</description></rule></rules>
      <rules>
        <rule id="9871-ed44-866e-9385" name="Ghost-Shroud (passive; approved)" hidden="false">
          <description>Hidden detection 12" instead of 15". When exposed and not fired this or preceding turn and not Advanced/Charged, has Stealth. Does not automatically gain Hidden.</description>
        </rule>
      </rules>
      <rules>
        <rule id="404e-aefa-b9c3-b931" name="Adaptive Specialist Module (approved)" hidden="false">
          <description>Once per battle, at start of opponent Shooting phase: while Hidden activate Spectral Veil for 9" Hidden detection OR while exposed activate Signal Nullifier to worsen enemy ranged BS by 1; one mode only and no stacking.</description>
        </rule>
      </rules>
      <rules>
        <rule id="50bd-2957-d7a0-64e6" name="Ghost-Sight Sergeant Targeting Uplink (approved)" hidden="false">
          <description>Once per your Shooting phase, living Sergeant chooses one enemy visible to them. Other models in own unit re-roll ranged Hit rolls of 1 vs that unit. No illegal targeting or rerolling a die twice.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="a808-29fc-2f6a-8034" name="Mission Kit / Deployment Protocol" hidden="false" collective="false" defaultSelectionEntryId="7e74-10f2-0d05-570f">
          <constraints>
            <constraint id="28e6-3145-a8e5-9ff9" type="min" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
            <constraint id="f67a-b034-40b3-cf25" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="7e74-10f2-0d05-570f" name="Covert Siege" hidden="false" collective="false" import="true" type="upgrade"><rules><rule id="fcab8c83-649e-5dd1-964e" name="Covert Siege Protocol" hidden="false"><description>Playtest: while controlling an objective in cover, this unit gains +1 total OC (not per model). Do not stack with a second total-OC bonus.</description></rule></rules></selectionEntry>
            <selectionEntry id="26f0-7583-1892-232b" name="Void Wraith Boarding" hidden="false" collective="false" import="true" type="upgrade"><rules><rule id="e80cdd1c-9925-51ae-96ec" name="Void Boarding Configuration" hidden="false"><description>Narrative boarding equipment only. The earlier proposed once-per-battle embark/disembark effect is not yet defined and does not grant an active rule. Normal transport restrictions apply.</description></rule></rules></selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <rules>
        <rule id="0f4c-a956-c4a0-0575" name="Faction / keyword boundary" hidden="false">
          <description>FACTION: ABANDONED DEAD. BRANCH: ASTARTES. All share one catalogue. No automatic extra active Ghost-Shroud for mortals.</description>
        </rule>
      </rules>
