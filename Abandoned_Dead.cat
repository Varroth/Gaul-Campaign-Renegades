              <selectionEntryGroups><selectionEntryGroup id="269ee2af-4060-5d91-80b4" name="Sergeant — standard issue" hidden="false" collective="false" defaultSelectionEntryId="e139-511a-b15b-5921"><constraints><constraint id="8c245286-f73f-50eb-af4b" type="min" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/><constraint id="1860fcd3-81ea-5cfe-bd2f" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/></constraints><selectionEntries><selectionEntry id="e139-511a-b15b-5921" name="Sergeant" hidden="false" collective="false" import="true" type="model">
