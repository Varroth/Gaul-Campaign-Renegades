    <selectionEntry id="4d81-3e34-ddda-5c08" name="Veil Stalker Hunter-Killer Squad" hidden="false" collective="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink id="7ce0-30ba-6ae4-12e5" name="Specialists" hidden="false" targetId="adbd-c48e-4b21-0002" primary="true"/>
      <categoryLink id="e7e8-42a3-6654-d39a" name="ASTARTES" hidden="false" targetId="adbd-c48e-4b21-a001" primary="false"/></categoryLinks>
      <constraints>
        <constraint id="faa2-c449-480c-0ade" type="max" value="3" field="selections" scope="force" shared="false" includeChildSelections="false" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile id="063c-67a0-4ff8-cada" name="Veil Stalker Hunter-Killer Squad" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic>
            <characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic>
            <characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic>
            <characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic>
            <characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic>
            <characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="d7fc-50cc-6c5f-4e60" name="Unit rules / draft status" hidden="false">
          <description>Mixed marksmen, reconnaissance and mobile concealment
APPROVED advanced Ghost-Shroud; Sergeant Ghost-Sight. No dedicated sniper-squad Ghost-Eye or Ghost-Nest unless expressly added.</description>
        </rule>
      <rule id="69b90a81-c627-5162-be3d" name="Where to find weapons (v1.8)" hidden="false"><description>Open Squad Size / Personnel, then the selected size, then each named model. Five (or ten) required models and their standard weapons now populate automatically. Change each model’s Primary Weapon choice to make legal replacements; optional sixth–ninth models must be added deliberately. Equipment is charged once per selected model; do not add a second separate weapon copy.</description></rule></rules>
      <rules>
        <rule id="ae3b-1359-f8e1-9538" name="Ghost-Shroud (passive; approved)" hidden="false">
          <description>Hidden detection 12" instead of 15". When exposed and not fired this or preceding turn and not Advanced/Charged, has Stealth. Does not automatically gain Hidden.</description>
        </rule>
      </rules>
      <rules>
        <rule id="aaa1-1ab6-692c-2d3f" name="Adaptive Specialist Module (approved)" hidden="false">
          <description>Once per battle, at start of opponent Shooting phase: while Hidden activate Spectral Veil for 9" Hidden detection OR while exposed activate Signal Nullifier to worsen enemy ranged BS by 1; one mode only and no stacking.</description>
        </rule>
      </rules>
      <rules>
        <rule id="f3d9-374e-53d1-e80c" name="Ghost-Sight Sergeant Targeting Uplink (approved)" hidden="false">
          <description>Once per your Shooting phase, living Sergeant chooses one enemy visible to them. Other models in own unit re-roll ranged Hit rolls of 1 vs that unit. No illegal targeting or rerolling a die twice.</description>
        </rule>
      </rules>
      <rules>
        <rule id="fdc0-cf00-c612-39a1" name="Faction / keyword boundary" hidden="false">
          <description>FACTION: ABANDONED DEAD. BRANCH: ASTARTES. All share one catalogue. No automatic extra active Ghost-Shroud for mortals.</description>
        </rule>
      </rules>
