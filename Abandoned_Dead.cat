      </constraints>
      <profiles>
        <profile id="ccf1-252c-2bc1-736d" name="Unmarked Scout Squad" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic>
            <characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic>
            <characteristic name="Sv" typeId="f078-5176-43c6-5f6a">4+</characteristic>
            <characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic>
            <characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic>
            <characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="a85a-4a6f-bbb0-c0f7" name="Unit rules / draft status" hidden="false">
          <description>10th Company recruit and reconnaissance patrol
APPROVED Stealth + Adaptive Shadowpath: during roster creation choose Infiltrators OR Scouts 6", never both. Veteran Sergeant Ghost-Sight. No advanced Ghost-Shroud.</description>
        </rule>
      <rule id="71424e57-bc55-5c0f-9a5b" name="Where to find weapons (v1.8)" hidden="false"><description>Open Squad Size / Personnel, then the selected size, then each named model. Five (or ten) required models and their standard weapons now populate automatically. Change each model’s Primary Weapon choice to make legal replacements; optional sixth–ninth models must be added deliberately. Equipment is charged once per selected model; do not add a second separate weapon copy.</description></rule><rule id="69866b46-9fae-5bad-8d7f" name="Unmarked Reconnaissance" hidden="false"><description>Stealth. Adaptive Shadowpath: select ONE deployment mode at army construction: Infiltrators (Ghost Entry) or Scouts 6" (Shadow Patrol), never both. Selecting either does not automatically grant Hidden.</description></rule></rules>
      <rules>
        <rule id="62c3-c1fa-75b4-d820" name="Ghost-Sight Veteran Scout Sergeant (approved)" hidden="false">
          <description>Once per your Shooting phase Sergeant selects one visible enemy; other models in squad re-roll ranged Hit rolls of 1 vs that enemy. Sergeant does not benefit.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="c88f-a012-9a5d-0ab9" name="Mission Kit / Deployment Protocol" hidden="false" collective="false" defaultSelectionEntryId="1424-021f-9072-13ca">
          <constraints>
            <constraint id="2b2f-a53e-d25a-2848" type="min" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
            <constraint id="9d1e-6de8-feaa-caee" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="1424-021f-9072-13ca" name="Ghost Entry — Infiltrators" hidden="false" collective="false" import="true" type="upgrade"><rules><rule id="eb86-4184-351a-6f62" name="Adaptive Shadowpath — selected protocol" hidden="false"><description>This squad has Stealth and uses ONLY the selected protocol; Infiltrators or Scouts 6 inches, never both. Does not automatically become Hidden.</description></rule></rules></selectionEntry>
            <selectionEntry id="7ff1-010d-4d70-b422" name="Shadow Patrol — Scouts 6&quot;" hidden="false" collective="false" import="true" type="upgrade"><rules><rule id="f65d-253b-cd28-2db2" name="Adaptive Shadowpath — selected protocol" hidden="false"><description>This squad has Stealth and uses ONLY the selected protocol; Infiltrators or Scouts 6 inches, never both. Does not automatically become Hidden.</description></rule></rules></selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <rules>
        <rule id="4c55-2bb0-287f-914f" name="Faction / keyword boundary" hidden="false">
          <description>FACTION: ABANDONED DEAD. BRANCH: ASTARTES. All share one catalogue. No automatic extra active Ghost-Shroud for mortals.</description>
        </rule>
      </rules>
