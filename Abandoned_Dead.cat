    <selectionEntry id="1166-01c8-c884-9ec0" name="Grave Seeker Recovery Team" hidden="false" collective="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink id="2fb8-0e88-ae17-eb68" name="Specialists" hidden="false" targetId="adbd-c48e-4b21-0002" primary="true"/>
      <categoryLink id="ec56-c3e9-072e-e969" name="ASTARTES" hidden="false" targetId="adbd-c48e-4b21-a001" primary="false"/></categoryLinks>
      <constraints>
        <constraint id="8bf0-30ba-50ab-fb7f" type="max" value="3" field="selections" scope="force" shared="false" includeChildSelections="false" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile id="c970-4200-3f68-78af" name="Grave Seeker Recovery Team" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic>
            <characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic>
            <characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic>
            <characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic>
            <characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic>
            <characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="8296-6822-28f3-a164" name="Unit rules / draft status" hidden="false">
          <description>4th Company relic retrieval and salvage
APPROVED advanced Ghost-Shroud and Sergeant Ghost-Sight. DRAFT Recovered Evidence: once/battle while on objective gain +2 TOTAL OC until end turn, nonstacking.</description>
        </rule>
      <rule id="61b2f183-5047-5363-8fd5" name="Where to find weapons (v1.8)" hidden="false"><description>Open Squad Size / Personnel, then the selected size, then each named model. Five (or ten) required models and their standard weapons now populate automatically. Change each model’s Primary Weapon choice to make legal replacements; optional sixth–ninth models must be added deliberately. Equipment is charged once per selected model; do not add a second separate weapon copy.</description></rule><rule id="d2e02e6d-842e-58dc-bc76" name="Recovered Evidence" hidden="false"><description>once/battle while on objective gain +2 TOTAL OC until end turn, nonstacking.</description></rule></rules>
      <rules>
        <rule id="ffb9-ce69-a056-afa2" name="Ghost-Shroud (passive; approved)" hidden="false">
          <description>Hidden detection 12" instead of 15". When exposed and not fired this or preceding turn and not Advanced/Charged, has Stealth. Does not automatically gain Hidden.</description>
        </rule>
      </rules>
      <rules>
        <rule id="6b9b-ff69-2405-49ca" name="Adaptive Specialist Module (approved)" hidden="false">
          <description>Once per battle, at start of opponent Shooting phase: while Hidden activate Spectral Veil for 9" Hidden detection OR while exposed activate Signal Nullifier to worsen enemy ranged BS by 1; one mode only and no stacking.</description>
        </rule>
      </rules>
      <rules>
        <rule id="6da0-bfb5-d7ee-cb28" name="Ghost-Sight Sergeant Targeting Uplink (approved)" hidden="false">
          <description>Once per your Shooting phase, living Sergeant chooses one enemy visible to them. Other models in own unit re-roll ranged Hit rolls of 1 vs that unit. No illegal targeting or rerolling a die twice.</description>
        </rule>
      </rules>
      <rules>
        <rule id="837a-7a65-e332-bd27" name="Faction / keyword boundary" hidden="false">
          <description>FACTION: ABANDONED DEAD. BRANCH: ASTARTES. All share one catalogue. No automatic extra active Ghost-Shroud for mortals.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="94e2-7118-75fb-590f" name="Squad Size / Personnel" hidden="false" collective="false" defaultSelectionEntryId="3d76-354f-a802-daaa">
