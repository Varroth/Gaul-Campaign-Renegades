    <selectionEntry id="7485-9d8d-440c-8acd" name="Unmarked Scout Squad" hidden="false" collective="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink id="81f9-dd23-34e0-b0a6" name="Battleline" hidden="false" targetId="ec2c-68bb-bfbc-5ee3" primary="true"/>
      <categoryLink id="4f01-fb82-2941-53c3" name="ASTARTES" hidden="false" targetId="adbd-c48e-4b21-a001" primary="false"/></categoryLinks>
      <constraints>
