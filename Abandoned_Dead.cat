                      </constraints>
                      <selectionEntries>
                        <selectionEntry id="ea52-e1db-dc6b-cbce" name="Longshot Precision Rifle" hidden="false" collective="false" import="true" type="upgrade">
                          <profiles>
                            <profile id="e558-9337-e582-e984" name="Longshot Precision Rifle" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon">
                              <characteristics>
                                <characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic>
                                <characteristic name="A" typeId="1df3-e803-7074-57ce">1</characteristic>
                                <characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic>
                                <characteristic name="S" typeId="846d-1dce-303c-5c75">6</characteristic>
                                <characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic>
                                <characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic>
                                <characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy, Precision</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <selectionEntryGroups>
                            <selectionEntryGroup id="52d4-bb1f-9090-c533" name="Fixed Longshot Ammunition" hidden="false" collective="false" defaultSelectionEntryId="144b-57ac-d753-fe2d">
                              <constraints>
                                <constraint id="a6cc-64cc-e625-11bb" type="min" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
                                <constraint id="1391-e0a2-7c6c-43cd" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
                              </constraints>
                              <selectionEntries>
                                <selectionEntry id="144b-57ac-d753-fe2d" name="Ghostmark Tracer" hidden="false" collective="false" import="true" type="upgrade">
                                  <rules>
                                    <rule id="4add-f783-6bb3-79c4" name="Ghostmark Tracer ability" hidden="false">
                                      <description>If this attack scores a Hit, target cannot benefit from Hidden for rest of current Shooting phase; the target must have been legally selectable initially.</description>
                                    </rule>
                                  </rules>
                                </selectionEntry>
                                <selectionEntry id="23cf-fc6c-b73e-d43d" name="Harrier Suppression" hidden="false" collective="false" import="true" type="upgrade">
                                  <rules>
                                    <rule id="0989-06f6-f79a-1053" name="Harrier Suppression ability" hidden="false">
                                      <description>If one or more shots Hit enemy INFANTRY, subtract 1 from their Advance and Charge rolls until end of their next turn. Does not stack.</description>
                                    </rule>
                                  </rules>
                                </selectionEntry>
                                <selectionEntry id="2491-14b1-48f0-b15c" name="Breach-Penetrator" hidden="false" collective="false" import="true" type="upgrade">
                                  <rules>
                                    <rule id="7247-3a26-b13f-a9ee" name="Breach-Penetrator ability" hidden="false">
                                      <description>An unmodified Wound roll of 6 improves AP of that attack by 1 (Longshot AP -2 to -3).</description>
                                    </rule>
                                  </rules>
                                </selectionEntry>
                              </selectionEntries>
                            </selectionEntryGroup>
                          </selectionEntryGroups>
                        </selectionEntry>
                      </selectionEntries>
                    </selectionEntryGroup>
                    <selectionEntryGroup id="2781-317a-c9c4-ac21" name="Recon Auspex Upgrade" hidden="false" collective="false" defaultSelectionEntryId="045d-f876-9d16-41fa">
                      <constraints>
                        <constraint id="40a7-a3f5-7bca-58fe" type="min" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
                        <constraint id="e5fb-7708-bccc-a3e9" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
                      </constraints>
                      <selectionEntries>
                        <selectionEntry id="045d-f876-9d16-41fa" name="No Ghost-Eye" hidden="false" collective="false" import="true" type="upgrade"/>
                        <selectionEntry id="5eb1-28ce-3b0e-4a93" name="Ghost-Eye Recon Auspex" hidden="false" collective="false" import="true" type="upgrade"><rules><rule id="0325-54af-4554-9ea7" name="Ghost-Eye Recon Auspex (approved)" hidden="false"><description>Once per own Shooting phase, operator designates one visible enemy within 36" and assists ONE OTHER sniper model in own unit: re-roll one Wound roll OR ignore cover for one attack; each model gets at most one Ghost-Eye benefit, operator retains rifle.</description></rule></rules></selectionEntry>
                      </selectionEntries>
                    </selectionEntryGroup>
                    <selectionEntryGroup id="1f3b-fb3a-925d-4310" name="Sergeant Melee Wargear" hidden="false" collective="false" defaultSelectionEntryId="a109-937a-46a2-332f">
                      <constraints>
                        <constraint id="912e-6faf-d174-7d32" type="min" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
                        <constraint id="0e90-5804-5a3d-18d4" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
                      </constraints>
                      <selectionEntries>
                        <selectionEntry id="a109-937a-46a2-332f" name="Chainsword" hidden="false" collective="false" import="true" type="upgrade">
                          <profiles>
                            <profile id="523f-77c2-50bb-7697" name="Chainsword" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon">
                              <characteristics>
                                <characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic>
