                                  <rules>
                                    <rule id="7b33-f959-1a4d-1c15" name="Ghostmark Tracer ability" hidden="false">
                                      <description>If this attack scores a Hit, target cannot benefit from Hidden for rest of current Shooting phase; the target must have been legally selectable initially.</description>
                                    </rule>
                                  </rules>
                                </selectionEntry>
                                <selectionEntry id="0d95-98d8-88cb-43e8" name="Harrier Suppression" hidden="false" collective="false" import="true" type="upgrade">
                                  <rules>
                                    <rule id="3933-5c41-c4d5-3206" name="Harrier Suppression ability" hidden="false">
                                      <description>If one or more shots Hit enemy INFANTRY, subtract 1 from their Advance and Charge rolls until end of their next turn. Does not stack.</description>
                                    </rule>
                                  </rules>
                                </selectionEntry>
                                <selectionEntry id="5da3-6fb2-89ea-345f" name="Breach-Penetrator" hidden="false" collective="false" import="true" type="upgrade">
                                  <rules>
                                    <rule id="7049-0335-2906-157f" name="Breach-Penetrator ability" hidden="false">
                                      <description>An unmodified Wound roll of 6 improves AP of that attack by 1 (Longshot AP -2 to -3).</description>
                                    </rule>
                                  </rules>
                                </selectionEntry>
                              </selectionEntries>
