    <selectionEntry id="425f-11e9-b1b8-8792" name="Veil Stalker Sniper Squad" hidden="false" collective="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink id="afd0-996e-b40b-a6ae" name="Specialists" hidden="false" targetId="adbd-c48e-4b21-0002" primary="true"/>
      <categoryLink id="73f6-c357-017a-42e0" name="ASTARTES" hidden="false" targetId="adbd-c48e-4b21-a001" primary="false"/></categoryLinks>
      <constraints>
        <constraint id="2a8c-0493-6e10-cbc1" type="max" value="3" field="selections" scope="force" shared="false" includeChildSelections="false" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile id="d255-e41e-d279-6a21" name="Veil Stalker Sniper Squad" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic>
            <characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic>
            <characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic>
            <characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic>
            <characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic>
            <characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="9611-2ed4-a2b4-e236" name="Unit rules / draft status" hidden="false">
          <description>Longshot anti-personnel and anti-materiel snipers
APPROVED Infiltrators + Ghost-Nest deployment and one 9" Concealed Relocation instead of Normal Move: no shooting/Advance/Charge that turn, must end in terrain, Hidden only if requirements met. Advanced Ghost-Shroud; Ghost-Sight. Ghost-Eye once/Shooting phase, spotter-visible enemy within 36": assist other model to re-roll one Wound roll OR ignore Cover for one attack; nonstacking.</description>
        </rule>
      <rule id="b024-9670-f34f-8a27" name="Equipment Selection Note" hidden="false"><description>Longshot ammunition is fixed during army construction per equipped rifle. Recon auspex effect applies ONLY if the corresponding auspex wargear option is selected on that living model, not merely because an operator slot exists. No re-roll of a re-rolled die.</description></rule><rule id="9ec80394-a396-5fe4-a908" name="Where to find weapons (v1.8)" hidden="false"><description>Open Squad Size / Personnel, then the selected size, then each named model. Five (or ten) required models and their standard weapons now populate automatically. Change each model’s Primary Weapon choice to make legal replacements; optional sixth–ninth models must be added deliberately. Equipment is charged once per selected model; do not add a second separate weapon copy.</description></rule></rules>
      <rules>
        <rule id="953d-bd20-4726-db80" name="Ghost-Shroud (passive; approved)" hidden="false">
          <description>Hidden detection 12" instead of 15". When exposed and not fired this or preceding turn and not Advanced/Charged, has Stealth. Does not automatically gain Hidden.</description>
        </rule>
      </rules>
      <rules>
        <rule id="ce80-1303-b492-10d4" name="Adaptive Specialist Module (approved)" hidden="false">
          <description>Once per battle, at start of opponent Shooting phase: while Hidden activate Spectral Veil for 9" Hidden detection OR while exposed activate Signal Nullifier to worsen enemy ranged BS by 1; one mode only and no stacking.</description>
        </rule>
      </rules>
      <rules>
        <rule id="8bbd-6be7-47e7-fdcd" name="Ghost-Sight Sergeant Targeting Uplink (approved)" hidden="false">
          <description>Once per your Shooting phase, living Sergeant chooses one enemy visible to them. Other models in own unit re-roll ranged Hit rolls of 1 vs that unit. No illegal targeting or rerolling a die twice.</description>
        </rule>
      </rules>
      <rules>
        <rule id="6a57-cbba-4117-7134" name="Ghost-Nest &amp; Concealed Relocation (approved)" hidden="false">
          <description>Infiltrators; begin Hidden only if deployment in qualifying terrain and normal Hidden requirements met. Once per battle instead of Normal Move, move up to 9" and end wholly in qualifying terrain; no Shoot, Advance, Charge that turn; Hidden only if all conditions met.</description>
        </rule>
      </rules>
      <rules>
        <rule id="9b85-ed90-6485-5d4f" name="Faction / keyword boundary" hidden="false">
          <description>FACTION: ABANDONED DEAD. BRANCH: ASTARTES. All share one catalogue. No automatic extra active Ghost-Shroud for mortals.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="b144-d089-58d6-b3e1" name="Squad Size / Personnel" hidden="false" collective="false" defaultSelectionEntryId="86f7-b2b2-0467-7df2">
          <constraints>
            <constraint id="ab81-03ac-75d0-8fdd" type="min" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
            <constraint id="65f2-91ca-838a-5521" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="86f7-b2b2-0467-7df2" name="5–9 models" hidden="false" collective="false" import="true" type="upgrade">
              <selectionEntryGroups><selectionEntryGroup id="f6854931-43be-51e4-973a" name="Sergeant — standard issue" hidden="false" collective="false" defaultSelectionEntryId="03fc-2242-2575-2bc7"><constraints><constraint id="6fe1e5e6-209c-5c21-b3b6" type="min" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/><constraint id="fa0f957d-5c99-599a-b287" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/></constraints><selectionEntries><selectionEntry id="03fc-2242-2575-2bc7" name="Sergeant" hidden="false" collective="false" import="true" type="model">
                  <constraints>
                    <constraint id="547d-42c9-e415-f47d" type="min" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
                    <constraint id="1679-d5a4-d8a1-f678" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
                  </constraints>
                  <costs>
                    <cost id="1602-23be-0c28-501b" name="pts" typeId="0246-3343-a75c-5ffa" value="26.0"/>
                  </costs>
                  <selectionEntryGroups>
                    <selectionEntryGroup id="d0c0-95fa-90ed-2ee8" name="Primary Weapon (choose one)" hidden="false" collective="false" defaultSelectionEntryId="ea52-e1db-dc6b-cbce">
                      <constraints>
                        <constraint id="dc3b-83c2-35a5-a90e" type="min" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false"/>
