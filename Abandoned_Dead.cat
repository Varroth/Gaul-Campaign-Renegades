    <selectionEntry id="1ecb-63cf-485e-3ec3" name="Falling Shroud Jump Assault" hidden="false" collective="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink id="073f-7d0d-aa68-128e" name="Specialists" hidden="false" targetId="adbd-c48e-4b21-0002" primary="true"/>
      <categoryLink id="1e69-4f9d-5392-cdec" name="ASTARTES" hidden="false" targetId="adbd-c48e-4b21-a001" primary="false"/></categoryLinks>
      <constraints>
        <constraint id="adb4-c166-5051-4f3a" type="max" value="3" field="selections" scope="force" shared="false" includeChildSelections="false" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile id="7ba3-e596-b38e-95c5" name="Falling Shroud Jump Assault" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="8ffa-8367-2184-5557">12"</characteristic>
            <characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic>
            <characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic>
            <characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic>
            <characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic>
            <characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="5882-24f5-be28-1eeb" name="Unit rules / draft status" hidden="false">
          <description>8th Company covert airborne assault
APPROVED advanced Ghost-Shroud and Sergeant Ghost-Sight. DRAFT Nightfall Landing: once per battle a unit that arrived this turn gains Stealth until end of enemy’s next Shooting phase if not Hidden; does not force Hidden.</description>
        </rule>
      <rule id="ec8a2696-17bb-5861-8a2f" name="Where to find weapons (v1.8)" hidden="false"><description>Open Squad Size / Personnel, then the selected size, then each named model. Five (or ten) required models and their standard weapons now populate automatically. Change each model’s Primary Weapon choice to make legal replacements; optional sixth–ninth models must be added deliberately. Equipment is charged once per selected model; do not add a second separate weapon copy.</description></rule><rule id="e823ec96-194d-5b29-a2db" name="Nightfall Landing" hidden="false"><description>once per battle a unit that arrived this turn gains Stealth until end of enemy’s next Shooting phase if not Hidden; does not force Hidden.</description></rule></rules>
      <rules>
        <rule id="4121-501a-83b2-bfde" name="Ghost-Shroud (passive; approved)" hidden="false">
          <description>Hidden detection 12" instead of 15". When exposed and not fired this or preceding turn and not Advanced/Charged, has Stealth. Does not automatically gain Hidden.</description>
        </rule>
      </rules>
      <rules>
        <rule id="f6f2-fdb6-4620-b38c" name="Adaptive Specialist Module (approved)" hidden="false">
          <description>Once per battle, at start of opponent Shooting phase: while Hidden activate Spectral Veil for 9" Hidden detection OR while exposed activate Signal Nullifier to worsen enemy ranged BS by 1; one mode only and no stacking.</description>
        </rule>
      </rules>
      <rules>
        <rule id="64a7-804d-4b51-8146" name="Ghost-Sight Sergeant Targeting Uplink (approved)" hidden="false">
          <description>Once per your Shooting phase, living Sergeant chooses one enemy visible to them. Other models in own unit re-roll ranged Hit rolls of 1 vs that unit. No illegal targeting or rerolling a die twice.</description>
        </rule>
      </rules>
      <rules>
        <rule id="6488-fb84-5593-c8c2" name="Faction / keyword boundary" hidden="false">
          <description>FACTION: ABANDONED DEAD. BRANCH: ASTARTES. All share one catalogue. No automatic extra active Ghost-Shroud for mortals.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="7a6a-3e17-29a8-68ad" name="Squad Size / Personnel" hidden="false" collective="false" defaultSelectionEntryId="c854-97d2-e56c-0298">
