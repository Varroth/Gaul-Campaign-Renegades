        <rule id="abcf-dad3-e1c7-6614" name="Unit rules / draft status" hidden="false">
          <description>Chapter signals intelligence and false-identity handler
Sever the Link (DRAFT): once per battle, at the start of the opponent’s Shooting phase, select one enemy unit visible within 18". Until phase end, that enemy cannot use Hit re-rolls granted by allied Character abilities while targeting the Ciphermaster’s attached unit; weapon-native re-rolls remain valid. Cannot duplicate Signal Nullifier or change Ballistic Skill.</description>
        </rule>
      <rule id="e64f2ad9-1127-5904-9163" name="Sever the Link" hidden="false"><description>once per battle, at the start of the opponent’s Shooting phase, select one enemy unit visible within 18". Until phase end, that enemy cannot use Hit re-rolls granted by allied Character abilities while targeting the Ciphermaster’s attached unit; weapon-native re-rolls remain valid. Cannot duplicate Signal Nullifier or change Ballistic Skill.</description></rule></rules>
      <rules>
        <rule id="fa9b-317d-d543-ded3" name="Leader Attachments (draft)" hidden="false">
          <description>May attach only to: Veiled Circuit Signal Cell, Veil Stalker Hunter-Killer Squad. One attached Leader per unit, no extra Sergeant.</description>
        </rule>
      </rules>
      <rules>
        <rule id="1182-89a6-ead8-5dae" name="Ghost-Shroud (passive; approved)" hidden="false">
          <description>Hidden detection 12" instead of 15". When exposed and not fired this or preceding turn and not Advanced/Charged, has Stealth. Does not automatically gain Hidden.</description>
        </rule>
      </rules>
      <rules>
        <rule id="a039-a3ba-59e6-f830" name="Faction / keyword boundary" hidden="false">
          <description>FACTION: ABANDONED DEAD. BRANCH: ASTARTES. All share one catalogue. No automatic extra active Ghost-Shroud for mortals.</description>
        </rule>
      </rules>
