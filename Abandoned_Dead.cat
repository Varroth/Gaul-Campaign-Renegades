                                    <rule id="d8c2-8d9b-2c54-1b38" name="Ghostmark Tracer ability" hidden="false">
                                      <description>If this attack scores a Hit, target cannot benefit from Hidden for rest of current Shooting phase; the target must have been legally selectable initially.</description>
                                    </rule>
                                  </rules>
                                </selectionEntry>
                                <selectionEntry id="da10-fcc3-c402-5d2c" name="Harrier Suppression" hidden="false" collective="false" import="true" type="upgrade">
                                  <rules>
                                    <rule id="cced-141e-c807-5cfe" name="Harrier Suppression ability" hidden="false">
                                      <description>If one or more shots Hit enemy INFANTRY, subtract 1 from their Advance and Charge rolls until end of their next turn. Does not stack.</description>
                                    </rule>
                                  </rules>
                                </selectionEntry>
                                <selectionEntry id="24ef-875c-6548-5caa" name="Breach-Penetrator" hidden="false" collective="false" import="true" type="upgrade">
                                  <rules>
                                    <rule id="6365-f3d1-1d76-c286" name="Breach-Penetrator ability" hidden="false">
                                      <description>An unmodified Wound roll of 6 improves AP of that attack by 1 (Longshot AP -2 to -3).</description>
                                    </rule>
                                  </rules>
                                </selectionEntry>
                              </selectionEntries>
