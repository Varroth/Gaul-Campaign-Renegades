      <constraints>
        <constraint id="cfb2-8967-b0fe-7542" type="max" value="3" field="selections" scope="force" shared="false" includeChildSelections="false" includeChildForces="false"/>
      </constraints>
      <profiles>
        <profile id="841b-ea0e-3818-55ec" name="Pathfinder Recon Team" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic>
            <characteristic name="T" typeId="c2bc-ad63-c63b-5cea">3</characteristic>
            <characteristic name="Sv" typeId="f078-5176-43c6-5f6a">5+</characteristic>
            <characteristic name="W" typeId="ecdc-11e1-15d1-5780">1</characteristic>
            <characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic>
            <characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="e4ba-2bf9-0060-9762" name="Unit rules / draft status" hidden="false">
          <description>Playtest mortal datasheet. No mandatory Guard-style officer Orders. This unit and all Astartes units belong to ONE Abandoned Dead faction.
5–10 models; M6, T3, Sv5+, W1, Ld7+, OC1. Carbines and auspex; up to one human sniper rifle or grenade launcher per five. Scouts 6"; Stealth. Eligible to designate targets for Coordinated Opening. Role: field observation, routes, real-world intelligence and screening.</description>
        </rule>
      <rule id="e0f56f5d-2b89-59c9-881c" name="Where to find weapons (v1.8)" hidden="false"><description>Open Squad Size / Personnel, then the selected size, then each named model. Five (or ten) required models and their standard weapons now populate automatically. Change each model’s Primary Weapon choice to make legal replacements; optional sixth–ninth models must be added deliberately. Equipment is charged once per selected model; do not add a second separate weapon copy.</description></rule></rules>
      <rules>
        <rule id="b045-e37e-014b-1a91" name="Faction / keyword boundary" hidden="false">
          <description>FACTION: ABANDONED DEAD. BRANCH: DIRECTORATE. All share one catalogue. No automatic extra active Ghost-Shroud for mortals.</description>
        </rule>
      </rules>
