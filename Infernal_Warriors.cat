 combat blade" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="30365f82-af3c-46b2" name="Multi-melta" hidden="false" targetId="4711-5a8c-ab44-5573" type="profile"/><infoLink id="71db5189-5895-46a6" name="Bolt pistol" hidden="false" targetId="19be-3f27-bea8-5ca4" type="profile"/><infoLink id="cc2b3ee9-0cac-4e02" name="Close-combat weapon" hidden="false" targetId="953b-aa30-035d-5d4d" type="profile"/></infoLinks></selectionEntry><selectionEntry id="224e7746-d061-48fa" name="plasma cannon, bolt pistol, combat blade" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="ccf77462-7b32-4177" name="Plasma cannon" hidden="false" targetId="ff14a50e-7891-5c25" type="profile"/><infoLink id="c8dd5238-2c66-41e0" name="Bolt pistol" hidden="false" targetId="19be-3f27-bea8-5ca4" type="profile"/><infoLink id="23824c2e-250f-4f25" name="Close-combat weapon" hidden="false" targetId="953b-aa30-035d-5d4d" type="profile"/></infoLinks></selectionEntry><selectionEntry id="172b0a42-3818-4839" name="missile, bolt pistol, combat blade" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="bb06d3a7-4954-4b60" name="Missile launcher (frag)" hidden="false" targetId="2f23-67a8-672a-56ba" type="profile"/><infoLink id="eb4d888b-419d-4fda" name="Missile launcher (krak)" hidden="false" targetId="d343-195f-5f9a-5a0e" type="profile"/><infoLink id="6c7a874b-5a97-4933" name="Bolt pistol" hidden="false" targetId="19be-3f27-bea8-5ca4" type="profile"/><infoLink id="0944b26c-2802-4d93" name="Close-combat weapon" hidden="false" targetId="953b-aa30-035d-5d4d" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="e8d03420-083e-4935" name="Deployment / passenger assignment (one declared plan)" hidden="false" collective="false" import="true" defaultSelectionEntryId="d7f18d76-733e-417a"><constraints><constraint id="0cb21532-4ce3-4214" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="7756168c-c108-49f0" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="d7f18d76-733e-417a" name="Deployed on the battlefield (normal)" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="3ea70cd7-9702-4e3a" name="Standard Strategic Reserves (mission restrictions)" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="5311d4c1-732a-4040" name="Standard Reserves" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Select only when the mission allows this formation and it fits the Reserves points cap; normal later-round timing applies. This is not an automatic Deep Strike grant.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="bed89ac0-d3a4-4700" name="Embarked in: Rhino Carrier" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="7a6c-99a9-6f03-5c81" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="8f23f2ae-745f-4a16" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a sep