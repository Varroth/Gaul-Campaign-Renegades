includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="fafd97b3-f17d-4970" name="Mechanised Vanguard — pre-battle move declaration" hidden="false" collective="false" import="true"><constraints><constraint id="0e983fc4-2b58-427a" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="9e689d1f-da88-4540" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries/><entryLinks><entryLink id="623dbb4a-52a7-497d" name="Select as Mechanised Vanguard (3-inch move, 0 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="47db8214-8de1-4efd"/></entryLinks></selectionEntryGroup></selectionEntryGroups><modifiers><modifier type="set" field="9fb2-00c7-0053-5af4" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="722a-2c35-6f47-5a04" name="Spartan Assault Tank" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="0f8a-64dc-b7f3-54de" name="Transports" hidden="false" targetId="9856-3547-9660-54c2" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d36e-a58f-ca0a-5924" type="max"/></constraints><profiles><profile id="f70e-fa54-edba-512e" name="Spartan Assault Tank" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">10"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">12</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">20</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">6</characteristic></characteristics></profile><profile id="4efb-b899-d94e-5715" name="Legion Carrier" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Capacity 20 eligible Infantry spaces; Terminators count as two.</characteristic></characteristics></profile><profile id="7332-969f-7e58-5011" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Two quad lascannon arrays, twin heavy bolter; optional hull multi-melta. Capacity 20 Infantry spaces; each Terminator occupies two.</characteristic></characteristics></profile><profile id="f547-689f-5300-5c6a" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="ba3a84a9-d147-4f39" name="Passenger Manifest &amp; capacity" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Transport registration: Passenger-bearing Infantry must DECLARE this vehicle type in their Deployment / passenger assignment selection. Capacity 20 spaces; Terminators and jump-equipped passengers may use two each where permitted. Include ALL attached leaders and all squads sharing a carrier; do not exceed capacity. The catalogue records carrier TYPE, not a unique vehicle instance, so this capacity total must still be checked before play.</characteristic></characteristics></profile><profile id="dfe1b95e-0d68-4d79" name="Legion Assault Requisition conditions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">OPTIONAL discounted transport under Breach and Ruin: saves 40 points once per eligible hull, with 1 discount per full 1,000 army points (max 2). This vehicle must start with a compatible separately purchased infantry formation embarked; not a formation using Void Assault or Cohort Insertion. Real passenger allocation must be confirmed manually.</characteristic></characteristics></profile><profile id="a1380cb4-e951-404e" name="Mechanised Vanguard conditions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">OPTIONAL pre-battle move of up to 3 inches after deployment if this non-AIRCRAFT transport starts with friendly INFANTRY embarked and the mission permits. End over 9 inches from all enemies, outside enemy deployment zone. 1/1,000-point battle limit (max 2). Aircraft can never gain this privilege. Never confers a charge or first-turn aircraft arrival exception.</characteristic></characteristics></profile><profile id="57ee7c94-c1ec-432b-a2e2-e137f56424a6" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Two quad lascannon arrays, twin heavy bolter; optional hull multi-melta. Capacity 20 Infantry spaces; each Terminator occupies two. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks>
        </infoLinks><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="355.0"/></costs><selectionEntryGroups><selectionEntryGroup id="c80f5c50-ad3e-4eb6" name="Fixed armament" hidden="false" collective="false" import="true" defaultSelectionEntryId="4a6321ed-4da6-414a"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="44303ff5-f1c7-43f7" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ab7aca62-575c-4634" type="max"/></constraints><selectionEntries><selectionEntry id="4a6321ed-4da6-414a" name="2 quad lascannon arrays + twin heavy bolter" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="d6ad5649-b638-47ff" name="Twin lascannons" hidden="false" targetId="50ca-22a4-36c4-5a73" type="profile"/><infoLink id="d2ed091f-c399-4ea0" name="Twin heavy bolter" hidden="false" targetId="45cfd916-26bf-58c2" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="d9f5c8ed-544a-42cd" name="Optional hull weapon" hidden="false" collective="false" import="true"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d3f4073d-2840-46af" type="max"/></constraints><selectionEntries><selectionEntry id="5d06d837-52b2-4677" name="Multi-melta" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="db17a969-b65f-4cc1" name="Multi-melta" hidden="false" targetId="4711-5a8c-ab44-5573" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="7c541db9-9146-4dec" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><constrain