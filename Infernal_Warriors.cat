haracteristics></profile></profiles></selectionEntry><selectionEntry id="7fab1a92-46d6-486b" name="Embarked in: Mastodon Heavy Transport" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="6403-07f8-9aad-532c" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="cba78fff-3c57-4c17" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Mastodon Heavy Transport. Formation is 10 infantry model(s); minimum passenger spaces 20. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="7f083d6c-3d11-45b8" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><constraints><constraint id="f10502e4-38d8-462b" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><entryLinks><entryLink id="a56317b4-6ba4-4be4" name="Vox of the Unforgotten (+10 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="9cb06d75-2acf-4d85"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="8eb0-8d1d-a832-5447" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="2de11288-d698-41c6" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink><entryLink id="f77345f6-6946-408f" name="War Hounds’ Field Manual (+15 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="3028597c-2a14-4594"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="8eb0-8d1d-a832-5447" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="96ec7e6c-cb3a-47cd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink><entryLink id="f7cae83f-12ab-448c" name="The Measured Strike (+15 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="dcf44d0a-d9cb-4d92"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="d6ca-9cbf-e275-5803" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="1307c605-442e-45a0" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink><entryLink id="59ab1973-ef3b-4862" name="Breachmaster’s Seal (+10 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="214b488b-9259-46a2"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="b7ad-18e3-9d4d-57e1" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="35f93afb-1e92-4e24" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink><entryLink id="18888fa2-be65-4fad" name="Dismantler’s Charge (+10 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="ccfc75ff-fece-4985"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="b7ad-18e3-9d4d-57e1" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="940fe0dc-82be-4532" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="b1d5-592b-df0f-519f" name="LEADER — select attached character for THIS squad (optional; 0 pts)" hidden="false" collective="false" import="true" defaultSelectionEntryId="9711-f157-946d-5d76"><constraints><constraint id="4810-400a-ca5c-5252" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="6a0a-4637-4ef0-5f53" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="9711-f157-946d-5d76" name="No attached Leader" hidden="false" type="upgrade" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="82ed-ec1b-2b67-5f30" name="Attached: Infernal Terminator Chaplain (already paid separately; generic Chaplain)" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry></selectionEntries><entryLinks><entryLink id="6f15-51ad-88ef-58c9" name="Attached: Varroth (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="3b45-ef3e-e405-5348"/></entryLinks></selectionEntryGroup></selectionEntryGroups><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="52c9-624e-f0c8-5b10" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="0631-ee39-aaef-5df1" name="Lost Cohort — Power Armour" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="5796-264a-9304-5793" name="Lost Cohort" hidden="false" targetId="2962-6989-212f-598d" primary="true"/><categoryLink id="7c88-5dfb-4b09-5171" name="Infantry" hidden="false" targetId="521d-dd50-6a49-58fb" primary="false"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="2" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0d7f-2cc8-162c-5e2e" type="max"/></constraints><profiles><profile id="b875-47ee-366b-5cc1" name="Lost Cohort — Power Armour" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="d7e1-4b7e-394f-5f38" name="Afflicted Ferocity" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each afflicted model gains +1 Attack with ONE selected melee weapon profile. Maximum TWO Lost Cohort units in the army. Each requires its own separate qualifying attached Chaplain at muster (cost bundled in the size selection). When supervision is lost, make a D6 Control Test at start of each Command phase: 4+ pass; failure means Aggressive Pursuit until control restored. May use Cohort Insertion from Reserves, including first friendly Reinforcements step, subject to Reserves cap and normal enemy exclusion/charge rules.</characteristic></characteristics></profile><profile id="1bfc-04bb-eacb-5ee4" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">5–10 afflicted (excluding attached Chaplain). Each has boltgun or bolt pistol and chainaxe or power weapon; one combi-weapon or heavy flamer per 5. Optional ALL-model jump packs add +15 pts per full or partial five afflicted; MUST pair with jump-pack Infernal Chaplain (+10) and no normal foot Chaplain. Deep Strike via Cohort Insertion, including first-round option. Two Cohort squads max army-wide.</characteristic></characteristics></profile><profile id="3601-ba9c-acec-5b31" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">ARMY RULE: Infernal Serum (+1 W already applied, FNP 5+, regenerate 1 W at start of your turn). Lost Cohort: mandatory attached Chaplain already INCLUDED in formation option cost below. Do NOT buy the same Chaplain again as an independent unit; total Lost Cohort ≤2 units across both sheets. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="5869a7af-4348-500d" name="Chaplain counted in this catalogue" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each SELECTABLE squad-size option already includes the points of exactly ONE separately required starting Chaplain. The Chaplain is represented by the chosen formation option (not a separately added Character selection). Do NOT add its points again. The chosen Chaplain has its actual separate character datasheet available in this catalogue for reference, but selecting that independent datasheet would charge twice. Strict model-by-model attachment is NOT automated in the current data structure.</characteristic></characteristics></profile><profile id="99d7c407-6ad3-4fb7-863e-1b45b61b4d94" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: 5–10 afflicted (excluding attached Chaplain). Each has boltgun or bolt pistol and chainaxe or power weapon; one combi-weapon or heavy flamer per 5. Optional ALL-model jump packs add +15 pts  | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="808f-7a35-41b9-5b62" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="5e51-e640-6e26-5657" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="217b-7ebf-61aa-5450" name="Lost Cohort — Control" hidden="false" targetId="3bff-1efe-c60b-511f" type="rule"/><infoLink id="a4ff490c-db3f-5469" name="Cohort Insertion" hidden="false" targetId="4bbaac30-6adb-5c5f" type="rule"/><infoLink id="8d39d116-d968-5f05" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="a205-bc96-de95-5245" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="93ff-9d0d-682d-5ee0"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="fb0c-b886-20fe-5bb8" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="015f-7cfe-8f03-5faa" type="max"/></constraints><selectionEntries><selectionEntry id="fb89-4d1f-cb4b-5e1e" name="5 afflicted + attached Infernal Chaplain (foot)" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="220.0"/></costs><profiles><profile id="d684-2a78-65c8-576c" name="Build notes" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Includes 75pt separate mandatory foot Chaplain; counts as one Lost Cohort unit.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="b44fe784-99b3-4f38" name="Champion 1 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="6f8adec1-b9cc-4adf"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="33d3534c-8b32-49ac" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="804085c4-0b35-4ecc" type="max"/></constraints><selectionEntries><selectionEntry id="6f8adec1-b9cc-4adf" name="bolter, chainaxe" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="c5053ab3-7563-4c6f" name="Boltgun" hidden="false" targetId="883a-5ac2-abab-5817" type="profile"/><infoLink id="a4285087-4071-40b1" name="Chainaxe" hidden="false" targetId="6adf-461d-bedd-589d" type="profile"/></infoLinks></selectionEntry><selectionEntry id="8be0d30f-f766-4c41" name="bolter, power" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="deee6eea-c15e-4f98" name="Boltgun" hidden="false" targetId="883a-5ac2-abab-5817" type="profile"/><infoLink id="a17e0452-2e9d-4eba" name="Power sword / axe" hidden="false" targetId="1ec2-20f5-fe4e-5b6c" type="profile"/></infoLinks></selectionEntry><selectionEntry id="ae019997-39b1-494d" name="bolt pistol, chainaxe" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="e79db128-d7a3-45c0" name="Bolt pistol" hidden="false" targetId="19be-3f27-bea8-5ca4" type="profile"/><infoLink id="101c8a1d-fc38-4b94" name="Chainaxe" hidden="false" targetId="6adf-461d-bedd-589d" type="profile"/></infoLinks></selectionEntry><selectionEntry id="f7341638-c8b6-4b88" name="bolt pistol, power" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="4db6f851-9d99-42ce" name="Bolt pistol" hidden="false" targetId="19be-3f27-bea8-5ca4" type="profile"/><infoLink id="19439e1c-99fa-4d56" name="P