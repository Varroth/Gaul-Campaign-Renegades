no attached bodyguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="6d80598d-61dc-4f16" name="Attach to: Ashen Chain Terminators" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="e094-37ca-b2d3-557b" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="08e7c6f3-cef8-48d3" name="Leader attachment — Zecer Varthis" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Ashen Chain Terminators squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="13a978bf-5cbe-4115" name="Attach to: Cataphractii Terminator Veterans" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="559b-35bb-bbdb-5632" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="0a43441f-837c-4c7c" name="Leader attachment — Zecer Varthis" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Cataphractii Terminator Veterans squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="583b-bec7-aef5-5bb7" name="Karnus Vehl" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="85.0"/></costs><categoryLinks><categoryLink id="8f48-8e64-5bac-5c62" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/><categoryLink id="3c6f-0841-560c-570d" name="Terminators" hidden="false" targetId="c317-a497-01c6-5b78" primary="false"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1eea-785b-3239-5c4b" type="max"/></constraints><profiles><profile id="730d-252d-d5ac-5128" name="Karnus Vehl" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">5"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">6</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">6</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="654e-c4a6-79eb-5215" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Storm bolter, chainfist, vox harness; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="bb2f-67ea-3cb8-59d1" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Ashen Net: one friendly Terminator within 12" counts in officer range for Disciplined Brutality; Clear Channel: once/battle cancel comms penalty; Deep Strike. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="9274a143-0649-5f93" name="Ashen Net" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One friendly Terminator unit within 12 inches counts as being in range of an OFFICER for Disciplined Brutality.</characteristic></characteristics></profile><profile id="ef96288b-247a-5d57" name="Clear Channel" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle ignore one communications-based homebrew penalty affecting a Terminator unit.</characteristic></characteristics></profile><profile id="13f4d470-e3d0-556f" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Ashen Chain Terminators. A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="a27a762a-f793-4feb" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="65013c2e-66f3-4487-9fb0-89b508d69f18" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Ashen Chain Terminators. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="bceb720e-4377-4b22-93e9-0d16a4dce3f7" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Storm bolter, chainfist, vox harness; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="23e5-6ff0-a6fd-5515" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="ce50-4982-ebce-5626" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="8eb2e15c-8996-5a11" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="29a28f44-065b-5fd0" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="9b20764a-5a8c-5e11" name="Legion Teleportarium" hidden="false" targetId="03fea306-e073-5356" type="rule"/><infoLink id="5c657ddb-4708-438f-bdea-33ac9dffb207" name="Leader Eligibility" hidden="false" type="rule" targetId="4850b1e3-fe55-4ea8-9e74-f9e80e4b9d74"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="d0ef6cc5-8794-4711" name="Wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="9faae7e8-367c-445a"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b5cf91e4-f051-4688" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7e4f4ef7-5539-4693" type="max"/></constraints><selectionEntries><selectionEntry id="9faae7e8-367c-445a" name="Storm bolter and chainfist, vox harness" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="5c4cd236-bc01-46b0" name="Combi-bolter / storm bolter" hidden="false" targetId="21b2-49c4-ad7f-57b9" type="profile"/><infoLink id="6dce99e4-02a7-43c9" name="Chainfist" hidden="false" targetId="61de-3111-0731-5698" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="77671ec1-c82c-475f" name="Legacy bodyguard TYPE reference (optional; use bodyguard-side assignment)" hidden="false" collective="false" import="true" defaultSelectionEntryId="f864eb53-156b-4f80"><constraints><constraint id="46d70338-a437-4501" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="441d2329-6ff8-4530" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="f864eb53-156b-4f80" name="Independent / no attached bodyguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="8f1b4d6a-db63-4163" name="Attach to: Ashen Chain Terminators" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="e094-37ca-b2d3-557b" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="9217db76-8b30-4c82" name="Leader attachment — Karnus Vehl" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Ashen Chain Terminators squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="6a40-bf6a-1b69-5551" name="Infernal Chaplain" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="75.0"/></costs><categoryLinks><categoryLink id="2513-bc86-a84a-53f9" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7453-cae4-7795-52e5" type="max"/></constraints><profiles><profile id="25e5-9d61-6cc2-5a4d" name="Infernal Chaplain" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">6</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="85a4-20a0-dcd8-5368" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Crozius, bolt pistol; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="21bc-1591-3685-56ef" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Guardian of Discipline: qualifies as required attached Lost Cohort Chaplain; after initial Chaplain loss supervises nearby unsupervised Lost Cohort within 12"; Litany of Restraint: led unit re-rolls a Battle-shock test once/battle. Serum applies; +1 W is included.</characteristic></characteristics></profile><profile id="182ed198-cd9b-5de0" name="Guardian of Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This character qualifies as the required starting Chaplain for a power-armoured Lost Cohort. After a cohort’s initial Chaplain is lost, this model supervises ALL such squads within 12 inches.</characteristic></characteristics></profile><profile id="e9e207db-852f-5880" name="Litany of Restraint" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle the unit led by this Chaplain may re-roll ONE failed Battle-shock test.</characteristic></characteristics></profile><profile id="253c3a1b-bfb2-547d" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Lost Cohort — Power Armour (foot or matched jump-pack build); Infernal Legionaries; Infernal Berzerkers; Despoiler Cadre; Void Breachers; compatible jump-assault squads if equipped with jump pack. A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="b1d679ab-384d-4fe1" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="d9044a32-f5ed-4485-a547-36079d500b0f" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Infernal Legionaries, Infernal Berzerkers, Despoiler Cadre, Void Breachers. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="c40e00b1-61bc-4be4-bb4a-03fc630d89ab" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Crozius, bolt pistol; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="de7a-43b9-3b91-5de4" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="2e8b-b898-0b10-5d76" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="086c-532c-5c20-5954" name="Lost Cohort — Control" hidden="false" targetId="3bff-1efe-c60b-511f" type="rule"/><infoLink id="54772a8f-5276-5e9b" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="9cf9b66d-56ac-48e9-9ecb-2488fd33027f" name="Leader Eligibility" hidden="false" type="rule" targetId="bef1208b-b66f-427c-b3a8-bf042196700c"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="ec52-cefd-6a6d-502b" name="Optional jump pack" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="3857-c3f7-4ec3-5fe7" name="Equip jump pack (12&quot; M, FLY, JUMP PACK, Deep Strike)" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10.0"/></costs></selectionEntry></selectionEntries><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c90b-3e40-ca7e-5c9b" type="max"/></constraints></selectionEntryGroup><selectionEntryGroup id="93d74476-01cf-4dc2" name="Standard wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="2dbe2966-3f31-4c68"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3f65ad16-4269-48fc" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b170403c-3489-40fd" type="max"/></constraints><selectionEntries><selectionEntry id="2dbe2966-3f31-4c68" name="Crozius and bolt pistol" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="aed73a8a-01ff-446b" name="Crozius" hidden="false" targetId="e77b-3835-0018-547f" type="profile"/><infoLink id="8d640977-6e27-45e4" name="Bolt pistol" hidden="false" targetId="19be-3f27-bea8-5ca4" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="456f6921-f330-45b3" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><constraints><constraint id="0b13a7da-ab65-4327" type="max" field="selections" sco