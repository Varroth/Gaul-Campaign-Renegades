t" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="f8ae55e3-f520-4e97" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup></selectionEntryGroups><modifiers><modifier type="set" field="06f1-c3b9-6980-5a6f" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="6403-07f8-9aad-532c" name="Mastodon Heavy Transport" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="0f8c-b871-476f-5c79" name="Transports" hidden="false" targetId="9856-3547-9660-54c2" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6e43-e6ed-fa3d-56ee" type="max"/></constraints><profiles><profile id="47f2-6731-a936-5745" name="Mastodon Heavy Transport" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">8"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">13</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">30</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">10</characteristic></characteristics></profile><profile id="a28d-1f6f-b6e6-54ed" name="Mobile Bastion" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Capacity 30 Infantry spaces; Terminators use two spaces each.</characteristic></characteristics></profile><profile id="2cd8-4215-bca6-5d2b" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Siege melta array, 2 heavy bolter defensive arrays, void-shield generator (not weapon). Capacity 30 Infantry spaces; each Terminator occupies 2.</characteristic></characteristics></profile><profile id="5a0e-7077-fb7b-58c3" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="831c8f38-924b-43ea" name="Passenger Manifest &amp; capacity" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Transport registration: Passenger-bearing Infantry must DECLARE this vehicle type in their Deployment / passenger assignment selection. Capacity 30 spaces; Terminators and jump-equipped passengers may use two each where permitted. Include ALL attached leaders and all squads sharing a carrier; do not exceed capacity. The catalogue records carrier TYPE, not a unique vehicle instance, so this capacity total must still be checked before play.</characteristic></characteristics></profile><profile id="f7295439-c544-4b69" name="Mechanised Vanguard conditions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">OPTIONAL pre-battle move of up to 3 inches after deployment if this non-AIRCRAFT transport starts with friendly INFANTRY embarked and the mission permits. End over 9 inches from all enemies, outside enemy deployment zone. 1/1,000-point battle limit (max 2). Aircraft can never gain this privilege. Never confers a charge or first-turn aircraft arrival exception.</characteristic></characteristics></profile><profile id="2082f792-f96b-4890-ab02-1346f9f6068d" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Siege melta array, 2 heavy bolter defensive arrays, void-shield generator (not weapon). Capacity 30 Infantry spaces; each Terminator occupies 2. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks/><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="675.0"/></costs><selectionEntryGroups><selectionEntryGroup id="7892541e-a027-47f4" name="Fixed weapons" hidden="false" collective="false" import="true" defaultSelectionEntryId="a1cc13f1-f5bc-44e4"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7d648785-4f70-4a64" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="cf5f7233-9ff7-4490" type="max"/></constraints><selectionEntries><selectionEntry id="a1cc13f1-f5bc-44e4" name="Siege melta array + 2 defensive heavy bolter arrays" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="164b96e1-8946-43e3" name="Siege melta array" hidden="false" targetId="1d43385a-928c-5cf5" type="profile"/><infoLink id="6a496d1a-75da-4e0f" name="Defensive heavy bolter array" hidden="false" targetId="793637ec-ea23-58a2" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="411b572e-d6be-4d30" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><constraints><constraint id="f01be01d-d8d8-4394" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><entryLinks><entryLink id="319c1a96-80f1-4f86" name="Ash-Forged Targeter (+10 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="46d64132-8587-4978"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="5856-87a6-b30e-596e" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="f8ae55e3-f520-4e97" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="6c973935-28eb-437f" name="Mechanised Vanguard — pre-battle move declaration" hidden="false" collective="false" import="true"><constraints><constraint id="7608a9d7-8f80-4e1a" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="8a48542c-e49c-496e" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries/><entryLinks><entryLink id="29cba7f1-03eb-4bc1" name="Select as Mechanised Vanguard (3-inch move, 0 pts)" hidden="false" collective="false" import="true" type="selectionEnt