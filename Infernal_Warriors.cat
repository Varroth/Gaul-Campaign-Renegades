 hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Select only when the mission allows this formation and it fits the Reserves points cap; normal later-round timing applies. This is not an automatic Deep Strike grant.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="0ab0ff6b-d30a-4aed-8d23-51460c9b67f1" name="Embarked in: Rhino Carrier" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="7a6c-99a9-6f03-5c81" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="661bf5b5-a472-410b-98f7-ff69c8b1d4ea" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Rhino Carrier. Formation is 10 infantry model(s); minimum passenger spaces 10. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b33f185e-43b3-4a37-b5ec-30ab714d76a5" name="Embarked in: Land Raider" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="b61d-137f-cbfd-594d" shared="true" includeChildSelec