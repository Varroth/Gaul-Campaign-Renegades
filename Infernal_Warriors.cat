ionEntry><selectionEntry id="ad958f0f-7bea-4af4" name="Standard Strategic Reserves (mission restrictions)" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="5b63a0a1-a824-4407" name="Standard Reserves" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Select only when the mission allows this formation and it fits the Reserves points cap; normal later-round timing applies. This is not an automatic Deep Strike grant.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="35d81b0f-f8fb-472f" name="Deep Strike — ordinary permitted arrival" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="55d23ebc-ccf0-4191" name="Deep Strike" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the existing Terminator Teleportarium or printed jump-pack deployment rule where applicable; DOES NOT override normal Reserves caps, distance or arrival timing.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="95bd5404-f0de-422f" name="Embarked in: Stormraven Assault Gunship" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="03b0-5e60-3b60-5812" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="3d92e977-e3f7-47d4" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Stormraven Assault Gunship. Formation is 5 infantry model(s); minimum passenger spaces 10. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="4c444ce5-2bda-43d7" name="Embarked in: Storm Eagle Assault Gunship" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="2f1c-4deb-6384-542d" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="f0fab24b-7200-4786" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Storm Eagle Assault Gunship. Formation is 5 infantry model(s); minimum passenger spaces 10. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c1442106-65ae-485f" name="Embarked in: Thunderhawk Gunship" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="2590-7f88-3edf-5c1a" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="301db2c2-5511-4fa0" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Thunderhawk Gunship. Formation is 5 infantry model(s); minimum passenger spaces 10. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="456f6a56-1a18-4c8b" name="Embarked in: Stormbird Heavy Assault Ship" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="b65a-7401-1fdc-5c1d" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="e8232a45-f338-40f9" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Stormbird Heavy Assault Ship. Formation is 5 infantry model(s); minimum passenger spaces 10. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="08f70b35-3544-41ff-b0f3-cf74b89229e8" name="5 models — Plasma Strike (editable preset)" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="125.0"/></costs><selectionEntryGroups><selectionEntryGroup id="4f53e1d6-6301-4635-a4a7-7a577acc9a05" name="Champion 1 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="535ec82b-4f47-4cb5-b166-05e6ad94ca7a"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b0814a39-aba9-4551-9e41-d70337304e58" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="473343aa-4b57-4a94-909c-7f3b62d8ea11" type="max"/></constraints><selectionEntries><selectionEntry id="535ec82b-4f47-4cb5-b166-05e6ad94ca7a" name="Jump pack, chainsword, bolt pistol" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="c6711849-a532-4507-8d1b-0cc4a7540cf2" name="Chainsword" hidden="false" targetId="2b18-7f7c-4b12-568a" type="profile"/><infoLink id="468e5284-1a2c-4527-b4a8-dba96cbcfc3c" name="Bolt pistol" hidden="false" targetId="19be-3f27-bea8-5ca4" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="963487bb-464e-48a2-a001-700b54d4bc62" name="Warrior 2 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="fef69605-2a65-4fba-8978-2c98c9da6ec6"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4673a923-fe56-4b40-8b75-2bc9d3c8a546" type="