ionEntryGroups></selectionEntry><selectionEntry id="578b-1fd7-2f2c-5c4a" name="Zecer Varthis" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="100.0"/></costs><categoryLinks><categoryLink id="3736-19da-27d0-5ea3" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/><categoryLink id="2989-9ce8-8d51-5ae2" name="Terminators" hidden="false" targetId="c317-a497-01c6-5b78" primary="false"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9777-f456-c1e0-512f" type="max"/></constraints><profiles><profile id="0a6f-31d6-d2f9-5b9c" name="Zecer Varthis" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">5"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">6</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="b82a-9bdf-ac6e-524b" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The Voice (Zecer), storm bolter; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="5a16-f7ab-ac0d-5b53" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The Voice Commands: one Ashen Chain unit within 6" re-rolls one Hit per turn; Breach Veteran: led Terminators re-roll one charge die after transport arrival; Deep Strike. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="209bcbf6-6858-58a3" name="The Voice Commands" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per turn one friendly Ashen Chain unit within 6 inches may re-roll ONE Hit roll.</characteristic></characteristics></profile><profile id="37c2a463-33ab-5cfd" name="Breach Veteran" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">A Terminator unit led by Varthis may re-roll ONE Charge die on arriving from a transport.</characteristic></characteristics></profile><profile id="f3f682b7-189f-508a" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Ashen Chain Terminators; Cataphractii Terminator Veterans. A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="8cffc1ac-98ce-4b7d" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="317e227f-87d8-4689-bcc2-c1d0093e5590" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Ashen Chain Terminators, Cataphractii Terminator Veterans. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="1fd7b10e-4e45-4bd2-9f3c-71a46691518a" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: The Voice (Zecer), storm bolter; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="b669-d471-168a-5cf9" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="4d24-233d-7bcc-5838" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="eba92f1a-1599-56af" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="2bb45caa-8d9d-52b9" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="ff1ba928-4e8c-5b3d" name