ld="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="d10f0063-7deb-45db" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="66c44898-2264-4a3a" name="Deployed on the battlefield (normal)" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="8ac2a7eb-9cf9-452e" name="Standard Strategic Reserves (mission restrictions)" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="ed3f0092-a473-4cf9" name="Standard Reserves" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Select only when the mission allows this formation and it fits the Reserves points cap; normal later-round timing applies. This is not an automatic Deep Strike grant.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5d7d6d65-8ca1-47dd" name="Deep Strike — ordinary permitted arrival" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="364e255f-68ba-4134" name="Deep Strike" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the existing Terminator Teleportarium or printed jump-pack deployment rule where applicable; DOES NOT override normal Reserves caps, distance or arrival timing.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="223a30c7-43ef-4060" name="Cohort Insertion — First-turn Deep Strike" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="7f1f332d-f537-4de1" name="Cohort Insertion" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Entire Chaplain-led formation (bundled in the selected unit size) deploys independently by Deep Strike, including the approved FIRST FRIENDLY Reinforcements step if the first-turn option was chosen. This waives ONLY first-round arrival prohibition, not Reserves cap, coherency or enemy exclusion. No transport may gain early arrival by carrying this unit.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="001a65e2-fa6f-4578" name="Cohort Insertion — Later-round Deep Strike" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="2b272915-17fd-410e" name="Cohort Insertion" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Entire Chaplain-led formation (bundled in the selected unit size) deploys independently by Deep Strike, including the approved FIRST FRIENDLY Reinforcements step if the first-turn option was chosen. This waives ONLY first-round arrival prohibition, not Reserves cap, coherency or enemy exclusion. No transport may gain early arrival by carrying this unit.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="4d810ba6-9835-4a6e" name="Embarked in: Spartan Assault Tank" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="722a-2c35-6f47-5a04" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="5c3c5989-3a52-4bc9" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Spartan Assault Tank. Formation is 9 infantry model(s) plus its mandatory PAID Chaplain; minimum passenger spaces 20. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="39ecc01f-7630-4554" name="Embarked in: Kharybdis Assault Claw" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="a6d8-ed7a-d637-506f" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="32240e7e-a16c-4ff0" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Kharybdis Assault Claw. Formation is 9 infantry model(s) plus its mandatory PAID Chaplain; minimum passenger spaces 20. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</char