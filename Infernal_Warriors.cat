rant.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><profiles><profile id="3363cdce-0b4d-4dc4-b51b-85562807ae37" name="Preset — Mortar Battery" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Preselected at muster, but each model/equipment group remains editable. No extra point cost. Team 2: Mortar team — 2 crew, 1 Pexi mortar; Team 3: Mortar team — 2 crew, 1 Pexi mortar; Champion 1: Mortar team — 2 crew, 1 Pexi mortar. All equipment restrictions and the original unit ability still apply.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="24471543-e9a6-4636-a964-26093aa46513" name="3 models — Autocannon Screen (editable preset)" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="50.0"/></costs><selectionEntryGroups><selectionEntryGroup id="b65dea2c-2a32-4086-883c-42051ada80b2" name="Champion 1 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="8b34ffab-f6f8-4b37-9d17-8e9de74cdf2a"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c6af4f33-ee3f-4657-85b1-844a91503210" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9dcf2f21-922f-4d85-b2e6-2093de32c1e0" type="max"/></constraints><selectionEntries><selectionEntry id="bede4eed-3842-4bcc-b99c-f1b0e96eb20d" name="Mortar team — 2 crew, 1 Pexi mortar" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="abe324ff-c8d8-4ebd-8111-843717ccd178" name="Pexi 270th mortar" hidden="false" targetId="06385641-6436-5416" type="profile