5" name="Bloodletters" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">5+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">1</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="f315-2c72-b112-5db2" name="Blood God’s Assault" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, re-roll one Charge die.</characteristic></characteristics></profile><profile id="8b62-7724-b8bf-5e7a" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">10 Daemons with Hellblades; no Serum; Khorne ally allowance only.</characteristic></characteristics></profile><profile id="b1a1-f887-0f76-56fe" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Only permitted allied Khorne daemons, ≤25% of army points (manual cap). Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="d48e01b9-133b-480d-b5d8-51e0c33a4cbc" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: 10 Daemons with Hellblades; no Serum; Khorne ally allowance only. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="125.0"/></costs><infoLinks><infoLink id="3d68-5ef7-468e-5c34" name="Khorne Ally Allowance" hidden="false" targetId="3ecd-6609-5f42-5166" type="rule"/><infoLink id="94076fa4-8881-5e2b" name="Khorne Daemon Allies" hidden="false" targetId="52fee7ba-5ef8-5737" type="rule"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="1ed61a21-993c-40e0" name="10 Bloodletters" hidden="false" collective="false" import="true" defaultSelectionEntryId="cd3b9564-d84e-4c10"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f682ebac-130f-4a1a" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e9912cac-1303-4363" type="max"/></constraints><selectionEntries><selectionEntry id="cd3b9564-d84e-4c10" name="10 Hellblades" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="14cb5f67-0251-4e36" name="Hellblade" hidden="false" targetId="718e-d420-cd9b-5f63" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="d3f2-4e8d-5275-52c1" name="Bloodletter Invocation: Reserves declaration (optional reference)" hidden="false" collective="false" import="true"><constraints><constraint id="b92f-eee2-dae9-5626" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/><constraint id="9cd5-bc56-00f0-5cb9" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><selectionEntries><selectionEntry id="5056-0f41-06bf-5959" name="PAID Bloodletters in legal Reserves — eligible target for Thralls invocation" hidden="false" collective="false" type="upgrade" import="true"><profiles><profile id="3524-9d95-03dd-5dbb" name="v251-invocation-reserve" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This selection is a zero-point roster REMINDER. Bloodletters must be purchased normally, start in Reserves within mission restrictions and be placed legally. One invocation per army; do NOT treat this as a granted extra Reserve entry or free unit. Declaring this option does not automatically assign a Thrall unit.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><modifiers><modifier type="set" field="87ee-542c-860e-5281" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="cfa2-ebcb-3126-5547" name="Flesh Hounds" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="20d3-8adb-4903-59f0" name="Khorne Allies" hidden="false" targetId="471b-b5c6-68a0-523c" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="aca3-d570-6db5-5866" type="max"/></constraints><profiles><profile id="ec01-febf-203c-5fe7" name="Flesh Hounds" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">10"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">5+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="60da-8a16-9c7e-5077" name="Dread Hunter" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, an enemy Psyker targeted by this unit takes -1 to its Battle-shock test.</characteristic></characteristics></profile><profile id="fab5-381b-ddea-5fe4" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Hellfangs and collar of Khorne (defensive, no extra attacks). No Serum.</characteristic></characteristics></profile><profile id="1dfb-fb9c-84dc-5845" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Only permitted allied Khorne daemons, ≤25% of army points (manual cap). Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="54c2ecd5-afb8-4d01-94d5-31dd06e8d1db" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Hellfangs and collar of Khorne (defensive, no extra attacks). No Serum. | The exported r