dition type="lessThan" value="1" field="selections" scope="roster" childId="6403-07f8-9aad-532c" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="bbca2edc-38b5-4731-ad54-d4c906759d7b" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Mastodon Heavy Transport. Formation is 10 infantry model(s); minimum passenger spaces 10. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries><entryLinks><entryLink id="e03ad50d-6c17-4b65-8c56-23c54a7c6707" name="Void Assault Insertion — Breach and Ruin (one per army)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="01302dab-0ff7-4eed"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="b7ad-18e3-9d4d-57e1" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup></selectionEntryGroups><profiles><profile id="28e7f04e-c203-4570-8c56-8dda35bd8af8" name="Preset — Anti-Armour" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Preselected at muster, but each model/equipment group remains editable. No extra point cost. Warrior 5: melta, bolt pistol, combat blade; Warrior 10: multi melta, bolt pistol, combat blade. All equipment restrictions and the original unit ability still apply.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="ef21a7dd-900e-4acd" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><constraints><constraint id="4d6f2004-79ff-435f" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><entryLinks><entryLink id="c07aa685-1ffa-4421" name="Vox of the Unforgotten (+10 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="9cb06d75-2acf-4d85"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="8eb0-8d1d-a832-5447" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="2de11288-d698-41c6" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink><entryLink id="e82078a9-43e6-49ff" name="War Hounds’ Field Manual (+15 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="3028597c-2a14-4594"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="8eb0-8d1d-a832-5447" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="96ec7e6c-cb3a-47cd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink><entryLink id="0823770b-ebcc-4e5a" name="The Measured Strike (+15 pts)" hidden