e" defaultSelectionEntryId="1f49-dc48-aac7-5fbd"><constraints><constraint id="62db-a5e3-4a96-546a" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="2509-13c6-cf27-53f7" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="1f49-dc48-aac7-5fbd" name="No attached Leader" hidden="false" type="upgrade" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry></selectionEntries><entryLinks><entryLink id="46aa-8544-a618-5a2c" name="Attached: Torgath Keld (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="5618-72fb-f2c8-5f8c"/><entryLink id="e312-17fd-bcf8-562e" name="Attached: Velkan Rusk (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="ce84-685e-7d1b-52c3"/><entryLink id="bc6f-9a55-d123-52ad" name="Attached: Kessel Rane (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="30b5-e38e-8573-5737"/></entryLinks></selectionEntryGroup></selectionEntryGroups><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><infoLinks><infoLink id="a874-acb1-707e-58db" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="2288-85f6-7195-5d61" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="5400-3463-b6aa-5be0" name="Warp-Aggravated Pain" hidden="false" targetId="1ed1-86a9-2d02-5af3" type="rule"/><infoLink id="acff-b1a9-4bef-59c9" name="Rare Psychic-Induced Psychosis" hidden="false" targetId="8da3-eead-cabf-56ea" type="rule"/></infoLinks><modifiers><modifier type="set" field="0fab-267e-4aac-5b11" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="84c1-e134-0ce1-5c13" name="Recon Veterans" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="f4c2-baa1-a4b3-54e8" name="Infantry" hidden="false" targetId="521d-dd50-6a49-58fb" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="fe62-91f9-8daa-5e47" type="max"/></constraints><profiles><profile id="5c77-c601-8107-5603" name="Recon Veterans" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="2f75-f423-6e9c-5fc5" name="Hidden Approach" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Before the first turn, make one legal 3-inch reposition within deployment.</characteristic></characteristics></profile><profile id="42f5-bd15-76ef-5d32" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Scoped bolt rifles and combat blades; one sniper rifle per 5 may replace a rifle. Locator equipment does not add attacks.</characteristic></characteristics></profile><profile id="6d68-41ac-af24-5013" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">ARMY RULE: Infernal Serum (+1 W already applied, FNP 5+, regenerate 1 W at start of your turn). Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="c9f00e2f-4184-4ba0-8f77-a07da2b31229" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Scoped bolt rifles and combat blades; one sniper rifle per 5 may replace a rifle. Locator equipment does not add attacks. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile><profile id="18c1-4eb2-c527-5425" name="LEADER Assignment — instance specific" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The selected attachment is local to THIS Recon Veterans unit, allowing multiple copies of this datasheet to have different Leaders. A matching Leader must also be bought separately. Use New Recruit's native Leader association command when available; this 0-point declaration does not physically join roster entries or apply an attached Leader's rules. Older Leader-side bodyguard-type choices remain for saved roster compatibility. A bodyguard normally takes one Leader; Lost Cohort uses its mandatory separate bundled Chaplain system.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="5f75-ece3-37f4-5b70" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="24dc-611e-ba5f-589b"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6003-51bb-e6f1-5703" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5b48-c371-76d7-5370" type="max"/></constraints><selectionEntries><selectionEntry id="24dc-611e-ba5f-589b" name="5 models" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="105.0"/></costs><selectionEntryGroups><selectionEntryGroup id="7cd78287-2ba9-4d14" name="Champion 1 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="c69e82df-1d31-4cfa"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="66a93c44-9720-4973" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2edfffeb-8d80-4af6" type="max"/></constraints><selectionEntries><selectionEntry id="c69e82df-1d31-4cfa" name="Scoped bolt rifle, blade" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="5344db24-7af1-45e6" name="Scoped bolt rifle" hidden="false" targetId="dff3-0c25-ce32-57a1" type="profile"/><infoLink id="5b48cbdd-6f47-46d3" name="Close-combat weapon" hidden="false" targetId="953b-aa30-035d-5d4d" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="ebb20c75-b521-4de3" name=