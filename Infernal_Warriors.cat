rted roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks/><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="170.0"/></costs><selectionEntryGroups><selectionEntryGroup id="5a8a2533-4501-447e" name="Main weapons" hidden="false" collective="false" import="true" defaultSelectionEntryId="3d7885b7-100e-4232"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8b2bcd45-54e1-448e" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="58115799-d656-4b6b" type="max"/></constraints><selectionEntries><selectionEntry id="3d7885b7-100e-4232" name="Ectoplasma cannon" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="a0aba624-d3e8-4776" name="Ectoplasma cannon" hidden="false" targetId="801f-e355-75e1-5454" type="profile"/></infoLinks></selectionEntry><selectionEntry id="03cff934-5360-478e" name="Hades autocannons" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="78058202-0ec6-41f6" name="Hades autocannon" hidden="false" targetId="7b29-05a4-4535-5242" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="c69bc598-5f20-4123" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><constraints><constraint id="62ce659e-4fe3-43c0" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><entryLinks><entryLink id="fce3fb12-a67f-4c58