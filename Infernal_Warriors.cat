lectionEntryGroup id="41d2abf6-16ce-4278" name="Deployment / passenger assignment (one declared plan)" hidden="false" collective="false" import="true" defaultSelectionEntryId="6009cb48-b6d7-4dfb"><constraints><constraint id="d72af7bb-f76b-4c25" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="a8ad38be-49b2-4c8c" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="6009cb48-b6d7-4dfb" name="Deployed on the battlefield (normal)" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="ae0a35ee-b588-4f4d" name="Standard Strategic Reserves (mission restrictions)" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="1cf37952-40f8-40cc" name="Standard Reserves" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Select only when the mission allows this formation and it fits the Reserves points cap; normal later-round timing applies. This is not an automatic Deep Strike grant.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a442a17c-7280-4e81" name="Deep Strike — ordinary permitted arrival" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="9783d9a9-b46b-40b1" name="Deep Strike" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the existing Terminator Teleportarium or printed jump-pack deployment rule where applicable; DOES NOT override normal Reserves caps, distance or arrival timing.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="ae4778bc-db59-4df0" name="Cohort Insertion — First-turn Deep Strike" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="85e7fc67-129d-4027" name="Cohort Insertion" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Entire Chaplain-led formation (bundled in the selected unit size) deploys independently by Deep Strike, including the approved FIRST FRIENDLY Reinforcements step if the first-turn option was chosen. This waives ONLY first-round arrival prohibition, not Reserves cap, coherency or enemy exclusion. No transport may gain early arrival by carrying this unit.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="580ab104-e3d8-47be" name="Cohort Insertion — Later-round Deep Strike" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="d5276129-950c-406a" name="Cohort Insertion" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Entire Chaplain-led formation (bundled in the selected unit size) deploys independently by Deep Strike, including the approved FIRST FRIENDLY Reinforcements step if the first-turn option was chosen. This waives ONLY first-round arrival prohibition, not Reserves cap, coherency or enemy exclusion. No transport may gain early arrival by carrying this unit.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="eb54e7c5-5337-4668" name="Embarked in: Spartan Assault Tank" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="722a-2c35-6f47-5a04" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="946fcf9c-71d0-4480" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Spartan Assault Tank. Formation is 8 infantry model(s) plus its mandatory PAID Chaplain; minimum passenger spaces 18. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5b2a05ea-2a1b-44cb" name="Embarked in: Kharybdis Assault Claw" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="a6d8-ed7a-d637-506f" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="ad154888-180e-4505" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Kharybdis Assault Claw. Formation is 8 infantry model(s) plus its mandatory PAID Chaplain; minimum passenger spaces 18. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="dd7ce3e1-0497-4fc0" name="Embarked in: Storm Eagle Assault Gunship" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="2f1c-4deb-6384-542d" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="bb8398bf-d550-473d" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Storm Eagle Assault Gunship. Formation is 8 infantry model(s) plus its mandatory PAID Chaplain; minimum passenger spaces 18. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="cdeafd27-133b-402f" name="Embarked in: Thunderhawk Gunship" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="2590-7f88-3edf-5c1a" shared="true" includeChildSelections="true" includeChildForces="true"/></co