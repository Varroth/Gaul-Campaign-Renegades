 field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="f8ae55e3-f520-4e97" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup></selectionEntryGroups><modifiers><modifier type="set" field="f714-0831-0634-5a17" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="03b0-5e60-3b60-5812" name="Stormraven Assault Gunship" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="2fce-3dac-7102-509e" name="Aircraft" hidden="false" targetId="6be8-bd06-032f-5209" primary="true"/><categoryLink id="c920-4d6e-a640-56e8" name="Transports" hidden="false" targetId="9856-3547-9660-54c2" primary="false"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7b61-26bd-4041-5ee9" type="max"/></constraints><profiles><profile id="14af-2cc7-9c08-5df5" name="Stormraven Assault Gunship" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">20"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">10</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">14</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">0</characteristic></characteristics></profile><profile id="3dfe-3110-4b90-5a32" name="Armoured Flight" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Subtract 1 from the Damage characteristic of attacks allocated to this model, to a minimum of 1 (provisional).</characteristic></characteristics></profile><profile id="03b6-b0ab-e17b-5795" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Two Stormstrike missiles, twin assault cannon OR twin heavy plasma cannon OR twin lascannons, Typhoon missiles OR twin heavy bolter OR twin multi-melta, optional 2 hurricane bolters. Choose at muster: AIRCRAFT INTERDICTOR with normal Aircraft arrival, OR LOW-ALTITUDE ASSAULT SKIMMER (explicit homebrew), Movement 14, removing AIRCRAFT keyword. Capacity 12 Infantry spaces plus one eligible externally carried Contemptor/Helbrute; each Terminator or Jump Pack consumes TWO Infantry spaces. No free Turn-1 arrival.</characteristic></characteristics></profile><profile id="ff44-ebd9-afe3-5074" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="bb31e116-9b94-52ee" name="Two flight configurations (mandatory declare at muster)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Two Stormstrike missiles, twin assault cannon OR twin heavy plasma cannon OR twin lascannons, Typhoon missiles OR twin heavy bolter OR twin multi-melta, optional 2 hurricane bolters. Choose at muster: AIRCRAFT INTERDICTOR with normal Aircraft arrival, OR LOW-ALTITUDE ASSAULT SKIMMER (explicit homebrew), Movement 14, removing AIRCRAFT keyword. Capacity 12 Infantry spaces plus one eligible externally carried Contemptor/Helbrute; each Terminator or Jump Pack consumes TWO Infantry spaces. No free Turn-1 arrival.</characteristic></characteristics></profile><profile id="5905e48a-0111-4403" name="Passenger Manifest &amp; capacity" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Transport registration: Passenger-bearing Infantry must DECLARE this vehicle type in their Deployment / passenger assignment selection. Capacity 12 spaces; Terminators and jump-equipped passengers may use two each where permitted. Include ALL attached leaders and all squads sharing a carrier; do not exceed capacity. The catalogue records carrier TYPE, not a unique vehicle instance, so this capacity total must still be checked before play.</characteristic></characteristics></profile><profile id="d13f3d21-4bda-4f46-b76c-fccae649db74" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Two Stormstrike missiles, twin assault cannon OR twin heavy plasma cannon OR twin lascannons, Typhoon missiles OR twin heavy bolter OR twin multi-melta, optional 2 hurricane bolters. Choose  | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks>
        </infoLinks><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="280.0"/></costs><selectionEntryGroups><selectionEntryGroup id="587b365a-5270-42b7" name="Main turret" hidden="false" collective="false" import="true" defaultSelectionEntryId="412296d2-80ac-48e8"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="bff1d856-2c0c-4758" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="245b7fa7-9199-448f" type="max"/></constraints><selectionEntries><selectionEntry id="412296d2-80ac-48e8" name="Twin assault cannon" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="5da2d952-3822-4b36" name="Twin assault cannon" hidden="false" targetId="94203c99-9640-598d" type="profile"/></infoLinks></selectionEntry><selectionEntry id="5ca54fc5-a5d8-4283" name="Twin heavy plasma cannon" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="78836d55-aa3e-4b54" name="Twin heavy plasma cannon" hidden="false" targetId="f57703ad-e69a-5a94" type="profile"/></infoLinks></selectionEntry><selectionEntry id="78676a71-ec7d-40d9" name="Twin lascannons" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="77eab7fe-605b-4a9b" name="Twin lascannons" hidden="false" targetId="50ca-22a4-36c4-5a73" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="882fdc68-9d87-41a2" name="Secondary missile/weapon" hidden="false" collective="false" import="true" defaultSelectionEntryId="dca8fc1d-93d5-4a16"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="725fbec6-dbf5-4db1" type="min"/><constraint field="sel