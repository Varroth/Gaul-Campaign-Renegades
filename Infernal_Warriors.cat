tics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Mastodon Heavy Transport. Formation is 7 infantry model(s) plus its mandatory PAID Chaplain; minimum passenger spaces 8. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="1366-afa7-4644-5cec" name="7 afflicted + attached Orvath Krail (foot)" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="305.0"/></costs><profiles><profile id="38bf-9d8e-a09e-5d28" name="Build notes" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Includes 100pt unique Orvath Krail; cannot be selected elsewhere again.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="4658f955-b539-446d" name="Champion 1 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="95bff60d-28af-49b5"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6143f883-cf03-480a" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7562c725-4b6c-4f24" type="max"/></constraints><selectionEntries><selectionEntry id="95bff60d-28af-49b5" name="bolter, chainaxe" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="5b80cd12-d7b7-4550" name="Boltgun"