 bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><profiles><profile id="23eda451-f1cf-4b6e-b903-1da1182a2b3f" name="Preset — Reaper Fire Support" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Preselected at muster, but each model/equipment group remains editable. No extra point cost. Champion 1: Storm bolter, chainfist; Warrior 5: Reaper autocannon, power maul; Warrior 10: Reaper autocannon, power maul. All equipment restrictions and the original unit ability still apply.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="38a79907-5a86-48fe-be69-33d2b3b93a47" name="10 models — Flame Breachers (editable preset)" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="390.0"/></costs><selectionEntryGroups><selectionEntryGroup id="75852711-0c83-4a8a-8668-fc49317c2c6a" name="Champion 1 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="6f7cb2b3-8e77-401c-b665-6053569c70d2"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="62dc58c7-cab4-4a2a-b51d-eb1be6b75544" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="406128ae-d6c1-4a32-95c9-eedb189e954c" type="max"/></constraints><selectionEntries><selectionEntry id="0f7fb97f-558b-4d0f-a5e6-d75b637804a7" name="Storm bolter, power maul" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="86fd68be-48aa-4c17-856c-f575be2e1c5b" name="Combi-bolter / s