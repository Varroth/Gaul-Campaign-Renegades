value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="0fbe-add8-a3b5-5f24" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="f7e5b758-fe23-4c88" name="External Dreadnought carry" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One separately purchased Helbrute Relic Walker can ride EXTERNALLY, IN ADDITION to the Stormraven’s 12 infantry passenger spaces, under printed deployment/reserve and disembark restrictions. Cannot carry Leviathan, Deredeo or oversized walker. If multiple Stormravens exist, record exact carrier in roster notes.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><modifiers><modifier type="set" field="7b61-26bd-4041-5ee9" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="a233-bede-533c-5c84" name="Fire Raptor Gunship" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="8668-d78e-a347-5966" name="Aircraft" hidden="false" targetId="6be8-bd06-032f-5209" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f3b5-9475-8cb9-5bb6" type="max"/></constraints><profiles><profile id="0088-2912-98f8-5cef" name="Fire Raptor Gunship" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">20+</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">10</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">16</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">0</characteristic></characteristics></profile><profile id="29bc-3453-32e3-5f64" name="Strafing Pass" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Re-roll one Hit roll against Infantry.</characteristic></characteristics></profile><profile id="86a6-32ed-2a03-5cc5" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Avenger gatling cannon and 2 autocannon batteries. Aircraft, no infantry capacity.</characteristic></characteristics></profile><profile id="81fd-54ec-c54c-5be7" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="2de47bfc-0482-435a-8236-906e71ec06b0" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Avenger gatling cannon and 2 autocannon batteries. Aircraft, no infantry capacity. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks>
        </infoLinks><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="300.0"/></costs><selectionEntryGroups><selectionEntryGroup id="45f9932e-a348-4e7d" name="Fixed weapons" hidden="false" collective="false" import="true" defaultSelectionEntryId="ca7047dd-6bb7-466d"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1b33386d-a2e8-4bd2" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a9910a4d-e3bf-4fb6" type="max"/></constraints><selectionEntries><selectionEntry id="ca7047dd-6bb7-466d" name="Avenger gatling cannon + 2 autocannon batteries" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="eccd3c72-d92f-45de" name="Avenger gatling cannon" hidden="false" targetId="e898-9ef9-9438-5087" type="profile"/><infoLink id="b7e6e44f-20fc-460f" name="Autocannon battery" hidden="false" targetId="66cdde64-31e6-5213" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="cec74c1e-fa6a-43e2" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><constraints><constraint id="ecad3a78-c0a4-4b2e" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><entryLinks><entryLink id="24db6476-2dc3-415b" name="Ash-Forged Targeter (+10 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="46d64132-8587-4978"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="5856-87a6-b30e-596e" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><mo