etId="4e2e-770b-89ed-5e62"/><entryLink id="999d-0b52-472a-54c4" name="Attached: Rhazek Thorne (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="8c58-1e34-d27d-50b2"/><entryLink id="f0a7-7379-d314-5970" name="Attached: Kordas Vrenn (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="66ab-dd75-ddad-5377"/><entryLink id="f30b-fa62-6981-5ed1" name="Attached: Varkhul Renn (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="1b8b-5f8a-d5b7-5bff"/><entryLink id="434f-07a7-9e17-56df" name="Attached: Torgath Keld (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="5618-72fb-f2c8-5f8c"/><entryLink id="d4ab-ea82-311e-5984" name="Attached: Malthor Ghor (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="f9f7-04bb-dfbb-578f"/><entryLink id="44c9-3775-b36c-561d" name="Attached: Velkan Rusk (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="ce84-685e-7d1b-52c3"/><entryLink id="a80f-91f8-29ba-54c6" name="Attached: Varek Thul (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="4649-6156-ebac-5fee"/><entryLink id="8d6a-27ec-a9e1-5d7e" name="Attached: Orvath Krail (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="6b96-35a6-1a55-5b0a"/><entryLink id="c6d3-5b6f-389d-5cc1" name="Attached: Istran Valcor (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="23c7-8026-b34f-5370"/><entryLink id="2aaa-0eae-11a6-56fd" name="Attached: Mordren Vhal (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="8499-66ca-f63f-5fa4"/><entryLink id="7a1a-287c-468f-5fe3" name="Attached: Kessel Rane (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="30b5-e38e-8573-5737"/></entryLinks></selectionEntryGroup></selectionEntryGroups><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="ce9a-7aa5-d2d2-5452" value="4"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="e17a-942c-38f0-5f23" name="Infernal Berzerkers" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="611a-ac92-4464-518b" name="Battleline" hidden="false" targetId="ec2c-68bb-bfbc-5ee3" primary="true"/><categoryLink id="439a-29b7-6dee-52da" name="Infantry" hidden="false" targetId="521d-dd50-6a49-58fb" primary="false"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="6" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a3e3-415d-0d27-5428" type="max"/></constraints><profiles><profile id="fb54-37bf-64fb-58af" name="Infernal Berzerkers" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="e77b-c26b-1519-5c70" name="Controlled Fury" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">After charging, one model in this unit may re-roll one melee Wound roll.</characteristic></characteristics></profile><profile id="9c61-0d87-0432-553a" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each model has a bolt pistol and chainaxe or chainsword. Champion may replace melee weapon with power weapon or power fist. One plasma pistol per 5 models. No Butcher’s Nails or daemon fusion.</characteristic></characteristics></profile><profile id="3206-a866-1b62-5d23" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">ARMY RULE: Infernal Serum (+1 W already applied, FNP 5+, regenerate 1 W at start of your turn). Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="f111c254-4786-4c91-8a6a-cb302a53291d" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Each model has a bolt pistol and chainaxe or chainsword. Champion may replace melee weapon with power weapon or power fist. One plasma pistol per 5 models. No Butcher’s Nails or daemon fusio | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile><profile id="e2f2-dfb7-9c5a-5502" name="LEADER Assignment — instance specific" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The selected attachment is local to THIS Infernal Berzerkers unit, allowing multiple copies of this datasheet to have different Leaders. A matching Leader must also be bought separately. Use New Recruit's native Leader association command when available; this 0-point declaration does not physically join roster entries or apply an attached Leader's rules. Older Leader-side bodyguard-type choices remain for saved roster compatibility. A bodyguard normally takes one Leader; Lost Cohort uses its mandatory separate bundled Chaplain system.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="3a7e-0fae-feb7-5b92" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="1604-3d2e-f10a-568e"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a29e-72b3-6f20-564c" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2edd-9d36-b31c-5ae4" type="max"/></constraints><selectionEntries><selectionEntry id="1604-3d2e-f10a-568e" name="5 models" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="115.0"/></costs><selectionEntryGroups><selectionEntryGroup id="5c5ed3a4-d410-4a3d" name="Champion 1 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="b391ea8c-3170-411f"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f3c299f2-b919-463c" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSel