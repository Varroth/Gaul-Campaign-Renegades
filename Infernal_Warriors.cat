ionEntries><entryLinks><entryLink id="991c-cba2-1152-5ce2" name="Attached: Azrakh Drenn (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="e0fd-7fee-ff4a-5e3e"/></entryLinks></selectionEntryGroup></selectionEntryGroups><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><infoLinks><infoLink id="808e-3ec2-5149-5ab5" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="301d-562b-03c8-56c4" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="3ad4-9ddc-8526-5c7e" name="Warp-Aggravated Pain" hidden="false" targetId="1ed1-86a9-2d02-5af3" type="rule"/><infoLink id="d70f-f9ed-738d-5d15" name="Rare Psychic-Induced Psychosis" hidden="false" targetId="8da3-eead-cabf-56ea" type="rule"/></infoLinks><modifiers><modifier type="set" field="d31a-eb0a-4572-53a2" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="6501-89b3-a5f4-5074" name="Raptor Strike Cadre" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="33b7-3d01-43df-5dac" name="Jump Infantry" hidden="false" targetId="2a7b-0016-ba81-5ad6" primary="true"/><categoryLink id="d610-2b14-edef-5195" name="Infantry" hidden="false" targetId="521d-dd50-6a49-58fb" primary="false"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a647-b482-931d-516c" type="max"/></constraints><profiles><profile id="be2a-655d-5940-55b3" name="Raptor Strike Cadre" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">12"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="e6fc-acf0-3aaa-50c4" name="Shock Fright" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, an enemy unit charged by this formation must take a Battle-shock test.</characteristic></characteristics></profile><profile id="fa94-ed78-d15b-5120" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All have jump packs, bolt pistols and twin chainblades; one power weapon per 5 may replace the basic melee weapon.</characteristic></characteristics></profile><profile id="d7f0-e4ac-3ca8-50a3" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">ARMY RULE: Infernal Serum (+1 W already applied, FNP 5+, regenerate 1 W at start of your turn). Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="bb339211-5a8e-4266-8850-31c1c7d1079a" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: All have jump packs, bolt pistols and twin chainblades; one power weapon per 5 may replace the basic melee weapon. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile><profile id="5eed-caa0-a3a2-58ca" name="LEADER Assignment — instance specific" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The selected attachment is local to THIS Raptor Strike Cadre unit, allowing multiple copies of this datasheet to have different Leaders. A matching Leader must also be bought separately. Use New Recruit's native Leader association command when available; this 0-point declaration does not physically join roster entries or apply an attached Leader's rules. Older Leader-side bodyguard-type choices remain for saved roster compatibility. A bodyguard normally takes one Leader; Lost Cohort uses its mandatory separate bundled Chaplain system.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="2bf0-b092-eb1b-5542" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="ab46-a074-da63-5763"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="774e-b517-0751-5bac" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5577-3039-7c28-5033" type="max"/></constraints><selectionEntries><selectionEntry id="ab46-a074-da63-5763" name="5 models" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="125.0"/></costs><selectionEntryGroups><selectionEntryGroup id="7554a666-5160-42b0" name="Champion 1 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="470bea7a-6741-4b15"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1c3a57d1-1322-4dc7" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5ae80297-2da5-4ae9" type="max"/></constraints><selectionEntries><selectionEntry id="470bea7a-6741-4b15" name="Jump pack, dual chainblades, bolt pistol" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="0520b924-f4bf-4c50" name="Dual chainblades" hidden="false" targetId="7e76-809f-c9cd-5a66" type="profile"/><infoLink id="e33d1e24-b601-48f3" name="Bolt pistol" hidden="false" targetId="19be-3f27-bea8-5ca4" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="2dbcc779-1330-4e40" name="Warrior 2 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="49a1cf06-5e4e-4af7"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e72fe6f4-4454-41a8" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ea804b29-d375-44bb" type="max"/></constraints><selectionEntries><selectionEntry id="49a1cf06-5e4e-4af7" name="Jump pack, dual chainblades, bolt pistol" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="82bb9138-4291-4dff" name="Dual chainblades" hidden="false" targetId="7e76-809f-c9cd-5a66" type="profile"/><infoLink id="20115807-27d0-4474" name="Bolt pistol" hidden="false" targetId="19be-3f27-bea8-5ca4" type="profile