"2590-7f88-3edf-5c1a" name="Thunderhawk Gunship" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="0856-8148-bce7-5261" name="Aircraft" hidden="false" targetId="6be8-bd06-032f-5209" primary="true"/><categoryLink id="56aa-a73e-8326-5883" name="Transports" hidden="false" targetId="9856-3547-9660-54c2" primary="false"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d5ee-da14-7263-558a" type="max"/></constraints><profiles><profile id="acc9-c9fe-f108-5d44" name="Thunderhawk Gunship" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">20+</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">12</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">22</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">0</characteristic></characteristics></profile><profile id="2f9c-8d81-8f55-5331" name="Assault Lift" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Capacity 30 Infantry spaces.</characteristic></characteristics></profile><profile id="e3d3-8145-a738-5f4f" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Turbo-laser destructor, heavy bolters, missile pods. 30 Infantry spaces; Terminators count 2. Aircraft restrictions apply.</characteristic></characteristics></profile><profile id="40f9-1e53-6903-5efb" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="046623ad-dfea-49ab" name="Passenger Manifest &amp; capacity" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Transport registration: Passenger-bearing Infantry must DECLARE this vehicle type in their Deployment / passenger assignment selection. Capacity 30 spaces; Terminators and jump-equipped passengers may use two each where permitted. Include ALL attached leaders and all squads sharing a carrier; do not exceed capacity. The catalogue records carrier TYPE, not a unique vehicle instance, so this capacity total must still be checked before play.</characteristic></characteristics></profile><profile id="77d9d004-0853-4de1-8139-50dcf070b07c" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Turbo-laser destructor, heavy bolters, missile pods. 30 Infantry spaces; Terminators count 2. Aircraft restrictions apply. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks/><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="615.0"/></costs><selectionEntryGroups><selectionEntryGroup id="59796db8-a404-4e73" name="Fixed weapons" hidden="false" collective="false" import="true" defaultSelectionEntryId="c6fb3087-4817-46e6"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a2057e3d-a148-4380" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5acd184c-8de0-42de" type="max"/></constraints><selectionEntries><selectionEntry id="c6fb3087-4817-46e6" name="Turbo-laser destructor, heavy bolters and missile pods" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="3fe89987-c2a1-4556" name="Turbo-laser destructor" hidden="false" targetId="7e50-a360-d7b3-5082" type="profile"/><infoLink id="cfb3573e-be97-45f0" name="Heavy bolter" hidden="false" targetId="72f2-bb1a-9e40-5de3" type="profile"/><infoLink id="ad21a518-bae1-4fc4" name="Missile launcher (frag)" hidden="false" targetId="2f23-67a8-672a-56ba" type="profile"/><infoLink id="09369450-6c8d-424e" name="Missile launcher (krak)" hidden="false" targetId="d343-195f-5f9a-5a0e" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="b1adc272-237a-4dde" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><constraints><constraint id="de25f54c-82ec-48e0" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><entryLinks><entryLink id="aaabe40e-a172-4736" name="Ash-Forged Targeter (+10 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="46d64132-8587-4978"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="5856-87a6-b30e-596e" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="f8ae55e3-f520-4e97" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup></selectionEntryGroups><modifiers><modifier type="set" field="d5ee-da14-7263-558a" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="4875-524b-6b40-5380" name="Astartes Assault Drop Pod" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="d96e-057b-08fc-5f99" name="Transports" hidden="false" targetId="9856-3547-9660-54c2" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="09e3-2577-0764-51af" type="max"/></constraints><profiles><profile id="3e0d-acd6-bde6-5057" name="Astartes Assault Drop Pod" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">0"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">9</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">8</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">0</characteristic></characteristics></profile><profile id="3dc4-3405-45c7-5d5a" name="Orbital Delivery" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">May carry one legal embarked unit in Reserves, using ordinary Drop Pod Deep Strike and mission timing; immobile once landed. Capacity 10 non-JUMP power-armoured models, attached Leader included. Does NOT inherit first-turn Cohort Insertion from passengers.</characteristic></characteristics></profile><profile id="5572-5212-b383-5b1e" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Choose storm bolter OR Deathwind launcher. Capacity 10 non-Jump Pack power-armoured Infantry (including Leaders); no Terminator, Mounted, Dreadnought or Daemon passengers. Pod does not inherit first-round Cohort Insertion.</characteristic></characteristics></profile><profile id="2da1-8a61-5f80-5222" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="4dce363f-0e1d-57a8" name="Orbital Delivery restriction" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Must deploy by normal Drop Pod procedures; an embarked Cohort does not confer its independent Turn-One Insertion rule on this Pod.</characteristic></characteristics></profile><profile id="9aa5421c-9cc2-418a" name="Passenger Manifest &amp; capacity" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Transport registration: Passenger-bearing Infantry must DECLARE this vehicle type in their Deployment / passenger assignment selection. Capacity 10 spaces; Terminators and jump-equipped passengers may use two each where permitted. Include ALL attached leaders and all squads sharing a carrier; do not exceed capacity. The catalogue records carrier TYPE, not a unique vehicle instance, so this capacity total must still be checked before play.</characteristic></characteristics></profile><profile id="9c379b61-ed68-475f" name="Mechanised Vanguard conditions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">OPTIONAL pre-battle move of up to 3 inches after deployment if this non-AIRCRAFT transport starts with friendly INFANTRY embarked and the mission permits. End over 9 inches from all enemies, outside enemy deployment zone. 1/1,000-point battle limit (max 2). Aircraft can never gain this privilege. Never confers a charge or first-turn aircraft arrival exception.</characteristic></characteristics></profile><profile id="9ae813cd-4a46-4509-920e-0b895ead3dbf" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Choose storm bolter OR Deathwind launcher. Capacity 10 non-Jump Pack power-armoured Infantry (including Leaders); no Terminator, Mounted, Dreadnought or Daemon passengers. Pod does not inher | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks/><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="90.0"/></costs><selectionEntryGroups><selectionEntryGroup id="6547d3a4-9ba5-4032" name="Main weapon" hidden="false" collective="false" import="true" defaultSelectionEntryId="721cb86c-62dd-43b5"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="76f39112-1772-489c" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2f9314f4-f1e4-4e74" type="max"/></constraints><selectionEntries><selectionEntry id="721cb86c-62dd-43b5" name="Storm bolter" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="5ebc3848-7d63-4fd2" name="Combi-bolter / storm bolter" hidden="false" targetId="21b2-49c4-ad7f-57b9" type="profile"/></infoLinks></selectionEntry><selectionEntry id="01b9a237-585a-40d0" name="Deathwind launcher" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="209a993d-4acd-4992" name="Deathwind launcher" hidden="false" targetId="124d6f50-cfd1-5412" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="0c8dbdd2-d23e-4b17" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><constraints><constraint id="8d8f8b28-c699-4b63" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><entryLinks><entryLink id="4a8c5eaa-0480-4a36" name="Ash-Forged Targeter (+10 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="46d64132-8587-4978"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="5856-87a6-b30e-596e" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="f8ae55e3-f520-4e97" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="7a5e357f-23d3-4ecc" name="Mechanised Vanguard — pre-battle move declaration" hidden="false" collective="false" import="true"><constraints><constraint id="2a6405e2-5a7a-48ae" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="6ede3e5c-be41-470b" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries/><entryLinks><entryLink id="104d388f-5441-4f94" name="Select as Mechanised Vanguard (3-inch move, 0 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="47db8214-8de1-4efd"/></entryLinks></selectionEntryGroup></selectionEntryGroups><modifiers><modifier type="set" field="09e3-2577-0764-51af" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="8e27-5136-efd3-5a5e" name="Dreadclaw Drop Pod" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="3eea-41e1-9fed-5d64" name="Transports" hidden="false" targetId="9856-3547-9660-54c2" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5f48-fbed-8ed1-5b06" type="max"/></constraints><profiles><profile id="515b-4e8e-613a-5e79" name="Dreadclaw Drop Pod" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">0"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">9</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">10</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">0</characteristic></characteristics></profile><profile id="bf8f-e383-7d9d-55df" name="Assault Descent" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Deep Strike subject to mission restrictions; transported unit disembarks after landing. Capacity 10 Infantry spaces, Terminators count as two.</characteristic></characteristics></profile><profile id="b1af-d59e-dd07-50f6" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Thermal thruster jets; capacity 10 Infantry spaces, Terminators count 2; Deep Strike/Reserves as mission permits.</characteristic></characteristics></profile><profile id="fba5-36ca-52ad-5f67" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="161420ad-85a3-4e90" name="Passenger Manifest &amp; capacity" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Transport registration: Passenger-bearing Infantry must DECLARE this vehicle type in their Deployment / passenger assignment selection. Capacity 10 spaces; Terminators and jump-equipped passengers may use two each where permitted. Include ALL attached leaders and all squads sharing a carrier; do not exceed capacity. The catalogue records carrier TYPE, not a unique vehicle instance, so this capacity total must still be checked before play.</characteristic></characteristics></profile><profile id="eac207d1-03cb-4b4c" name="Legion Assault Requisition conditions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">OPTIONAL discounted transport under Breach and Ruin: saves 25 points once per eligible hull, with 1 discount per full 1,000 army points (max 2). This vehicle must start with a compatible separately purchased infantry formation embarked; not a formation using Void Assault or Cohort Insertion. Real passenger allocation must be confirmed manually.</characteristic></characteristics></profile><profile id="7347e637-1568-44e7" name="Mechanised Vanguard conditions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">OPTIONAL pre-battle move of up to 3 inches after deployment if this non-AIRCRAFT transport starts with friendly INFANTRY embarked and the mission permits. End over 9 inches from all enemies, outside enemy deployment zone. 1/1,000-point battle limit (max 2). Aircraft can never gain this privilege. Never confers a charge or first-turn aircraft arrival exception.</characteristic></characteristics></profile><profile id="705c0313-9951-4a30-880c-d26bca5f255b" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Thermal thruster jets; capacity 10 Infantry spaces, Terminators count 2; Deep Strike/Reserves as mission permits. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks/><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="145.0"/></costs><selectionEntryGroups><selectionEntryGroup id="bf8ea650-4081-4b4e" name="Fixed weapon" hidden="false" collective="false" import="true" defaultSelectionEntryId="9c915389-96c1-4bae"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b558f3f4-cf5c-4c52" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7d8b8964-2424-4b61" type="max"/></constraints><selectionEntries><selectionEntry id="9c915389-96c1-4bae" name="Thermal thruster jets" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="b89e2ba7-af56-4ea8" name="Thermal thruster jets" hidden="false" targetId="e70fd64f-f907-5eff" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="87585075-364c-4dc1" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><constraints><constraint id="c2e3f1f6-8b19-4a7d" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><entryLinks><entryLink id="f8664f38-dcbe-45d1" name="Ash-Forged Targeter (+10 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="46d64132-8587-4978"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="5856-87a6-b30e-596e" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><