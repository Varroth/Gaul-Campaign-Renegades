tegoryLink id="9689-20ac-a52c-5efc" name="Dreadnoughts" hidden="false" targetId="930f-f4e6-1451-52ba" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="068b-b708-fd5e-5945" type="max"/></constraints><profiles><profile id="626b-058d-9cc4-59df" name="Deredeo Dreadnought" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">10</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">12</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">4</characteristic></characteristics></profile><profile id="d200-9f31-94e1-5ae1" name="Air-Defence Tracking" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Re-roll one Hit roll when attacking Aircraft. Eligible living pilot has Pilot Resilience, NOT hull regeneration.</characteristic></characteristics></profile><profile id="41eb-d129-5726-5030" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Anvilus autocannon battery and missile launcher; alternate heavy lascannon array may replace Anvilus [provisional]. Eligible for Pilot Resilience; no hull serum.</characteristic></characteristics></profile><profile id="b5be-13ec-d359-54d8" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Pilot Resilience: once per battle round may re-roll failed save against a Damage 1 attack; no hull regeneration. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="e6f1a3b4-4bfb-458b-bac3-062018fc88e8" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Anvilus autocannon battery and missile launcher; alternate heavy lascannon array may replace Anvilus [provisional]. Eligible for Pilot Resilience; no hull serum. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="c3c4afb1-3dd8-5af8" name="Pilot Resilience" hidden="false" targetId="595a068d-663b-51e6" type="rule"/></infoLinks><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="225.0"/></costs><selectionEntryGroups><selectionEntryGroup id="852759ec-9e60-4346" name="Main battery" hidden="false" collective="false" import="true" defaultSelectionEntryId="fd1fbe32-5407-4962"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="cdb53512-962c-4a11" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="bc90adc3-cf3e-4f38" type="max"/></constraints><selectionEntries><selectionEntry id="fd1fbe32-5407-4962" name="Anvilus autocannon array" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="5ac0bcef-508f-48fb" name="Anvilus autocannon array" hidden="false" targetId="ca6c-a8fb-e3a4-5725" type="profile"/></infoLinks></selectionEntry><selectionEntry id="d40b4ffb-3d62-4cb4" name="Heavy lascannon array" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="6d9985cc-20e1-4223" name="Heavy lascannon array" hidden="false" targetId="52a2fccc-c99c-5c15" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="faf3c084-69ce-4c9c" name="Missile battery" hidden="false" collective="false" import="true" defaultSelectionEntryId="99424ca4-f5f2-42f6"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a65266d5-12dc-4c73" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3f682754-fabe-43cb" type="max"/></constraints><selectionEntries><selectionEntry id="99424ca4-f5f2-42f6" name="Missile launcher" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="509bd082-c232-48ce" name="Missile launcher (frag)" hidden="false" targetId="2f23-67a8-672a-56ba" type="profile"/><infoLink id="d2e4a670-7331-46ff" name="Missile launcher (krak)" hidden="false" targetId="d343-195f-5f9a-5a0e" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="57397dbb-cce7-4a65" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><constraints><constraint id="799274e2-3017-4fac" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><entryLinks><entryLink id="6e7b5ea0-4beb-4fda" name="Ash-Forged Targeter (+10 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="46d64132-8587-4978"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="5856-87a6-b30e-596e" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="f8ae55e3-f520-4e97" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup></selectionEntryGroups><modifiers><modifier type="set" field="068b-b708-fd5e-5945" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="0fbe-add8-a3b5-5f24" name="Helbrute Relic Walker" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="4b9d-310e-9364-5044" name="Dreadnoughts" hidden="false" targetId="930f-f4e6-1451-52ba" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0d8f-003e-d75a-518d" type="max"/></constraints><profiles><profile id="2d51-44df-9b21-5386" name="Helbrute Relic Walker" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">7"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">9</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">8</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">3</characteristic></characteristics></profile><profile id="eefd-7741-9b0d-50df" name="Wrath Harness" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle after suffering damage, re-roll one melee Hit roll. Eligible pilot uses the separate Pilot Resilience rule, not hull healing.</characteristic></characteristics></profile><profile id="7ea1-06e6-a287-50b7" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Autocannon and power fist; autocannon may be replaced by twin lascannons or multi-melta. Eligible surviving inducted pilot uses Pilot Resilience, no hull regeneration.</characteristic></characteristics></profile><profile id="52d7-4e2d-df6d-5fb9" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Pilot Resilience: once per battle round may re-roll failed save against a Damage 1 attack; no hull regeneration. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="57c790f1-3ff9-4fe6-82b5-bdf43ec7c2d8" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Autocannon and power fist; autocannon may be replaced by twin lascannons or multi-melta. Eligible surviving inducted pilot uses Pilot Resilience, no hull regeneration. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="ead10d06-1640-52a9" name="Pilot Resilience" hidden="false" targetId="595a068d-663b-51e6" type="rule"/></infoLinks><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="140.0"/></costs><selectionEntryGroups><selectionEntryGroup id="b2d8f812-afe2-42e5" name="Main ranged weapon" hidden="false" collective="false" import="true" defaultSelectionEntryId="ed9c3d6d-cf00-4110"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="93f8662d-f260-4fa5" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="30f98c5c-6b02-4785" type="max"/></constraints><selectionEntries><selectionEntry id="ed9c3d6d-cf00-4110" name="Autocannon" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="ed638701-b672-41dc" name="Autocannon" hidden="false" targetId="bab9-db31-01d9-5507" type="profile"/></infoLinks></selectionEntry><selectionEntry id="ef452936-ca7f-48b2" name="Twin lascannons" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="3e2437e8-a3cc-4fef" name="Twin lascannons" hidden="false" targetId="50ca-22a4-36c4-5a73" type="profile"/></infoLinks></selectionEntry><selectionEntry id="d052d873-8333-4d65" name="Multi-melta" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="bb8b037c-a4a4-4e34" name="Multi-melta" hidden="false" targetId="4711-5a8c-ab44-5573" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="5dc1c61e-205a-431c" name="Melee arm" hidden="false" collective="false" import="true" defaultSelectionEntryId="20e56df7-d1cc-475d"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ed508db3-3d5f-4db7" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7bfe30a3-6fb0-4f08" type="max"/></constraints><selectionEntries><selectionEntry id="20e56df7-d1cc-475d" name="Power fist" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="9901f420-ca94-4f3f" name="Power fist" hidden="false" targetId="bea6-5c80-14b8-58f0" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="f365b12e-d99e-4a5e" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><constraints><constraint id="aadeb059-943f-417e" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><entryLinks><entryLink id="282948d1-2ac8-4829" name="Ash-Forged Targeter (+10 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="46d64132-8587-4978"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="5856-87a6-b30e-596e" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="f8ae55e3-f520-4e97" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup></selectionEntryGroups><modifiers><modifier type="set" field="0d8f-003e-d75a-518d" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="7a6c-99a9-6f03-5c81" name="Rhino Carrier" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="5605-8d14-3fc9-5d0f" name="Transports" hidden="false" targetId="9856-3547-9660-54c2" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4bca-d873-afca-58a1" type="max"/></constraints><profiles><profile id="65d0-cb8a-9ea7-5b19" name="Rhino Carrier" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">12"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">9</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">10</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="bd61-0ee8-4e04-588a" name="Battle Taxi" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle after passengers disembark, one unit gains +1 to its Charge roll.</characteristic></characteristics></profile><profile id="497f-a5ab-079e-595a" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Combi-bolter, optional second combi-bolter. Capacity 10 ordinary power-armoured infantry spaces; no Terminators, jump packs, bikes, daemons or Dreadnoughts.</characteristic></characteristics></profile><profile id="8b15-8a05-1240-5782" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="717eab32-116f-4284" name="Passenger Manifest &amp; capacity" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Transport registration: Passenger-bearing Infantry must DECLARE this vehicle type in their Deployment / passenger assignment selection. Capacity 10 spaces; Terminators and jump-equipped passengers may use two each where permitted. Include ALL attached leaders and all squads sharing a carrier; do not exceed capacity. The catalogue records carrier TYPE, not a unique vehicle instance, so this capacity total must still be checked before play.</characteristic></characteristics></profile><profile id="3f81a4de-16ed-4c4a" name="Legion Assault Requisition conditions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">OPTIONAL discounted transport under Breach and Ruin: saves 20 points once per eligible hull, with 1 discount per full 1,000 army points (max 2). This vehicle must start with a compatible separately purchased infantry formation embarked; not a formation using Void Assault or Cohort Insertion. Real passenger allocation must be confirmed manually.</characteristic></characteristics></profile><profile id="f1950111-aaa0-4dfa" name="Mechanised Vanguard conditions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">OPTIONAL pre-battle move of up to 3 inches after deployment if this non-AIRCRAFT transport starts with friendly INFANTRY embarked and the mission permits. End over 9 inches from all enemies, outside enemy deployment zone. 1/1,000-point battle limit (max 2). Aircraft can never gain this privilege. Never confers a charge or first-turn aircraft arrival exception.</characteristic></characteristics></profile><profile id="7dbd85f8-1cb9-47ed-ab51-08d2aa425be4" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Combi-bolter, optional second combi-bolter. Capacity 10 ordinary power-armoured infantry spaces; no Terminators, jump packs, bikes, daemons or Dreadnoughts. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks/><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="80.0"/></costs><selectionEntryGroups><selectionEntryGroup id="57e6c1f5-179e-48aa" name="Hull weapon" hidden="false" collective="false" import="true" defaultSelectionEntryId="b7e3a68e-9b48-4916"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c47d925e-a859-4b48" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e56aa83d-4f8f-47c0" type="max"/></constraints><selectionEntries><selectionEntry id="b7e3a68e-9b48-4916" name="Combi-bolter" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="a85f3831-9d11-4e60" name="Combi-bolter / storm bolter" hidden="false" targetId="21b2-49c4-ad7f-57b9" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="60295b08-7f7a-4c76" name="Optional pintle" hidden="false" collective="false" import="true"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3cb5c1cd-c329-4235" type="max"/></constraints><selectionEntries><selectionEntry id="8645d5f7-14dd-43a3" name="Second combi-bolter" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="7c466145-d8a1-4f48" name="Combi-bolter / storm bolter" hidden="false" targetId="21b2-49c4-ad7f-57b9" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="f4187d84-593f-4ec3" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><constraints><constraint id="e560eaa2-6af9-41b0" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><entryLinks><entryLink id="45d03b2e-a72b-4a4f" name="Ash-Forged Targeter (+10 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="46d64132-8587-4978"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="5856-87a6-b30e-596e" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="f8ae55e3-f520-4e97" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="017fa67e-ffd5-4de4" name="Breach and Ruin — Legion Assault Requisition" hidden="false" collective="false" import="true"><constraints><constraint id="1f5a7018-e11a-4e34" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="802a4fb6-ea70-4395" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries/><entryLinks><entryLink id="474e47d0-7ad3-4fc9" name="Apply Legion Assault Requisition discount (−20 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="690e6cd7-0fd3-469d"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="-20.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="b7ad-18e3-9d4d-57e1" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="c0dc1476-6d3c-479f" name="Mechanised Vanguard — pre-battle move declaration" hidden="false" collective="false" import="true"><constraints><constraint id="20a249dd-2ee9-4b78" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="9bb16fde-bb85-40d2" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries/><entryLinks><entryLink id="d8ced01a-3c3b-4527" name="Select as Mechanised Vanguard (3-inch move, 0 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="47db8214-8de1-4efd"/></entryLinks></selectionEntryGroup></selectionEntryGroups><modifiers><modifier type="set" field="4bca-d873-afca-58a1" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="41be-8619-7094-5666" name="Razorback Fire-support Carrier" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="5d18-18db-ccf0-5b15" name="Transports" hidden="false" targetId="9856-3547-9660-54c2" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3946-cb8e-d9d0-5181" type="max"/></constraints><profiles><profile id="d9e9-3477-6fde-5532" name="Razorback Fire-support Carrier" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">12"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">9</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">10</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="48f8-9d38-cb55-5987" name="Fire-support Drop" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle after disembarkation, one model in the passenger unit may re-roll one ranged Hit roll that phase. Capacity: six ordinary non-jump power-armoured Infantry models, counting attached Leaders.</characteristic></characteristics></profile><profile id="3650-28e8-5bc6-5b52" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Twin heavy bolter or twin lascannons, optional storm bolter. Capacity SIX ordinary power-armoured Chapter Infantry including attached Leaders; no Terminator, Gravis, Jump Pack, Mounted or Daemon passengers.</characteristic></characteristics></profile><profile id="a5f8-a6f3-3857-58ee" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="3bcd9339-4ecc-4a64" name="Passenger Manifest &amp; capacity" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Transport registration: Passenger-bearing Infantry must DECLARE this vehicle type in their Deployment / passenger assignment selection. Capacity 6 spaces; Terminators and jump-equipped passengers may use two each where permitted. Include ALL attached leaders and all squads sharing a carrier; do not exceed capacity. The catalogue records carrier TYPE, not a unique vehicle instance, so this capacity total must still be checked before play.</characteristic></characteristics></profile><profile id="0d360c15-2fad-4332" name="Mechanised Vanguard conditions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">OPTIONAL pre-battle move of up to 3 inches after deployment if this non-AIRCRAFT transport starts with friendly INFANTRY embarked and the mission permits. End over 9 inches from all enemies, outside enemy deployment zone. 1/1,000-point battle limit (max 2). Aircraft can never gain this privilege. Never confers a charge or first-turn aircraft arrival exception.</characteristic></characteristics></profile><profile id="a6a4576e-3fdb-4519-8ddf-7bda2ff7f209" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Twin heavy bolter or twin lascannons, optional storm bolter. Capacity SIX ordinary power-armoured Chapter Infantry including attached Leaders; no Terminator, Gravis, Jump Pack, Mounted or Da | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks>
        </infoLinks><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="95.0"/></costs><selectionEntryGroups><selectionEntryGroup id="23dedc45-c5c1-447b" name="Main turret" hidden="false" collective="false" import="true" defaultSelectionEntryId="e8827a5a-f005-4a60"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="24c3363b-8b99-4a1a" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="152dfafe-2f9d-4402" type="max"/></constraints><selectionEntries><selectionEntry id="e8827a5a-f005-4a60" name="Twin heavy bolter" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="3011f2d4-35ae-4a58" name="Twin heavy bolter" hidden="false" targetId="45cfd916-26bf-58c2" type="profile"/></infoLinks></selectionEntry><selectionEntry id="201e08f0-4197-450b" name="Twin lascannons" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="1f72eb97-ee25-48d6" name="Twin lascannons" hidden="false" targetId="50ca-22a4-36c4-5a73" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="ed890669-f74c-4a12" name="Pintle upgrade" hidden="false" collective="false" import="true"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0c4f52a6-7dc4-46a6" type="max"/></constraints><selectionEntries><selectionEntry id="df7ab761-630c-4e48" name="Storm bolter" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="f8597435-c720-4cc9" name="Combi-bolter / storm bolter" hidden="false" targetId="21b2-49c4-ad7f-57b9" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="7c3eacf1-0a75-489d" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><constraints><constraint id="187358f7-610e-461f" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><entryLinks><entryLink id="9215a824-8a0e-4da2" name="Ash-Forged Targeter (+10 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="46d64132-8587-4978"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="5856-87a6-b30e-596e" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="f8ae55e3-f520-4e97" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="62359522-54e8-4477" name="Mechanised Vanguard — pre-battle move declaration" hidden="false" collective="false" import="true"><constraints><constraint id="92d1a19c-8809-4cfc" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="4f190730-3643-4447" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries/><entryLinks><entryLink id="9b558b1f-a115-4f8c" name="Select as Mechanised Vanguard (3-inch move, 0 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="47db8214-8de1-4efd"/></entryLinks></selectionEntryGroup></selectionEntryGroups><modifiers><modifier type="set" field="3946-cb8e-d9d0-5