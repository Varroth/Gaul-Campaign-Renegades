lective="false" import="true" defaultSelectionEntryId="2c1e31ba-cf92-421d"><constraints><constraint id="4a5d8326-ec53-4b9c" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="8ce86462-05e8-4d60" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="2c1e31ba-cf92-421d" name="Deployed on the battlefield (normal)" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="c3c52ea1-5697-4f6b" name="Standard Strategic Reserves (mission restrictions)" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="f56ef424-eacb-434a" name="Standard Reserves" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Select only when the mission allows this formation and it fits the Reserves points cap; normal later-round timing applies. This is not an automatic Deep Strike grant.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="ff119c30-41c2-420e" name="Cohort Insertion — First-turn Deep Strike" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="c4bfcc59-a961-4e60" name="Cohort Insertion" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Entire Chaplain-led formation (bundled in the selected unit size) deploys independently by Deep Strike, including the approved FIRST FRIENDLY Reinforcements step if the first-turn option was chosen. This waives ONLY first-round arrival prohibition, not Reserves cap, coherency or enemy exclusion. No transport may gain early arrival by carrying this unit.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1a877453-2af3-47bd" name="Cohort Insertion — Later-round Deep Strike" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="474b9fe6-c7a8-429b" name="Cohort Insertion" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Entire Chaplain-led formation (bundled in the selected unit size) deploys independently by Deep Strike, including the approved FIRST FRIENDLY Reinforcements step if the first-turn option was chosen. This waives ONLY first-round arrival prohibition, not Reserves cap, coherency or enemy exclusion. No transport may gain early arrival by carrying this unit.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7aff4f64-0176-4bba" name="Embarked in: Rhino Carrier" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="7a6c-99a9-6f03-5c81" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="4bb0d465-7091-47e6" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Rhino Carrier. Formation is 9 infantry model(s) plus its mandatory PAID Chaplain; minimum passenger spaces 10. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="89399791-1893-458b" name="Embarked in: Land Raider" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="b61d-137f-cbfd-594d" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="1e7516ff-c9cc-4d02" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Land Raider. Formation is 9 infantry model(s) plus its mandatory PAID Chaplain; minimum passenger spaces 10. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a01ad3bc-a357-4fdb" name="Embarked in: Spartan Assault Tank" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="722a-2c35-6f47-5a04" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><