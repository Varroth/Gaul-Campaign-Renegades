></modifiers></selectionEntry><selectionEntry id="24fab875-f799-4f35-97ad-959756940b44" name="Warlord: Rhazdan Krell" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="67ce-6248-ce2e-5b62" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="547b0980-4656-472c-80f1-c707af47c8d4" name="Warlord: Zecer Varthis" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="578b-1fd7-2f2c-5c4a" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="4906f6cf-3f97-4a47-9280-ff80a6a91852" name="Warlord: Karnus Vehl" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="583b-bec7-aef5-5bb7" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="fe2019db-c53c-4dc7-a2b8-33ecbeeb5ede" name="Warlord: Infernal Chaplain" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="6a40-bf6a-1b69-5551" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="8d9be195-3d2c-4752-8eee-b3ccfe3d2521" name="Warlord: Infernal Terminator Chaplain" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="ba2d-3d71-2379-52cc" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><profiles><profile id="9c790b69-47a7-4d59" name="Muster configuration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Select the battle size here AND set the corresponding PTS and DP cost limits in New Recruit. This campaign uses 1,000- and 2,000-point homebrew defaults. Choose authorised Enhancement names below before applying them to units. These authorisation tokens are free and each distinct name can be authorised only once.</characteristic></characteristics></profile><profile id="6b5b0f48-edde-48d7-b033-2eaa79b3da41" name="Quick Start — four steps" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">1. Set cost limits in New Recruit (1,000 pts/2 DP, or 2,000 pts/3 DP). 2. Add this START HERE entry, set battle size, and authorize distinct Enhancement names only when you intend to purchase them. 3. Add one or more DETACHMENTS within DP, then select ONE MISSION disposition. 4. Add units; size defaults and preconfigured weapon builds are editable. Attach Leaders to their legal bodyguard unit in New Recruit when a native association action is available. Check transport passenger allocation and Cohort Chaplains before the battle.</characteristic></characteristics></profile><profile id="257894af-69a4-4ca5-9a74-c6e72832cc9b" name="Warlord assignment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The Warlord selection references an existing purchased Character and adds no new model or points. For multiple generic Chaplains, record the particular instance as the Warlord in the roster notes. One Warlord must be chosen as part of START HERE.</characteristic></characteristics></profile><profile id="35a2-f36c-8493-57f1" name="2.5.2 quick start / enhancements" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">1. Choose battle size; 2. Select the detachment(s) and mission disposition; 3. Add units and editable weapons; 4. Buy CHARACTERs and declare each under the specific bodyguard squad; 5. Authorise distinct Enhancement names in this section and apply their point-costed Upgrade on the unit; 6. Export .ros and open ROSTER_FIELD_CHECK.html to validate the complete army. Repeated squad Upgrades still count once per distinct name in the authorisation group. Do NOT buy an attached Leader twice for Lost Cohort; Chaplains are bundled there. Native New Recruit associations are a client action and cannot be forced by this BattleScribe 2.03 catalogue.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8d559da4-63be-49c6" name="02 — MISSION: Select One Disposition" type="upgrade" hidden="false" collective="false" import="true"><categoryLinks><categoryLink id="ab64a058-f0a5-4b32" name="Force Dispositions" hidden="false" targetId="b9f3-c313-59f0-5cef" primary="true"/></categoryLinks><constraints><constraint id="fa6c0c71-e021-4d5d" type="max" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="ada86cc4-1d17-4474" name="One unlocked Force Disposition" hidden="false" collective="false" import="true"><constraints><constraint id="b47bece4-4c6b-49cc" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="e00abbd7-c464-49ec" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="77786b80-dd1c-4f88" name="Take and Hold" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="9ba98207-b439-498f" name="Force Disposition — Take and Hold" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Choose this ONE mission disposition from War Hounds’ Legacy. Only one disposition may be selected for the army even when multiple detachments have been purchased. Mission scoring/mission card effects use the agreed 11th-edition mission pack, not invented game effects.</characteristic></characteristics></profile></profiles><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="8eb0-8d1d-a832-5447" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="653afa38-4eaa-4ee1" name="Purge the Foe" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="170ab8c8-ff81-4380" name="Force Disposition — Purge the Foe" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Choose this ONE mission disposition from Crimson Onslaught. Only one disposition may be selected for the army even when multiple detachments have been purchased. Mission scoring/mission card effects use the agreed 11th-edition mission pack, not invented game effects.</characteristic></characteristics></profile></profiles><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="d6ca-9cbf-e275-5803" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="f5e8ad4e-06f3-452b" name="Reconnaissance" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="65c8b278-aa35-439c" name="Force Disposition — Reconnaissance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Choose this ONE mission disposition from Crimson Onslaught. Only one disposition may be selected for the army even when multiple detachments have been purchased. Mission scoring/mission card effects use the agreed 11th-edition mission pack, not invented game effects.</characteristic></characteristics></profile></profiles><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="d6ca-9cbf-e275-5803" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="25c0b34f-e5aa-4d20" name="Priority Assets" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="e09a5fcd-1d05-4480" name="Force Disposition — Priority Assets" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Choose this ONE mission disposition from Iron Reavers. Only one disposition may be selected for the army even when multiple detachments have been purchased. Mission scoring/mission card effects use the agreed 11th-edition mission pack, not invented game effects.</characteristic></characteristics></profile></profiles><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="5856-87a6-b30e-596e" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="43535ae8-21db-4c45" name="Disruption" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="ee7c51f2-cd27-4ce1" name="Force Disposition — Disruption" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Choose this ONE mission disposition from Breach and Ruin. Only one disposition may be selected for the army even when multiple detachments have been purchased. Mission scoring/mission card effects use the agreed 11th-edition mission pack, not invented game effects.</characteristic></characteristics></profile></profiles><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="b7ad-18e3-9d4d-57e1" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><profiles><profile id="07abc153-9527-43f9-8d45-d73024f2b38f" name="Mission setup note" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Choose exactly one Force Disposition unlocked by purchased detachments. This selection is a muster declaration, not a simulated mission scoring engine. Crimson Onslaught unlocks Purge the Foe OR Reconnaissance.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5e9d-d4f4-1dec-5e6c" name="Bloodmarked Thralls" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="ca5d-574f-697b-590b" name="Mortal Auxilia" hidden="false" targetId="93a3-7ba9-2915-5ea2" primary="true"/></categoryLinks><constraints><constraint id="326c-5501-8dbd-5a18" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max"/></constraints><profiles><profile id="37f9-088b-6800-5132" name="Bloodmarked Thralls" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">3</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">6+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">1</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">8+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="0c60-09d6-172c-5202" name="Bloodletter Invocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle PER ARMY, at the end of your Movement phase, a Bloodmarked Thralls unit on the battlefield that is not Battle-shocked may select one BLOODLETTERS unit already bought and placed in Reserves. Set it up wholly within 6" of the invoking Thralls and more than 9" from all enemy models. Follow all mission Reserves timing, capacity, and placement restrictions. If there is no legal placement, the invocation cannot be made. Bloodletters count toward the Khorne Daemon ally points limit. No free or other Daemon models are created.</characteristic></characteristics></profile><profile id="46c9-6454-e325-5423" name="Expendable Followers" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This unit never receives Infernal Serum, Disciplined Brutality or any ability restricted to ASTARTES. Its presence does not satisfy ASTARTES unit requirements or count as a military officer.</characteristic></characteristics></profile><profile id="e49d-242f-2e76-56e4" name="Unit composition / selectable wargear" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">10–20 models, including ONE Blood-Caller. All carry an autopistol and crude blade. For every full 10 models, one model (including the Blood-Caller if desired) may replace its autopistol with a flamer or heavy stubber. The per-model specialist slots are exclusive weapon REPLACEMENTS, not additional pistols. No serum. Units of 10 cost 45 pts; 20 cost 90 pts. Intermediate-size points follow existing codex proportional-up-to-5 scaling.</characteristic></characteristics></profile><profile id="ae9e-9057-d6b5-5691" name="Mortal war-host / keyword restrictions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Keywords: INFANTRY, MORTALS, CULTISTS, KHORNE, INFERNAL WARRIORS, BLOODMARKED THRALLS. Neither INFANTRY MORTALS unit has ASTARTES; no Infernal Serum (no +1 Wound, Feel No Pain 5+, or regeneration), no ASTARTES-only rules. Not Khorne Daemon allies; these are Infernal Warriors mortal entries.</characteristic></characteristics></profile><profile id="7a71-7e13-83c6-5eae" name="BLOODLETTER INVOCATION — paid Reserve requirement" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">To summon: purchase Bloodletters as a separate Khorne Ally, select their existing legal Reserves declaration, and optionally nominate a Thralls unit as planned invoker. No free Bloodletters are generated. This planning choice is 0 pts and does not replace the in-game once-per-army restriction.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="584a-1e96-b0eb-576e" name="Mortal War-Host and Blood Rites" hidden="false" type="rule" targetId="b0a7-02c8-f70c-54d4"/></infoLinks><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><selectionEntryGroups><selectionEntryGroup id="4808-a4be-aff7-52fe" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="69e7-2b83-f5cf-515f"><constraints><constraint id="4d82-8e3a-b3ed-5a14" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/><constraint id="e63b-2ff0-0bf8-5a0f" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><selectionEntries><selectionEntry id="69e7-2b83-f5cf-515f" name="10 models — 45 pts" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="45.0"/></costs><selectionEntryGroups><selectionEntryGroup id="5e22-e21f-35c6-529a" name="Standard Bloodmarked Thralls (including Blood-Caller if not nominated as specialist)" hidden="false" collective="false" import="true" defaultSelectionEntryId="b169-8b87-f571-5155"><constraints><constraint id="9deb-03ca-2581-54f0" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/><constraint id="0b40-45bc-a6d0-52b5" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><selectionEntries><selectionEntry id="b169-8b87-f571-5155" name="9 regular Thralls — autopistols and crude blades" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="ddf4-e5bb-36fd-59bd" name="Bloodmarked Thralls autopistol" hidden="false" targetId="3cd1-e21f-e2fa-587e" type="profile"/><infoLink id="cb71-1f82-dbc1-596b" name="Bloodmarked Thralls crude blade" hidden="false" targetId="44bc-1acd-66d1-5719" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="f8f8-ceb4-f808-5f28" name="Specialist slot 1 (may be the Blood-Caller) — choose ONE weapon" hidden="false" collective="false" import="true" defaultSelectionEntryId="0486-956c-d8c9-5144"><constraints><constraint id="5f77-ea51-aaf0-56bd" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/><constraint id="515d-cce6-6c11-5aab" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><selectionEntries><selectionEntry id="0486-956c-d8c9-5144" name="1 Thrall — autopistol and crude blade" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="d930-b9a7-4681-53cf" name="Bloodmarked Thralls autopistol" hidden="false" targetId="3cd1-e21f-e2fa-587e" type="profile"/><infoLink id="b2c4-2eb4-b34c-51ee" name="Bloodmarked Thralls crude blade" hidden="false" targetId="44bc-1acd-66d1-5719" type="profile"/></infoLinks></selectionEntry><selectionEntry id="59c0-2769-8194-5bf7" name="1 Thr