rces="true"/></constraints><selectionEntries/><entryLinks><entryLink id="b4252bcb-ddaa-41ae" name="Select as Mechanised Vanguard (3-inch move, 0 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="47db8214-8de1-4efd"/></entryLinks></selectionEntryGroup></selectionEntryGroups><modifiers><modifier type="set" field="5f48-fbed-8ed1-5b06" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="a6d8-ed7a-d637-506f" name="Kharybdis Assault Claw" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="6a77-bfd7-0747-546b" name="Transports" hidden="false" targetId="9856-3547-9660-54c2" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f651-faa4-1fa3-54dc" type="max"/></constraints><profiles><profile id="4a00-943c-61bd-5a39" name="Kharybdis Assault Claw" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">0"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">11</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">16</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">0</characteristic></characteristics></profile><profile id="1f46-3674-901a-58d0" name="Breaching Assault" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Disembarked passengers may re-roll one Charge die if that turn’s mission rules permit the charge.</characteristic></characteristics></profile><profile id="4694-194e-7347-58f0" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Thermic ram; capacity 20 Infantry spaces, Terminators count 2; mission restrictions apply.</characteristic></characteristics></profile><profile id="fb48-ccd5-0fad-5a51" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="ace1f1be-4848-4125" name="Passenger Manifest &amp; capacity" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Transport registration: Passenger-bearing Infantry must DECLARE this vehicle type in their Deployment / passenger assignment selection. Capacity 20 spaces; Terminators and jump-equipped passengers may use two each where permitted. Include ALL attached leaders and all squads sharing a carrier; do not exceed capacity. The catalogue records carrier TYPE, not a unique vehicle instance, so this capacity total must still be checked before play.</characteristic></characteristics></profile><profile id="e5cce738-f567-460e" name="Legion Assault Requisition conditions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">OPTIONAL discounted transport under Breach and Ruin: saves 35 points once per eligible hull, with 1 discount per full 1,000 army points (max 2). This vehicle must start with a compatible separately purchased infantry formation embarked; not a formation using Void Assault or Cohort Insertion. Real passenger allocation must be confirmed manually.</characteristic></characteristics></profile><profile id="3612fad3-84e3-4fab" name="Mechanised Vanguard conditions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">OPTIONAL pre-battle move of up to 3 inches after deployment if this non-AIRCRAFT transport starts with friendly INFANTRY embarked and the mission permits. End over 9 inches from all enemies, outside enemy deployment zone. 1/1,000-point battle limit (max 2). Aircraft can never gain this privilege. Never confers a charge or first-turn aircraft arrival exception.</characteristic></characteristics></profile><profile id="7c69d27a-d9b2-4a5b-996c-31c1e67325bd" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Thermic ram; capacity 20 Infantry spaces, Terminators count 2; mission restrictions apply. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks>
