ondition type="lessThan" value="1" field="selections" scope="roster" childId="8eb0-8d1d-a832-5447" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="2de11288-d698-41c6" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink><entryLink id="f6aa6fcc-2623-4b99" name="War Hounds’ Field Manual (+15 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="3028597c-2a14-4594"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="8eb0-8d1d-a832-5447" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="96ec7e6c-cb3a-47cd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink><entryLink id="7d0fa70b-c268-45db" name="The Measured Strike (+15 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="dcf44d0a-d9cb-4d92"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="d6ca-9cbf-e275-5803" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="1307c605-442e-45a0" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="06e89ea8-bec6-4a98" name="Deployment / passenger assignment (one declared plan)" hidden="false" collective="false" import="true" defaultSelectionEntryId="79d442fd-6d22-4577"><constraints><constraint id="7ca2a6b6-15ce-4d55" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="207a7b23-cceb-465f" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="79d442fd-6d22-4577" name="Deployed on the battlefield (normal)" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="37797200-b5f4-4e11" name="Standard Strategic Reserves (mission restrictions)" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="bc832895-4b26-470c" name="Standard Reserves" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Select only when the mission allows this formation and it fits the Reserves points cap; normal later-round timing applies. This is not an automatic Deep Strike grant.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="cfc6ba01-6e8a-49e2" name="Cohort Insertion — First-turn Deep Strike" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="c600535a-a6da-43b6" name="Cohort Insertion" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Entire Chaplain-led formation (bundled in the selected unit size) deploys independently by Deep Strike, including the approved FIRST FRIENDLY Reinforcements step if the first-turn option was chosen. This waives ONLY first-round arrival prohibition, not Reserves cap, coherency or enemy exclusion. No transport may gain early arrival by carrying this unit.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="ceed5224-3c62-409a" name="Cohort Insertion — Later-round Deep Strike" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="b2000d94-2b68-4abd" name="Cohort Insertion" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Entire Chaplain-led formation (bundled in the selected unit size) deploys independently by Deep Strike, including the approved FIRST FRIENDLY Reinforcements step if the first-turn option was chosen. This waives ONLY first-round arrival prohibition, not Reserves cap, coherency or enemy exclusion. No transport may gain early arrival by carrying this unit.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="dfd3b6b3-6af6-4020" name="Embarked in: Rhino Carrier" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="7a6c-99a9-6f03-5c81" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="95985adc-79ef-45e0" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Rhino Carrier. Formation is 