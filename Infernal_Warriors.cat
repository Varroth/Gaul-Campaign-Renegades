b3f6-5724-a150-57b6" name="Pexi 270th Heavy Weapon Team" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">5"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">3</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">5+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="f44b-3247-8878-53ef" name="Overwatch Screen" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Re-roll one Hit roll against charging enemy Infantry.</characteristic></characteristics></profile><profile id="cf28-4ae3-1ca4-56f8" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">3–6 Pexi 270th weapons teams, EACH model representing TWO mortal crew. Before battle, declare EXACTLY ONE primary weapon for EACH team: Pexi 270th mortar, heavy stubber or autocannon. Different teams in the same unit may choose different weapons. A mortar-equipped team shoots using its single Pexi 270th mortar profile: Range 48", D6 attacks, BS 5+, Strength 5, AP 0, Damage 1, Blast, Heavy, Indirect Fire. Mortar crew do not make an additional sidearm shooting sequence. No automatic serum resilience. Current points are for the complete unit at its selected team count; all three permitted weapon families are zero-surcharge choices. Each team now has a compulsory selectable weapon slot in its chosen unit size; record the actual selected mortar/stubber/autocannon choices in New Recruit.</characteristic></characteristics></profile><profile id="d031-3809-239b-57ea" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Mortals: NO Infernal Serum. Mortar (if equipped): 48", D6 attacks, BS 5+, S5, AP0, D1; Blast, Heavy, Indirect Fire. Overwatch Screen: re-roll ONE Hit roll against charging enemy Infantry. The legal primary armament must be declared for each weapons-team model. Individual weapon selection is currently a textual roster declaration, not a clickable enforced upgrade.</characteristic></characteristics></profile><profile id="710903f5-fd67-5b48" name="Pexi 270th — mortar fire discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">A team with a mortar fires its declared mortar profile only; do not count a separate crew-sidearm attack. Mortars may use Indirect Fire against targets without line of sight, but every attack remains subject to the current 11th-edition Indirect Fire targeting, cover, hit-roll and action restrictions. Heavy and Blast use the current edition core definitions. Overwatch Screen is the unit’s existing ability and does not grant additional mortar shots. This rule/profile is a provisional homebrew completion of a previously unprofiled loadout.</characteristic></characteristics></profile><profile id="3b6ef97a-c447-4ed5-ac56-1bca2b997f29" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: 3–6 Pexi 270th weapons teams, EACH model representing TWO mortal crew. Before battle, declare EXACTLY ONE primary weapon for EACH team: Pexi 270th mortar, heavy stubber or autocannon. Differ | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks>
        </infoLinks><selectionEntryGroups><selectionEntryGroup id="49aa-72bf-6aa9-5f88" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="4deb-5e2d-7b37-50df"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="554d-3413-d7e7-5b78" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="830c-202b-025c-51bd" type="max"/></constraints><selectionEntries><selectionEntry id="4deb-5e2d-7b37-50df" name="3 models" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="50.0"/></costs><selectionEntryGroups><selectionEntryGroup id="2e2b7384-1e7c-4958" name="Champion 1 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="e24d313d-58bd-492f"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="435492aa-972d-4cb3" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="422bb8f7-c6af-416b" type="max"/></constraints><selectionEntries><selectionEntry id="e24d313d-58bd-492f" name="Mortar team — 2 crew, 1 Pexi mortar" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="a3b200f0-533d-458c" name="Pexi 270th mortar" hidden="false" targetId="06385641-6436-5416" type="profile"/></infoLinks></selectionEntry><selectionEntry id="fc19474a-889e-4ad8" name="Heavy stubber team — 2 crew" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="9dce18a8-6f5e-40f8" name="Heavy stubber" hidden="false" targetId="a215-46c9-f2b9-