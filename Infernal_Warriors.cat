ity"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Capacity 20 appropriate Infantry spaces.</characteristic></characteristics></profile><profile id="0da0-ef78-3f0d-5dc6" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">2 lascannons, missile launcher and defensive heavy bolter. Carries 20 Infantry spaces, Terminators count 2; follows Aircraft timing.</characteristic></characteristics></profile><profile id="b3e6-3ae8-3d4d-5fc8" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="882cf58a-2549-40b8" name="Passenger Manifest &amp; capacity" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Transport registration: Passenger-bearing Infantry must DECLARE this vehicle type in their Deployment / passenger assignment selection. Capacity 20 spaces; Terminators and jump-equipped passengers may use two each where permitted. Include ALL attached leaders and all squads sharing a carrier; do not exceed capacity. The catalogue records carrier TYPE, not a unique vehicle instance, so this capacity total must still be checked before play.</characteristic></characteristics></profile><profile id="64e4ae5b-d5d6-4f18-91e6-2cc2514f66ab" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: 2 lascannons, missile launcher and defensive heavy bolter. Carries 20 Infantry spaces, Terminators count 2; follows Aircraft timing. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks/><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="290.0"/></costs><selectionEntryGroups><selectionEntryGroup id="c0451710-2c1c-4cfb" name="Fixed weapons" hidden="false" collective="false" import="true" defaultSelectionEntryId="a4f4165b-52a0-492a"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d66c2b2e-7dd8-4e80" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e3271db5-da14-4135" type="max"/></constraints><selectionEntries><selectionEntry id="a4f4165b-52a0-492a" name="2 lascannons, missile launcher and defensive heavy bolter" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="f964f8e2-d12b-4383" name="Lascannon" hidden="false" targetId="9990-7a50-26b6-5af0" type="profile"/><infoLink id="95bc77ba-7177-4b57" name="Missile launcher (frag)" hidden="false" targetId="2f23-67a8-672a-56ba" type="profile"/><infoLink id="583e3a9d-9f99-4911" name="Missile launcher (krak)" hidden="false" targetId="d343-195f-5f9a-5a0e" type="profile"/><infoLink id="c5c152a2-105b-4214" name="Heavy bolter" hidden="false" targetId="72f2-bb1a-9e40-5de3" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="cdb08acb-41c4-41ae" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><