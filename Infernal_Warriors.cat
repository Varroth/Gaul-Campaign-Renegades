alse" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="8c75de1a-41b5-4979" name="Standard Reserves" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Select only when the mission allows this formation and it fits the Reserves points cap; normal later-round timing applies. This is not an automatic Deep Strike grant.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="cefc-4bd7-92dc-53ea" name="LEADER — select attached character for THIS squad (optional; 0 pts)" hidden="false" collective="false" import="true" defaultSelectionEntryId="25a4-c148-ab4c-5718"><constraints><constraint id="868c-163d-419d-5da2" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="d5d7-0935-87e3-50ea" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="25a4-c148-ab4c-5718" name="No attached Leader" hidden="false" type="upgrade" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry></selectionEntries><entryLinks><entryLink id="22f2-991d-d686-5ba9" name="Attached: Varek Thul (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="4649-6156-ebac-5fee"/></entryLinks></selectionEntryGroup></selectionEntryGroups><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="0b81-9549-c3c3-5df6" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="607f-0fa7-97c6-5716" name="Chosen Veterans" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="7835-aef5-1425-5195" name="Infantry" hidden="false" targetId="521d-dd50-6a49-58fb" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8475-4fb1-6e2a-5fab" type="max"/></constraints><profiles><profile id="dc34-887b-aa8c-5b72" name="Chosen Veterans" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">4</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="0d3d-014a-7392-5c4f" name="Veterans of Two Judgments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per phase, re-roll one melee Hit roll.</characteristic></characteristics></profile><profile id="907b-47b2-94ed-57c0" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Combi-weapons and power swords or axes. One power fist per 5. Champion may have one plasma pistol, replacing the applicable item.</characteristic></characteristics></profile><profile id="bc1c-1c87-5578-5a42" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">ARMY RULE: Infernal Serum (+1 W already applied, FNP 5+, regenerate 1 W at start of your turn). Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="b636afae-8574-4515-b63e-4ce159495b96" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Combi-weapons and power swords or axes. One power fist per 5. Champion may have one plasma pistol, replacing the applicable item. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile><profile id="fb64-1ab9-7d08-5397" name="LEADER Assignment — instance specific" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The selected attachment is local to THIS Chosen Veterans unit, allowing multiple copies of this datasheet to have different Leaders. A matching Leader must also be bought separately. Use New Recruit's native Leader association command when available; this 0-point declaration does not physically join roster entries or apply an attached Leader's rules. Older Leader-side bodyguard-type choices remain for saved roster compatibility. A bodyguard normally takes one Leader; Lost Cohort uses its mandatory separate bundled Chaplain system.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="b9ff-f6c7-28d9-59ca" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="5be7-a55f-fb31-5ad6"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7885-1bdc-82e2-581e" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="cd82-bfa2-81e5-547b" type="max"/></constraints><selectionEntries><selectionEntry id="5be7-a55f-fb31-5ad6" name="5 models" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="150.0"/></costs><selectionEntryGroups><selectionEntryGroup id="3f4be312-e2aa-40af" name="Champion 1 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="c818ff75-0791-4eb4"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="bcf74491-df14-4a04" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="22bed406-78e9-4188" type="max"/></constraints><selectionEntries><selectionEntry id="c818ff75-0791-4eb4" name="Combi-weapon, power sword/axe" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="1e5c9d4d-33de-43b7" name="Combi-weapon" hidden="false" targetId="92b7-b12f-d123-5b28" type="profile"/><infoLink id="4117fed6-6942-4328" name="Power sword / axe" hidden="false" targetId="1ec2-20f5-fe4e-5b6c" type="profile"/></infoLinks></selectionEntry><selectionEntry id="ef8746a3-9841-4711" name="Plasma pistol, power sword/axe (replaces combi-weapon)" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="f6b6c806-1cf4-429d" name="Plasma pistol" hidden="false" targetId="e195-9137-278e-53ac" type="profile"/><infoLink id="9ede3262-22b3-47e4" name="Power sword / axe" hidden="false" targetId="1ec2-20f5-fe4e-5b6c" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="f271b2a3-c402-47b9" name="Warrior 2 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="2c96c156-aa6e-414d"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="25481e75-43f4-4326" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5d73b7e5-2020-4624" type="max"/></constraints><selectionEntries><selectionEntry id="2c96c156-aa6e-414d" name="Combi-weapon, power sword/axe" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="1118dcce-8392-480f" name="Combi-weapon" hidden="false" targetId="92b7-b12f-d123-5b28" type="profile"/><infoLink id="6ecec293-bbb4-4ce2" name="Power sword / axe" hidden="false" targetId="1ec2-20f5-fe4e-5b6c" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="70eefa3d-acc5-4a3b" name="Warrior 3 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="a05d4a80-af51-4582"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1452df3d-7d29-46d6" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a727e8d8-2cef-4760" type="max"/></constraints><selectionEntries><selectionEntry id=