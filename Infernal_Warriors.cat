acteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">D6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">Auto</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Torrent, Ignores Cover</characteristic></characteristics></profile><profile id="aed2-156e-2cc7-5bfb" name="Bloodmarked Thralls heavy stubber" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">5+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy</characteristic></characteristics></profile><profile id="1515-8c32-0131-5eed" name="Chainbound Reavers autopistol" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">1</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">3</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Pistol</characteristic></characteristics></profile><profile id="d56b-0c27-37aa-5050" name="Chainbound Reavers chainaxe" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile><profile id="f367-cffa-ae00-5848" name="Chainbound Reavers power blade" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile><profile id="bb67-e09c-14a9-5c74" name="Chainbound Reavers hand flamer" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">D6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">Auto</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">3</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Torrent, Ignores Cover</characteristic></characteristics></profile></sharedProfiles><sharedSelectionEntries><selectionEntry id="9cb06d75-2acf-4d85" name="Vox of the Unforgotten" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint id="f7399dd1-33e5-4197" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="8317918c-cbb1-425b" name="Vox of the Unforgotten — selectable rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">UPGRADE — INFERNAL WARRIORS ASTARTES INFANTRY (non-Character). This unit gains VOXMASTER for Chapter command-network purposes. Command ranges measured from this unit gain 3 inches. Does not grant extra attacks or serum. [PROVISIONAL 10 pts — homebrew balancing anchor; must select the War Hounds’ Legacy detachment.]</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10.0"/></costs></selectionEntry><selectionEntry id="0e833813-82b0-4391" name="Oath-Wrought Aegis" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint id="ff253e3c-5020-4c19" type="max" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="5ba6fccc-c4f8-4782" name="Oath-Wrought Aegis — selectable rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">ENHANCEMENT — eligible generic non-Epic-Hero CHARACTER. The first time in the battle the bearer would fail a saving throw, reduce the Damage of that attack by 1 (minimum 1). [PROVISIONAL 15 pts — homebrew balancing anchor; must select the War Hounds’ Legacy detachment.]</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15.0"/></costs></selectionEntry><selectionEntry id="3028597c-2a14-4594" name="War Hounds’ Field Manual" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint id="b414059c-a207-4b92" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="38f9e078-4a56-414f" name="War Hounds’ Field Manual — selectable rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">UPGRADE — non-Character ASTARTES INFANTRY. Once per battle, immediately after your Directed Objective is destroyed during your turn, designate a different legal enemy visible to a friendly OFFICER or within 12 inches of this unit as the Directed Objective until your next Command phase. [PROVISIONAL 15 pts — homebrew balancing anchor; must select the War Hounds’ Legacy detachment.]</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15.0"/></costs></selectionEntry><selectionEntry id="5e3e475c-f411-4a7d" name="Remembrancer of Isstvan" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint id="529e5648-398b-47ea" type="max" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="c145460a-5c30-4a84" name="Remembrancer of Isstvan — selectable rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">ENHANCEMENT — eligible generic CHAPLAIN. Attached unit can re-roll its first failed Battle-shock test each battle. [PROVISIONAL 10 pts — homebrew balancing anchor; must select the War Hounds’ Legacy detachment.]</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10.0"/></costs></selectionEntry><selectionEntry id="10596293-67cd-4d0c" name="Crimson Spur" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint id="96276000-9da3-4641" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="0535cf09-8b84-4fdc" name="Crimson Spur — selectable rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">UPGRADE — non-Character JUMP PACK ASTARTES INFANTRY or MOUNTED unit. Add 1 inch to its Advance rolls only; does not increase Movement, arrival distances, or allow Advance-and-Charge. [PROVISIONAL 10 pts — homebrew balancing anchor; must select the Crimson Onslaught detachment.]</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10.0"/></costs></selectionEntry><selectionEntry id="0fbb0ee6-540b-4019" name="Pain-Sworn Standard" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint id="a2efc17b-5acc-4c77" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="0ddcc122-1918-4bb0" name="Pain-Sworn Standard — selectable rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">UPGRADE — non-Character Infernal Berzerkers unit. Once per battle ignore the first negative modifier to this unit’s melee Hit roll. [PROVISIONAL 15 pts — homebrew balancing anchor; must select the Crimson Onslaught detachment.]</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15.0"/></costs></selectionEntry><selectionEntry id="dcf44d0a-d9cb-4d92" name="The Measured Strike" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint id="4a4351ce-9d10-43c4" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="1d05ca8f-d28d-4764" name="The Measured Strike — selectable rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">UPGRADE — non-Character INFERNAL WARRIORS ASTARTES INFANTRY or MOUNTED. Once per battle this unit can re-roll one complete Charge roll (both dice). No die can be re-rolled twice, including through Shock Assault. [PROVISIONAL 15 pts — homebrew balancing anchor; must select the Crimson Onslaught detachment.]</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15.0"/></costs></selectionEntry><selectionEntry id="91c95693-8968-48ce" name="Chain of Resolve" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint id="309d5442-c40a-4428" type="max" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="c4d8e2cf-ec0a-4adb" name="Chain of Resolve — selectable rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">ENHANCEMENT — eligible generic CHAPLAIN. Friendly Infernal Berzerkers within 6 inches of this bearer improve their Leadership characteristic by 1. [PROVISIONAL 10 pts — homebrew balancing anchor; must select the Crimson Onslaught detachment.]</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10.0"/></costs></selectionEntry><selectionEntry id="46d64132-8587-4978" name="Ash-Forged Targeter" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint id="f3087ee5-6925-4358" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="95cfe857-324e-4e9c" name="Ash-Forged Targeter — selectable rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">UPGRADE — non-Character INFERNAL WARRIORS VEHICLE. Once in each of your Shooting phases, this vehicle can re-roll one ranged Hit roll. [PROVISIONAL 10 pts — homebrew balancing anchor; must select the Iron Reavers detachment.]</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10.0"/></costs></selectionEntry><selectionEntry id="7ad45c89-f78d-4044" name="Chain-Bound Governor" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint id="11c4f53b-912a-48ff" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="84e03b4c-5e79-4d40" name="Chain-Bound Governor — selectable rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">UPGRADE — non-Character INFERNAL WARRIORS DAEMON ENGINE. Once per battle this engine may re-roll one of its own failed Battle-shock tests. Does not confer serum. [PROVISIONAL 10 pts — homebrew balancing anchor; must select the Iron Reavers detachment.]</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10.0"/></costs></selectionEntry><selectionEntry id="3d76ca65-fda8-441c" name="Pattern Reliquary" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint id="8f6f400e-2514-4011" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="2a33dcff-d651-4d6c" name="Pattern Reliquary — selectable rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">UPGRADE — non-Character Forge Servitor Cohort. Once per battle, when Hadrak Voss repairs a friendly Vehicle within 3 inches of this Cohort, increase that repair by 1 lost wound (up to its starting Wounds). Does not stack with Maintenance Crew on that repair. [PROVISIONAL 20 pts — homebrew balancing anchor; must select the Iron Reavers detachment.]</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20.0"/></costs></selectionEntry><selectionEntry id="a845f21f-a955-4fbb" name="Siege Ledger" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint id="b443e25d-7ef0-409b" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="e71d95d5-f834-49a4" name="Siege Ledger — selectable rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">UPGRADE — non-Character INFERNAL WARRIORS ARTILLERY. Once in each of your Shooting phases this unit may re-roll one Wound roll against a target receiving Benefit of Cover. [PROVISIONAL 10 pts — homebrew balancing anchor; must select the Iron Reavers detachment.]</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10.0"/></costs></selectionEntry><selectionEntry id="214b488b-9259-46a2" name="Breachmaster’s Seal" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint id="d27c1e1e-f05a-4701" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="32766e24-7f18-4d35" name="Breachmaster’s Seal — selectable rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">UPGRADE — non-Character INFERNAL WARRIORS TERMINATOR unit. Add 1 to this unit’s Battle-shock tests. Does not replace its Lost Cohort Chaplain or affect Cohort Control tests. [PROVISIONAL 10 pts — homebrew balancing anchor; must select the Breach and Ruin detachment.]</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10.0"/></costs></selectionEntry><selectionEntry id="7c722648-8408-4e86" name="Void-Tempered Ward" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint id="6d661764-f7c9-4f67" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="98f35379-c274-428d" name="Void-Tempered Ward — selectable rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">UPGRADE — non-Character INFERNAL WARRIORS VOID BREACHERS unit. Once per battle, when this unit fails a saving throw, treat that ONE saving throw as successful before applying damage. [PROVISIONAL 15 pts — homebrew balancing anchor; must select the Breach and Ruin detachment.]</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15.0"/></costs></selectionEntry><selectionEntry id="ccfc75ff-fece-4985" name="Dismantler’s Charge" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint id="b0b534f2-6f5b-4f30" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="3356787d-c49e-4252" name="Dismantler’s Charge — selectable rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">UPGRADE — non-Character VOID BREACHERS or TERMINATOR. Designate a model and one of its melee weapons; increase that weapon’s Strength by 1. [PROVISIONAL 10 pts — homebrew balancing anchor; must select the Breach and Ruin detachment.]</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10.0"/></costs></selectionEntry><selectionEntry id="45cfb8d5-41c7-487f" name="Sunderer of Gates" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint id="540209e9-59d1-4de8" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="4e6f4aa5-d390-45eb" name="Sunderer of Gates — selectable rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">UPGRADE — non-Character VOID BREACHERS or SIEGE INFANTRY. Once during its Shooting or Fight phase, this unit may re-roll ONE Wound roll against an enemy FORTIFICATION. [PROVISIONAL 10 pts — homebrew balancing anchor; must select the Breach and Ruin detachment.]</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10.0"/></costs></selectionEntry><selectionEntry id="01302dab-0ff7-4eed" name="MARKER: Void Assault Insertion" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="24c5610a-e1c5-4985" name="Void Assault Insertion" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per army when Breach and Ruin is selected, one eligible non-Lost Cohort ordinary power-armoured Astartes Infantry unit gains Deep Strike at no cost, including qualifying attached Leader. Normal mission restrictions remain.</characteristic></characteristics></profile></profiles><constraints><constraint id="4e5243b4-34ee-4701" type="max" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints></selectionEntry><selectionEntry id="690e6cd7-0fd3-469d" name="MARKER: Legion Assault Requisition" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="8ca8a2bf-e4f8-4667" name="Legion Assault Requisition" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use one discounted eligible transport, 1 per full 1,000 army points, maximum 2 at 2,000; MUST begin with an eligible full infantry formation embarked, may not carry a unit also using Void/Cohort Insertion.</characteristic></characteristics></profile></profiles><constraints><constraint id="e52fe67b-0d1a-486b" type="max" field="selections" scope="roster" value="2" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><modifiers><modifier type="set" field="e52fe67b-0d1a-486b" value="1"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="47db8214-8de1-4efd" name="MARKER: Mechanised Vanguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="3cd58a24-426e-475e" name="Mechanised Vanguard" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One eligible non-AIRCRAFT transport with infantry embarked may pre-game move up to 3 inches if mission permits. Maximum one per full 1,000-point battle limit, maximum 2.</characteristic></characteristics></profile></profiles><constraints><constraint id="4bef6eca-4eda-41ba" type="max" field="selections" scope="roster" value="2" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><modifiers><modifier type="set" field="4bef6eca-4eda-41ba" value="1"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="442d74e2-b162-4b3a" name="MARKER: Combined Lost Cohort slot" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><constraints><constraint id="234d147b-727a-4702" type="max" field="selections" scope="roster" value="2" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="729cbc15-b3aa-40b5" name="MARKER: Combined Lost Cohort slot" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each selected Lost Cohort squad consumes ONE of TWO total slots, regardless of whether it wears power or Terminator armour; Chaplain requirement is separate and already bundled.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="79346c0a-ede2-4066" name="MARKER: Named Orvath Krail (unique)" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><constraints><constraint id="844a133c-f33a-4ff9" type="max" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="ed3ef0ef-5a84-424d" name="MARKER: Named Orvath Krail (unique)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One Orvath Krail in the entire roster, whether selected as a standalone paid named character or bundled into Lost Cohort formation points.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="e0fd-7fee-ff4a-5e3e" name="ASSIGNMENT TOKEN — Azrakh Drenn" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><constraints><constraint id="642b-b873-8993-5dd0" type="max" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="b515-1bfc-f196-5d82" name="Leader assignment (declaration only)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach already purchased Azrakh Drenn to this precise bodyguard unit. This is NOT a free Character or a native association. The named Leader can be declared on at most one squad in the roster; validate actual Leader presence and the New Recruit client association in the roster checker.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="4e2e-770b-89ed-5e62" name="ASSIGNMENT TOKEN — Balan Bannon" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><constraints><constraint id="cae1-cf45-f2fb-5b64" type="max" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="133d-40f9-c503-5e52" name="Leader assignment (declaration only)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach already purchased Balan Bannon to this precise bodyguard unit. This is NOT a free Character or a native association. The named Leader can be declared on at most one squad in the roster; validate actual Leader presence and the New Recruit client association in the roster checker.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7198-a73c-d688-5b38" name="ASSIGNMENT TOKEN — Dravik Sorn" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><constraints><constraint id="4ec3-a82f-514d-5f57" type="max" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="47d7-1f7c-b513-5e87" name="Leader assignment (declaration only)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach already purchased Dravik Sorn to this precise bodyguard unit. This is NOT a free Character or a native association. The named Leader can be declared o