/entryLinks></selectionEntryGroup></selectionEntryGroups><profiles><profile id="2948ef98-bea7-4b9c-9ccd-6b14f003e465" name="Preset — Melta Specialists" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Preselected at muster, but each model/equipment group remains editable. No extra point cost. Choose ONE weapon family: All 10: melta. All equipment restrictions and the original unit ability still apply.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="dc4a5f9f-91d0-4749" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><constraints><constraint id="4912f7c1-a738-4b1d" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><entryLinks><entryLink id="6635302b-2f3e-452b" name="Vox of the Unforgotten (+10 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="9cb06d75-2acf-4d85"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="8eb0-8d1d-a832-5447" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="2de11288-d698-41c6" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink><entryLink id="ed285b54-ce7b-49cf" name="War Hounds’ Field Manual (+15 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="3028597c-2a14-4594"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1"