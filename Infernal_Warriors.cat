infoLink id="21534ad0-36cf-4351-86a0-205e8b44d82a" name="Autocannon" hidden="false" targetId="bab9-db31-01d9-5507" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="3987b9c0-dab2-498f-b090-6da1e07e2d2d" name="Deployment / passenger assignment (one declared plan)" hidden="false" collective="false" import="true" defaultSelectionEntryId="f5b189ad-9082-4b44-b059-054847715bfe"><constraints><constraint id="8e5318e1-7da7-4840-82c8-286b112e3e39" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="54dfb79b-b4fa-49d7-8866-1739ddca6349" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="f5b189ad-9082-4b44-b059-054847715bfe" name="Deployed on the battlefield (normal)" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="498bee33-2a87-4f73-b001-da5cc741e84f" name="Standard Strategic Reserves (mission restrictions)" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="1da82d49-2c03-4b5b-8d67-f583894cb5f6" name="Standard Reserves" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Select only when the mission allows this formation and it fits the Reserves points cap; normal later-round timing applies. This is not an automatic Deep Strike grant.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><profiles><profile id="801639f3-e935-4dbb-985e-db852a86ed03" name="Preset — Autocannon Screen" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Preselected at muster, but each model/equipment group remains editable. No extra point cost. Team 2: Autocannon team — 2 crew; Team 3: Autocannon team — 2 crew; Team 4: Autocannon team — 2 crew; Team 5: Autocannon team — 2 crew; Team 6: Autocannon team — 2 crew; Champion 1: Autocannon team — 2 crew. All equipment restrictions and the original unit ability still apply.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="1b1e-69a9-529f-5dee" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="89f0-698e-b637-5ce5" name="Forge Servitor Cohort" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="69e9-16c3-5dfd-5380" name="Mortal Auxilia" hidden="false" targetId="93a3-7ba9-2915-5ea2" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="860b-b251-3c96-5f0d" type="max"/></constraints><profiles><profile id="14e8-b9e2-4574-5ade" name="Forge Servitor Cohort" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">5"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">4+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">1</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">8+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="1816-5378-9362-5790" name="Maintenance Crew" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">When within 3 inches of Hadrak Voss, increase one eligible vehicle repair from 1 to 2 restored wounds, once per battle. This unit is a mortal servitor formation with OC 1 per model; it receives NO Infernal Serum.</characteristic></characteristics></profile><profile id="0ba3-58a2-1819-5eff" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">4–8 servitors, servo-arm and industrial tool; one in 4 may take heavy bolter. OC 1 each; no serum. Maintenance Crew repairs as written.</characteristic></characteristics></profile><profile id="fb5e-68df-0159-5028" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="ae246e0a-a542-56fa" name="Repair / objective clarification" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">M5, OC1 each; 4 servitors cost 50 points. No serum, no induction. Maintenance Crew requires Hadrak Voss and improves one vehicle repair from 1 to 2 wounds once/battle.</characteristic></characteristics></profile><profile id="84297623-cf88-4e8e-9236-b6f19d60bbcc" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: 4–8 servitors, servo-arm and industrial tool; one in 4 may take heavy bolter. OC 1 each; no serum. Maintenance Crew repairs as written. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks>
        </infoLinks><selectionEntryGroups><selectionEntryGroup id="e756-3cd7-902d-5748" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="eede-b515-ebc5-5678"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2cbc-edf3-5ed3-5f50" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e9aa-350e-6f80-56cc" type="max"/></constraints><selectionEntries><selectionEntry id="eede-b515-ebc5-5678" name="4 models" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="50.0"/></costs><selectionEntryGroups><selectionEntryGroup id="f6ff735f-5b5a-43e8" name="Champion 1 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="3aeb0694-4895-4197"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f3938d90-c0da-498b" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3b01ab21-670c-4f9f" type="max"/></constraints><selectionEntries><selectionEntry id="3aeb0694-4895-4197" name="Servo-arm and industrial tools" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="7b2ee22f-870d-463a" name="Servo-arm" hidden="false" targetId="e241-e18b-6638-58e7" type="profile"/><infoLink id="8e359aaa-b108-4442" name="Close-combat weapon" hidden="false" targetId="953b-aa30-035d-5d4d" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="322ea9b4-c816-4ddb" name="Warrior 2 — choose exact wargear" hidden=