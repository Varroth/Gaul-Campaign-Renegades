/profile><profile id="1d8a-2def-40a4-5f87" name="Mobile Spear" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Re-roll one Hit roll after charging.</characteristic></characteristics></profile><profile id="6f0f-47b2-68bb-552e" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each bike has twin boltguns or assault bolter; rider has power blade and bolt pistol. One plasma pistol per 3 models.</characteristic></characteristics></profile><profile id="c55f-b3da-2c89-55d8" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">ARMY RULE: Infernal Serum (+1 W already applied, FNP 5+, regenerate 1 W at start of your turn). Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="c44e3b0f-20d9-4956-9cf7-9af67231dce5" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Each bike has twin boltguns or assault bolter; rider has power blade and bolt pistol. One plasma pistol per 3 models. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="614b-8762-618f-5982" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="81f1-572f-617a-55c2"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5d65-7532-4454-5a6c" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="bf38-3db6-fcb5-50b0" type="max"/></constraints><selectionEntries><selectionEntry id="81f1-572f-617a-55c2" name="3 models" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="110.0"/></costs><selectionEntryGroups><selectionEntryGroup id="d022d42c-e348-44bf" name="Champion 1 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="a41e0218-e5b0-45f5"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="90f2df56-8ae7-489b" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="729325c1-068b-447b" type="max"/></constraints><selectionEntries><selectionEntry id="a41e0218-e5b0-45f5" name="Twin boltguns, power blade, bolt pistol" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="bcf25ba4-a49d-4c0e" name="Twin boltguns" hidden="false" targetId="a9e88573-894b-59a1" type="profile"/><infoLink id="fa721143-12f6-4094" name="Power sword / axe" hidden="false" targetId="1ec2-20f5-fe4e-5b6c" type="profile"/><infoLink id="2b7d8693-bb1d-4f3c" name="Bolt pistol" hidden="false" targetId="19be-3f27-bea8-5ca4" type="profile"/></infoLinks></selectionEntry><selectionEntry id="daac8dd0-8c8a-407c" name="Assault bolter, power blade, bolt pistol" hidden="false" collective="false" type="upgrade" import="true"><i