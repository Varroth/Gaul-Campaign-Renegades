e="selectionEntry" targetId="66ab-dd75-ddad-5377"/><entryLink id="ecfd-375f-1213-5cf8" name="Attached: Dravik Sorn (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="7198-a73c-d688-5b38"/><entryLink id="3213-3ba3-94d2-5952" name="Attached: Torgath Keld (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="5618-72fb-f2c8-5f8c"/><entryLink id="3cb5-4d61-4fae-502f" name="Attached: Orvath Krail (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="6b96-35a6-1a55-5b0a"/><entryLink id="9dc3-fc21-2287-58b1" name="Attached: Istran Valcor (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="23c7-8026-b34f-5370"/><entryLink id="83f9-b6cc-8d0e-5c7a" name="Attached: Tervan Khol (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="a6a9-d08e-553c-543e"/><entryLink id="a769-940c-1846-5a53" name="Attached: Mordren Vhal (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="8499-66ca-f63f-5fa4"/><entryLink id="d09e-f057-01ea-55c8" name="Attached: Rhazdan Krell (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="2017-314b-8d6e-5530"/></entryLinks></selectionEntryGroup></selectionEntryGroups><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><infoLinks><infoLink id="b5eb-cce8-8f2b-58f1" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="ff89-546f-b73a-54c0" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="3f8e-252a-3d09-57ee" name="Warp-Aggravated Pain" hidden="false" targetId="1ed1-86a9-2d02-5af3" type="rule"/><infoLink id="4086-b33c-0228-5773" name="Rare Psychic-Induced Psychosis" hidden="false" targetId="8da3-eead-cabf-56ea" type="rule"/></infoLinks><modifiers><modifier type="set" field="8475-4fb1-6e2a-5fab" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="94a9-92d2-523d-5d8b" name="Infernal Butchers" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="cf6d-9752-0375-5113" name="Infantry" hidden="false" targetId="521d-dd50-6a49-58fb" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c17e-3940-3d33-5736" type="max"/></constraints><profiles><profile id="604b-439a-af1e-5fb6" name="Infernal Butchers" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">4</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="8fed-492c-fe46-5599" name="Butcher’s Precision" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Re-roll one failed melee Wound roll against enemy elite Infantry.</characteristic></characteristics></profile><profile id="3878-4262-4735-544e" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Heavy two-handed chainaxes and bolt pistols; up to 2 power fists per 5 may replace axes. No daemon fusion.</characteristic></characteristics></profile><profile id="dbfd-05de-ea27-5548" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">ARMY RULE: Infernal Serum (+1 W already applied, FNP 5+, regenerate 1 W at start of your turn). Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="84f63b16-fa75-419e-94a8-6b519cdc2e0e" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Heavy two-handed chainaxes and bolt pistols; up to 2 power fists per 5 may replace axes. No daemon fusion. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile><profile id="9432-b678-0c8e-57ea" name="LEADER Assignment — instance specific" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The selected attachment is local to THIS Infernal Butchers unit, allowing multiple copies of this datasheet to have different Leaders. A matching Leader must also be bought separately. Use New Recruit's native Leader association command when available; this 0-point declaration does not physically join roster entries or apply an attached Leader's rules. Older Leader-side bodyguard-type choices remain for saved roster compatibility. A bodyguard normally takes one Leader; Lost Cohort uses its mandatory separate bundled Chaplain system.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="e161-3497-9519-538c" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="7e50-bba2-87ae-5df1"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d2f1-73ea-a69e-5359" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b64a-cdd7-fe39-5edc" type="max"/></constraints><selectionEntries><selectionEntry id="7e50-bba2-87ae-5df1" name="5 models" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="175.0"/></costs><selectionEntryGroups><selectionEntryGroup id="6b082252-9560-4858" name="Champion 1 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="617d343f-0be7-4afa"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5b9bf6c2-cfe0-49ea" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="abac4af7-b7b2-4422" type="max"/></constraints><selectionEntries><selectionEntry id="617d343f-0be7-4afa" name="Heavy chainaxe, bolt pistol" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="bb10cead-b079-4650" name="Chainaxe" hidden="false" targetId="6adf-461d-bedd-589d" type="profile"/><infoLink id="0b22f797-ba72-4f1b" name="Bolt pistol" hidden="false" targetId="19be-3f27-bea8-5ca4" type="profile"/></infoLinks></selectionEntry></selectionEntries