teristic></characteristics></profile><profile id="4bab-d9f6-090b-5729" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="da9fb409-b5f2-47cb-a3a7-e8fb3e07974d" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Whirlwind rocket launcher and combi-bolter. Indirect Fire as printed; no assumption of enemy visibility. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks/><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="160.0"/></costs><selectionEntryGroups><selectionEntryGroup id="d545b8d8-c1e0-454a" name="Fixed weapons" hidden="false" collective="false" import="true" defaultSelectionEntryId="508f2b9d-7746-4852"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c9c9daad-019e-4dab" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c6114824-19a1-4d34" type="max"/></constraints><selectionEntries><selectionEntry id="508f2b9d-7746-4852" name="Whirlwind rocket launcher + combi-bolter" hidden="false" collective="false" type="upgrade" import="