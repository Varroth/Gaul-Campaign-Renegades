1c0" name="Bloodmarked Thralls flamer" hidden="false" targetId="4690-e90b-2b32-5305" type="profile"/><infoLink id="79c8-0beb-e05e-5313" name="Bloodmarked Thralls crude blade" hidden="false" targetId="44bc-1acd-66d1-5719" type="profile"/></infoLinks></selectionEntry><selectionEntry id="bea1-c298-a311-546c" name="1 Thrall — heavy stubber and crude blade" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="31cf-d936-eb49-5f32" name="Bloodmarked Thralls heavy stubber" hidden="false" targetId="aed2-156e-2cc7-5bfb" type="profile"/><infoLink id="aaea-8d5f-b263-580b" name="Bloodmarked Thralls crude blade" hidden="false" targetId="44bc-1acd-66d1-5719" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="8a55-fca2-7f50-59f1" name="Bloodletter Invocation — optional planned invoker (0 pts)" hidden="false" collective="false" import="true"><constraints><constraint id="7a34-4730-398f-5ed8" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="370c-0255-e680-5fc3" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><entryLinks><entryLink id="321b-252c-f99c-5425" name="Plan Invocation with this Thralls squad (once per army)" type="selectionEntry" targetId="47c8-bd23-8037-56ab" hidden="false" collective="false" import="true"/></entryLinks></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="a0b6-a03e-428d-5001" name="Chainbound Reavers" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="8e01-5959-6529-554e" name="Mortal Auxilia" hidden="false" targetId="93a3-7ba9-2915-5ea2" primary="true"/></categoryLinks><constraints><constraint id="7e58-dd5a-cb7b-5874" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max"/></constraints><profiles><profile id="e9f5-8d67-ab91-593b" name="Chainbound Reavers" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">3</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">5+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">1</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="7d96-e938-3812-5308" name="Blood-Earned Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per turn, when this unit makes a Charge roll against an enemy unit within range of an objective marker, it may re-roll ONE die of that Charge roll. A die cannot be re-rolled more than once.</characteristic></characteristics></profile><profile id="90db-937c-aa8f-594e" name="Proven Blades" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once in each Fight phase when this unit fights, it may re-roll ONE Hit roll for one of its melee attacks, whether or not friendly Astartes are nearby.</characteristic></characteristics></profile><profile id="0240-2969-c3e6-58c9" name="Unit composition / selectable wargear" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">5–10 Chainbound Reavers including ONE Reaver Champion. Each carries an autopistol and chainaxe; Champion may replace chainaxe with power blade. For every full five models, one Reaver may replace autopistol with a hand flamer (including Champion). Champion variants handle the cap without double-counting. Units of 5 cost 55 pts; 10 cost 110 pts. Intermediate-size points follow existing codex proportional-up-to-5 scaling.</characteristic></characteristics></profile><profile id="4313-356c-c30e-5775" name="Mortal war-host / keyword restrictions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Keywords: INFANTRY, MORTALS, INFERNAL WARRIORS, CHAINBOUND REAVERS. Neither INFANTRY MORTALS unit has ASTARTES; no Infernal Serum (no +1 Wound, Feel No Pain 5+, or regeneration), no ASTARTES-only rules. Not Khorne Daemon allies; these are Infernal Warriors mortal entries.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="3f96-60e2-ba73-52dc" name="Mortal War-Host and Blood Rites" hidden="false" type="rule" targetId="b0a7-02c8-f70c-54d4"/></infoLinks><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><selectionEntryGroups><selectionEntryGroup id="36db-6af8-2707-5bae" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="9abe-1d85-c327-5944"><constraints><constraint id="29d2-679e-7a0d-5dc1" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/><constraint id="c79c-5b72-1834-56be" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><selectionEntries><selectionEntry id="9abe-1d85-c327-5944" name="5 models — Champion autopistol — 55 pts" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="55.0"/></costs><selectionEntryGroups><selectionEntryGroup id="6112-a3c0-7e5f-5221" name="Reaver Champion — choose melee weapon" hidden="false" collective="false" import="true" defaultSelectionEntryId="624b-28e0-dde9-59a0"><constraints><constraint id="e793-fe3c-2439-53d6" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/><constraint id="f9ce-0d5f-cfe2-5404" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><selectionEntries><selectionEntry id="624b-28e0-dde9-59a0" name="Champion: autopistol and chainaxe" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="dcfa-ab1f-2ef4-55fa" name="Chainbound Reavers autopistol" hidden="false" targetId="1515-8c32-0131-5eed" type="profile"/><infoLink id="e6d3-edee-642e-5304" name="Chainbound Reavers chainaxe" hidden="false" targetId="d56b-0c27-37aa-5050" type="profile"/></infoLinks></selectionEntry><selectionEntry id="13a7-e20e-aef6-5d1b" name="Champion: autopistol and power blade" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="cbd3-9b0d-bf8f-5d77" name="Chainbound Reavers autopistol" hidden="false" targetId="1515-8c32-0131-5eed" type="profile"/><infoLink id="5b92-c46d-0d4f-506b" name="Chainbound Reavers power blade" hidden="false" targetId="f367-cffa-ae00-5848" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="665f-33ca-f0a3-5116" name="Regular Reavers — fixed weapons" hidden="false" collective="false" import="true" defaultSelectionEntryId="4ea5-eb67-398b-5356"><constraints><constraint id="b318-b5c7-4ac6-513b" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/><constraint id="b69f-448f-568d-5ad9" type="max" field="selections" scope="parent" val