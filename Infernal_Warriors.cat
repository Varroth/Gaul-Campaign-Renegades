p><selectionEntryGroup id="afa8922a-2d87-42c1" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><constraints><constraint id="132751c3-3691-4167" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><entryLinks><entryLink id="a1a8282e-5dac-4527" name="Vox of the Unforgotten (+10 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="9cb06d75-2acf-4d85"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="8eb0-8d1d-a832-5447" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="2de11288-d698-41c6" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink><entryLink id="bfa59738-8205-4c5e" name="War Hounds’ Field Manual (+15 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="3028597c-2a14-4594"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="8eb0-8d1d-a832-5447" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="96ec7e6c-cb3a-47cd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink><entryLink id="f8e8cbff-ad85-4a61" name="The Measured Strike (+15 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="dcf44d0a-d9cb-4d92