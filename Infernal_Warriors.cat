5d1-5780">6</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="3259-a8e7-312c-52ec" name="Forward Observer" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle round when a visible enemy within 18 inches is targeted by friendly INFERNAL WARRIORS, re-roll ONE ranged Hit roll of the attacking unit.</characteristic></characteristics></profile><profile id="06f4-7e91-fddb-57f8" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Heavy bolter or multi-melta; optional scanner replacement assault cannon OR Typhoon launcher (one additional main gun max). No transport capacity.</characteristic></characteristics></profile><profile id="757e-293f-f822-5e08" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="257a5de9-7315-4365-880c-1be6e08216a1" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Heavy bolter or multi-melta; optional scanner replacement assault cannon OR Typhoon launcher (one additional main gun max). No transport capacity. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks>
        </infoLinks><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="90.0"/></costs><selectionEntryGroups><selectionEntryGroup id="f5f56a60-b9c0-427a" name="Primary gun" hidden="false" collective="false" import="true" defaultSelectionEntryId="afe6380d-30ec-4a55"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f8410c21-2a7f-4f6c" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d3a7c36f-795c-4f5b" type="max"/></constraints><selectionEntries><selectionEntry id="afe6380d-30ec-4a55" name="Heavy bolter" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="2e687d9b-4850-4df7" name="Heavy bolter" hidden="false" targetId="72f2-bb1a-9e40-5de3" type="profile"/></infoLinks></selectionEntry><selectionEntry id="5e292358-b570-48a0" name="Multi-melta" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="ce5f7017-6b56-4f17" name="Multi-melta" hidden="false" targetId="4711-5a8c-ab44-5573" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="a4cc4aec-80f1-4a03" name="Optional scanner replacement" hidden="false" collective="false" import="true"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8b033d53-0f16-4193" type="max"/></constraints><selectionEntries><selectionEntry id="a8509d05-f055-4523" name="Assault cannon" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="42ee11d3-c6ab-446a" name="Assault cannon" hidden="false" targetId="bc4e-169a-420b-58ce" type="profile"/></infoLinks></selectionEntry><selectionEntry id="eb309056-31fa-4c20" name="Typhoon missile launcher (