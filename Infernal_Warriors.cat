in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries><entryLinks><entryLink id="76d51e2b-2294-48ca-90ad-ab21959dd57d" name="Void Assault Insertion — Breach and Ruin (one per army)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="01302dab-0ff7-4eed"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="b7ad-18e3-9d4d-57e1" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup></selectionEntryGroups><profiles><profile id="7ea306f5-393b-4334-9366-7fc9850bfcfc" name="Preset — Anti-Armour Lascannons" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Preselected at muster, but each model/equipment group remains editable. No extra point cost. Choose ONE weapon family: All 10: lascannon. All equipment restrictions and the original unit ability still apply.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="c5110a6f-e6ef-4fba" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><constraints><constraint id="8979f46a-5b1f-4bde" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><entryLinks><entryLink id="bc043469-edc9-497e" name="Vox of the Unforgotten (+10 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="9cb06d75-2acf-4d85"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="8eb0-8d1d-a832-5447" shared="true" includeChi