"52fee7ba-5ef8-5737" type="rule"/></infoLinks><modifiers><modifier type="set" field="ebe8-7396-cb39-5676" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="bb4f-e220-481b-5f99" name="Herald of Khorne" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="49d5-f566-2740-5ead" name="Khorne Allies" hidden="false" targetId="471b-b5c6-68a0-523c" primary="true"/><categoryLink id="b250-25a9-7279-5f7d" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="false"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="132d-c26d-d235-58db" type="max"/></constraints><profiles><profile id="a724-1346-c13f-50b0" name="Herald of Khorne" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">4+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">5</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="d32b-39d4-fcd6-572e" name="Banner of Skulls" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Nearby Bloodletters may re-roll one melee Hit roll per turn.</characteristic></characteristics></profile><profile id="591a-b52b-3ffc-552a" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Hellblade and icon; only provisional Khorne ally module, may lead Bloodletters, never Lost Cohort.</characteristic></characteristics></profile><profile id="9304-b517-1412-5725" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Only permitted allied Khorne daemons, ≤25% of army points (manual cap). Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="a4e741a0-b744-41e9-9fc5-66dee848a02e" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Hellblade and icon; only provisional Khorne ally module, may lead Bloodletters, never Lost Cohort. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="fb96-a352-9997-59f1" name="Khorne Ally Allowance" hidden="false" targetId="3ecd-6609-5f42-5166" type="rule"/><infoLink id="5eb2472a-9b01-5584" name="Khorne Daemon Allies" hidden="false" targetId="52fee7ba-5ef8-5737" type="rule"/></infoLinks><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="90.0"/></costs><selectionEntryGroups><selectionEntryGroup id="0b735932-f3b6-4b8f" name="Wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="b6fcf3ca-6457-4e59"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="75bff922-8d5a-4e3d" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="80cd802b-693c-4061" type="max"/></constraints><selectionEntries><selectionEntry id="b6fcf3ca-6457-4e59" name="Hellblade and Icon of Khorne" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="3103a37e-0825-4d63" name="Hellblade" hidden="false" targetId="718e-d420-cd9b-5f63" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><modifiers><modifier type="set" field="132d-c26d-d235-58db" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="38ad-d981-9e57-5f58" name="Bloodthirster" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="ba6d-e74f-650c-5633" name="Khorne Allies" hidden="false" targetId="471b-b5c6-68a0-523c" primary="true"/><categoryLink id="12fe-d327-9408-5c00" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="false"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0d09-af7f-e779-5269" type="max"/></constraints><profiles><profile id="f53c-8969-d206-57d3" name="Bloodthirster" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">12"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">11</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">4+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">18</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">5</characteristic></characteristics></profile><profile id="936d-79ee-3d64-57af" name="Greater Daemon" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, re-roll both dice of a single Charge roll.</characteristic></characteristics></profile><profile id="afb5-9721-ad11-5b50" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Great axe of Khorne and Hellfire whip. No Serum.</characteristic></characteristics></profile><profile id="b272-4c74-944c-5ef0" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Only permitted allied Khorne daemons, ≤25% of army points (manual cap). Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="233d332a-fbaf-41ff-9a32-d44b719468c6" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Great axe of Khorne and Hellfire whip. No Serum. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="86b5-8c96-67b9-5acc" name="Khorne Ally Allowance" hidden="false" targetId="3ecd-6609-5f42-5166" type="rule"/><infoLink id="406b67a9-8598-53bb" name="Khorne Daemon Allies" hidden="false" targetId="52fee7ba-5ef8-5737" type="rule"/></infoLinks><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="350.0"/></costs><selectionEntryGroups><selectionEntryGroup id="176a5327-250e-476a" name="Wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="248893fd-81a6-4474"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2e6a9d5b-36df-4f59" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0099c59e-2ad3-4258" type="max"/></constraints><selectionEntries><selectionEntry id="248893fd-81a6-4474" name="Great axe of Khorne and Hellfire whip" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="4bec2881-1c93-406f" name="Great axe of Khorne" hidden="false" targetId="9b41-6dc8-73f1-5618" type="profile"/><infoLink id="89ea4374-993b-4070" name="Hellfire whip" hidden="false" targetId="0fcc5e8a-177d-5b33" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><modifiers><modifier type="set" field="0d09-af7f-e779-5269" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="f47c-0ff1-c265-51e8" name="Balan Bannon" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="180.0"/></costs><categoryLinks><categoryLink id="c3cc-30c7-8727-5f12" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f8db-0e05-fbb9-57eb" type="max"/></constraints><profiles><profile id="aa1e-31b0-968c-5890" name="Balan Bannon" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">9</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">3</characteristic></characteristics></profile><profile id="1a0f-c082-2c4e-5c9a" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Maul of Infinite Rage, hand flamer; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="b323-4829-14e3-5b42" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Warmaster of the Twice-Condemned: once/turn a friendly Astartes within 9" re-rolls one Hit and one Wound against Directed Objective; Judgment of Fire: once/battle after charge an engaged enemy takes Battle-shock. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="d227cded-fd41-5549" name="Warmaster of the Twice-Condemned" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per turn select a friendly INFERNAL WARRIORS ASTARTES unit within 9 inches. Against the Directed Objective, it may re-roll ONE Hit roll and ONE Wound roll.</characteristic></characteristics></profile><profile id="8dcfaed1-1857-55d4" name="Judgment of Fire" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, after Bannon makes a successful melee charge, select one enemy unit he engaged; it must take a Battle-shock test.</characteristic></characteristics></profile><profile id="ab1c40cf-cba3-596e" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Infernal Legionaries; Chosen Veterans; Infernal Berzerkers; Infernal Butchers. A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="e3393abc-a04b-4806" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="35bdc9fd-1f82-4325-8505-4132b8019c64" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Infernal Legionaries, Chosen Veterans, Infernal Berzerkers, Infernal Butchers. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="bebbb184-c358-403c-ab10-3cec4190f768" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Maul of Infinite Rage, hand flamer; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="e11f-b23b-7119-5171" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="ffc1-2606-daff-5521" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="ac3e1581-d877-517c" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="6775458e-6f86-5f65" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="220acc63-3c44-4cf5-8f34-deca2c4963a4" name="Leader Eligibility" hidden="false" type="rule" targetId="2adf0699-3369-4040-8ff5-7139af7a314e"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="ae240936-e4e7-4b93" name="Relic weapons" hidden="false" collective="false" import="true" defaultSelectionEntryId="8eb7b815-a4ea-4af4"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="04b7c226-6198-4a36" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="cd234e03-718a-46cc" type="max"/></constraints><selectionEntries><selectionEntry id="8eb7b815-a4ea-4af4" name="Maul of Infinite Rage and hand flamer" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="68237573-3c4e-4cac" name="Maul of Infinite Rage" hidden="false" targetId="5ea8-46af-28a1-56ae" type="profile"/><infoLink id="7f96ccc6-a620-4471" name="Hand flamer" hidden="false" targetId="6f8c-690e-fb73-57bc" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="4bbd5f5b-be66-47df" name="Legacy bodyguard TYPE reference (optional; use bodyguard-side assignment)" hidden="false" collective="false" import="true" defaultSelectionEntryId="36673129-06a5-49e1"><constraints><constraint id="a9fb0aca-af61-41d0" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="a415d1ad-1b12-4f26" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="36673129-06a5-49e1" name="Independent / no attached bodyguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="0e60af30-73d1-48bd" name="Attach to: Infernal Legionaries" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="cedb-da92-81b0-5a8c" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="f66a01ed-bc97-42bc" name="Leader attachment — Balan Bannon" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Infernal Legionaries squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8f029a34-19a4-49fa" name="Attach to: Chosen Veterans" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="607f-0fa7-97c6-5716" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="e2d459cf-1d75-4c0c" name="Leader attachment — Balan Bannon" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Chosen Veterans squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="bebcc52d-20fa-4a8f" name="Attach to: Infernal Berzerkers" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="e17a-942c-38f0-5f23" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="03c9ad20-1020-42f9" name="Leader attachment — Balan Bannon" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Infernal Berzerkers squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="e5162b72-2b2a-4807" name="Attach to: Infernal Butchers" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="94a9-92d2-523d-5d8b" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="d6923378-ad80-470e" name="Leader attachment — Balan Bannon" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Infernal Butchers squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="0746-a8b2-e0d7-58d2" name="Varroth" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="155.0"/></costs><categoryLinks><categoryLink id="037e-6569-f041-5384" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/><categoryLink id="ab12-b41f-3a38-5790" name="Terminators" hidden="false" targetId="c317-a497-01c6-5b78" primary="false"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b712-c284-2522-5381" type="max"/></constraints><profiles><profile id="3319-6019-4b1d-50ab" name="Varroth" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">5"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">6</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">8</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="1a3f-9564-f196-58f8" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Woe-Maker (Varroth), storm bolter; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="b903-67d7-223c-5677" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Veteran of Diesor II: first fatal hit on 5+ survives at 1W; Ashen Chain Commander: led Terminator unit re-rolls one charge die when arriving from reserves; Deep Strike. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="1018be53-6ff5-517f" name="Veteran of Diesor II" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The first time each battle Varroth would be destroyed, roll one D6. On 5+, he instead survives with 1 wound.</characteristic></characteristics></profile><profile id="4321baff-f198-5fb1" name="Ashen Chain Commander" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">A Terminator unit led by Varroth may re-roll ONE Charge die when arriving from Reserves.</characteristic></characteristics></profile><profile id="9d8455eb-be2e-5075" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Ashen Chain Terminators; Cataphractii Terminator Veterans; Tartaros Terminator Veterans. A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="26b3a6e6-096d-4da2" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="7bcf96e7-1a7b-4165-a17a-35b4a3b3e730" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Ashen Chain Terminators, Cataphractii Terminator Veterans, Tartaros Terminator Veterans. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="31eab90b-e4e2-4f5b-8101-95d005071291" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Woe-Maker (Varroth), storm bolter; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="402e-f857-1468-532e" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="06c2-4dba-6352-5876" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="30bf3936-3182-5fc9" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="773ace66-9d74-5de9" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="a27e3298-ada4-5656" name="Legion Teleportarium" hidden="false" targetId="03fea306-e073-5356" type="rule"/><infoLink id="540ec7ee-5dac-4e84-bc57-eedd710b9a48" name="Leader Eligibility" hidden="false" type="rule" targetId="c77b26be-741b-4fe5-b0d4-e29ef6ba921f"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="6ebeaafd-ddf0-49e8" name="Relic weapons" hidden="false" collective="false" import="true" defaultSelectionEntryId="f287764d-8e96-41e7"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d0b1efb8-35b7-4526" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d32002d1-640c-4f69" type="max"/></constraints><selectionEntries><selectionEntry id="f287764d-8e96-41e7" name="Woe-Maker and storm bolter" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="eb8cd33b-e306-4220" name="Woe-Maker (Varroth)" hidden="false" targetId="e249-35a9-1ab0-5770" type="profile"/><infoLink id="ae7d76cc-45ca-4f4e" name="Combi-bolter / storm bolter" hidden="false" targetId="21b2-49c4-ad7f-57b9" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="af13369a-3f1c-42d3" name="Legacy bodyguard TYPE reference (optional; use bodyguard-side assignment)" hidden="false" collective="false" import="true" defaultSelectionEntryId="59e86645-bb65-4511"><constraints><constraint id="53f3ddc6-40c4-4331" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="ed7fa398-cb61-475b" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="59e86645-bb65-4511" name="Independent / no attached bodyguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="6c168d35-43e2-4b8e" name="Attach to: Ashen Chain Terminators" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="e094-37ca-b2d3-557b" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="8ec0116b-e37a-4d78" name="Leader attachment — Varroth" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Ashen Chain Terminators squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b21215db-c12d-4d2a" name="Attach to: Cataphractii Terminator Veterans" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="559b-35bb-bbdb-5632" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="3591561a-bc55-4f9a" name="Leader attachment — Varroth" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Cataphractii Terminator Veterans squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="0e8820a2-e512-4853" name="Attach to: Tartaros Terminator Veterans" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="b3a7-3ebf-431e-534d" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="3dab449c-0beb-49d8" name="Leader attachment — Varroth" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Tartaros Terminator Veterans squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="0a68-86eb-657e-5e80" name="Rhazek Thorne" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="95.0"/></costs><categoryLinks><categoryLink id="d4ee-b82b-4fc8-5ddd" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0dfb-8854-c5e8-5798" type="max"/></constraints><profiles><profile id="8d62-e1b4-da50-5834" name="Rhazek Thorne" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="01ff-5e41-f704-5ee8" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Relic power sword, combi-bolter; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="ec7a-fe06-80ca-51b8" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Linked Assault: one re-roll to Hit when led unit attacks an enemy previously shot by another friendly unit; Line Held: one Battle-shock re-roll while on objective per game. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="4870c952-5478-5068" name="Linked Assault" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">A unit led by Rhazek re-rolls ONE Hit roll when attacking an enemy that a different friendly unit shot earlier that turn.</characteristic></characteristics></profile><profile id="f01ff951-4021-5321" name="Line Held" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">While on an objective, his unit may re-roll ONE Battle-shock test each game.</characteristic></characteristics></profile><profile id="ec476fed-05f4-57d6" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Infernal Legionaries; Despoiler Cadre; Chosen Veterans. A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="315d19fc-2574-400f" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="2783ed72-c032-4e18-ad24-48af85c69fa2" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Infernal Legionaries, Despoiler Cadre, Chosen Veterans. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="1dfab4c8-ddef-4857-a12a-69aed47c4848" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Relic power sword, combi-bolter; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="6e36-12ad-0386-592b" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="fa4f-323e-869d-5013" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="8c6dbd65-3282-59ed" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="d20ed486-d1c9-57d4" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="d2d32de0-5138-4653-9041-85b740ec7760" name="Leader Eligibility" hidden="false" type="rule" targetId="166c4edd-babf-43d8-9994-fc42de50078a"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="e92ad3b9-f7b8-49d8" name="Wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="1422af5b-e00b-493b"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="74726978-33cd-41a6" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="00b7d41d-6119-46bb" type="max"/></constraints><selectionEntries><selectionEntry id="1422af5b-e00b-493b" name="Relic power sword and combi-bolter" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="85d978a1-445f-403f" name="Power sword / axe" hidden="false" targetId="1ec2-20f5-fe4e-5b6c" type="profile"/><infoLink id="11a04324-46de-40ba" name="Combi-bolter / storm bolter" hidden="false" targetId="21b2-49c4-ad7f-57b9" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="6833d9e2-fee9-4442" name="Legacy bodyguard TYPE reference (optional; use bodyguard-side assignment)" hidden="false" collective="false" import="true" defaultSelectionEntryId="d641bbf4-5ca2-4784"><constraints><constraint id="c57617e6-29be-49f7" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="2379818d-1f47-4e41" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="d641bbf4-5ca2-4784" name="Independent / no attached bodyguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="44d852df-ef23-4770" name="Attach to: Infernal Legionaries" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="cedb-da92-81b0-5a8c" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="bc641adf-7461-4f09" name="Leader attachment — Rhazek Thorne" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Infernal Legionaries squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="04cabb45-cb0d-490d" name="Attach to: Despoiler Cadre" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="cf62-7f18-8a35-505a" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="df648414-35d8-4966" name="Leader attachment — Rhazek Thorne" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Despoiler Cadre squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="38a08f95-3072-41cd" name="Attach to: Chosen Veterans" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="607f-0fa7-97c6-5716" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="021692a7-7bc7-45c6" name="Leader attachment — Rhazek Thorne" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Chosen Veterans squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="c1c2-cc1d-0d8a-5569" name="Kordas Vrenn" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="95.0"/></costs><categoryLinks><categoryLink id="015c-05d7-9a13-516c" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6c44-8543-f6ee-5b5a" type="max"/></constraints><profiles><profile id="ad00-dd5c-07c4-56c3" name="Kordas Vrenn" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="76f1-1157-acef-58c2" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Breach hammer, bolt pistol; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="0e52-35d1-62e9-536b" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Seal the Breach: led Breacher unit cover vs one ranged attack sequence when on objective; Void Knife: once/game re-roll failed charge die after transport arrival. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="0374e64f-b8e3-5e10" name="Seal the Breach" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One led Void Breachers unit gains the Benefit of Cover against one enemy ranged attack sequence per enemy Shooting phase while on an objective.</characteristic></characteristics></profile><profile id="1aa9e9e3-d00e-5fa2" name="Void Knife" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, his unit may re-roll ONE failed Charge die after arriving from a transport.</characteristic></characteristics></profile><profile id="7419c37d-313b-5f87" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Void Breachers; Infernal Legionaries; Chosen Veterans. A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="ab9f0e0e-1e0a-4339" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="d904796d-5733-46f0-961c-655cc3751ef7" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Void Breachers, Infernal Legionaries, Chosen Veterans. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="d046fc6c-a828-4dcd-9f4e-3fde143c76ee" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Breach hammer, bolt pistol; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="c923-2191-3e23-5eb9" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="2567-92ea-ea71-50ce" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="e5512b14-065c-538b" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="0be84baf-dc48-54a5" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="43b32380-98ca-4389-bf36-986f14c14b55" name="Leader Eligibility" hidden="false" type="rule" targetId="3b8acffc-fae8-4570-8d78-588cf0ae55fd"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="c4f4d51c-22a5-4146" name="Wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="70fdb27f-e63a-41ef"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e6c5a386-0747-44cf" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="38f8bbf0-9729-4e39" type="max"/></constraints><selectionEntries><selectionEntry id="70fdb27f-e63a-41ef" name="Breach hammer and bolt pistol" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="83867d1a-e419-4eab" name="Thunder hammer" hidden="false" targetId="01ab-c075-4e2b-591f" type="profile"/><infoLink id="9f29905d-60fa-4a91" name="Bolt pistol" hidden="false" targetId="19be-3f27-bea8-5ca4" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="11e7f7d3-9150-4fed" name="Legacy bodyguard TYPE reference (optional; use bodyguard-side assignment)" hidden="false" collective="false" import="true" defaultSelectionEntryId="face8b73-a3d0-401a"><constraints><constraint id="c93dbb3d-dcc4-4c86" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="f82ce07a-53e3-4f04" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="face8b73-a3d0-401a" name="Independent / no attached bodyguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="4581735c-3bd8-4487" name="Attach to: Void Breachers" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="03a3-ea1d-2004-526b" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="fe2198a9-c731-46b5" name="Leader attachment — Kordas Vrenn" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Void Breachers squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a7106313-a00c-4e0d" name="Attach to: Infernal Legionaries" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="cedb-da92-81b0-5a8c" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="428d494d-561c-4748" name="Leader attachment — Kordas Vrenn" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Infernal Legionaries squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="d26e18f7-7c3f-44e5" name="Attach to: Chosen Veterans" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="607f-0fa7-97c6-5716" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="1c3a4f94-5157-4e76" name="Leader attachment — Kordas Vrenn" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Chosen Veterans squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="98d3-ca72-fa73-5478" name="Dravik Sorn" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="100.0"/></costs><categoryLinks><categoryLink id="c07c-3a7b-ac87-5663" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5c60-6167-5f1c-56af" type="max"/></constraints><profiles><profile id="14dc-7557-db6b-5ddd" name="Dravik Sorn" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="81ef-baf7-f415-55c7" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Power axe, combi-melta; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="cacd-918e-bc3b-5c58" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Siegebreaker: improve one melee Wound roll by 1 vs target in cover per phase; Forge Liaison: friendly Daemon Engine within 9" re-rolls one Hit per Shooting phase. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="4f61af60-3c73-5fc3" name="Siegebreaker" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per phase, his unit adds 1 to ONE melee Wound roll against an enemy receiving the Benefit of Cover.</characteristic></characteristics></profile><profile id="cca8d224-f47f-5fde" name="Forge Liaison" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One supporting friendly Daemon Engine within 9 inches may re-roll ONE Hit roll each Shooting phase.</characteristic></characteristics></profile><profile id="a9ab9898-7dce-5bab" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Void Breachers; Despoiler Cadre; Chosen Veterans. A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="364d158e-3484-4588" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="f511e23e-769d-4b3d-9790-d1263d15c251" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Void Breachers, Despoiler Cadre, Chosen Veterans. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="80fcce96-5779-4d18-92ef-931884953485" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Power axe, combi-melta; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="8fe4-0408-459f-5d31" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="9d0d-1306-ecb3-55c4" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="68e8155b-ba14-5e38" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="78427c8b-27db-52f7" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="ccf933a1-6140-4c0c-b688-95e192f5a395" name="Leader Eligibility" hidden="false" type="rule" targetId="c9b3d8d9-10a5-4926-860a-7d2244abeaae"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="b638b0e7-bb24-4ee7" name="Wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="a425129b-bd6b-47ec"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8de18c7d-60b2-4dfb" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2489dc3d-f532-45c6" type="max"/></constraints><selectionEntries><selectionEntry id="a425129b-bd6b-47ec" name="Power axe and combi-melta" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="3ed6fe17-8a5f-4a73" name="Power sword / axe" hidden="false" targetId="1ec2-20f5-fe4e-5b6c" type="profile"/><infoLink id="7dd153f9-4178-4956" name="Combi-melta" hidden="false" targetId="2718-8df8-35df-5be4" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="eda99cf8-34c9-46e9" name="Legacy bodyguard TYPE reference (optional; use bodyguard-side assignment)" hidden="false" collective="false" import="true" defaultSelectionEntryId="f2cadaa2-4c42-4168"><constraints><constraint id="f2203aab-4001-493b" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="0704d750-e8d8-4c7d" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="f2cadaa2-4c42-4168" name="Independent / no attached bodyguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="46620995-b8f7-4033" name="Attach to: Void Breachers" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="03a3-ea1d-2004-526b" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="7be1aced-f52c-4d21" name="Leader attachment — Dravik Sorn" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Void Breachers squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7859de6a-cf46-44de" name="Attach to: Despoiler Cadre" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="cf62-7f18-8a35-505a" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="12e61b87-fcc8-41a0" name="Leader attachment — Dravik Sorn" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Despoiler Cadre squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="d894ac41-e790-4182" name="Attach to: Chosen Veterans" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="607f-0fa7-97c6-5716" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="bff4d30d-b851-4f77" name="Leader attachment — Dravik Sorn" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Chosen Veterans squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="7877-0be3-fdca-5880" name="Varkhul Renn" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="95.0"/></costs><categoryLinks><categoryLink id="7c40-dbf9-a621-54d9" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ed79-1636-121a-5854" type="max"/></constraints><profiles><profile id="20d0-fe80-0fe7-5bd9" name="Varkhul Renn" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="8c81-ce1f-3a0d-5480" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Power sword, bolt rifle; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="bac5-6c79-cf6e-58ee" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Long March Doctrine: led unit +1 Advance; Independent Column: once/game one Scout unit may make legal 3" pregame reposition. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="73af8910-3c07-5e0f" name="Long March Doctrine" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The unit he leads adds 1 to its Advance roll.</characteristic></characteristics></profile><profile id="32cf86f4-9713-50e4" name="Independent Column" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, after deployment, one friendly Scout unit in his detachment may make a legal 3-inch pre-game reposition.</characteristic></characteristics></profile><profile id="ce48b5a9-2f7e-5447" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Infernal Legionaries; Recon Veterans; Tactical Support Cadre. A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="e4d74d1f-1a15-4140" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="aae2e0b4-1453-401b-83c5-ea16a9fc8f12" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Infernal Legionaries, Recon Veterans, Tactical Support Cadre. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="3a8307dc-2c15-4bd7-8b0e-5b3528f927da" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Power sword, bolt rifle; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="ae14-ec86-7247-53f6" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="6bb3-07e0-16b5-553b" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="a9a347fe-e5fd-5a8d" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="514e2028-6735-5ee1" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="r