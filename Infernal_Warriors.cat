true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="c0358579-0c28-4a72" name="Deployment / passenger assignment (one declared plan)" hidden="false" collective="false" import="true" defaultSelectionEntryId="73458d02-345f-42a2"><constraints><constraint id="6a047f15-ca49-4be0" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="f9536716-8132-4d71" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="73458d02-345f-42a2" name="Deployed on the battlefield (normal)" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="016230db-05bb-49dd" name="Standard Strategic Reserves (mission restrictions)" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="037f70f0-f0ea-4f97" name="Standard Reserves" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Select only when the mission allows this formation and it fits the Reserves points cap; normal later-round timing applies. This is not an automatic Deep Strike grant.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="6166efba-ca6a-4011" name="Deep Strike — ordinary permitted arrival" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="1491a9ab-b449-4258" name="Deep Strike" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the existing Terminator Teleportarium or printed jump-pack deployment rule where applicable; DOES NOT override normal Reserves caps, distance or arrival timing.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="24ab42a7-7ab1-450b" name="Cohort Insertion — First-turn Deep Strike" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="798b7a2c-6093-4873" name="Cohort Insertion" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Entire Chaplain-led formation (bundled in the selected unit size) deploys independently by Deep Strike, including the approved FIRST FRIENDLY Reinforcements step if the first-turn option was chosen. This waives ONLY first-round arrival prohibition, not Reserves cap, coherency or enemy exclusion. No transport may gain early arrival by carrying this unit.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7574a25e-450d-47e3" name="Cohort Insertion — Later-round Deep Strike" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="ab0beb1a-28a3-44f9" name="Cohort Insertion" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Entire Chaplain-led formation (bundled in the selected unit size) deploys independently by Deep Strike, including the approved FIRST FRIENDLY Reinforcements step if the first-turn option was chosen. This waives ONLY first-round arrival prohibition, not Reserves cap, coherency or enemy exclusion. No transport may gain early arrival by carrying this unit.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="2c37ad85-816c-4326" name="Embarked in: Spartan Assault Tank" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="722a-2c35-6f47-5a04" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="ca5b6f87-ab3a-48fc" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Spartan Assault Tank. Formation is 6 infantry model(s) plus its mandatory PAID Chaplain; minimum passenger spaces 14. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5411abde-e6f2-410f" name="Embarked in: Kharybdis Assault Claw" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="a6d8-ed7a-d637-506f" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="7f11c966-eae0-4127" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EM