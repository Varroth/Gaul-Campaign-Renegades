ditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="b2c8-04a1-9b84-53e7" name="Bloodcrushers" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="7c8c-b4a4-1d26-54d5" name="Khorne Allies" hidden="false" targetId="471b-b5c6-68a0-523c" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ebe8-7396-cb39-5676" type="max"/></constraints><profiles><profile id="32c1-baa8-90cc-5532" name="Bloodcrushers" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">8"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">6</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">4+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">4</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="4418-d5b5-c119-53e5" name="Impact Assault" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle when charging an enemy unit, deal 1 mortal wound on D6 4+.</characteristic></characteristics></profile><profile id="8c37-b9e3-877f-59a8" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Hellblades and Juggernaut horns; rider+mount = ONE model. No Serum.</characteristic></characteristics></profile><profile id="6586-db34-6eb1-50c1" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Only permitted allied Khorne daemons, ≤25% of army points (manual cap). Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="c479d1b5-9e10-4098-9747-0526cafddaa5" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Hellblades and Juggernaut horns; rider+mount = ONE model. No Serum. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="d0c1-1103-f4c2-5b2b" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="c299-1261-2654-5ff9"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f64a-5706-0adc-54a4" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1d36-2960-4226-54c5" type="max"/></constraints><selectionEntries><selectionEntry id="c299-1261-2654-5ff9" name="3 models" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="145.0"/></costs><selectionEntryGroups><selectionEntryGroup i