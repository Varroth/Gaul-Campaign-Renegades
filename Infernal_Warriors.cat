modifiers><modifier type="set" field="fe62-91f9-8daa-5e47" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="d5a4-3a40-fa65-56a6" name="Tenth Company Scouts" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="fc56-8a7d-1e83-5821" name="Infantry" hidden="false" targetId="521d-dd50-6a49-58fb" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0b81-9549-c3c3-5df6" type="max"/></constraints><profiles><profile id="211b-706f-d335-5f8a" name="Tenth Company Scouts" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">4+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="a6cb-379f-2907-56ea" name="Patient Recon" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per turn, re-roll one Hit roll when targeting enemy Scouts.</characteristic></characteristics></profile><profile id="dc00-4aa8-bc1e-5ca4" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bolt carbines, combat knives; 1 sniper rifle OR heavy stubber per 5. Aspirants are NOT eligible for Infernal Serum.</characteristic></characteristics></profile><profile id="6a90-4cd1-5f33-53ae" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="f3bf8705-d8f8-43c3-9ac9-7ddb7a595195" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Bolt carbines, combat knives; 1 sniper rifle OR heavy stubber per 5. Aspirants are NOT eligible for Infernal Serum. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile><profile id="b0e8-4a30-a4d5-5c2c" name="LEADER Assignment — instance specific" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The selected attachment is local to THIS Tenth Company Scouts unit, allowing multiple copies of this datasheet to have different Leaders. A matching Leader must also be bought separately. Use New Recruit's native Leader association command when available; this 0-point declaration does not physically join roster entries or apply an attached Leader's rules. Older Leader-side bodyguard-type choices remain for saved roster compatibility. A bodyguard normally takes one Leader; Lost Cohort uses its mandatory separate bundled Chaplain system.</character