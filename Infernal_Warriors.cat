<cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="15d94e99-6a8b-4414" name="Attach to: Infernal Legionaries" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="cedb-da92-81b0-5a8c" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="264eb69a-dc5a-44f4" name="Leader attachment — Varkhul Renn" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Infernal Legionaries squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="cf53eea2-4386-4051" name="Attach to: Recon Veterans" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="84c1-e134-0ce1-5c13" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="4b9cf348-bb63-41f5" name="Leader attachment — Varkhul Renn" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Recon Veterans squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="2f4c88b6-c0de-4643" name="Attach to: Tactical Support Cadre" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="0a82-b22f-e88c-5dbd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="0e123b3f-0bc4-4fdc" name="Leader attachment — Varkhul Renn" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Tactical Support Cadre squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="973f-1e3e-0648-5b11" name="Torgath Keld" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="120.0"/></costs><categoryLinks><categoryLink id="b69e-c973-d7e9-59cb" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6a7d-29b0-83cb-5277" type="max"/></constraints><profiles><profile id="24b2-c32b-a9e7-5f0e" name="Torgath Keld" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="e4b4-81d2-3770-5777" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Power maul, combi-bolter; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="2737-f8bb-9996-5a4a" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Iron Column: friendly vehicle within 9" re-rolls one ranged Hit per turn; Armoured Breakthrough: after disembark re-roll one Charge die. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="6e166317-3fd4-5b26" name="Iron Column" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per turn, one friendly INFERNAL WARRIORS VEHICLE within 9 inches may re-roll ONE ranged Hit roll.</characteristic></characteristics></profile><profile id="c7f02802-d3e0-5c18" name="Armoured Breakthrough" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If Keld disembarked this turn, his unit may re-roll ONE Charge die.</characteristic></characteristics></profile><profile id="9372dc7a-1ef2-5f67" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Infernal Legionaries; Heavy Support Cadre; Chosen Veterans. A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="4cd85dbf-2421-40b7" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="540cd529-6c9e-4246-ad19-c95d0be696f8" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Infernal Legionaries, Heavy Support Cadre, Chosen Veterans. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="68f348d5-3b52-4c65-922d-ce79f1757d1d" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Power maul, combi-bolter; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="c09c-dbbf-5f11-5f69" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="0c0c-a3c5-9856-5992" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="dbe2fc86-d937-5fe3" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="a2b6dd98-4d52-5f79" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="0c4a772b-e495-435b-bd4c-781d652a5fbc" name="Leader Eligibility" hidden="false" type="rule" targetId="b8c51b72-a483-4ca7-a791-dab2d35e7899"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="6b56ecd1-26b6-4e9a" name="Wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="4f755958-120a-44b9"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9824e468-327c-4590" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9c17b6e7-630a-4629" type="max"/></constraints><selectionEntries><selectionEntry id="4f755958-120a-44b9" name="Power maul and combi-bolter" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="38b8351d-af27-4029" name="Power maul" hidden="false" targetId="377b-5078-7243-55fb" type="profile"/><infoLink id="9214cd44-7a13-4fa5" name="Combi-bolter / storm bolter" hidden="false" targetId="21b2-49c4-ad7f-57b9" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="07b3a2cd-5d08-47b1" name="Legacy bodyguard TYPE reference (optional; use bodyguard-side assignment)" hidden="false" collective="false" import="true" defaultSelectionEntryId="f558acf0-ac4c-40f7"><constraints><constraint id="220598d0-f797-4f7f" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="fa14c2cf-b4aa-4939" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="f558acf0-ac4c-40f7" name="Independent / no attached bodyguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="253ca70b-aaf6-403e" name="Attach to: Infernal Legionaries" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="cedb-da92-81b0-5a8c" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="82bc3f84-3781-4b0a" name="Leader attachment — Torgath Keld" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Infernal Legionaries squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="bd0b5e92-5c62-48e9" name="Attach to: Heavy Support Cadre" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="2cd2-8998-18bc-5ad1" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="0643f223-3683-4a59" name="Leader attachment — Torgath Keld" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Heavy Support Cadre squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="da57c633-b7bb-4dac" name="Attach to: Chosen Veterans" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="607f-0fa7-97c6-5716" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="9b0a1373-6249-4e6c" name="Leader attachment — Torgath Keld" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Chosen Veterans squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="24a0-144b-cea3-5023" name="Malthor Ghor" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="95.0"/></costs><categoryLinks><categoryLink id="33f8-f1e4-abe8-5f90" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="922b-7bed-6914-52c2" type="max"/></constraints><profiles><profile id="a4c0-8372-e76e-58b5" name="Malthor Ghor" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="b202-9085-1fd2-5805" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Pair of chainblades, plasma pistol; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="07ab-419d-8b7a-566d" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Reaver Assault: led unit re-rolls an Advance die; Battlefield Dislocation: once/game enemy within 9" has -1 next Battle-shock test. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="c1d46281-5650-5135" name="Reaver Assault" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">His unit may re-roll ONE Advance die.</characteristic></characteristics></profile><profile id="ce6e90d9-a0cd-5245" name="Battlefield Dislocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, select one enemy unit within 9 inches: subtract 1 from that enemy’s next Battle-shock test.</characteristic></characteristics></profile><profile id="d53b1162-f7e7-5fcd" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Recon Veterans; Infernal Legionaries; Despoiler Cadre. A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="88f7366d-8c45-492b" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="a2ae9d65-ac74-45d1-9ab7-f956a48f7a57" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Recon Veterans, Infernal Legionaries, Despoiler Cadre. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="0650b8cc-5c63-46f5-bdd0-f3dc3a78a1a0" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Pair of chainblades, plasma pistol; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="9cbb-7bb9-ef33-57b4" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="0bea-43b5-73ae-53c2" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="d973bc03-8540-5cca" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="5af3b3f9-4b32-5e9f" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="d9a9b6f5-643c-47ee-be7c-887482a8bad8" name="Leader Eligibility" hidden="false" type="rule" targetId="73000c65-26b5-4db4-89b7-9988e2697553"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="faa3e9fd-721b-4142" name="Wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="ee94df9a-b773-4840"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6029c4c7-10bf-4bdb" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="20994daa-8cb1-442f" type="max"/></constraints><selectionEntries><selectionEntry id="ee94df9a-b773-4840" name="Dual chainblades and plasma pistol" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="16fc6c1c-fef8-44da" name="Dual chainblades" hidden="false" targetId="7e76-809f-c9cd-5a66" type="profile"/><infoLink id="4fe59c28-63a4-4938" name="Plasma pistol" hidden="false" targetId="e195-9137-278e-53ac" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="def6513e-ecd5-4261" name="Legacy bodyguard TYPE reference (optional; use bodyguard-side assignment)" hidden="false" collective="false" import="true" defaultSelectionEntryId="71185f9c-1bf4-4d67"><constraints><constraint id="3ffc83eb-57eb-42dd" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="8b222445-15e3-45cb" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="71185f9c-1bf4-4d67" name="Independent / no attached bodyguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="cd25909f-9e6f-4276" name="Attach to: Recon Veterans" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="84c1-e134-0ce1-5c13" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="d4c6fa17-caba-4608" name="Leader attachment — Malthor Ghor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Recon Veterans squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1919eca6-35cc-4ab5" name="Attach to: Infernal Legionaries" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="cedb-da92-81b0-5a8c" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="51519714-6016-477b" name="Leader attachment — Malthor Ghor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Infernal Legionaries squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="4016222c-9e88-4f7f" name="Attach to: Despoiler Cadre" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="cf62-7f18-8a35-505a" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="e13b5a56-6611-460f" name="Leader attachment — Malthor Ghor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Despoiler Cadre squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="4f4c-ad5e-d44a-51fb" name="Azrakh Drenn" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="115.0"/></costs><categoryLinks><categoryLink id="59f9-95d0-250a-5979" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/><categoryLink id="f3bd-a51b-e957-5ea9" name="Jump Infantry" hidden="false" targetId="2a7b-0016-ba81-5ad6" primary="false"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="167e-90ed-48d8-5366" type="max"/></constraints><profiles><profile id="5351-e8ba-3062-5583" name="Azrakh Drenn" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">12"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="27eb-0a28-5278-5185" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Inferno pistol, power axe, jump pack; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="4caf-79f7-b53d-5766" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Falling Spear: once/battle after charge enemy in Engagement Range takes 1 mortal wound on 4+; Skyborne Commander: re-roll one Charge die after Deep Strike. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="e341bb76-89bf-5a92" name="Falling Spear" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, after this unit completes a Charge move, on a D6 roll of 4+ one enemy unit in Engagement Range suffers 1 mortal wound.</characteristic></characteristics></profile><profile id="c8b185a3-32ae-59c1" name="Skyborne Commander" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The unit led by Azrakh may re-roll ONE Charge die after Deep Strike.</characteristic></characteristics></profile><profile id="feddfff6-7597-57cc" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Assault Jump Cadre; Raptor Strike Cadre (jump-pack bodyguards only). A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="df62f4f2-1b03-443f" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="e3970fcf-b2c9-4cb2-953c-4146e8f28db1" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Assault Jump Cadre, Raptor Strike Cadre. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="fbc8a0bb-8211-448b-86a3-bdd4e1292b83" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Inferno pistol, power axe, jump pack; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="3c26-1dbf-0bc4-5c10" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="9569-a3a1-0b9a-5b66" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="dbd565b8-b463-5667" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="1fbc3d83-b644-5c46" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="7a6c406d-4c29-4e51-9882-185ef273ed5b" name="Leader Eligibility" hidden="false" type="rule" targetId="9729d83d-df2f-4bf8-8c64-77eebca9f050"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="9213524a-e78a-4e0a" name="Wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="82316526-4844-46a0"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2287f702-3f5d-4bfa" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8df0c368-153d-44cb" type="max"/></constraints><selectionEntries><selectionEntry id="82316526-4844-46a0" name="Power axe, inferno pistol and jump pack" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="a7b165b9-93b3-44d9" name="Power sword / axe" hidden="false" targetId="1ec2-20f5-fe4e-5b6c" type="profile"/><infoLink id="e22c77be-5fbf-4c41" name="Inferno pistol" hidden="false" targetId="549d-7835-8069-51c8" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="2e489b9f-e940-45f8" name="Legacy bodyguard TYPE reference (optional; use bodyguard-side assignment)" hidden="false" collective="false" import="true" defaultSelectionEntryId="498fa810-2b3b-42be"><constraints><constraint id="71fa8615-a058-43f3" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="21286b52-8227-4429" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="498fa810-2b3b-42be" name="Independent / no attached bodyguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="49a09092-a3d1-4c80" name="Attach to: Assault Jump Cadre" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="abf8-0469-47de-5477" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="05e32e50-27c2-48ed" name="Leader attachment — Azrakh Drenn" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Assault Jump Cadre squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="ea2f8baa-b22d-4192" name="Attach to: Raptor Strike Cadre" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="6501-89b3-a5f4-5074" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="f196631f-b48d-4aaa" name="Leader attachment — Azrakh Drenn" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Raptor Strike Cadre squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="04c1-b1ff-5e34-5351" name="Velkan Rusk" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="95.0"/></costs><categoryLinks><categoryLink id="680d-ed16-2c7f-5f3a" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8db2-1739-2128-5503" type="max"/></constraints><profiles><profile id="166f-d68e-a52b-5309" name="Velkan Rusk" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="3c76-f673-a523-5e24" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Combi-bolter, power fist; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="aa5d-4b3c-19c6-55f2" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Suppression Grid: one led heavy-support weapon re-rolls one Wound in Shooting phase; Mobile Gunline: ignores homebrew moving/heavy-weapon penalty. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="35f8e55f-88be-58d2" name="Suppression Grid" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per Shooting phase ONE heavy support weapon in his led unit may re-roll ONE Wound roll.</characteristic></characteristics></profile><profile id="4a781412-ec33-5d7f" name="Mobile Gunline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">His led unit does not suffer an ADDITIONAL homebrew penalty for moving before firing Heavy weapons; ordinary core rules still apply.</characteristic></characteristics></profile><profile id="169d8c9a-1a24-5324" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Heavy Support Cadre; Tactical Support Cadre; Infernal Legionaries. A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="f777ac3b-dbf9-4922" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="57994f45-8506-44a2-aec5-4161d66d88bd" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Heavy Support Cadre, Tactical Support Cadre, Infernal Legionaries. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="2ef74d70-5ad2-4eb0-82a1-c3899966177b" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Combi-bolter, power fist; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="88c9-a127-e7f6-5ca2" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="7c88-0eda-6a28-59a8" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="7d9f8518-5c54-5911" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="2a83781b-91fe-5667" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="0523395c-e867-4986-927b-02d1618fb70a" name="Leader Eligibility" hidden="false" type="rule" targetId="81dfddc2-6d2d-4e6b-b2d4-5ab951b42cd9"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="9fcd1afb-31a6-476e" name="Wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="7a69b6be-21bf-4508"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9d295fb6-2f93-4ec5" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2559fb22-006b-4946" type="max"/></constraints><selectionEntries><selectionEntry id="7a69b6be-21bf-4508" name="Combi-bolter and power fist" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="244e0c02-197e-4b62" name="Combi-bolter / storm bolter" hidden="false" targetId="21b2-49c4-ad7f-57b9" type="profile"/><infoLink id="b2e5aa6c-424b-4bad" name="Power fist" hidden="false" targetId="bea6-5c80-14b8-58f0" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="89850565-273b-466b" name="Legacy bodyguard TYPE reference (optional; use bodyguard-side assignment)" hidden="false" collective="false" import="true" defaultSelectionEntryId="337e6d59-9cb9-4f61"><constraints><constraint id="2bb2ce84-497f-46a5" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="dfb9ffee-d29e-4533" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="337e6d59-9cb9-4f61" name="Independent / no attached bodyguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="cf660a64-6c1f-499e" name="Attach to: Heavy Support Cadre" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="2cd2-8998-18bc-5ad1" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="b560657e-7bbd-4c2d" name="Leader attachment — Velkan Rusk" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Heavy Support Cadre squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="fb332988-1f24-4459" name="Attach to: Tactical Support Cadre" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="0a82-b22f-e88c-5dbd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="c7788e6c-0d20-4d3a" name="Leader attachment — Velkan Rusk" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Tactical Support Cadre squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1842715d-da1c-4d32" name="Attach to: Infernal Legionaries" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="cedb-da92-81b0-5a8c" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="b302a055-405e-4766" name="Leader attachment — Velkan Rusk" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Infernal Legionaries squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="8b60-0277-8e5f-5cd2" name="Varek Thul" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="85.0"/></costs><categoryLinks><categoryLink id="b7aa-36d3-2efc-520b" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="849e-11cb-4f93-5a92" type="max"/></constraints><profiles><profile id="3805-ac55-b86d-54a6" name="Varek Thul" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="0696-9ca9-0a57-5192" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bolt rifle, combat blade; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="894a-4372-27ba-5f1c" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Measured Instruction: nearby Scout, Recruit or Recon unit re-rolls one Hit per turn; Patient Strategist: once/battle reposition friendly training unit inside deployment zone. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="5736fc6a-e11f-5320" name="Measured Instruction" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per turn, one nearby friendly Scout, Recruit or Recon unit may re-roll ONE Hit roll.</characteristic></characteristics></profile><profile id="1de3eff1-dd07-5c59" name="Patient Strategist" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, after deployment, reposition one friendly training unit wholly within your deployment zone.</characteristic></characteristics></profile><profile id="403ee505-722b-5bc1" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Tenth Company Scouts; Recon Veterans; Infernal Legionaries. Scouts do not gain serum. A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="986d13d1-7a35-454d" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="ac8ae349-ff84-441d-878a-3360f1660c66" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Tenth Company Scouts, Recon Veterans, Infernal Legionaries. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="de35d23a-5cd7-4f96-9164-cc13a218db3d" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Bolt rifle, combat blade; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="10bf-2784-9c17-52a8" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="6026-7251-cadb-5c6a" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="f86f6520-ec2b-5f64" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="d6117f99-54b1-535d" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="27f54327-ec0b-4bb6-811d-4fbbaa34aca9" name="Leader Eligibility" hidden="false" type="rule" targetId="9444299f-ab76-4830-b20a-4001f0a7b200"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="98a7cd94-934a-4d2f" name="Wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="e22deb15-ef37-4762"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="679178bf-d317-43b5" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6568990e-350e-4e43" type="max"/></constraints><selectionEntries><selectionEntry id="e22deb15-ef37-4762" name="Bolt rifle and combat blade" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="021bd53d-1625-488f" name="Bolt rifle" hidden="false" targetId="f413-b65b-eb0c-5cdc" type="profile"/><infoLink id="37a154b8-409f-49ca" name="Close-combat weapon" hidden="false" targetId="953b-aa30-035d-5d4d" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="68276034-e38a-415b" name="Legacy bodyguard TYPE reference (optional; use bodyguard-side assignment)" hidden="false" collective="false" import="true" defaultSelectionEntryId="dba46a73-c6f9-4e33"><constraints><constraint id="bebd5a44-61da-4019" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="54d1f47c-8f9e-4812" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="dba46a73-c6f9-4e33" name="Independent / no attached bodyguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="edf6a22b-8f8e-4049" name="Attach to: Tenth Company Scouts" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="d5a4-3a40-fa65-56a6" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="8122c7fe-1881-45a0" name="Leader attachment — Varek Thul" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Tenth Company Scouts squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="481f2512-5981-47a4" name="Attach to: Recon Veterans" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="84c1-e134-0ce1-5c13" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="d256c964-2b49-4395" name="Leader attachment — Varek Thul" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Recon Veterans squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="cbeab1cc-b720-46b3" name="Attach to: Infernal Legionaries" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="cedb-da92-81b0-5a8c" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="73954e8a-5545-4ee1" name="Leader attachment — Varek Thul" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Infernal Legionaries squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="8903-0ab6-5678-5f5b" name="Orvath Krail" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="100.0"/></costs><categoryLinks><categoryLink id="67d5-f37e-b8ae-56a3" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e99e-cf9e-f2c9-55f7" type="max"/></constraints><profiles><profile id="f798-3cec-bedd-5c86" name="Orvath Krail" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="300e-7502-3b78-5c1a" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Crozius, bolt pistol; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="3237-95a6-1510-5966" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Keeper of Discipline: Lost Cohort within 12" supervised after initial Chaplains die; Oath Without End: led unit re-rolls one failed Battle-shock per battle; may lead foot Lost Cohort. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="32fd5581-bc16-5af7" name="Keeper of Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Eligible Lost Cohort squads within 12 inches are supervised if their original attached Chaplain is lost. The normal Cohort control process is suspended while supervised.</characteristic></characteristics></profile><profile id="8dc24104-89f8-50e0" name="Oath Without End" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The unit led by Krail may re-roll ONE failed Battle-shock test once per battle.</characteristic></characteristics></profile><profile id="1f76fcaf-ea08-58a0" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Lost Cohort — Power Armour; Infernal Legionaries; Chosen Veterans (qualifying starting Chaplain for foot Cohort). A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="b0a2e9fa-33ce-44ba" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="19af9e9f-07b8-4ad3-a730-bbcd4136d3cd" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Infernal Legionaries, Chosen Veterans. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="969e1a82-8832-4b66-8a82-a7fa9275c434" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Crozius, bolt pistol; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="010a-efce-5e03-5469" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="1cbe-faf0-4908-5f7f" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="d5d08c4b-5c16-5eed" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="18ecb389-4a4a-559e" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="b35f73fc-4ab7-4d7c-b002-3133473db30e" name="Leader Eligibility" hidden="false" type="rule" targetId="a2af1900-a7c2-40a8-9d3a-51194f9fdcaf"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="e2d166f7-4c82-48b1" name="Wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="afbd5451-4af8-4403"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="89f4c438-fc25-4eeb" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0ef2e048-6305-4ef8" type="max"/></constraints><selectionEntries><selectionEntry id="afbd5451-4af8-4403" name="Crozius and bolt pistol" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="1d16ae39-aeb4-4df5" name="Crozius" hidden="false" targetId="e77b-3835-0018-547f" type="profile"/><infoLink id="9f618982-6606-4f7d" name="Bolt pistol" hidden="false" targetId="19be-3f27-bea8-5ca4" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="a614e7eb-5073-4f58" name="Legacy bodyguard TYPE reference (optional; use bodyguard-side assignment)" hidden="false" collective="false" import="true" defaultSelectionEntryId="6581613e-0c76-4371"><constraints><constraint id="0be856d8-2b05-4a9f" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="0d646386-d398-4e8c" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="6581613e-0c76-4371" name="Independent / no attached bodyguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="aac218cf-5709-4bee" name="Attach to: Infernal Legionaries" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="cedb-da92-81b0-5a8c" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="25d0d1c3-cbd7-498d" name="Leader attachment — Orvath Krail" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Infernal Legionaries squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="892c9e49-eafd-4026" name="Attach to: Chosen Veterans" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="607f-0fa7-97c6-5716" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="f1cf4760-7d3d-44ca" name="Leader attachment — Orvath Krail" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Chosen Veterans squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="62399fe4-4e5b-4c10" name="MANDATORY unique Orvath Krail registration" hidden="false" collective="false" import="true" defaultSelectionEntryId="c0266552-5e8d-426f"><constraints><constraint id="6f11a3d3-2a01-4b42" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="3df3156f-cf54-47f7" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries/><entryLinks><entryLink id="c0266552-5e8d-426f" name="Declare unique Orvath (paid as standalone character)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="79346c0a-ede2-4066"/></entryLinks></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="5b0e-372a-656f-5fd2" name="Istran Valcor" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="95.0"/></costs><categoryLinks><categoryLink id="bc30-a395-a791-51d2" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="66a7-1257-a977-5c60" type="max"/></constraints><profiles><profile id="6875-1c08-816c-57c6" name="Istran Valcor" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="993e-1b04-cf35-53d7" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Narthecium, bolt pistol, surgical blade; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="f1e9-2392-dc5a-53a8" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Serum Custodian: one friendly Astartes within 3" heals +1 lost W per turn; Triage of the Broken: +1 next Control Test of nearby supervised Lost Cohort; NOT a Chaplain substitute. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="f0f7ac7a-d842-595f" name="Serum Custodian" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per turn, heal ONE additional lost wound to one eligible living friendly Astartes model within 3 inches, up to its modified Wounds maximum.</characteristic></characteristics></profile><profile id="a5d38ce8-427b-5074" name="Triage of the Broken" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One nearby Lost Cohort squad gains +1 to its next Control Test ONLY if it still has a living attached Chaplain. Valcor is not a substitute Chaplain.</characteristic></characteristics></profile><profile id="d7da7d4c-3301-5983" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Infernal Legionaries; Chosen Veterans; Infernal Berzerkers (not a Chaplain). A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="8655b943-ed7c-413d" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="709bac17-9b96-46af-a324-3b5a0ba9dfa0" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Infernal Legionaries, Chosen Veterans, Infernal Berzerkers. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="b41f9bc4-3749-453f-90a1-ce945e3e476a" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Narthecium, bolt pistol, surgical blade; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="ba0f-1c47-f496-57e9" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="7e8d-7f24-c27c-5dac" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="6c1eda61-66ee-58c7" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="8b4f7a6a-7b2a-51dc" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="bc4fbaf4-922d-433c-9a0e-468252439056" name="Leader Eligibility" hidden="false" type="rule" targetId="370778a4-869f-410d-9522-712a892ea58f"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="254c1f15-408f-4208" name="Wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="cf5d478a-33f4-4339"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3508e7ee-dda5-4928" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e5acc4e4-eaa5-4b32" type="max"/></constraints><selectionEntries><selectionEntry id="cf5d478a-33f4-4339" name="Narthecium, bolt pistol and surgical blade" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="3da2151a-55d3-44d1" name="Bolt pistol" hidden="false" targetId="19be-3f27-bea8-5ca4" type="profile"/><infoLink id="cc80e435-7a44-4e21" name="Surgical blade" hidden="false" targetId="dd4e0d7d-21dc-5e28" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="ea015e2d-0e8b-4798" name="Legacy bodyguard TYPE reference (optional; use bodyguard-side assignment)" hidden="false" collective="false" import="true" defaultSelectionEntryId="fb3c8280-8b63-4f72"><constraints><constraint id="92d78707-467c-4450" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="e9ea31d3-aeaf-46f1" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="fb3c8280-8b63-4f72" name="Independent / no attached bodyguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="068de15a-1384-4d46" name="Attach to: Infernal Legionaries" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="cedb-da92-81b0-5a8c" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="601cff2f-e3af-4bfb" name="Leader attachment — Istran Valcor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Infernal Legionaries squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c69229b4-8c01-4c03" name="Attach to: Chosen Veterans" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="607f-0fa7-97c6-5716" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="08b55609-263b-4afe" name="Leader attachment — Istran Valcor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Chosen Veterans squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="31dd11f0-c3b3-4a85" name="Attach to: Infernal Berzerkers" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="e17a-942c-38f0-5f23" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="ea469007-3e20-4253" name="Leader attachment — Istran Valcor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Infernal Berzerkers squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="9ae0-40c2-3734-5866" name="Tervan Khol" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="95.0"/></costs><categoryLinks><categoryLink id="fa8d-b2f7-d812-5f0a" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8c87-8858-c0d1-5d8b" type="max"/></constraints><profiles><profile id="07e3-a032-5779-5691" name="Tervan Khol" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="9ecc-daac-f3f8-557e" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Reinforced narthecium, chainblade; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="83a0-5810-a91c-51b4" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Neurological Stabilizers: one friendly unit within 6" ignores a routine -1 ranged Hit penalty; Cohort Handler: unsupervised Lost Cohort within 6" may re-roll Control Test; NOT Chaplain. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="ef931d3f-b9bd-5c14" name="Neurological Stabilizers" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per turn one friendly unit within 6 inches ignores its ordinary Warp-Aggravated Pain -1 ranged Hit penalty for the current phase.</characteristic></characteristics></profile><profile id="956e0a3a-8034-54ea" name="Cohort Handler" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One unsupervised Lost Cohort squad within 6 inches may re-roll its D6 Control Test. Khol alone is not a qualifying Chaplain.</characteristic></characteristics></profile><profile id="656b9645-47f4-5a93" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Infernal Berzerkers; Infernal Butchers; Chosen Veterans (not a Chaplain). A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="333dd0ff-56dc-44f4" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="ffc230fd-8b83-4520-b6d9-f084f5631e1b" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Infernal Berzerkers, Infernal Butchers, Chosen Veterans. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="eddf33c0-7ce0-411b-b917-58b5238b5305" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Reinforced narthecium, chainblade; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="2c8b-f204-5cfb-5e03" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="c250-5299-e271-5045" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="9b9a52b6-a4b4-5182" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="8a1eb0c9-1a21-5a85" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="5c8ca4a6-bec9-44f2-9ff5-f5b83db1b2a0" name="Leader Eligibility" hidden="false" type="rule" targetId="f864090c-27e3-4b65-a7eb-da20a74adda7"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="dca4571f-457a-4486" name="Wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="d69f0bd0-a566-419f"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="755cb45a-7957-4f73" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4fc0e317-d680-485b" type="max"/></constraints><selectionEntries><selectionEntry id="d69f0bd0-a566-419f" name="Reinforced narthecium and chainblade" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="13adf619-b424-480b" name="Chainsword" hidden="false" targetId="2b18-7f7c-4b12-568a" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="e60a14a8-534f-4581" name="Legacy bodyguard TYPE reference (optional; use bodyguard-side assignment)" hidden="false" collective="false" import="true" defaultSelectionEntryId="debedb25-9b91-4dc3"><constraints><constraint id="5eef1334-b71b-42f3" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="6ad760d0-0415-47ec" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="debedb25-9b91-4dc3" name="Independent / no attached bodyguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="a1a23612-dff1-4bc6" name="Attach to: Infernal Berzerkers" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="e17a-942c-38f0-5f23" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="16cc0f17-652a-4cca" name="Leader attachment — Tervan Khol" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Infernal Berzerkers squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1068920b-4b1c-4ec3" name="Attach to: Infernal Butchers" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="94a9-92d2-523d-5d8b" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="9a1f9458-93e1-4e98" name="Leader attachment — Tervan Khol" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Infernal Butchers squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="ad97f15a-88ca-481a" name="Attach to: Chosen Veterans" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="607f-0fa7-97c6-5716" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="7a677c2b-01c7-4f56" name="Leader attachment — Tervan Khol" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Chosen Veterans squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="1bd2-0670-3134-5c7a" name="Hadrak Voss" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="105.0"/></costs><categoryLinks><categoryLink id="5e6e-df91-c990-513b" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2a50-c97a-6e25-5aa8" type="max"/></constraints><profiles><profile id="6395-a857-00b1-51e8" name="Hadrak Voss" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="b916-9af8-516f-5c70" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Omnissian axe, servo-arm, volkite sidearm; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="3704-d11a-c85e-51c2" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Custodian of Engines: one Vehicle within 3" heals 1 wound at end of Movement; Independent Forge: nearby Daemon Engine re-rolls one Battle-shock per turn. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="65fee96e-f48f-5880" name="Custodian of Engines" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At end of Movement phase, restore 1 lost wound to one friendly Vehicle within 3 inches, without reviving destroyed models.</characteristic></characteristics></profile><profile id="4b7a6172-8085-5592" name="Independent Forge" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per turn one friendly Daemon Engine within 6 inches may re-roll ONE Battle-shock test.</characteristic></characteristics></profile><profile id="827d5d6b-b34d-5bae" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Independent character; no bodyguard attachment [provisional]. A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="a60826cc-c42b-4ab0-b0ad-982058879799" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Omnissian axe, servo-arm, volkite sidearm; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="a7ea-cce8-86aa-55d5" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="10d0-9956-c2c7-5e5e" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="321f554a-c335-5334" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="77e5abd6-1c0b-5d0a" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="8bcc0ba4-cc6c-42b7" name="Wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="5d467601-0bd7-4099"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5e189bc9-9795-4786" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3579795e-3642-4bc4" type="max"/></constraints><selectionEntries><selectionEntry id="5d467601-0bd7-4099" name="Omnissian axe, servo-arm and volkite sidearm" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="a7bd686b-be43-4ad2" name="Omnissian axe" hidden="false" targetId="8669-844c-c743-5d62" type="profile"/><infoLink id="caa07058-43c4-4afc" name="Servo-arm" hidden="false" targetId="e241-e18b-6638-58e7" type="profile"/><infoLink id="916554eb-aa84-4022" name="Volkite sidearm" hidden="false" targetId="6fb3f364-ac56-5a70" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="8f41-2c7a-48bb-5c7c" name="Mordren Vhal" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="95.0"/></costs><categoryLinks><categoryLink id="296e-5f42-6adf-56c4" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1362-5764-a5d6-5856" type="max"/></constraints><profiles><profile id="d6ed-2d1b-5029-5900" name="Mordren Vhal" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="fd81-2f0a-5783-5a09" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Power sabre, naval combi-bolter; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="04ae-7fa7-77b2-5c33" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Void Deployment: once/battle one arriving unit re-rolls a charge die or aircraft a Hit; Boarding Priority: friendly transport within 9" may re-roll first failed Battle-shock. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="7ebd3286-725f-58f2" name="Void Deployment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, either one friendly arriving unit may re-roll ONE Charge die, or one friendly Aircraft may re-roll ONE Hit roll.</characteristic></characteristics></profile><profile id="8f45302b-f2c1-5c95" name="Boarding Priority" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One friendly Transport within 9 inches may re-roll its first failed Battle-shock test.</characteristic></characteristics></profile><profile id="e176d716-28ce-5f71" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Infernal Legionaries; Chosen Veterans. A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="9e306023-02e3-48b9" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="4e93a0b3-9fbc-465a-a9c2-2d768f1480e5" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Infernal Legionaries, Chosen Veterans. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="c6ddc093-01a7-4d62-9c78-5a978dda248c" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Power sabre, naval combi-bolter; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="5f35-7c76-4b0f-5cfd" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="ad78-9938-c27f-5e56" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="e051191c-1028-5fc1" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="69a7bb29-1f2f-5ff7" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="eb83282f-b40b-4621-9c3d-9774c2210517" name="Leader Eligibility" hidden="false" type="rule" targetId="c7219d8a-a874-4fc3-9fe3-a8734baf2a07"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="470669ac-1460-4906" name="Wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="501fc697-d8ae-4b95"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5907d363-dbaf-4e35" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c069058f-0032-426d" type="max"/></constraints><selectionEntries><selectionEntry id="501fc697-d8ae-4b95" name="Power sabre and naval combi-bolter" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="8f60f5d0-416c-4090" name="Power sword / axe" hidden="false" targetId="1ec2-20f5-fe4e-5b6c" type="profile"/><infoLink id="9ae8e4b6-bd52-4371" name="Combi-bolter / storm bolter" hidden="false" targetId="21b2-49c4-ad7f-57b9" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="39e930a9-4786-4ac5" name="Legacy bodyguard TYPE reference (optional; use bodyguard-side assignment)" hidden="false" collective="false" import="true" defaultSelectionEntryId="3c0c6dc3-bdf8-4e21"><constraints><constraint id="4ad9ae0f-8580-44e9" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="7c17dfb9-1f1f-4544" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="3c0c6dc3-bdf8-4e21" name="Independent / no attached bodyguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="62abfa69-aa1f-4522" name="Attach to: Infernal Legionaries" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="cedb-da92-81b0-5a8c" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="90559b98-96ca-4876" name="Leader attachment — Mordren Vhal" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Infernal Legionaries squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="e4cf39fa-c835-4d27" name="Attach to: Chosen Veterans" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="607f-0fa7-97c6-5716" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="4bbf4020-2cbc-40dc" name="Leader attachment — Mordren Vhal" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Chosen Veterans squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="74f0-20ac-293d-5d02" name="Kessel Rane" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="90.0"/></costs><categoryLinks><categoryLink id="88b8-617b-1802-5fc0" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9f0f-1d72-1c3e-5601" type="max"/></constraints><profiles><profile id="2e61-0245-cbb7-5fe5" name="Kessel Rane" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="e304-1858-0587-5f98" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Boltgun, power blade, vox relay harness; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="183b-9a1c-a855-5995" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Signal Grid: extends one Directed Objective command range to 18"; Denied Silence: one nearby infantry re-rolls a ranged Hit once/turn. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="7d3b6dca-1d9a-504a" name="Signal Grid" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Extend ONE Directed Objective command range to 18 inches.</characteristic></characteristics></profile><profile id="0d36fa5b-cd11-5543" name="Denied Silence" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per turn one nearby friendly Infantry unit may re-roll ONE ranged Hit roll.</characteristic></characteristics></profile><profile id="b3543d39-00fb-5e39" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Infernal Legionaries; Tactical Support Cadre; Heavy Support Cadre. A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="f1b8e12e-d1aa-4d55" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="6344d27b-e413-4164-8536-ce89b58c5e50" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Infernal Legionaries, Tactical Support Cadre, Heavy Support Cadre. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="3c390b96-059b-4011-9cbc-bbb8facb0756" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Boltgun, power blade, vox relay harness; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="1db3-705b-e0e2-5c8a" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="fb41-af16-42b7-57b2" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="b51a54cd-963b-5ed5" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="ac9922f8-d1e0-5080" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="13a89eb8-2531-41e2-a3d3-a3d84aea0eac" name="Leader Eligibility" hidden="false" type="rule" targetId="52027dfe-1c05-4d1a-98a1-14d1c0dd70c5"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="949ede3d-c21a-40b7" name="Wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="91aa2e53-fcbd-4699"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d501d3b7-e3a2-476c" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5169f7fd-40c9-473f" type="max"/></constraints><selectionEntries><selectionEntry id="91aa2e53-fcbd-4699" name="Boltgun, power blade and vox relay harness" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="f662fb23-aadb-4358" name="Boltgun" hidden="false" targetId="883a-5ac2-abab-5817" type="profile"/><infoLink id="04cafac8-f5f7-4b4f" name="Power sword / axe" hidden="false" targetId="1ec2-20f5-fe4e-5b6c" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="8812c9bb-9f85-49f7" name="Legacy bodyguard TYPE reference (optional; use bodyguard-side assignment)" hidden="false" collective="false" import="true" defaultSelectionEntryId="a97f05b2-a3d7-4447"><constraints><constraint id="306c7a65-e899-4903" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="adff79c7-6fba-4d85" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="a97f05b2-a3d7-4447" name="Independent / no attached bodyguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="a02ecfa3-f48e-4557" name="Attach to: Infernal Legionaries" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="cedb-da92-81b0-5a8c" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="5036a1b9-324a-461d" name="Leader attachment — Kessel Rane" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Infernal Legionaries squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="db465a2e-c544-446d" name="Attach to: Tactical Support Cadre" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="0a82-b22f-e88c-5dbd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="714e7314-ffc5-4e0d" name="Leader attachment — Kessel Rane" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Tactical Support Cadre squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="3d5a81bb-e212-491b" name="Attach to: Heavy Support Cadre" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="2cd2-8998-18bc-5ad1" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="e4fa3906-6c1f-4fa4" name="Leader attachment — Kessel Rane" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Heavy Support Cadre squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="67ce-6248-ce2e-5b62" name="Rhazdan Krell" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="100.0"/></costs><categoryLinks><categoryLink id="89b8-7e64-f992-5fda" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b4a6-58b8-4557-5504" type="max"/></constraints><profiles><profile id="dace-fb87-000e-556f" name="Rhazdan Krell" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="c4cc-d3bb-3193-575b" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Executioner axe, bolt pistol; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="907f-e19a-aa49-5d4e" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Champion-Seeker: re-roll one Hit and one Wound against enemy Character in melee; The Last Sentence: after destroying enemy Character his unit auto-passes next Battle-shock. INFERNAL SERUM applies (+1 W displayed, FNP 5+, heal 1 W/turn). Named Leaders cannot take generic Enhancements.</characteristic></characteristics></profile><profile id="eebb589f-b823-5287" name="Champion-Seeker" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">In melee against an enemy CHARACTER, re-roll ONE Hit roll and ONE Wound roll.</characteristic></characteristics></profile><profile id="6568a38e-1a79-551c" name="The Last Sentence" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">When Krell destroys an enemy CHARACTER, his unit automatically passes its next Battle-shock test.</characteristic></characteristics></profile><profile id="6d9e64f3-0a44-51e9" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Chosen Veterans; Infernal Butchers; Despoiler Cadre. A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="b639d600-f4e1-4170" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="dfceb02f-6405-417f-b968-8309c961b856" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Chosen Veterans, Infernal Butchers, Despoiler Cadre. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="9e9b5768-0015-4212-b562-3b1e6013ed3a" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Executioner axe, bolt pistol; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="65d0-9c1e-5d3d-563e" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="cde0-4b11-6baa-5588" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="8773e293-9a06-5a45" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="9e32c5c3-582e-5e04" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="03d4fe57-a1ca-4b07-b834-ce9a27658851" name="Leader Eligibility" hidden="false" type="rule" targetId="a563efbe-c0a7-4595-aa2f-28f9d8687313"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="5134eca3-a253-4564" name="Wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="ab808ce5-8f57-410b"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e8f73010-f586-4eb9" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="09ad9b44-c10a-4092" type="max"/></constraints><selectionEntries><selectionEntry id="ab808ce5-8f57-410b" name="Executioner axe and bolt pistol" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="27051f56-b85c-47a6" name="Executioner axe" hidden="false" targetId="6c05d832-8c36-5337" type="profile"/><infoLink id="ddd41632-ccc7-4382" name="Bolt pistol" hidden="false" targetId="19be-3f27-bea8-5ca4" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="27351af9-0a92-48f8" name="Legacy bodyguard TYPE reference (optional; use bodyguard-side assignment)" hidden="false" collective="false" import="true" defaultSelectionEntryId="76489e66-189e-4f93"><constraints><constraint id="7a4a0f5f-9436-481d" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="ac48dda2-4f06-4920" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="76489e66-189e-4f93" name="Independent / no attached bodyguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="de13788d-4581-49f4" name="Attach to: Chosen Veterans" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="607f-0fa7-97c6-5716" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="52d76423-f9f7-4c4c" name="Leader attachment — Rhazdan Krell" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Chosen Veterans squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="cbf82dd8-7691-40da" name="Attach to: Infernal Butchers" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type=