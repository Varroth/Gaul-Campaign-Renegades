value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="e4cd-b092-b4eb-5649" name="Bike Recon Squadron" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="3b53-f5bb-8ea6-5dc0" name="Mounted" hidden="false" targetId="bf60-94d3-7c97-5f42" primary="true"/><categoryLink id="389d-4694-54c2-5c02" name="Infantry" hidden="false" targetId="521d-dd50-6a49-58fb" primary="false"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="10dd-df73-cd3a-50ee" type="max"/></constraints><profiles><profile id="fe08-3841-ed30-521f" name="Bike Recon Squadron" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">12"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">4</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="7409-c361-6ecf-5093" name="Pursuit Column" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Add 1 to Advance rolls.</characteristic></characteristics></profile><profile id="9048-6b39-6aad-54d1" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each biker has twin boltguns, bolt pistol and chainsword. One in 3 may substitute mounted boltguns with flamer, plasma gun or meltagun (codex notes alternative mounted melta family).</characteristic></characteristics></profile><profile id="6102-7948-2fac-5c4e" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">ARMY RULE: Infernal Serum (+1 W already applied, FNP 5+, regenerate 1 W at start of your turn). Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="7264335e-cf1d-4f6a-bc20-f13714636476" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Each biker has twin boltguns, bolt pistol and chainsword. One in 3 may substitute mounted boltguns with flamer, plasma gun or meltagun (codex notes alternative mounted melta family). | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="f970-97e9-fd19-5ef1" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="0af8-35bc-aeb5-5316"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e171-49c0-0f78-5571" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" 