false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="ba50b0ca-3ee0-440c" name="Standard Reserves" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Select only when the mission allows this formation and it fits the Reserves points cap; normal later-round timing applies. This is not an automatic Deep Strike grant.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7702a73a-a568-45fb" name="Deep Strike — ordinary permitted arrival" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="de658d24-404c-4753" name="Deep Strike" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the existing Terminator Teleportarium or printed jump-pack deployment rule where applicable; DOES NOT override normal Reserves caps, distance or arrival timing.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="9869abda-7a53-4f97" name="Cohort Insertion — First-turn Deep Strike" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="b57410df-8b0e-4cc7" name="Cohort Insertion" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Entire Chaplain-led formation (bundled in the selected unit size) deploys independently by Deep Strike, including the approved FIRST FRIENDLY Reinforcements step if the first-turn option was chosen. This waives ONLY first-round arrival prohibition, not Reserves cap, coherency or enemy exclusion. No transport may gain early arrival by carrying this unit.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="3271dad5-c504-4586" name="Cohort Insertion — Later-round Deep Strike" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="b49f4b58-8f86-4aae" name="Cohort Insertion" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Entire Chaplain-led formation (bundled in the selected unit size) deploys independently by Deep Strike, including the approved FIRST FRIENDLY Reinforcements step if the first-turn option was chosen. This waives ONLY first-round arrival prohibition, not Reserves cap, coherency or enemy exclusion. No transport may gain early arrival by carrying this unit.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c72f2287-9e25-49c8" name="Embarked in: Thunderhawk Gunship" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="2590-7f88-3edf-5c1a" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="c220199c-002b-4564" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Thunderhawk Gunship. Formation is 10 infantry model(s) plus its mandatory PAID Chaplain; minimum passenger spaces 21. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b38813fd-dd58-4959" name="Embarked in: Stormbird Heavy Assault Ship" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="b65a-7401-1fdc-5c1d" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="037e3e1f-b0a6-4c60" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Stormbird Heavy Assault Ship. Formation is 10 infantry model(s) plus its mandatory PAID Chaplain; minimum passenger spaces 21. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="a82dab1b-4fb9-4e8d" name="MANDATORY combined Lost Cohort roster slot" hidden="false" collective="false" import="true" defaultSelectionEntryId="8ea0c4f9-86b6-47b1"><constraints><constraint id="fb56daf6-4a6b-465f" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="751726f8-f66a-4a8a" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries/><entryLinks><entryLink id="8ea0c4f9-86b6-47b1" name="Count 1 of 2 combined Lost Cohort slots" hidden="false" collective="false" import="true" type="selectionEntry" targetId="442d74e2-b162-4b3a"/></entryLinks></selectionEntryGroup></selectionEntryGroups><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="c28b-3452-84c1-5ad6" name="Lost Cohort — Terminator Armour" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="8d77-eba4-ff58-58ff" name="Lost Cohort" hidden="false" targetId="2962-6989-212f-598d" primary="true"/><categoryLink id="521a-1233-a18c-5af8" name="Terminators" hidden="false" targetId="c317-a497-01c6-5b78" primary="false"/><categoryLink id="0627-536b-e16d-5dde" name="Infantry" hidden="false" targetId="521d-dd50-6a49-58fb" primary="false"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="2" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f64c-bedd-1cc7-5562" type="max"/></constraints><profiles><profile id="7e5a-4e70-129f-5c28" name="Lost Cohort — Terminator Armour" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">5"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">6</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">4</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="93e7-a507-b843-58e2" name="Afflicted Ferocity" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each afflicted model gains +1 Attack with ONE selected melee weapon profile. Maximum TWO Lost Cohort units in the army. Each requires its own separate qualifying Terminator Chaplain at muster (cost bundled in the size selection). Unsupervised D6 Control Test at start of Command phase: 4+ pass, otherwise Aggressive Pursuit. Deep Strike and optional first-turn Cohort Insertion subject to normal enemy distance and Reserves limits.</characteristic></characteristics></profile><profile id="a1cf-7b60-090c-584a" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">5–10 afflicted (excluding attached Chaplain). Storm bolter/combi-weapon with power fist or chainfist; one reaper autocannon OR heavy flamer per 5. Deep Strike; each requires its own separately-costed Terminator Chaplain. 2 transport spaces per model.</characteristic></characteristics></profile><profile id="d539-d19c-e7b0-57e3" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">ARMY RULE: Infernal Serum (+1 W already applied, FNP 5+, regenerate 1 W at start of your turn). Terminator Teleportarium: Deep Strike at no extra points. Lost Cohort: mandatory attached Chaplain already INCLUDED in formation option cost below. Do NOT buy the same Chaplain again as an independent unit; total Lost Cohort ≤2 units across both sheets. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="3c70700a-1d3a-5d87" name="Chaplain counted in this catalogue" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each SELECTABLE squad-size option already includes the points of exactly ONE separately required starting Chaplain. The Chaplain is represented by the chosen formation option (not a separately added Character selection). Do NOT add its points again. The chosen Chaplain has its actual separate character datasheet available in this catalogue for reference, but selecting that independent datasheet would charge twice. Strict model-by-model attachment is NOT automated in the current data structure.</characteristic></characteristics></profile><profile id="d127c5db-9458-48de-8e72-99bee8d7ff50" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: 5–10 afflicted (excluding attached Chaplain). Storm bolter/combi-weapon with power fist or chainfist; one reaper autocannon OR heavy flamer per 5. Deep Strike; each requires its own separate | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="c60e-f1a3-a23e-5f4f" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="e0bb-5b7d-f85a-5f86" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="be9c-67ca-e4e6-55c3" name="Lost Cohort — Control" hidden="false" targetId="3bff-1efe-c60b-511f" type="rule"/><infoLink id="8a2af9cc-5983-5806" name="Legion Teleportarium" hidden="false" targetId="03fea306-e073-5356" type="rule"/><infoLink id="1f26e2ad-050c-50a2" name="Cohort Insertion" hidden="false" targetId="4bbaac30-6adb-5c5f" type="rule"/><infoLink id="44dfb7e0-e79d-5971" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="a7bd-5b45-3965-57fa" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="0d6b-c847-a00d-52c8"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="dd48-5f53-30f8-56d6" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5a36-e48d-8bec-51ba" type="max"/></constraints><selectionEntries><selectionEntry id="75d4-0819-f214-5327" name="5 afflicted + attached Terminator Chaplain" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="330.0"/></costs><profiles><profile id="a6c7-f1cb-7337-58fa" name="Build notes" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Includes 95pt mandatory Terminator Chaplain; Deep Strike; first-round Cohort Insertion per codex.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="3ff6e04f-1d8e-48b6" name="Champion 1 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="879187bc-b467-407a"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="824f17fa-eeb4-4b11" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="34f66695-f8b1-40b6" type="max"/></constraints><selectionEntries><selectionEntry id="879187bc-b467-407a" name="Storm bolter, power fist" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><in