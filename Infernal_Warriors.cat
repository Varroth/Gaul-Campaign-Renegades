91-5978"><constraints><constraint id="f2b5-0766-307b-5323" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="3976-745d-ef95-58e6" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="af25-06f1-5091-5978" name="No attached Leader" hidden="false" type="upgrade" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="68db-6a68-99de-5372" name="Attached: Infernal Chaplain (already paid separately; generic Chaplain)" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry></selectionEntries><entryLinks><entryLink id="840e-e7cc-8296-5709" name="Attached: Rhazek Thorne (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="8c58-1e34-d27d-50b2"/><entryLink id="3b86-26f6-3884-543d" name="Attached: Dravik Sorn (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="7198-a73c-d688-5b38"/><entryLink id="668d-2a3f-03fc-5de0" name="Attached: Malthor Ghor (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="f9f7-04bb-dfbb-578f"/><entryLink id="906c-0b96-044c-56f1" name="Attached: Rhazdan Krell (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="2017-314b-8d6e-5530"/></entryLinks></selectionEntryGroup></selectionEntryGroups><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><infoLinks><infoLink id="010a-dff9-f847-53de" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="9c92-bbc7-4934-5529" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="fff6-dd8b-9daf-5a44" name="Warp-Aggravated Pain" hidden="false" targetId="1ed1-86a9-2d02-5af3" type="rule"/><infoLink id="71c4-8573-e552-595f" name="Rare Psychic-Induced Psychosis" hidden="false" targetId="8da3-eead-cabf-56ea" type="rule"/></infoLinks><modifiers><modifier type="set" field="43bf-9724-4877-5c17" value="4"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="03a3-ea1d-2004-526b" name="Void Breachers" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="17ae-9848-e1f3-5072" name="Infantry" hidden="false" targetId="521d-dd50-6a49-58fb" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7af6-aca2-29ce-5407" type="max"/></constraints><profiles><profile id="51b9-c8fb-4a10-51d5" name="Void Breachers" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">5"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="2d67-1c6b-33c7-5a7f" name="Breacher Shield" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Re-roll one failed saving throw per enemy Shooting phase while this unit is on an objective.</characteristic></characteristics></profile><profile id="5b18-cb54-5ffc-5bc0" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Boarding shield, breacher gun and combat blade each. One in five may exchange breacher gun for flamer or meltagun. Champion may use power maul; shield is defensive wargear, not a bonus weapon.</characteristic></characteristics></profile><profile id="4cd5-a924-9492-5869" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">ARMY RULE: Infernal Serum (+1 W already applied, FNP 5+, regenerate 1 W at start of your turn). Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="aa755f5a-50c3-4ac5-8cde-f7a98c57800e" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Boarding shield, breacher gun and combat blade each. One in five may exchange breacher gun for flamer or meltagun. Champion may use power maul; shield is defensive wargear, not a bonus weapo | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile><profile id="5e9c-afec-72ca-5fe8" name="LEADER Assignment — instance specific" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The selected attachment is local to THIS Void Breachers unit, allowing multiple copies of this datasheet to have different Leaders. A matching Leader must also be bought separately. Use New Recruit's native Leader association command when available; this 0-point declaration does not physically join roster entries or apply an attached Leader's rules. Older Leader-side bodyguard-type choices remain for saved roster compatibility. A bodyguard normally takes one Leader; Lost Cohort uses its mandatory separate bundled Chaplain system.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="4677-2954-9ba2-52bf" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="70bd-a178-50f6-5eb5"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0318-6957-5362-51d1" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b6c6-6ff0-624b-5588" type="max"/></constraints><selectionEntries><selectionEntry id="70bd-a178-50f6-5eb5" name="5 models" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="115.0"/></costs><selectionEntryGroups><selectionEntryGroup id="53582cc9-4be7-4beb" name="Champion 1 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="6f2139dd-79c3-4fc8"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="59308a55-d6af-45e5" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForc