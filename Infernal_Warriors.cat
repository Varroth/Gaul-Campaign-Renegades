ype="unit" import="true"><categoryLinks><categoryLink id="fda8-8839-bf8d-5d25" name="Mounted" hidden="false" targetId="bf60-94d3-7c97-5f42" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1fe2-2379-ccdf-5727" type="max"/></constraints><profiles><profile id="9dcd-55d8-d5fb-5e1d" name="Attack Bike Flanking Section" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">12"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">5</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="e0a0-80b3-d759-5362" name="Flanking Run" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, re-roll the Advance roll when moving toward the nearest objective.</characteristic></characteristics></profile><profile id="901e-5537-92c9-5b6e" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Exactly TWO attack bikes. Twin boltguns and heavy bolter per bike; either heavy bolter may become multi-melta. MOUNTED ASTARTES, not VEHICLE; inducted riders receive ordinary Serum under the Expanded Parchment, while their chassis is not a separate regenerating vehicle.</characteristic></characteristics></profile><profile id="d430-4f2c-792d-5309" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">MOUNTED ASTARTES: Serum grants +1 W (now W5), FNP 5+, and restores 1 lost wound at start of own turn while alive; no separately-regenerating vehicle chassis.</characteristic></characteristics></profile><profile id="e8bdb6bd-7e3d-4f85-8cf7-563419bac884" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Exactly TWO attack bikes. Twin boltguns and heavy bolter per bike; either heavy bolter may become multi-melta. MOUNTED ASTARTES, not VEHICLE; inducted riders receive ordinary Serum under the | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="c01851af-5dba-540b" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/></infoLinks><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="95.0"/></costs><selectionEntryGroups><selectionEntryGroup id="a2962853-57bd-441d" name="First attack bike" hidden="false" collective="false" import="true" defaultSelectionEntryId="c5f83005-7d90-4306"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ec1dff32-c875-40f7" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1c629022-9988-47e9" type="max"/></constraints><selectionEntries><selectionEntry id="c5f83005-7d90-4306" name="Twin bol