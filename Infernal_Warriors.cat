4af1694f9ab4" name="Standard Strategic Reserves (mission restrictions)" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="b7aa122b-79f7-4cd9-8fc9-9f3dc5f7f342" name="Standard Reserves" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Select only when the mission allows this formation and it fits the Reserves points cap; normal later-round timing applies. This is not an automatic Deep Strike grant.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="4342e5d3-52e8-4b2f-a349-815e9106e081" name="Embarked in: Rhino Carrier" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="7a6c-99a9-6f03-5c81" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="886becfa-67b1-48d1-9331-ba566bb5f1de" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Rhino Carrier. Formation is 10 infantry model(s); minimum passenger spaces 10. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="3aba572a-022f-4572-9765-a23030362e19" name="Embarked in: Land Raider" type="upgrade" hidden="false" collective="false