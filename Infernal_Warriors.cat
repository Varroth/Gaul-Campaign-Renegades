hidden="false" targetId="9856-3547-9660-54c2" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ffb3-5e8d-8381-5cb9" type="max"/></constraints><profiles><profile id="4bda-2fd9-3a52-5c18" name="Terrax Termite Assault Drill" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">8"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">10</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">12</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="d866-7d0e-81d3-5756" name="Subterranean Approach" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Reserves arrival follows mission rules; carries 10 eligible Infantry models.</characteristic></characteristics></profile><profile id="6a2a-fe59-0005-547d" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Magma/melta cutters, capacity 10 appropriate Infantry models; Subterranean Approach uses mission Reserves restrictions.</characteristic></characteristics></profile><profile id="8895-4c6f-6710-5bf3" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Does not receive Infernal Serum. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="5b1979d1-05a2-4862" name="Passenger Manifest &amp; capacity" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Transport registration: Passenger-bearing Infantry must DECLARE this vehicle type in their Deployment / passenger assignment selection. Capacity 10 spaces; Terminators and jump-equipped passengers may use two each where permitted. Include ALL attached leaders and all squads sharing a carrier; do not exceed capacity. The catalogue records carrier TYPE, not a unique vehicle instance, so this capacity total must still be checked before play.</characteristic></characteristics></profile><profile id="48f2579c-990d-43d1" name="Mechanised Vanguard conditions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">OPTIONAL pre-battle move of up to 3 inches after deployment if this non-AIRCRAFT transport starts with friendly INFANTRY embarked and the mission permits. End over 9 inches from all enemies, outside enemy deployment zone. 1/1,000-point battle limit (max 2). Aircraft can never gain this privilege. Never confers a charge or first-turn aircraft arrival exception.</characteristic></characteristics></profile><profile id="a71791cf-bca4-4303-a013-3ca98e080baf" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Magma/melta cutters, capacity 10 appropriate Infantry models; Subterranean Approach uses mission Reserves restrictions. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks/><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="185.0"/></costs><selectionEntryGroups><selectionEntryGroup id="b90e7056-0fc6-4f92" name="Fixed drilling weapons" hidden="false" collective="false" import="true" defaultSelectionEntryId="1b7149de-2a49-4ab2"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a6d283d1-bfdd-4538" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7e04571c-02e6-4630" type="max"/></constraints><selectionEntries><selectionEntry id="1b7149de-2a49-4ab2" name="Magma cutters" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="812b0beb-06ed-4624" name="Magma cutters" hidden="false" targetId="c8d5fb77-4c07-5717" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="b762f7c4-c0d7-45d3" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><constraints><constraint id="33096f93-9f27-41ea" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><entryLinks><entryLink id="8aee5c2d-bf5b-4247" name="Ash-Forged Targeter (+10 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="46d64132-8587-4978"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="5856-87a6-b30e-596e" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><conditi