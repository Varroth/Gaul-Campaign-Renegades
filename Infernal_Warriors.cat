s></selectionEntryGroup></selectionEntryGroups><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><infoLinks><infoLink id="03d7-94bb-6e89-5250" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="f80e-6498-3571-5fd5" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="6e6b-2c78-6e1d-5d95" name="Warp-Aggravated Pain" hidden="false" targetId="1ed1-86a9-2d02-5af3" type="rule"/><infoLink id="2fdb-7580-8db3-5eb8" name="Rare Psychic-Induced Psychosis" hidden="false" targetId="8da3-eead-cabf-56ea" type="rule"/></infoLinks><modifiers><modifier type="set" field="7af6-aca2-29ce-5407" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="0a82-b22f-e88c-5dbd" name="Tactical Support Cadre" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="e56c-7536-ab91-58b3" name="Infantry" hidden="false" targetId="521d-dd50-6a49-58fb" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="91dc-4c90-6ef7-5e7d" type="max"/></constraints><profiles><profile id="0c26-3f2e-c2f3-556a" name="Tactical Support Cadre" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="4e0e-693e-8369-5898" name="Specialist Volley" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per turn, re-roll one Hit roll made with a special weapon.</characteristic></characteristics></profile><profile id="1edb-0637-06d5-5865" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Choose ONE common specialist weapon family for non-Leaders: flamer, volkite charger, plasma gun, meltagun or firstborn grav-gun. Leader may have same weapon or boltgun and power weapon. No more than 2 different types per squad.</characteristic></characteristics></profile><profile id="bf71-d76d-14d8-5620" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">ARMY RULE: Infernal Serum (+1 W already applied, FNP 5+, regenerate 1 W at start of your turn). Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="3fdf01ba-0e48-4f86-9353-f7222d0e445c" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Choose ONE common specialist weapon family for non-Leaders: flamer, volkite charger, plasma gun, meltagun or firstborn grav-gun. Leader may have same weapon or boltgun and power weapon. No m | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile><profile id="bdaa-2dc0-cf36-526d" name="LEADER Assignment — instance specific" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The selected attachment is local to THIS Tactical Support Cadre unit, allowing multiple copies of this datasheet to have different Leaders. A matching Leader must also be bought separately. Use New Recruit's native Leader association command when available; this 0-point declaration does not physically join roster entries or apply an attached Leader's rules. Older Leader-side bodyguard-type choices remain for saved roster compatibility. A bodyguard normally takes one Leader; Lost Cohort uses its mandatory separate bundled Chaplain system.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="eba1-efa8-94a8-5aa4" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="d72d-6f00-530b-5561"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e092-666f-56ef-522b" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="135f-a6e2-6e7e-59df" type="max"/></constraints><selectionEntries><selectionEntry id="d72d-6f00-530b-5561" name="5 models" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="115.0"/></costs><selectionEntryGroups><selectionEntryGroup id="caebb497-51cd-4d46" name="Choose ONE weapon family for the squad" hidden="false" collective="false" import="true" defaultSelectionEntryId="cfde9410-9fe9-4985"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d7ca032b-ed68-40d0" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0e7cee40-e244-4cef" type="max"/></constraints><selectionEntries><selectionEntry id="cfde9410-9fe9-4985" name="All 5: flamer" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="cd822b27-ba48-4a7d" name="Flamer" hidden="false" targetId="0c85-1069-ae67-5a20" type="profile"/></infoLinks></selectionEntry><selectionEntry id="2af72a2c-a128-4553" name="4 flamer + leader boltgun + power weapon" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="bdd8f3ad-1790-409d" name="Flamer" hidden="false" targetId="0c85-1069-ae67-5a20" type="profile"/><infoLink id="d1672bc2-34e7-40e0" name="Boltgun" hidden="false" targetId="883a-5ac2-abab-5817" type="profile"/><infoLink id="0aae0aa9-6b6b-41d8" name="Power sword / axe" hidden="false" targetId="1ec2-20f5-fe4e-5b6c" type="profile"/></infoLinks></selectionEntry><selectionEntry id="5e0ff611-d5c6-4872" name="All 5: volkite" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="0eeb4179-d0bd-40ae" name="Volkite charger" hidden="false" targetId="b305-3554-114a-5122" type="profile"/></infoLinks></selectionEntry><selectionEntry id="3d8132ea-3e50-47b5" name="4 volkite + leader boltgun + power weapon" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="b10ca3f9-712f-4d35" name="Volkite charger" hidden="false" targetId="b305-3554-114a-5122" type="profile"/><infoLink id="19dc7558-3e8a-46e2" name="Boltgun" hidden="false" targetId="883a-5ac2-abab-5817" type="profile"/><infoLink id="df60882d-1088-4515" name="Power sword / axe" hidden="false" targetId="1ec2-20f5-fe4e-5b6c" type="profile"/></infoLinks></sel