tId="74b8-67f9-a1d8-594e"/></entryLinks></selectionEntryGroup></selectionEntryGroups><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="0ded-83d9-9605-5b50" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="b3a7-3ebf-431e-534d" name="Tartaros Terminator Veterans" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="66d9-0358-876c-5386" name="Terminators" hidden="false" targetId="c317-a497-01c6-5b78" primary="true"/><categoryLink id="dff0-c80d-fb29-53be" name="Infantry" hidden="false" targetId="521d-dd50-6a49-58fb" primary="false"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="52c9-624e-f0c8-5b10" type="max"/></constraints><profiles><profile id="fb84-dce1-e3b1-51f8" name="Tartaros Terminator Veterans" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">6</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">4</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="2d05-95be-0c99-5c20" name="Relic Mobility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">May re-roll one Advance die. Has Deep Strike.</characteristic></characteristics></profile><profile id="1f31-d587-ab05-53b1" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Combi-bolter + power weapon. One reaper autocannon per 5, up to 2 chainfists per 5. Each occupies 2 transport spaces and has Deep Strike.</characteristic></characteristics></profile><profile id="a212-ce8d-ccab-56ab" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">ARMY RULE: Infernal Serum (+1 W already applied, FNP 5+, regenerate 1 W at start of your turn). Terminator Teleportarium: Deep Strike at no extra points. Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="11e9c86d-64a1-42b3-9a51-42be6af09d61" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Combi-bolter + power weapon. One reaper autocannon per 5, up to 2 chainfists per 5. Each occupies 2 transport spaces and has Deep Strike. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile><profile id="c42a-8167-87ba-5aa8" name="LEADER Assignment — instance specific" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The selected attachment is local to THIS Tartaros Terminator Veterans unit, allowing multiple copies of this datasheet to have different Leaders. A matching Leader must also be bought separately. Use New Recruit's native Leader association command when available; this 0-point declaration does not physically join roster entries or apply an attached Leader's rules. Older Leader-side bodyguard-type choices remain for saved roster compatibility. A bodyguard normally takes one Leader; Lost Cohort uses its mandatory separate bundled Chaplain system.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="0be9-296a-03de-5a49" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="57de-2608-f97e-5cb4" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="91a9-15e6-c4ea-5168" name="Warp-Aggravated Pain" hidden="false" targetId="1ed1-86a9-2d02-5af3" type="rule"/><infoLink id="1a87-26d1-ede7-52d3" name="Rare Psychic-Induced Psychosis" hidden="false" targetId="8da3-eead-cabf-56ea" type="rule"/><infoLink id="9f73bb93-c2f1-5f0e" name="Legion Teleportarium" hidden="false" targetId="03fea306-e073-5356" type="rule"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="8f57-75ce-8bdb-5c2d" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="49a2-ced2-6938-5e22"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="30d1-2405-0838-5abb" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ee7b-b200-298c-53b9" type="max"/></constraints><selectionEntries><selectionEntry id="5103-105a-8060-5fdc" name="5 models" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="185.0"/></costs><selectionEntryGroups><selectionEntryGroup id="1c57d