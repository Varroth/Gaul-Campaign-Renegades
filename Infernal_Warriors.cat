<?xml version='1.0' encoding='UTF-8'?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="9337-a54f-d3db-5126" name="Infernal Warriors" revision="10" battleScribeVersion="2.03" gameSystemId="0408-b3dc-97f0-53dc" gameSystemRevision="6" library="false"><selectionEntries><selectionEntry id="cedb-da92-81b0-5a8c" name="Infernal Legionaries" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="47d7-e43b-7ff5-5a5d" name="Battleline" hidden="false" targetId="ec2c-68bb-bfbc-5ee3" primary="true"/><categoryLink id="29d5-de93-442d-5916" name="Infantry" hidden="false" targetId="521d-dd50-6a49-58fb" primary="false"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="6" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ce9a-7aa5-d2d2-5452" type="max"/></constraints><profiles><profile id="68df-0ae1-6a34-5e21" name="Infernal Legionaries" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="db2b-e497-7b74-52cb" name="Disciplined Line" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One squad weapon may re-roll one Hit roll against the Directed Objective.</characteristic></characteristics></profile><profile id="5f25-bad0-e29e-5b46" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Boltgun, bolt pistol and combat blade. Champion may replace blade with power weapon. One special/heavy weapon per 5, maximum 2 per 10: plasma gun, meltagun, flamer, autocannon, heavy bolter, or firstborn replacement grav-gun, grav-cannon, multi-melta, plasma cannon, missile launcher. Replacements consume existing specialist slots.</characteristic></characteristics></profile><profile id="9417-e4e7-eaf7-5e31" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">ARMY RULE: Infernal Serum (+1 W already applied, FNP 5+, regenerate 1 W at start of your turn). Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="bcaa1b0a-1acc-40c1-ae49-86f4f4bd9954" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Boltgun, bolt pistol and combat blade. Champion may replace blade with power weapon. One special/heavy weapon per 5, maximum 2 per 10: plasma gun, meltagun, flamer, autocannon, heavy bolter, | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile><profile id="7f4f-a5cc-d8bc-5536" name="LEADER Assignment — instance specific" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The selected attachment is local to THIS Infernal Legionaries unit, allowing multiple copies of this datasheet to have different Leaders. A matching Leader must also be bought separately. Use New Recruit's native Leader association command when available; this 0-point declaration does not physically join roster entries or apply an attached Leader's rules. Older Leader-side bodyguard-type choices remain for saved roster compatibility. A bodyguard normally takes one Leader; Lost Cohort uses its mandatory separate bundled Chaplain system.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="0b58-b6fa-c0a1-55c4" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="4edf-5246-5c24-5989" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="031d-7e74-9235-58b2" name="Warp-Aggravated Pain" hidden="false" targetId="1ed1-86a9-2d02-5af3" type="rule"/><infoLink id="f03b-2440-6c66-5251" name="Rare Psychic-Induced Psychosis" hidden="false" targetId="8da3-eead-cabf-56ea" type="rule"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="1373-1252-b3ac-5382" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="9199-e012-42b2-52d0"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1180-1e19-83ce-555a" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0413-ade5-7835-5958" type="max"/></constraints><selectionEntries><selectionEntry id="9199-e012-42b2-52d0" name="5 models" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="95.0"/></costs><selectionEntryGroups><selectionEntryGroup id="b777cebf-9a12-4194" name="Champion 1 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="4c05f595