modifiers></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="f3c01d34-41b7-4e45" name="Legacy bodyguard TYPE reference (optional; use bodyguard-side assignment)" hidden="false" collective="false" import="true" defaultSelectionEntryId="99df2109-58b4-4723"><constraints><constraint id="07a93283-5795-46e5" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="c7a24762-5e3d-419a" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="99df2109-58b4-4723" name="Independent / no attached bodyguard" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="d925c835-2304-4724" name="Attach to: Ashen Chain Terminators" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="e094-37ca-b2d3-557b" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="d93933b8-7ef4-4477" name="Leader attachment — Infernal Terminator Chaplain" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Ashen Chain Terminators squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="05008f82-a1b5-4581" name="Attach to: Cataphractii Terminator Veterans" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="559b-35bb-bbdb-5632" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="278cc899-4932-4668" name="Leader attachment — Infernal Terminator Chaplain" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Cataphractii Terminator Veterans squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="3bf79d3b-3a84-41e4" name="Attach to: Tartaros Terminator Veterans" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="b3a7-3ebf-431e-534d" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="f612047e-fcce-422e" name="Leader attachment — Infernal Terminator Chaplain" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Tartaros Terminator Veterans squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><modifiers><modifier type="set" field="d0f4-e312-4aeb-58a0" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="8eb0-8d1d-a832-5447" name="DETACHMENT — War Hounds’ Legacy" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/><cost name="DP" typeId="6c3b-5f19-3bc2-5dbb" value="2.0"/></costs><categoryLinks><categoryLink id="0924-d56d-8946-513f" name="Detachments" hidden="false" targetId="3c17-c261-4038-5fcc" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4709-32b5-ff6a-5a8a" type="max"/></constraints><profiles><profile id="6ae0-353c-a52b-5729" name="War Hounds’ Legacy Detachment Rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Legion Battle Network: At start of Shooting OR Fight phase choose up to two different friendly ASTARTES within 12" of same friendly OFFICER/VOXMASTER. Once both target same enemy this phase, each re-rolls ONE Hit OR Wound (once).</characteristic></characteristics></profile><profile id="1bad-0892-1c2f-52c9" name="Legion Battle Network — complete detachment rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At START of one of your Shooting or Fight phases choose up to two different ASTARTES units within 12 inches of the SAME friendly OFFICER/VOXMASTER on battlefield. Once both selected units have targeted the SAME enemy this phase, each may re-roll ONE Hit OR ONE Wound die. Units embarked or off battlefield cannot issue commands.</characteristic></characteristics></profile><profile id="3c51-7b09-6a2d-5c19" name="Detachment Stratagems (reference only)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The Old Oath (1 CP): qualifying failed Battle-shock re-roll near another Astartes; Crossing Fires (1 CP): improve AP by 1 on a single second-unit ranged attack after first unit scores unsaved wound; Reserves in Step (1 CP): re-roll one Charge die for eligible arrival from Reserves; Unbroken Order (1 CP): clear routine Pain shooting penalty; Brotherhood of Iron (1 CP): infantry near non-aircraft vehicle gains Cover against one enemy unit; Marked and Broken (2 CP): two friendly units engage enemy, each re-rolls one Wound roll.</characteristic></characteristics></profile><profile id="79e6-df29-0cdc-5f3d" name="Eligible Enhancements / Upgrades (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Vox of the Unforgotten (non-character Infantry upgrade); Oath-Wrought Aegis (eligible generic Character); War Hounds’ Field Manual (Infantry upgrade); Remembrancer of Isstvan (Chaplain). Buy these directly within the eligible unit or generic Chaplain. Points are calculated automatically; availability follows selected detachments. Some edition-wide combined Enhancement limits still require manual checks.</characteristic></characteristics></profile><profile id="bece38ba-2ac2-5a2c" name="Force Disposition" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Choose ONE of unlocked dispositions for army: Take and Hold</characteristic></characteristics></profile><profile id="987b3430-2dd6-524f" name="Stratagem — The Old Oath (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Your Command phase: after one eligible ASTARTES unit within 6 inches of another friendly ASTARTES unit fails Battle-shock, re-roll the test before applying its outcome.</characteristic></characteristics></profile><profile id="ab482ab2-b404-5c0b" name="Stratagem — Crossing Fires (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Your Shooting phase: after an ASTARTES unit scores an unsaved wound on a visible target, a SECOND ASTARTES unit targeting that enemy improves AP by 1 on its NEXT SINGLE ranged attack this phase.</characteristic></characteristics></profile><profile id="bccb10da-5b83-55a8" name="Stratagem — Reserves in Step (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Your Charge phase: one legal charge by an ASTARTES INFANTRY unit that arrived from Reserves this turn may re-roll ONE Charge die. Does not bypass standard enemy separation or the no-double-reroll rule.</characteristic></characteristics></profile><profile id="8e426f0f-a625-5371" name="Stratagem — Unbroken Order (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Your Command phase: remove a routine Pain-Control -1 shooting Hit penalty from one non-Lost-Cohort unit.</characteristic></characteristics></profile><profile id="0bf6e18a-6a42-5d81" name="Stratagem — Brotherhood of Iron (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Opponent Shooting phase: select one ASTARTES INFANTRY unit wholly within 6 inches of a friendly non-AIRCRAFT vehicle; gain Benefit of Cover against one enemy unit’s ranged attacks this phase (not stackable).</characteristic></characteristics></profile><profile id="f1b4b359-3868-5cb7" name="Stratagem — Marked and Broken (2 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Fight phase: select one enemy currently engaged by TWO friendly units; each attacking unit may re-roll ONE Wound roll this phase.</characteristic></characteristics></profile><profile id="0a2b33c6-273b-59a5" name="Enhancement — Vox of the Unforgotten (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Eligibility and effect: Non-Character INFERNAL WARRIORS ASTARTES INFANTRY Upgrade; up to 3 paid copies. Unit gains VOXMASTER; command-network measurements from unit increase by 3 inches. Enhancement must be PURCHASED with applicable provisional points and respects 2,000-point limit of 4 distinct selections. Named characters cannot buy Character Enhancements.</characteristic></characteristics></profile><profile id="075a34f2-52a3-53e9" name="Enhancement — Oath-Wrought Aegis (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Eligibility and effect: Eligible non-Epic-Hero CHARACTER: first failed save each battle reduces that attack’s Damage by 1 (minimum 1). Enhancement must be PURCHASED with applicable provisional points and respects 2,000-point limit of 4 distinct selections. Named characters cannot buy Character Enhancements.</characteristic></characteristics></profile><profile id="b27f1ac4-5d64-58db" name="Enhancement — War Hounds’ Field Manual (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Eligibility and effect: Non-Character INFERNAL WARRIORS ASTARTES INFANTRY Upgrade; up to 3 paid copies. Once per battle immediately after Directed Objective is destroyed, retarget a new legal visible/near-VOXMASTER enemy. Enhancement must be PURCHASED with applicable provisional points and respects 2,000-point limit of 4 distinct selections. Named characters cannot buy Character Enhancements.</characteristic></characteristics></profile><profile id="8428ab5c-4b55-5ffd" name="Enhancement — Remembrancer of Isstvan (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Eligibility and effect: Eligible non-Epic-Hero CHAPLAIN: attached unit may re-roll first failed Battle-shock test each battle. Enhancement must be PURCHASED with applicable provisional points and respects 2,000-point limit of 4 distinct selections. Named characters cannot buy Character Enhancements.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="d6ca-9cbf-e275-5803" name="DETACHMENT — Crimson Onslaught" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/><cost name="DP" typeId="6c3b-5f19-3bc2-5dbb" value="1.0"/></costs><categoryLinks><categoryLink id="0c26-6348-0b97-5bc0" name="Detachments" hidden="false" targetId="3c17-c261-4038-5fcc" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="eae8-c118-4d3a-562a" type="max"/></constraints><profiles><profile id="52a4-cead-87a1-58fe" name="Crimson Onslaught Detachment Rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Close-assault and recon integrated doctrine; refer to Codex v1.3.7 Section V / XIX for complete detachment abilities, stratagems and Enhancements.</characteristic></characteristics></profile><profile id="6c9c-8705-c018-5ede" name="Controlled Fury — complete detachment rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The FIRST time each turn a friendly INFERNAL WARRIORS ASTARTES INFANTRY or MOUNTED unit successfully charges, it may re-roll ONE melee Hit roll during that Fight phase. Jump Packs qualify as Infantry; Attack Bikes qualify via Mounted. No duplicate keyword stacking.</characteristic></characteristics></profile><profile id="ca55-07cd-8fd8-5e62" name="Detachment Stratagems (reference only)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Redline Advance (1 CP): Infantry/Mounted +2 inches Advance, cannot shoot unless separately allowed; Anvil and Fang (1 CP): if two friendly units engage same enemy, one gains +1 melee Strength; Pain as Purpose (1 CP): after serum unit loses a model, surviving models +1 Battle-shock tests this turn; Shock Assault (1 CP): re-roll ONE Charge die; By the Chain (1 CP): Berzerkers/Butchers re-roll one failed melee Wound roll per five; No Quarter Asked (2 CP): after enemy destroyed, one nearby Infantry makes legal 3-inch consolidation.</characteristic></characteristics></profile><profile id="f484-8e76-0b8e-5bb5" name="Eligible Enhancements / Upgrades (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Crimson Spur (Jump Pack/Mounted upgrade); Pain-Sworn Standard (Berzerkers upgrade); The Measured Strike (Infantry/Mounted upgrade, one full Charge re-roll per battle); Chain of Resolve (generic Chaplain Enhancement). Buy these directly within the eligible unit or generic Chaplain. Points are calculated automatically; availability follows selected detachments. Some edition-wide combined Enhancement limits still require manual checks.</characteristic></characteristics></profile><profile id="cf475d16-49e9-552e" name="Force Disposition" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Choose ONE of unlocked dispositions for army: Purge the Foe OR Reconnaissance (choose one)</characteristic></characteristics></profile><profile id="f17f6d0c-3872-580c" name="Stratagem — Redline Advance (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Your Movement phase: one friendly ASTARTES INFANTRY or MOUNTED unit adds 2 inches to Advance roll; may not shoot unless another rule explicitly permits.</characteristic></characteristics></profile><profile id="b5ec63ab-fa71-5089" name="Stratagem — Anvil and Fang (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Fight phase: when TWO friendly units engage the same enemy, one gains +1 Strength on melee weapons this phase.</characteristic></characteristics></profile><profile id="25e47e4f-7e60-5004" name="Stratagem — Pain as Purpose (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">After an eligible serum-enhanced unit loses a model, remaining models gain +1 to Battle-shock tests until end of turn.</characteristic></characteristics></profile><profile id="ec6058ed-b865-537e" name="Stratagem — Shock Assault (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Your Charge phase: when an eligible friendly ASTARTES INFANTRY/MOUNTED unit makes a legal Charge roll, re-roll ONE die; never the same die twice.</characteristic></characteristics></profile><profile id="69e33c58-e464-522a" name="Stratagem — By the Chain (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Fight phase: one Infernal Berzerkers or Infernal Butchers unit may re-roll ONE failed melee Wound roll per five models.</characteristic></characteristics></profile><profile id="b53e669a-4a13-5d01" name="Stratagem — No Quarter Asked (2 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Fight phase: after destroying an enemy unit, one nearby eligible Infantry unit may make a legal 3-inch consolidation toward nearest enemy.</characteristic></characteristics></profile><profile id="201a28c2-33bd-5fc8" name="Enhancement — Crimson Spur (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Eligibility and effect: Non-Character JUMP PACK INFANTRY or MOUNTED Upgrade; max 3 paid copies. Add 1 inch to Advance rolls only; no extra Move or Advance-and-Charge. Enhancement must be PURCHASED with applicable provisional points and respects 2,000-point limit of 4 distinct selections. Named characters cannot buy Character Enhancements.</characteristic></characteristics></profile><profile id="2a7d07e3-ff76-533c" name="Enhancement — Pain-Sworn Standard (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Eligibility and effect: Non-Character Infernal Berzerkers Upgrade; max 3 paid copies. Once per battle ignore the first reduction to its melee Hit roll. Enhancement must be PURCHASED with applicable provisional points and respects 2,000-point limit of 4 distinct selections. Named characters cannot buy Character Enhancements.</characteristic></characteristics></profile><profile id="9ac1db2f-e06f-5e4a" name="Enhancement — The Measured Strike (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Eligibility and effect: Non-Character ASTARTES INFANTRY or MOUNTED Upgrade; max 3 paid copies. Once per battle re-roll ONE full Charge roll; cannot double-reroll same die. Enhancement must be PURCHASED with applicable provisional points and respects 2,000-point limit of 4 distinct selections. Named characters cannot buy Character Enhancements.</characteristic></characteristics></profile><profile id="2ec8efa3-17cd-5313" name="Enhancement — Chain of Resolve (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Eligibility and effect: Eligible non-Epic-Hero Chaplain: friendly Infernal Berzerkers within 6 inches improve Leadership by 1. Enhancement must be PURCHASED with applicable provisional points and respects 2,000-point limit of 4 distinct selections. Named characters cannot buy Character Enhancements.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5856-87a6-b30e-596e" name="DETACHMENT — Iron Reavers" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/><cost name="DP" typeId="6c3b-5f19-3bc2-5dbb" value="1.0"/></costs><categoryLinks><categoryLink id="bc7f-6ccb-7dee-5266" name="Detachments" hidden="false" targetId="3c17-c261-4038-5fcc" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5887-2db4-8ce6-5bdd" type="max"/></constraints><profiles><profile id="dc69-fab5-18ec-528f" name="Iron Reavers Detachment Rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Vehicle, armour and engineer-focused doctrine; see Codex v1.3.7 Section V / XIX for complete abilities, stratagems and Enhancements.</characteristic></characteristics></profile><profile id="0bca-a90a-ab3f-5e07" name="Iron and Ash — complete detachment rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At START of Shooting choose one friendly on-table VEHICLE and different INFANTRY within 9 inches with a shared legal target. If both attack that enemy, choose ONE of them to re-roll ONE Hit in that phase. Qualified Daemon Engines and ground Skimmer Stormravens can count; off-table Aircraft cannot.</characteristic></characteristics></profile><profile id="b858-c569-ff5e-51b6" name="Detachment Stratagems (reference only)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Machine-Ready (1 CP): vehicle ignore one Move reduction; Hammer the Breach (1 CP): vehicle weapon +1 AP into cover/Fortification; Emergency Field Repair (1 CP): vehicle within 3 inches of Hadrak Voss OR Forge Servitors regains 1 W once/battle; Armoured Curtain (1 CP): nearby Infantry Cover against one enemy unit; Old Night Ammunition (2 CP): relic tank re-roll one Wound vs Vehicle/Monster; Containment Protocol (1 CP): nearby Daemon Engine re-roll Battle-shock.</characteristic></characteristics></profile><profile id="a253-279d-d960-5f6b" name="Eligible Enhancements / Upgrades (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Ash-Forged Targeter (vehicle upgrade); Chain-Bound Governor (Daemon Engine upgrade); Pattern Reliquary (Forge Servitor upgrade); Siege Ledger (Artillery upgrade). Buy these directly within the eligible unit or generic Chaplain. Points are calculated automatically; availability follows selected detachments. Some edition-wide combined Enhancement limits still require manual checks.</characteristic></characteristics></profile><profile id="2eb24251-dd1e-5783" name="Force Disposition" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Choose ONE of unlocked dispositions for army: Priority Assets</characteristic></characteristics></profile><profile id="66dbd6d0-5747-5347" name="Stratagem — Machine-Ready (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Your Movement phase: one non-AIRCRAFT INFERNAL WARRIORS vehicle ignores one negative inches modifier to its Move characteristic (not terrain, mission or damage prohibitions).</characteristic></characteristics></profile><profile id="b28ed143-4c3b-58d2" name="Stratagem — Hammer the Breach (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Shooting phase: one vehicle attacking Fortification or enemy with Benefit of Cover improves AP by 1 on ONE weapon.</characteristic></characteristics></profile><profile id="2ee6f02a-439b-504a" name="Stratagem — Emergency Field Repair (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">End of either player’s Movement phase: one friendly VEHICLE within 3 inches of Hadrak Voss OR Forge Servitor Cohort regains 1 lost wound, maximum once per vehicle per battle; not resurrected.</characteristic></characteristics></profile><profile id="4fb449b1-c5f4-5912" name="Stratagem — Armoured Curtain (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Enemy Shooting phase: eligible friendly ASTARTES INFANTRY wholly within 3 inches of friendly non-AIRCRAFT vehicle gains Benefit of Cover against one enemy unit’s ranged attacks, not stacking.</characteristic></characteristics></profile><profile id="35d627d1-f826-5862" name="Stratagem — Old Night Ammunition (2 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Shooting phase: one Legion relic tank re-rolls ONE failed Wound roll against a Vehicle or Monster.</characteristic></characteristics></profile><profile id="f3bfc5c0-a530-568d" name="Stratagem — Containment Protocol (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">After friendly Daemon Engine within 6 inches of Hadrak Voss OR 3 inches of Forge Servitors fails Battle-shock, re-roll the test once. No allied daemon-only unit without Chapter keyword.</characteristic></characteristics></profile><profile id="3bf89c75-7a33-504f" name="Enhancement — Ash-Forged Targeter (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Eligibility and effect: Non-Character INFERNAL WARRIORS VEHICLE Upgrade; max 3 paid copies. Once each Shooting phase re-roll ONE ranged Hit roll. Enhancement must be PURCHASED with applicable provisional points and respects 2,000-point limit of 4 distinct selections. Named characters cannot buy Character Enhancements.</characteristic></characteristics></profile><profile id="daedd807-6e0d-5591" name="Enhancement — Chain-Bound Governor (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Eligibility and effect: Non-Character DAEMON ENGINE Upgrade; max 3 paid copies. Once/battle re-roll its own failed Battle-shock test; no serum benefits. Enhancement must be PURCHASED with applicable provisional points and respects 2,000-point limit of 4 distinct selections. Named characters cannot buy Character Enhancements.</characteristic></characteristics></profile><profile id="f5e0b703-dd42-543f" name="Enhancement — Pattern Reliquary (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Eligibility and effect: Forge Servitor Cohort Upgrade; max 3 paid copies. Once/battle when Hadrak Voss repairs a vehicle within 3 inches, +1 restored wound; does not stack with Maintenance Crew increase. Enhancement must be PURCHASED with applicable provisional points and respects 2,000-point limit of 4 distinct selections. Named characters cannot buy Character Enhancements.</characteristic></characteristics></profile><profile id="d7bfefb8-7a3e-5574" name="Enhancement — Siege Ledger (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Eligibility and effect: Non-Character ARTILLERY Upgrade; max 3 paid copies. Once each Shooting phase re-roll ONE Wound roll vs enemy with Benefit of Cover. Enhancement must be PURCHASED with applicable provisional points and respects 2,000-point limit of 4 distinct selections. Named characters cannot buy Character Enhancements.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b7ad-18e3-9d4d-57e1" name="DETACHMENT — Breach and Ruin" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/><cost name="DP" typeId="6c3b-5f19-3bc2-5dbb" value="1.0"/></costs><categoryLinks><categoryLink id="7386-4662-493c-56b0" name="Detachments" hidden="false" targetId="3c17-c261-4038-5fcc" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="03cd-e5ef-ede1-57cb" type="max"/></constraints><profiles><profile id="5799-8367-82e3-5dc3" name="Breach and Ruin Detachment Rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Void-breaching and Terminator doctrine, including Conditional Mechanised Vanguard transport discounts; see v1.3.7 Section V / XIX.</characteristic></characteristics></profile><profile id="4956-8c39-fa64-5bcf" name="No Door Holds — complete detachment rule" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per turn an eligible Void Breachers, Terminator, or Siege Infantry unit charging an enemy on an objective or receiving Cover may re-roll ONE Wound roll in ensuing Fight phase. Also offers limited Void Assault Insertion and Legion Assault Requisition transport discount under separate codex restrictions.</characteristic></characteristics></profile><profile id="c17f-8166-db0b-5857" name="Detachment Stratagems (reference only)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bulkhead Breakers (1 CP): breacher +1 melee AP on objective; Pressurised Entry (1 CP): re-roll one Charge die after disembark/Reserves; Shield Wall (1 CP): stationary Breachers Cover; Contain the Passage (1 CP): +1 OC per model on objective to eligible unit (not Battle-shocked or embarked); Vox-Silent Assault (1 CP): arrival/disembark Breachers/Terminators re-roll one ranged Hit; Cataphractii Resolve (2 CP): one Terminator allocated attack Damage -1 (minimum 1).</characteristic></characteristics></profile><profile id="4f70-535f-0558-5253" name="Eligible Enhancements / Upgrades (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Breachmaster’s Seal (Terminator upgrade); Void-Tempered Ward (Breachers upgrade); Dismantler’s Charge (Breachers/Terminator upgrade); Sunderer of Gates (Breachers/Siege Infantry upgrade). Buy these directly within the eligible unit or generic Chaplain. Points are calculated automatically; availability follows selected detachments. Some edition-wide combined Enhancement limits still require manual checks.</characteristic></characteristics></profile><profile id="01eb50dd-74ea-5c9a" name="Force Disposition" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Choose ONE of unlocked dispositions for army: Disruption</characteristic></characteristics></profile><profile id="f3ca1796-79ca-5d77" name="Stratagem — Bulkhead Breakers (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Fight phase: one Void Breachers unit improves melee AP by 1 against enemies on an objective.</characteristic></characteristics></profile><profile id="3cc5db4b-505f-574f" name="Stratagem — Pressurised Entry (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Your Charge phase: a TERMINATOR or Void Breachers unit that arrived from Reserves or disembarked this turn may re-roll ONE Charge die on a legal declared charge; no bypass of Deep Strike separation or Rapid Disembark prohibition.</characteristic></characteristics></profile><profile id="f94639e0-b0df-5e30" name="Stratagem — Shield Wall (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Opponent Shooting phase: one Void Breachers unit that stayed stationary in preceding Movement phase gains Benefit of Cover against the attacking enemy until phase end; no stacking.</characteristic></characteristics></profile><profile id="87ba5a1b-628a-5e6c" name="Stratagem — Contain the Passage (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">End of either player’s Movement phase: choose one eligible Void Breachers, TERMINATOR or ASTARTES INFANTRY unit in range of an objective. Each model in range has +1 OC until turn end; not applicable when Battle-shocked (OC 0) or embarked.</characteristic></characteristics></profile><profile id="80b3bf57-c6e9-5c3d" name="Stratagem — Vox-Silent Assault (1 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Your Shooting phase: one Void Breachers or TERMINATOR unit arrived from Reserves or disembarked this turn may re-roll ONE ranged Hit against enemy within 12 inches.</characteristic></characteristics></profile><profile id="3a4ac661-fe8b-5cef" name="Stratagem — Cataphractii Resolve (2 CP)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Fight phase: one TERMINATOR unit reduces Damage of one allocated attack by 1 (minimum 1).</characteristic></characteristics></profile><profile id="28f76071-4a45-56ba" name="Enhancement — Breachmaster’s Seal (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Eligibility and effect: Non-Character Terminator Upgrade; max 3 paid copies. +1 to Battle-shock tests; no lost Cohort control/Chaplain exemption. Enhancement must be PURCHASED with applicable provisional points and respects 2,000-point limit of 4 distinct selections. Named characters cannot buy Character Enhancements.</characteristic></characteristics></profile><profile id="4faba697-603c-58bb" name="Enhancement — Void-Tempered Ward (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Eligibility and effect: Non-Character Void Breachers Upgrade; max 3 paid copies. Once/battle treat ONE failed save as successful. Enhancement must be PURCHASED with applicable provisional points and respects 2,000-point limit of 4 distinct selections. Named characters cannot buy Character Enhancements.</characteristic></characteristics></profile><profile id="24039bce-0e1d-593f" name="Enhancement — Dismantler’s Charge (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Eligibility and effect: Non-Character Void Breachers or Terminator Upgrade; max 3 paid copies. Designate one melee weapon; +1 Strength. Enhancement must be PURCHASED with applicable provisional points and respects 2,000-point limit of 4 distinct selections. Named characters cannot buy Character Enhancements.</characteristic></characteristics></profile><profile id="958832a0-4fe5-5947" name="Enhancement — Sunderer of Gates (select at eligible unit)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Eligibility and effect: Non-Character Void Breachers or Siege Infantry Upgrade; max 3 paid copies. Once in Shooting or Fight phase re-roll ONE Wound roll vs a Fortification. Enhancement must be PURCHASED with applicable provisional points and respects 2,000-point limit of 4 distinct selections. Named characters cannot buy Character Enhancements.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="f1d2-4a82-72d7-5b2d" name="03 — RULES: Infernal Warriors Quick Reference" hidden="false" collective="false" type="upgrade" import="true"><categoryLinks><categoryLink id="7aba-b090-202f-50f0" name="Enhancements" hidden="false" targetId="40b7-29b0-a885-5757" primary="true"/></categoryLinks><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><constraints><constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="fc1a-d5dd-0dfe-5c79" type="max"/></constraints><infoLinks><infoLink id="48f2-8b6b-3df3-5ae1" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="d45c-9802-f15c-53e2" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="6901-8a9d-d370-59d8" name="Warp-Aggravated Pain" hidden="false" targetId="1ed1-86a9-2d02-5af3" type="rule"/><infoLink id="898f-3d37-1532-5d84" name="Rare Psychic-Induced Psychosis" hidden="false" targetId="8da3-eead-cabf-56ea" type="rule"/><infoLink id="ecb9-4b75-75c1-5752" name="Lost Cohort — Control" hidden="false" targetId="3bff-1efe-c60b-511f" type="rule"/><infoLink id="e4a6-6bfb-f6ba-5152" name="11th-Edition Homebrew Muster" hidden="false" targetId="88db-cb52-d552-50e7" type="rule"/><infoLink id="216e-6ce0-a5fc-5ea1" name="Khorne Ally Allowance" hidden="false" targetId="3ecd-6609-5f42-5166" type="rule"/><infoLink id="708e-5e40-d791-57b3" name="Unified Forces — Coalition (Homebrew)" hidden="false" targetId="2ebc-af04-8c25-5029" type="rule"/><infoLink id="7d96f070-e4a4-5e59" name="Vox-Directed Advance" hidden="false" targetId="dcda18a8-c302-54e3" type="rule"/><infoLink id="ab9c2a6e-7b20-58aa" name="Mechanised Vanguard" hidden="false" targetId="f4c7de0f-8a1a-503b" type="rule"/><infoLink id="e058fc49-d45d-582a" name="Pilot Resilience" hidden="false" targetId="595a068d-663b-51e6" type="rule"/><infoLink id="78920407-5057-53f0" name="Cohort Insertion" hidden="false" targetId="4bbaac30-6adb-5c5f" type="rule"/><infoLink id="1b6877cf-93ab-572b" name="Legion Teleportarium" hidden="false" targetId="03fea306-e073-5356" type="rule"/><infoLink id="87969761-f5ac-597e" name="Named Character Enhancement Lock" hidden="false" targetId="f45d38e4-bfe7-5602" type="rule"/><infoLink id="c5891dcd-db2d-5feb" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/></infoLinks><profiles><profile id="b423b1db-6522-401f" name="How to configure a roster" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Set PTS/DP limits and select MUSTER SETTINGS. Buy detachments, then choose MISSION Force Disposition. Authorise distinct Enhancements at Muster Settings before buying the paid unit Upgrade (one authorisation per name, even if repeated up to three squads). Assign bodyguards under each Leader. Select each infantry formation’s deployment or transport plan under its size option. Record and discount eligible carriers under Breach and Ruin. Transport passenger capacity and exact character-to-squad instance matches still require final physical roster verification.</characteristic></characteristics></profile><profile id="054f-0b9a-8af6-584a" name="ROSTER AUDIT — five mandatory pregame checks" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Before battle: (1) No more than TWO Lost Cohort squads total, including each unit's bundled separately paid qualifying Chaplain; (2) Khorne Daemon allies cost at most 25% of the agreed limit; (3) once PER ARMY Bloodletter Invocation requires paid Bloodletters in legal Reserves; (4) distinct Enhancements remain capped 2 at 1,000 / 4 at 2,000, and repeated unit Upgrades still pay on each recipient; (5) physically assign exact-instance Leaders and count all passenger models including their attached Leaders. The offline field roster tool calculates automatic roster warnings where possible.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="961910bf-a3ae-49d0" name="01 — START HERE: Battle Size &amp; Enhancements" type="upgrade" hidden="false" collective="false" import="true"><categoryLinks><categoryLink id="be358a71-b762-4948" name="Muster Settings" hidden="false" targetId="9bc4-2501-1ea8-5f22" primary="true"/></categoryLinks><constraints><constraint id="eb9a4f00-6c7c-4aec" type="max" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="6a9dfb3f-9b6c-43f5" name="Battle size — select 1,000 or 2,000 points" hidden="false" collective="false" import="true" defaultSelectionEntryId="696da276-b253-4aca"><constraints><constraint id="cc1290e5-f322-4e59" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="e045ec77-7a5e-4b55" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="b5e1b5c6-826e-48dd" name="Incursion — 1,000 pts / 2 DP / 2 Enhancements" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="696da276-b253-4aca" name="Strike Force — 2,000 pts / 3 DP / 4 Enhancements" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="86125de8-2db8-4f0a" name="Battle format / Unified Forces declaration" hidden="false" collective="false" import="true" defaultSelectionEntryId="90527e91-d760-49cc"><constraints><constraint id="a9ca9912-b9c9-4a8d" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="6d9a5f16-8cef-40e1" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="90527e91-d760-49cc" name="Single Infernal Warriors army / ordinary battle" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="b08fb836-d706-413d" name="Unified Forces — approved allied 2v2 / combined force" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="1e1f6277-d708-455b" name="Unified Forces (homebrew standing alliance)" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">A selectable declaration for the permanent Infernal Warriors / Frozen Cogs / future Abandoned Dead allied doctrine. It is NOT restricted to Gaul; requires opponents’ approval for outside homebrew games. The Frozen Cogs and Abandoned Dead catalogues are not yet playable and selecting this mode does NOT add those armies, reduce allied points, or create free units.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="5ed3273e-20b4-4a3d" name="Enhancement Authorisations — each UNIQUE name counts once" hidden="false" collective="false" import="true"><constraints><constraint id="eca6a97a-db1f-41de" type="min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="8f4c5aa0-62bd-411c" type="max" field="selections" scope="parent" value="4" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="2de11288-d698-41c6" name="Authorise: Vox of the Unforgotten" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><constraints><constraint id="e766630f-e0a7-46ca" type="max" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><profiles><profile id="c13e5972-930c-4d35" name="Authorization for Vox of the Unforgotten" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Select this free permission ONCE per army before buying the associated paid Enhancement or Unit Upgrade. Repeated copies of the same named Unit Upgrade consume only ONE authorisation (each individual unit still pays its full upgrade cost). The battle-size setting enforces 2 distinct names at 1,000 points or 4 at 2,000 points.</characteristic></characteristics></profile></profiles><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1"