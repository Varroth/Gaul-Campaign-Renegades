nfoLink id="711878d5-ef10-40a0" name="Power fist" hidden="false" targetId="bea6-5c80-14b8-58f0" type="profile"/></infoLinks></selectionEntry><selectionEntry id="9c356d8f-5edf-4e14" name="Paired lightning claws" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="c342dc62-5e6f-4c0e" name="Lightning claws" hidden="false" targetId="54d9-9bbb-42d3-5e5c" type="profile"/></infoLinks></selectionEntry><selectionEntry id="0bf534d3-6bfc-4613" name="Combi-bolter, chainfist" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="33cacf41-1b4d-4e77" name="Combi-bolter / storm bolter" hidden="false" targetId="21b2-49c4-ad7f-57b9" type="profile"/><infoLink id="347916b2-9112-44e9" name="Chainfist" hidden="false" targetId="61de-3111-0731-5698" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="5498ff44-caf6-4243" name="Deployment / passenger assignment (one declared plan)" hidden="false" collective="false" import="true" defaultSelectionEntryId="3ff4e9cc-198d-4226"><constraints><constraint id="704bcdbd-f63f-4968" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="a6793887-593c-4768" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="3ff4e9cc-198d-4226" name="Deployed on the battlefield (normal)" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry><selectionEntry id="219a0423-d107-42d5" name="Standard Strategic Reserves (mission restrictions)" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="5af1319c-b09b-4ec9" name="Standard Reserves" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Select only when the mission allows this formation and it fits the Reserves points cap; normal later-round timing applies. This is not an automatic Deep Strike grant.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a5607e24-58d2-476b" name="Deep Strike — ordinary permitted arrival" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><profiles><profile id="990a688d-2395-45cb" name="Deep Strike" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the existing Terminator Teleportarium or printed jump-pack deployment rule where applicable; DOES NOT override normal Reserves caps, distance or arrival timing.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="885018c3-90cf-4367" name="Embarked in: Land Raider" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="b61d-137f-cbfd-594d" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="b54b7eae-73ea-42c1" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Land Raider. Formation is 5 infantry model(s); minimum passenger spaces 10. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="6a2963fd-fa41-400a" name="Embarked in: Spartan Assault Tank" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="722a-2c35-6f47-5a04" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="a25657f7-03ef-4690" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Spartan Assault Tank. Formation is 5 infantry model(s); minimum passenger spaces 10. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="47d849de-c945-4df4" name="Embarked in: Dreadclaw Drop Pod" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="8e27-5136-efd3-5a5e" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="2662f26f-5ee0-4f2d" name="Transport declaration" hidden="false" typeId="bd5c-f8