="false" collective="false" import="true" type="selectionEntry" targetId="9cb06d75-2acf-4d85"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="8eb0-8d1d-a832-5447" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="2de11288-d698-41c6" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink><entryLink id="285962a5-8359-4f6f" name="War Hounds’ Field Manual (+15 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="3028597c-2a14-4594"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="8eb0-8d1d-a832-5447" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="96ec7e6c-cb3a-47cd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink><entryLink id="86aeea88-585c-44a3" name="The Measured Strike (+15 pts)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="dcf44d0a-d9cb-4d92"><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="d6ca-9cbf-e275-5803" shared="true" includeChildSelections="false" includeChildForces="true"/></conditions></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="1307c605-442e-45a0" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="ab6c-63f1-f4a4-5c44" name="LEADER — select attached character for THIS squad (optional; 0 pts)" hidden="false" collective="false" import="true" defaultSelectionEntryId="22b1-36e9-467f-59a4"><constraints><constraint id="0136-84d0-b4c2-528f" type="min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/><constraint id="fae2-9c12-0426-514c" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><selectionEntries><selectionEntry id="22b1-36e9-467f-59a4" name="No attached Leader" hidden="false" type="upgrade" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry></selectionEntries><entryLinks><entryLink id="45f8-c775-16e7-5a0f" name="Attached: Balan Bannon (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="4e2e-770b-89ed-5e62"/><entryLink id="1ea4-f62d-1f4a-511c" name="Attached: Tervan Khol (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="a6a9-d08e-553c-543e"/><entryLink id="ab43-fa7d-a63c-531c" name="Attached: Rhazdan Krell (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="2017-314b-8d6e-5530"/></entryLinks></selectionEntryGroup></selectionEntryGroups><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><infoLinks><infoLink id="d013-4d19-e42d-5e33" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="06da-7d23-833b-5ba1" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="f6e1-6567-7f92-5759" name="Warp-Aggravated Pain" hidden="false" targetId="1ed1-86a9-2d02-5af3" type="rule"/><infoLink id="2a01-d79a-ecce-580d" name="Rare Psychic-Induced Psychosis" hidden="false" targetId="8da3-eead-cabf-56ea" type="rule"/></infoLinks><modifiers><modifier type="set" field="c17e-3940-3d33-5736" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="abf8-0469-47de-5477" name="Assault Jump Cadre" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="2eb9-5add-936f-5b52" name="Jump Infantry" hidden="false" targetId="2a7b-0016-ba81-5ad6" primary="true"/><categoryLink id="193c-be96-6e21-5cc4" name="Infantry" hidden="false" targetId="521d-dd50-6a49-58fb" primary="false"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d31a-eb0a-4572-53a2" type="max"/></constraints><profiles><profile id="b181-d309-bbe9-5fcb" name="Assault Jump Cadre" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">12"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="f2a0-2a61-b08b-5e5b" name="Assault Descent" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">When this unit arrives from Reserves, it may re-roll ONE Charge die. Jump pack warriors; default bolt pistols and chainswords, with up to two plasma pistols per ten.</characteristic></characteristics></profile><profile id="55fb-f251-5a84-515b" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All members have jump packs, chainswords and bolt pistols; up to 2 plasma pistols per 10. Must have jump packs to claim 12-inch Movement and jump deployment rules.</characteristic></characteristics></profile><profile id="4d1b-57c6-0702-50dc" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">ARMY RULE: Infernal Serum (+1 W already applied, FNP 5+, regenerate 1 W at start of your turn). Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="7a38ab16-2b6d-4520-87e6-cbf2047ef741" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: All members have jump packs, chainswords and bolt pistols; up to 2 plasma pistols per 10. Must have jump packs to claim 12-inch Movement and jump deployment rules. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile><profile id="47e0-8482-5e11-5346" name="LEADER Assignment — instance specific" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The selected attachment is local to THIS Assault Jump Cadre unit, allowing multiple copies of this datasheet to have different Leaders. A matching Leader must also be bought separately. Use New Recruit's native Leader association command when available; this 0-point declaration does not physically join roster entries or apply an attached Leader's rules. Older Leader-side bodyguard-type choices remain for saved roster compatibility. A bodyguard normally takes one Leader; Lost Cohort uses its mandatory separate bundled Chaplain system.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="ac4e-f0f8-11a3-54db" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="3617-ce8e-0464-5aff"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2eda-dbf7-0a32-5896" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3dbc-8dd1-fe35-5458" type="max"/></constraints><selectionEntries><selectionEntry id="3617-ce8e-0464-5aff" name="5 models" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="125.0"/></costs><selectionEntryGroups><selectionEntryGroup id="54095922-db0d-4e6b" name="Champion 1 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="0971d301-f077-4431"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="59c52487-3854-4375" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a4dcae0a-af01-4867" type="max"/></constraints><selectionEntries><selectionEntry id="0971d301-f077-4431" name="Jump pack, chainsword, bolt pistol" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="fba6554c-651f-4302" name="Chainsword" hidden="false" targetId="2b18-7f7c-4b12-568a" type="profile"/><infoLink id="bddf3297-dabc-4d00" name="Bolt pistol" hidden="false" targetId="19be-3f27-bea8-5ca4" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="b883aba1-0bb9-427b" name="Warrior 2 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="47d5a08f-fb0c-465c"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="73fc3688-80fa-4bcf" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6294ecec-6411-4201" type="max"/></constraints><selectionEntries><selectionEntry id="47d5a08f-fb0c-465c" name="Jump pack, chainsword, bolt pistol" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="c1b3114f-d7f6-47eb" name="Chainsword" hidden="false" targetId="2b18-7f7c-4b12-568a" type="profile"/><infoLink id="f83e8049-86ed-465e" name="Bolt pistol" hidden="false" targetId="19be-3f27-bea8-5ca4" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="70bd5277-f9d5-4944" name="Warrior 3 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="923685f2-4e0e-44f3"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="82338444-5a96-46e0" type="min"/><constraint field="selectio