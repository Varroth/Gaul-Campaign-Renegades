75c-5ffa" value="0.0"/></costs></selectionEntry></selectionEntries><entryLinks><entryLink id="2ae0-4c69-8d57-5912" name="Attached: Varkhul Renn (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="1b8b-5f8a-d5b7-5bff"/><entryLink id="310f-d4a6-fd02-54cb" name="Attached: Velkan Rusk (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="ce84-685e-7d1b-52c3"/><entryLink id="2da7-b98f-d979-5960" name="Attached: Kessel Rane (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="30b5-e38e-8573-5737"/></entryLinks></selectionEntryGroup></selectionEntryGroups><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><infoLinks><infoLink id="93a4-d25f-90d7-5b39" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="674e-b41f-7c38-5e2c" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="2966-f06a-7d76-5303" name="Warp-Aggravated Pain" hidden="false" targetId="1ed1-86a9-2d02-5af3" type="rule"/><infoLink id="73a3-e609-bf26-5764" name="Rare Psychic-Induced Psychosis" hidden="false" targetId="8da3-eead-cabf-56ea" type="rule"/></infoLinks><modifiers><modifier type="set" field="91dc-4c90-6ef7-5e7d" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="2cd2-8998-18bc-5ad1" name="Heavy Support Cadre" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="0671-fafe-b9b2-578d" name="Infantry" hidden="false" targetId="521d-dd50-6a49-58fb" primary="true"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0fab-267e-4aac-5b11" type="max"/></constraints><profiles><profile id="578e-ccaf-142e-5c8b" name="Heavy Support Cadre" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="683d-b0b5-45b1-5828" name="Sustained Fire" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If stationary, re-roll one heavy-weapon Wound roll per turn.</characteristic></characteristics></profile><profile id="353c-8903-ab1a-54b9" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Choose ONE heavy weapon family: heavy bolter, autocannon, missile launcher, lascannon, grav-cannon, multi-melta or plasma cannon. Leader may keep boltgun. Declare family before battle.</characteristic></characteristics></profile><profile id="4dc4-9c67-2334-5f42" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">ARMY RULE: Infernal Serum (+1 W already applied, FNP 5+, regenerate 1 W at start of your turn). Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="614f4a70-4dc1-4fca-8480-8264494c3a55" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Choose ONE heavy weapon family: heavy bolter, autocannon, missile launcher, lascannon, grav-cannon, multi-melta or plasma cannon. Leader may keep boltgun. Declare family before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile><profile id="a978-7e3e-51e4-5695" name="LEADER Assignment — instance specific" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The selected attachment is local to THIS Heavy Support Cadre unit, allowing multiple copies of this datasheet to have different Leaders. A matching Leader must also be bought separately. Use New Recruit's native Leader association command when available; this 0-point declaration does not physically join roster entries or apply an attached Leader's rules. Older Leader-side bodyguard-type choices remain for saved roster compatibility. A bodyguard normally takes one Leader; Lost Cohort uses its mandatory separate bundled Chaplain system.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="e41e-45a6-4298-533e" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="ace0-b336-bd28-5ded"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0354-6de1-e05a-5dd4" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c5e9-2161-4377-5de8" type="max"/></constraints><selectionEntries><selectionEntry id="ace0-b336-bd28-5ded" name="5 models" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="125.0"/></costs><selectionEntryGroups><selectionEntryGroup id="b2013c79-d703-47be" name="Choose ONE weapon family for the squad" hidden="false" collective="false" import="true" defaultSelectionEntryId="635bf672-5460-450f"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="06f6bbf9-3369-4810" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b37814d3-d0f4-4e50" type="max"/></constraints><selectionEntries><selectionEntry id="635bf672-5460-450f" name="All 5: heavy bolter" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="873346c7-3b42-4a2f" name="Heavy bolter" hidden="false" targetId="72f2-bb1a-9e40-5de3" type="profile"/></infoLinks></selectionEntry><selectionEntry id="19e75bc6-891b-47a1" name="4 heavy bolter + leader boltgun" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="99a0124a-0341-47e5" name="Heavy bolter" hidden="false" targetId="72f2-bb1a-9e40-5de3" type="profile"/><infoLink id="f092d698-a536-4d72" name="Boltgun" hidden="false" targetId="883a-5ac2-abab-5817" type="profile"/></infoLinks></selectionEntry><selectionEntry id="d3f74894-1f57-4475" name="All 5: autocannon" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="c122d5aa-8b1e-4f99" name="Autocannon" hidden="false" targetId="bab9-db31-01d9-5507" type="profile"/></infoLinks></selectionEntry><selectionEntry id="f75f7f7c-8e6f-49b2"