e passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="20857f57-f7f7-4435-a491-407d25e3cdc8" name="Embarked in: Stormbird Heavy Assault Ship" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="b65a-7401-1fdc-5c1d" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="36830bb1-81e5-49c7-825a-9a72d7d62ccc" name="Transport declaration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">START EMBARKED in a separately purchased Stormbird Heavy Assault Ship. Formation is 10 infantry model(s); minimum passenger spaces 10. Add attached character passenger spaces separately. A vehicle cannot be assigned more passengers than its printed capacity. This selector does not automatically bind to a specific vehicle instance or validate multiple squads combined in one carrier.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1ae39a2d-860f-4041-95ba-b5149c83f760" name="Embarked in: Mastodon Heavy Transport" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="6403-07f8-9aad-532c" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="7cdd