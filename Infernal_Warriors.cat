e="0.0"/></costs></selectionEntry><selectionEntry id="4d0b-dd5b-187f-574b" name="Attached: Infernal Chaplain (already paid separately; generic Chaplain)" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs></selectionEntry></selectionEntries><entryLinks><entryLink id="7f6c-d502-2369-5cfe" name="Attached: Balan Bannon (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="4e2e-770b-89ed-5e62"/><entryLink id="9872-ebe8-d9d1-56f4" name="Attached: Istran Valcor (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="23c7-8026-b34f-5370"/><entryLink id="2877-b679-2400-53d0" name="Attached: Tervan Khol (already paid separately)" hidden="false" collective="false" import="true" type="selectionEntry" targetId="a6a9-d08e-553c-543e"/></entryLinks></selectionEntryGroup></selectionEntryGroups><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><infoLinks><infoLink id="6cb8-90b5-33f8-5f5c" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="c439-542b-6e89-5857" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="f2c9-9bff-7ea9-55f9" name="Warp-Aggravated Pain" hidden="false" targetId="1ed1-86a9-2d02-5af3" type="rule"/><infoLink id="472a-ff3a-8394-5e14" name="Rare Psychic-Induced Psychosis" hidden="false" targetId="8da3-eead-cabf-56ea" type="rule"/></infoLinks><modifiers><modifier type="set" field="a3e3-415d-0d27-5428" value="4"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="cf62-7f18-8a35-505a" name="Despoiler Cadre" hidden="false" collective="false" type="unit" import="true"><categoryLinks><categoryLink id="2d02-a730-ec41-5d32" name="Battleline" hidden="false" targetId="ec2c-68bb-bfbc-5ee3" primary="true"/><categoryLink id="1a9c-e0ff-351c-5d15" name="Infantry" hidden="false" targetId="521d-dd50-6a49-58fb" primary="false"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="6" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="43bf-9724-4877-5c17" type="max"/></constraints><profiles><profile id="2603-2bf7-bd03-5cd2" name="Despoiler Cadre" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic></characteristics></profile><profile id="57bc-30e5-5133-5319" name="Legion Rush" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Re-roll one Advance die for this unit.</characteristic></characteristics></profile><profile id="e4ec-d6a3-49b6-5627" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each model has bolt pistol and chainsword or chainaxe. One model per 5 may take power weapon in place of melee weapon. Leader may take a plasma pistol.</characteristic></characteristics></profile><profile id="ffe1-8f71-fb44-5c4f" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">ARMY RULE: Infernal Serum (+1 W already applied, FNP 5+, regenerate 1 W at start of your turn). Fully accurate core interactions require human oversight; this is homebrew.</characteristic></characteristics></profile><profile id="6622df8f-9fa2-47e0-bc90-89363b93a6c2" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Each model has bolt pistol and chainsword or chainaxe. One model per 5 may take power weapon in place of melee weapon. Leader may take a plasma pistol. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile><profile id="8f9a-3f31-0d10-5790" name="LEADER Assignment — instance specific" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The selected attachment is local to THIS Despoiler Cadre unit, allowing multiple copies of this datasheet to have different Leaders. A matching Leader must also be bought separately. Use New Recruit's native Leader association command when available; this 0-point declaration does not physically join roster entries or apply an attached Leader's rules. Older Leader-side bodyguard-type choices remain for saved roster compatibility. A bodyguard normally takes one Leader; Lost Cohort uses its mandatory separate bundled Chaplain system.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="4b0a-04be-2954-57fd" name="Required unit size and formation" hidden="false" collective="false" import="true" defaultSelectionEntryId="09c9-2890-379a-517e"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1d4d-01f2-e6c4-5d42" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="530e-3edd-f4ac-5b4d" type="max"/></constraints><selectionEntries><selectionEntry id="09c9-2890-379a-517e" name="5 models" hidden="false" collective="false" type="upgrade" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="100.0"/></costs><selectionEntryGroups><selectionEntryGroup id="4593bf3d-77b2-4e2e" name="Champion 1 — choose exact wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="5d317e51-af41-4060"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9751a079-d34f-47f1" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1c0e927f-bfb0-463b" type="max"/></constraints><selectionEntries><selectionEntry id="5d317e51-af41-4060" name="chainsword, bolt pistol" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="269fe98e-aa52-4e9f" name="Chainsword" hidden="false" targetId="2b18-7f7c-4b12-568a" type="profile"/><infoLink id="10ae51fe-e71a-4ef4" name="Bolt pistol" hidden="false" targetId="19be-3f27-bea8-5ca4" type="profile"/></infoLinks></selectionEntry><selectionEntry id="2fcced46-2d3c-482a" name="chainaxe, bolt pistol" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="860ced0e-313f-4a77" name="Chainaxe" hidden="false" targetId="6adf-461d-bedd-589d" type="profile"/><infoLink id="82897c62-77a8-437b" name="Bolt pistol" hidden="false" targetId="19be-3