Legionaries squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="3d557b88-524f-4e4b" name="Attach to: Infernal Berzerkers" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="e17a-942c-38f0-5f23" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="07e752ae-f63a-4bc6" name="Leader attachment — Infernal Chaplain" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Infernal Berzerkers squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="d6e5c95e-37ef-4023" name="Attach to: Despoiler Cadre" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="cf62-7f18-8a35-505a" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="c2b90d8f-6999-4061" name="Leader attachment — Infernal Chaplain" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Despoiler Cadre squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="9d95c47e-0909-4b1e" name="Attach to: Void Breachers" type="upgrade" hidden="false" collective="false" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="0.0"/></costs><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="03a3-ea1d-2004-526b" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers><profiles><profile id="45c8c0ec-e990-4d5d" name="Leader attachment — Infernal Chaplain" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attach this PAID character to one separately selected Void Breachers squad. This is the declared bodyguard TYPE, not a guaranteed link to a particular instance if multiple identical squads exist. One Leader per bodyguard; additional Support models require specific permission (none defined here). No additional points charged here.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><modifiers><modifier type="set" field="7453-cae4-7795-52e5" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="b5e1b5c6-826e-48dd" shared="true" includeChildSelections="true" includeChildForces="true"/></conditions></modifier></modifiers></selectionEntry><selectionEntry id="ba2d-3d71-2379-52cc" name="Infernal Terminator Chaplain" hidden="false" collective="false" type="model" import="true"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="95.0"/></costs><categoryLinks><categoryLink id="aff1-b496-d941-5f8b" name="Command" hidden="false" targetId="b411-6717-d966-5c6d" primary="true"/><categoryLink id="3876-d97e-5e82-5cd3" name="Terminators" hidden="false" targetId="c317-a497-01c6-5b78" primary="false"/></categoryLinks><constraints><constraint field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d0f4-e312-4aeb-58a0" type="max"/></constraints><profiles><profile id="42dd-b545-87e7-569a" name="Infernal Terminator Chaplain" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">5"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">6</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">6</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic></characteristics></profile><profile id="30db-a184-3d2c-59ca" name="Wargear / legal alternatives" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Crozius, storm bolter; any selections not explicitly costed in this first import must be declared before battle.</characteristic></characteristics></profile><profile id="9ac5-cff8-7b01-5672" name="Unit rule / battlefield role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Armour of Custody: qualifies as required attached Terminator Lost Cohort Chaplain; supervises nearby orphaned Lost Cohort within 12"; Last Order: once/battle led unit re-rolls a charge die; Deep Strike. Serum applies; +1 W is included.</characteristic></characteristics></profile><profile id="a534609c-d2f3-5044" name="Armour of Custody" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This character qualifies as required starting Chaplain for a Terminator Lost Cohort. After a cohort’s initial Chaplain dies, supervises ALL unsupervised Lost Cohort units within 12 inches.</characteristic></characteristics></profile><profile id="aa934621-fe7f-5245" name="Last Order" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle his led unit may re-roll ONE Charge die.</characteristic></characteristics></profile><profile id="2dcd8192-9032-5cdc" name="Leader eligibility / attachments" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Lost Cohort — Terminator Armour; Ashen Chain Terminators; Cataphractii Terminator Veterans; Tartaros Terminator Veterans. A standard bodyguard normally has one Leader; this requires actual roster matching, not just paying points.</characteristic></characteristics></profile><profile id="eb8b5a8f-e6b1-4705" name="Leader assignment instructions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the Leader assignment selector to declare the bodyguard TYPE. Select the actual bodyguard as a separately paid unit, and specify squad instance in list notes if duplicates exist. Lost Cohort Chaplains are INCLUDED within Cohort formation selections; do not field a duplicate Chaplain for the same Cohort. New Recruit may have its own Leader-association UI; this custom choice does not replace that functionality.</characteristic></characteristics></profile><profile id="ed17ffa6-ca09-4a79-8e45-a9d090358fec" name="LEADER — Legal Bodyguard Units" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This Leader can join: Ashen Chain Terminators, Cataphractii Terminator Veterans, Tartaros Terminator Veterans. Choose a particular bodyguard unit during Declare Battle Formations; normal limits apply. If the New Recruit native Leader association control appears, use that to identify the specific unit. The in-catalogue bodyguard-type choice remains an explicit fallback and does not create an extra squad.</characteristic></characteristics></profile><profile id="ae7bb90b-840a-4167-a575-3661fb1950cc" name="ROSTER CARD — Configuration Guide" hidden="true" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use selected weapon subentries for the exact equipped models (not every available arsenal option). Wargear / legal alternatives: Crozius, storm bolter; any selections not explicitly costed in this first import must be declared before battle. | The exported roster should include the selected size variant, any Enhancement/Upgrade and the declared deployment method. Leaders are separate paid units unless the Lost Cohort formation includes its compulsory Chaplain in its printed cost.</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="44b5-ec90-be68-5adc" name="Infernal Serum" hidden="false" targetId="2c4e-2b7d-53e1-5d0d" type="rule"/><infoLink id="4281-9d43-f8aa-5efc" name="Disciplined Brutality" hidden="false" targetId="e0f2-fa24-c84e-59af" type="rule"/><infoLink id="af80-def7-4cb0-5470" name="Lost Cohort — Control" hidden="false" targetId="3bff-1efe-c60b-511f" type="rule"/><infoLink id="fd4246df-cb9b-509d" name="Leader Attachment Eligibility" hidden="false" targetId="8e4d6e8b-1aaf-5e67" type="rule"/><infoLink id="d4c73d19-238d-5124" name="Legion Teleportarium" hidden="false" targetId="03fea306-e073-5356" type="rule"/><infoLink id="8a57a40c-4e57-43be-a328-99c80c36d85d" name="Leader Eligibility" hidden="false" type="rule" targetId="3cb31661-628b-4f26-9cef-5413dec46e6b"/></infoLinks><selectionEntryGroups><selectionEntryGroup id="7a7b1612-0d07-4995" name="Wargear" hidden="false" collective="false" import="true" defaultSelectionEntryId="eebff18d-d433-48b4"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3dad1d59-18d7-44ae" type="min"/><constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d073e401-4339-44a6" type="max"/></constraints><selectionEntries><selectionEntry id="eebff18d-d433-48b4" name="Crozius and storm bolter" hidden="false" collective="false" type="upgrade" import="true"><infoLinks><infoLink id="b0f8d066-9502-4a32" name="Crozius" hidden="false" targetId="e77b-3835-0018-547f" type="profile"/><infoLink id="037f8e4a-5819-4328" name="Combi-bolter / storm bolter" hidden="false" targetId="21b2-49c4-ad7f-57b9" type="profile"/></infoLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="651feab1-f476-46d4" name="Enhancements &amp; Unit Upgrades — choose at most ONE" hidden="false" collective="false" import="true"><constraints><constraint id="f724a603-046b-4efb" type="max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false"/></constraints><entryLinks><entryLink id="8adbde9f-5512-4ebf" name="Oath-Wrought Aegis (+15 pts)" hidden="false" collective="false" import="true" type="selectionEntry" 