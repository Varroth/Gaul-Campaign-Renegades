f032-c172-32a6" name="Character" targetId="2e98-8db1-b592-bebd" hidden="false" primary="false"/><categoryLink id="3728-cf7a-b5c9-52b6" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/><categoryLink id="7d1f-e503-36be-ff59" name="Infantry" targetId="d640-7a85-a199-c350" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="c75a-cc2c-7c71-a137" type="max" value="1" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="f528-cd3b-564c-e6bd" name="Magnir the Barbarian" typeId="0cb1-7394-fb88-5322" typeName="Unit" hidden="false"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">5"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">6</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">6</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">4+</characteristic></characteristics></profile><profile id="7205-00cb-8c16-1e85" name="Ruinous Countercharge" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">When leading Terminators, once per round one melee attack gains +1 to Wound rolls against a unit that charged this turn.</characteristic></characteristics></profile><profile id="1b77-a5f2-b877-fe66" name="Wolf Brother" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Historic personal identity does not grant Space Wolves faction keywords.</characteristic></characteristics></profile><profile id="f536-a3ba-0baa-4733" name="Leader attachment authorization" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">May lead ONLY these bodyguard unit types: Wintergrave Siege Terminators, IceBreaker Terminators, Frosthammer Terminators, Winterguard Terminators. One attached Leader per bodyguard by default; designated character must be separately included in army roster, no free attached model or extra equipment quotas. Cross-check attachments in offline editor.</characteristic></characteristics></profile><profile id="0240-2a8d-ded5-2f04" name="Equipment and compatibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">homebrew character points, abilities and weapon profiles; no battle testing performed. Fixed signature weapons remain mandatory; mixed pre-Primaris Firstborn armor patterns supported within each appropriate class.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="75b4-bb75-f1fc-b9e2" name="Magnir the Barbarian" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="140"/></costs><constraints><constraint id="3b96-2cf4-9b56-393f" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="a5e5-b099-5fdc-e89b" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="7bfd-b5ef-d839-3650" name="Armor / pattern" hidden="false" defaultSelectionEntryId="47d5-8716-c32e-ab5d"><constraints><constraint id="8bc8-9af3-e8b4-86e5" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="1de2-8fe6-95a7-e604" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="47d5-8716-c32e-ab5d" name="Cataphractii" type="upgrade" hidden="false"/><selectionEntry id="2375-8891-66fb-9c79" name="Indomitus" type="upgrade" hidden="false"/><selectionEnt