eristic name="Traits" typeId="0f05-4353-204c-511f">Blast; Suppression</characteristic></characteristics></profile><profile id="0bfc-4433-dafd-32bc" name="Weapon notes — Hoarfrost suppression array" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Suppression: first successful hit against INFANTRY during this unit’s Shooting phase imposes -1" Move until the end of target’s next Movement phase; multiple effects do not stack.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="6b88-e235-9631-80a5" name="Melee weapon" hidden="false" defaultSelectionEntryId="f456-d079-eeb0-83b4"><constraints><constraint id="a7d7-e2f7-bee0-937a" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="8dd0-00c9-087a-ec36" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="f456-d079-eeb0-83b4" name="Hydraulic siege claw" type="upgrade" hidden="false"><profiles><profile id="f916-1fe9-b8e3-6ef1" name="Hydraulic siege claw" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">10</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7d4a-73eb-13fd-2725" name="Rimeguard siege ram" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="5807-4d58-d338-1515" name="Rimeguard siege ram" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">12</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="39e4-7b71-d407-d840" name="Interlocking ward blades" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="5"/></costs><profiles><profile id="ce2b-ce8b-6a90-680b" name="Interlocking ward blades" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">7</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="cba5-6f85-656e-a52a" name="Optional Aegis projector" hidden="false" defaultSelectionEntryId="34b0-807a-fec1-7a96"><constraints><constraint id="0abf-b7b9-af7d-ce66" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="69b1-6b21-f831-8802" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="34b0-807a-fec1-7a96" name="None" type="upgrade" hidden="false"/><selectionEntry id="5355-77e5-3852-b2a9" name="Aegis projector" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="be98-7e05-b064-6501" name="Aegis projector — equipment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per enemy Shooting phase, select one friendly Frozen Cogs INFANTRY unit within 3"; it gains Benefit of Cover against that phase’s ranged attacks while within 3". Cannot stack identical effects.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="ae44-6312-9651-6c5a" name="Optional Vault-cipher transceiver" hidden="false" defaultSelectionEntryId="c8c9-39d9-e652-0197"><constraints><constraint id="a60f-776a-b95e-d8e7" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="69ce-7499-b0c2-a7d9" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="c8c9-39d9-e652-0197" name="None" type="upgrade" hidden="false"/><selectionEntry id="9a54-c57f-1399-f5ec" name="Vault-cipher transceiver" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="9872-772b-3b62-8fac" name="Vault-cipher transceiver — equipment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per turn, one model in this unit can ignore a negative modifier to one ranged Hit roll, excluding modifiers prohibited by the core rules.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="2454-d704-4b00-9d10" name="Glacierfall Artillery Cadres" type="unit" hidden="false" import="true"><constraints><constraint id="840f-9dc7-bea4-5c50" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><categoryLinks><categoryLink id="8f0e-8424-fedd-f7b8" targetId="6718-fb81-5496-8416" name="Siege Artillery" hidden="false" primary="true"/><categoryLink id="f6d9-3972-42f0-13c6" targetId="e5e4-dd08-6ce4-34b7" name="Frozen Cogs" hidden="false" primary="false"/><categoryLink id="fbc1-8e32-a016-34fd" targetId="d640-7a85-a199-c350" name="Infantry" hidden="false" primary="false"/></categoryLinks><profiles><profile id="7c4b-6b7d-6215-c527" name="Glacierfall Artillery Cadres" typeId="0cb1-7394-fb88-5322" typeName="Unit" hidden="false"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="3c6c-55c3-b1d2-87b9" name="Mandatory Gunnery harness and survey array" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Mandatory crew harness is included; these are Astartes infantry operators, not shield wall. Artillery carriages are field weapons operated by nominated crew, not extra models or separate Wounds pools.</characteristic></characteristics></profile><profile id="3e76-eb93-8c39-ff28" name="Surveyed Fire" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the end of your Movement phase, if this unit Remained Stationary, designate one visible enemy unit or objective area within 60" as its plotted target. During your next Shooting phase, the unit may re-roll ONE Hit roll made with one field artillery weapon against an enemy in the plotted area. If the unit moves or loses all nominated gunners, the designation expires. This never permits ignoring core Indirect Fire visibility restrictions.</characteristic></characteristics></profile><profile id="1c29-6566-d72b-89ba" name="Artillery Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each field artillery carriage is an equipped weapon of the unit rather than a separate vehicle: it does not provide an additional model, wounds, toughness or OC. Normal line of sight, Indirect Fire limitations and hit-modifier caps apply.</characteristic></characteristics></profile><profile id="48bf-f059-29b2-8d85" name="Fire Mission Selection" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At army construction select one field artillery weapon for each of the 1–2 carriages. Carriages may use different approved patterns. No carriage fires two separate ammunition profiles in one Shooting phase.</characteristic></characteristics></profile><profile id="7487-a0fc-3ff9-d6ef" name="Roster and equipment restrictions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">5–10 models, including one Glacierfall Gunnery-Sergeant. Exactly 1 artillery platform per complete five models: 5–9 operators = 1; 10 operators = 2. Each platform is a selected weapon carriage assigned to an existing crew member, not an extra model or hull. Its price adds once; no model may crew more than one. Only one firing profile per carriage per Shooting phase. Detailed cross-model quotas validated with bundled roster validator; native New Recruit app integration not yet verified. Use the listed homebrew statistics and points.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="7ee6-dbc0-6ac5-cd2c" name="Glacierfall Gunnery-Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="22"/></costs><constraints><constraint id="4ab9-f52a-ce6b-d03d" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="7da7-fb9f-034d-0cdf" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><profiles><profile id="2345-2ea2-f1b1-7b5f" name="Mandatory fittings" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Gunnery harness and survey array</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="fd85-678f-d817-ad8b" name="Armor pattern" hidden="false" defaultSelectionEntryId="93c8-53d8-d404-61d6"><constraints><constraint id="0372-f5ac-cb6a-cfcd" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="b571-746d-cb04-ddcf" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="93c8-53d8-d404-61d6" name="Mk III" type="upgrade" hidden="false"/><selectionEntry id="0475-9b01-fabb-5c4f" name="Mk IV" type="upgrade" hidden="false"/><selectionEntry id="bfb1-0439-fd00-425c" name="Mk V" type="upgrade" hidden="false"/><selectionEntry id="73d8-a3fd-e958-416e" name="Mk VI" type="upgrade" hidden="false"/><selectionEntry id="fb36-e9ec-c11d-144b" name="Mk VII" type="upgrade" hidden="false"/><selectionEntry id="8eb6-d7fd-6647-0f6b" name="Mk VIII" type="upgrade" hidden="false"/></selectionEntries></selectionEntryGroup><selectionEntryGroup id="dbd0-98b0-5322-fd2f" name="Primary ranged weapon" hidden="false" defaultSelectionEntryId="579a-49a5-4ee6-bfdf"><constraints><constraint id="1b57-e5c3-8ee5-7eb4" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="830e-051b-e6e4-2165" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="579a-49a5-4ee6-bfdf" name="Boltgun" type="upgrade" hidden="false"><profiles><profile id="d930-0613-60cb-ea03" name="Boltgun" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Rapid Fire 1</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="0546-b63d-12e6-65b7" name="Bolt pistol" type="upgrade" hidden="false"><profiles><profile id="4e08-1067-e2a9-0ce5" name="Bolt pistol" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">1</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic na