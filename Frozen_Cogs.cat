 stated external vehicle gantries. 12 spaces and Terminator-compatible; no Jump Pack models. It is a drop/assault transport, not a standard Aircraft.</characteristic></characteristics></profile><profile id="7c75-5195-e72c-7644" name="Homebrew development status" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All new weapons, points, capacities, arrival rules and effects are preliminary homebrew and not verified against current official 40k or native New Recruit importing.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="77b7-5863-cddb-8149" name="Anvillus Dreadclaw" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="145"/></costs><constraints><constraint id="4a5e-604b-665c-d60f" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="8ca0-a568-1f23-5f82" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="73f7-33d1-a059-4378" name="Close siege projectors" hidden="false" defaultSelectionEntryId="7b9a-d163-0e74-26ff"><constraints><constraint id="4253-3e6f-4a2c-969e" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="ee55-146f-2b96-1a2d" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="7b9a-d163-0e74-26ff" name="Thermal cutter thrusters" type="upgrade" hidden="false"><profiles><profile id="726a-398c-5c2b-b025" name="Thermal cutter thrusters" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">D6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">—</characteristic><characteristic name="S" typeId="846d-1d