profile></profiles></selectionEntry></selectionEntries></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="88fc-09ba-7778-f6a6" name="Frozen Cogs Contemptor-Mortis Dreadnought" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="6f4b-5efd-15df-9d59" name="Dreadnoughts &amp; Living Masters" targetId="a75f-1881-2e1a-697a" hidden="false" primary="true"/><categoryLink id="34f7-d185-4236-296c" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="f493-f363-7e78-44ac" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="8cb5-7177-aac9-76c5" name="Frozen Cogs Contemptor-Mortis Dreadnought" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">7"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">9</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">10</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">3</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="6f43-f88b-7f3f-f300" name="Mortis Fire Lane" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If this model Remained Stationary, once per Shooting phase it may re-roll one Wound roll against a VEHICLE or a unit with FLY .</characteristic></characteristics></profile><profile id="a7e8-c8bf-5270-70e3" name="Armored Emplacement" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">May not select ordinary infantry Leader attachments.</characteristic></characteristics></profile><profile id="3205-571f-9202-0b95" name="Squad size / designation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">1–1 model(s) per unit. Base 205 points/model; selected options are additional. Living Astartes remains part of the fixed inducted 1,200.</characteristic></characteristics></profile><profile id="b406-5d48-6aa8-9202" name="Engineering and command compatibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No mandatory Techmarine. Friendly tech specialists may interact via explicitly stated repair abilities. No ordinary attached Infantry Leader. Not an Infernal Warrior; no serum FNP, healing or extra wound.</characteristic></characteristics></profile><profile id="214a-9613-5f47-9529" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All unapproved points, weapon profiles, new titles and numeric abilities remain homebrew until full faction roster is built and balance tested. New Recruit native import not yet verified.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="2e2d-86fa-a724-24a4" name="Contemptor-Mortis Dreadnought" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="205"/></costs><constraints><constraint id="322e-c344-f754-9e56" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="cd1f-0eae-df75-faaa" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="d6fa-45be-9582-fd28" name="Mortis reconstruction" hidden="false" defaultSelectionEntryId="e333-6b19-434f-7619"><constraints><constraint id="dda