3dfb-f571" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><profiles><profile id="efe8-775d-3dce-141e" name="Module effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Nearby allied breachers may re-roll one charge die once per battle .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="f366-6b88-cc41-1acc" name="Frozen Cogs Deredeo Fire-Support Dreadnought" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="d38d-6ea3-fad3-0a0a" name="Dreadnoughts &amp; Living Masters" targetId="a75f-1881-2e1a-697a" hidden="false" primary="true"/><categoryLink id="56b0-b9d8-002c-6776" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="38b9-6f7e-df60-ea29" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="f985-e671-0d86-be83" name="Frozen Cogs Deredeo Fire-Support Dreadnought" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">7"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">10</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">12</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">3</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="d1b5-be4d-2fe3-29b8" name="Surveyed Gunnery" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If Remained Stationary, once per Shooting phase re-roll one ranged Hit roll made against a vehicle or aircraft .</characteristic></characteristics></profile><profile id="79ed-5b6b-81c3-2ec9" name="Interlocking Fire" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">While defending an objective, friendly nearby Frozen Cogs Infantry may ignore one negative Hit roll modifier on one attack per phase .</characteristic></characteristics></profile><profile id="a9bd-e5d7-9977-371b" name="Squad size / designation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">1–1 model(s) per unit. Base 230 points/model; selected options are additional. Living Astartes remains part of the fixed inducted 1,200.</characteristic></characteristics></profile><profile id="4efb-b1ff-5022-a52a" name="Engineering and command compatibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No mandatory Techmarine. Friendly tech specialists may interact via explicitly stated repair abilities. No ordinary attached Infantry Leader. Not an Infernal Warrior; no serum FNP, healing or extra wound.</characteristic></characteristics></profile><profile id="6058-1c13-f651-28ae" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All unapproved points, weapon profiles, new titles and numeric abilities remain homebrew until full faction roster is built and balance tested. New Recruit native import not yet verified.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="a017-29ac-66dc-224e" name="Deredeo Fire-Support Dreadnought" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="230"/></costs><constraints><constraint id="af92-fece-fc16-9283" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="5d92-86e2-ef9d-ca5a" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="e3ed-85d7-c535-26f1" name="Deredeo certification" hidden="false" defaultSelectionEntryId="179a-bfba-ca74-61f8"><constraints><constraint id="9e50-bbd4-fdb3-367a" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="50ee-55de-2bc4-e905" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="179a-bfba-ca74-61f8" name="Legacy Deredeo siege fire frame" type="upgrade" hidden="false"><profiles><profile id="5e0d-8543-7de2-91dc" name="Selected configuration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Relic chassis</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="3fd6-2dd5-113d-8892" name="Sacred Forge naval defense conversion" type="upgrade" hidden="false"><profiles><profile id="2eb6-b1d2-fb3c-cb2e" name="Selected configuration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Rebuilt fire-control housing</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="c7c1-ae58-7463-a6d4" name="Main cannon battery" hidden="false" defaultSelectionEntryId="e530-942b-c795-e05c"><constraints><constraint id="a269-eb1d-a27a-1a16" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="8cdb-82ec-7a8d-3e97" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selec