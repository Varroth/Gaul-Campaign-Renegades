63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">4+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="6663-1c99-9b5f-3554" name="Recon Deployment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This unit has Scouts 6". If its starting position is in cover, it may use that cover when making its pre-battle Scout move; no free Infiltrators ability is conferred.</characteristic></characteristics></profile><profile id="00f0-a805-8411-2e86" name="Silent Survey" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per Shooting phase, if no model in this unit Advanced this turn, select one visible enemy unit within 24". One ranged attack by this unit against that target can re-roll a Hit roll.</characteristic></characteristics></profile><profile id="d4ab-c946-107e-3040" name="Roster constraints and timing" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">5–10 total models including one Scout Veteran Instructor; {"sniper_per_five": 1, "heavy_per_five": 1, "one_primary_per_model": true}. Per-model costs and allowances apply; native cross-model constraints pending actual New Recruit import/verification. Use the listed homebrew statistics; no battle simulations.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="f234-5f00-84c2-cc86" name="Scout Veteran Instructor" type="model" hidden="false"><costs><cost name="pts" ty