haracteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8689-3ad2-4831-ff38" name="Drum grenade launcher" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="8"/></costs><profiles><profile id="0541-3895-feb9-fba8" name="Drum grenade launcher" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">D3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Blast </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="bfb4-82d1-4678-1851" name="Hardpoint kit" hidden="false" defaultSelectionEntryId="e869-a3eb-d528-ea24"><constraints><constraint id="c194-ea40-43fa-dd44" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="5d4e-f825-9715-23bf" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="e869-a3eb-d528-ea24" name="Hardened field kit" type="upgrade" hidden="false"><profiles><profile id="33ee-79b9-982d-2d26" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No added ability; typical armour/kit issued for task</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="6aaa-1123-5fc1-b2c5" name="Portable reinforced shield" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="5"/></costs><profiles><profile id="faae-3bf2-ae97-596c" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If stationary and in Cover, one model rerolls one armor save per battle </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="17cf-8555-872d-9627" name="Frostbound Field Medicae Team" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="a0d0-2c36-7427-3ca3" name="Frostbound Auxilia" targetId="ba92-31ee-3264-a18e" hidden="false" primary="true"/><categoryLink id="b3bd-8f85-cd8a-d521" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="400e-9642-934b-130a" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="859e-d94d-c824-1605" name="Frostbound Field Medicae Team" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">3</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">5+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">1</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">0</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="91b7-6a14-4426-b8ae" name="One Frozen Cogs Army" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROSTBOUND AUXILIA are mortal fighting elements of a Frozen Cogs detachment, not a separate Guard faction. They share FROZEN COGS faction allegiance. Their datasheets do not unlock Astra Militarum Orders, Platoon detachments, Guard stratagems or detachment abilities. </characteristic></characteristics></profile><profile id="c7de-00a0-e124-ecdb" name="Mortal Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Models with FROSTBOUND AUXILIA MORTAL keywords do NOT gain Astartes serum healing, Chapter-level Astartes Feel No Pain, neural-lace mastery, an Obliterator Masterwork, or the special armor abilities of inducted Marines. A unit receives its own printed abilities only. </characteristic></characteristics></profile><profile id="f729-09ff-6be4-7736" name="Direct Support, Not Orders" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attached optional Frostbound Characters provide only their datasheet abilities. No compulsory officer chain and no separate recurring Orders resource. </characteristic></characteristics></profile><profile id="61ac-aff5-2b17-f6b7" name="Workshop Repair Cap" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each VEHICLE may have lost Wounds restored by only one Frozen Cogs repair source in each friendly turn; mortal medicae can affect only named eligible MORTAL INFANTRY. </characteristic></characteristics></profile><profile id="e509-3d94-67b4-ff1a" name="Transport Eligibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Auxilia transports may carry FROSTBOUND AUXILIA INFANTRY (including eligible CHARACTERS) only. They never carry Astartes or Terminators unless a future datasheet expressly says so. </characteristic></characteristics></profile><profile id="07aa-32bd-0cad-95ab" name="Non-Astartes Medicine" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Medicae recovery applies only to a surviving FROSTBOUND AUXILIA MORTAL INFANTRY unit, not Astartes, vehicles, daemon engines or Characters. No recovery if the entire target unit was destroyed. Maximum one successful medicae restoration per target unit per friendly turn .</characteristic></characteristics></profile><profile id="1d8f-958f-8bf6-0455" name="Roster notice" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew — not official Warhammer 40,000 rules; all profiles and costs homebrew. Native New Recruit combined caps requires an in-app check. Ratio limits are checked in the offline editor; native importer not tested.</characteristic></characteristics></profile><profile id="a566-b24b-f69b-a69d" name="Force allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Mortal military medical detachments — Rapid casualty recovery and triage</characteristic></characteristics></profile><profile id="6d9f-ed56-db34-38d4" name="Keywords" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROZEN COGS, FROSTBOUND AUXILIA, MORTAL, CHAOS, INFANTRY</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="9604-17db-5d6a-756a" name="Auxilia member 1" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><constraints><constraint id="54ab-3088-5549-7a02" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="daf4-88c9-2fc3-beac" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="a3d2-a4cb-4815-f14f" name="Self-defense weapon" hidden="false" defaultSelectionEntryId="348f-7f39-fc8f-8f9e"><constraints><constraint id="f42f-2841-f889-70cd" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="8fe5-30f8-4c7b-78d4" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="348f-7f39-fc8f-8f9e" name="Frostbound pattern lascarbine" type="upgrade" hidden="false"><profiles><profile id="73ff-4c29-cea5-bde3" name="Frostbound pattern lascarbine" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">3</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Rapid Fire 1 </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b9d8-1be1-b184-c1a3" name="Deck-clearing autopistol" type="upgrade" hidden="false"><profiles><profile id="85eb-bd1f-e092-ceeb" name="Deck-clearing autopistol" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">3</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Pistol </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="f5b0-21a5-624b-7b88" name="Frostbound boarding shotgun" type="upgrade" hidden="false"><profiles><profile id="36dd-7996-8d72-1e73" name="Frostbound boarding shotgun" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Assault; +1 A against INFANTRY within 6" </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="2d05-ee7d-1b1c-5866" name="Medical kit" hidden="false" defaultSelectionEntryId="1c54-27b2-4a6c-3709"><constraints><constraint id="c868-950c-553d-1444" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="9263-b423-1bef-f0f2" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="1c54-27b2-4a6c-3709" name="Portable medicae pack" type="upgrade" hidden="false"><profiles><profile id="cd8f-d922-5eb4-c7ad" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle in your Command phase, on 4+, return one previously destroyed W1 non-CHARACTER Frostbound Auxilia INFANTRY model to a nearby friendly surviving unit within 3"; place in coherency .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="bc7d-5cf7-26b4-4888" name="Trauma stabilizer" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="12"/></costs><profiles><profile id="3b49-6cf4-515d-b6d3" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, prevent one MORTAL INFANTRY model from being destroyed by a failed Hazardous roll if within 3" </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="866c-f943-02c8-7782" name="Internal squad NCO" hidden="false" defaultSelectionEntryId="e31c-044f-52dc-a763"><constraints><constraint id="25ba-5c7b-94d9-92de" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="fd6e-9374-8edc-8907" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="e31c-044f-52dc-a763" name="Squad leader comm bead" type="upgrade" hidden="false"><profiles><profile id="719f-df59-e50d-44e5" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One per section, issued to first model; no separate officer-chain or Orders system</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7c9b-7e9e-e017-f6ef" name="Veteran section leader" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="5"/></costs><profiles><profile id="b04e-5f30-2fce-8d84" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle this squad may reroll a failed Battle-shock test </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="0249-4fc3-66d6-aae7" name="Auxilia member 2" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><constraints><constraint id="7bcd-bd80-5901-f826" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="3815-c9fe-7d47-44fc" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="2e98-6155-a4cc-df5a" name="Self-defense weapon" hidden="false" defaultSelectionEntryId="23a7-da7f-d2b8-dc72"><constraints><constraint id="68ed-7f94-777c-2915" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="235c-4295-bd54-26ef" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="23a7-da7f-d2b8-dc72" name="Frostbound pattern lascarbine" type="upgrade" hidden="false"><profiles><profile id="f9df-0f7b-5867-d84a" name="Frostbound pattern lascarbine" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">3</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Rapid Fire 1 </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b525-e94c-8084-ad56" name="Deck-clearing autopistol" type="upgrade" hidden="false"><profiles><profile id="2b24-05c6-d816-163b" name="Deck-clearing autopistol" hidden="false"