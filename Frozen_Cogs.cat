ed denial and encrypted signal bastion; Signals vault / fortification</characteristic></characteristics></profile><profile id="8e6f-9c5f-4316-2d93" name="Equipment guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew. Costs, stats and new abilities are homebrew. Not balanced or New Recruit import-tested. Specialist allocation is independently checked in offline editor; native New Recruit cross-model enforcement requires an in-app check.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="593f-085f-b34c-95c2" name="Iron Firewall Relay Node" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="85"/></costs><constraints><constraint id="2e92-80f3-b21a-87f8" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="0fa9-59ea-f31c-0d6a" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="2861-a3cc-532a-56d9" name="Relay package" hidden="false" defaultSelectionEntryId="9805-b0f0-b668-ab84"><constraints><constraint id="e218-a2f8-a636-85ee" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="6cf4-8f54-0701-c913" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="9805-b0f0-b668-ab84" name="Passive encrypted mesh" type="upgrade" hidden="false"><profiles><profile id="181f-d4e1-4612-075c" name="Equipment detail" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Standard equipment</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="861b-dbbc-00ed-698e" name="Aegis pulse shield" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="1e29-92a8-e755-5361" name="Equipment detail" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per game allow one friendly unit within 6 inches to reroll one failed saving throw against ranged fire .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="f33a-fdff-94d3-b81b" name="Counter-jamming processor" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="a6b3-1431-af20-c940" name="Equipment detail" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per turn allow one eligible Signals unit within 9 inches to reroll one Hit .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="e2de-50f6-ba61-e81b" name="Coldforge Field Fabricator" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="5bca-b06f-a954-7b77" name="Sacred Forge Support" targetId="fcb6-2503-af40-5e72" hidden="false" primary="true"/><categoryLink id="7c31-6ca3-a8b5-7c35" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="5364-5614-752e-b9fe" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="f459-6a76-59ab-35b5" name="Coldforge Field Fabricator" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">—</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">8</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name