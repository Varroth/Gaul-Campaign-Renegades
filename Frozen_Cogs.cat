equipment" type="upgrade" hidden="false"/><selectionEntry id="7201-af22-2550-9cbc" name="Deployable glacis kit" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="edb8-988b-4e2b-6fa2" name="Equipment — Deployable glacis kit" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">A marker for the Fieldwork Orders Cover effect; does not create permanent impassable terrain or an additional scoring model.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c0fe-358c-bb25-86f5" name="Siege auspex relay" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="5011-60d1-18c6-46cb" name="Equipment — Siege auspex relay" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle round, increase Combat Repairs range for this unit from 3" to 6" for one declared target.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="8344-60e2-e4a4-a932" name="Frozen Cogs Sternguard Veterans" type="unit" hidden="false" import="true"><constraints><constraint id="1b8f-b1c4-6f5f-5195" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><categoryLinks><categoryLink id="22dc-a3a1-fc62-d761" name="Veterans" targetId="7560-57c6-6880-4a63" hidden="false" primary="true"/><categoryLink id="f6c1-b975-b09d-8103" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/><categoryLink id="eb00-137f-6f1d-ab70" name="Infantry" targetId="d640-7a85-a199-c350" hidden="false" primary="false"/></categoryLinks><profiles><profile id="2d06-ebcf-7bc2-ce80" name="Frozen Cogs Sternguard Veterans" typeId="0cb1-7394-fb88-5322" typeName="Unit" hidden="false"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="81e2-16f5-c8ac-76ea" name="Special-Issue Rounds" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of each friendly Shooting phase, choose ONE bolt-ammunition doctrine for this unit until the end of the phase: (1) Rimepiercer — one special-issue boltgun attack made by this unit gains Ignores Cover; (2) Hoarfrost Tracers — re-roll one Hit roll with a bolt-type weapon; (3) Withering Pattern — one bolt-type attack against INFANTRY within 12" gains Sustained Hits 1. Different modes do not stack.</characteristic></characteristics></profile><profile id="ad0a-0f1b-a219-e743" name="Veteran Siegecraft" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If this unit controls an objective it may re-roll one Battle-shock test per battle round; does not grant Wintergrave Bastion benefits.</characteristic></characteristics></profile><profile id="241f-eb52-33df-df39" name="Roster constraints and timing" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4