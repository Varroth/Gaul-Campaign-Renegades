eId="0cb1-7394-fb88-5322" typeName="Unit" hidden="false"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="aae4-bd3f-e35e-68da" name="Synced Fire Channels" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of this unit’s Shooting phase designate one enemy visible within 18" of a squad model; once per phase, one special weapon in the squad targeting it can re-roll one Wound roll. Does not require a mandatory Officer attachment.</characteristic></characteristics></profile><profile id="21dc-7d04-6ebc-8a29" name="Rapid Refit" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Before deployment, select one tactical focus for this unit: Anti-Armor, Anti-Infantry or Containment. The focus is descriptive until a compatible Detachment rule explicitly references it; it does not grant a bonus by itself.</characteristic></characteristics></profile><profile id="9a02-b16b-1ea5-feb3" name="Roster constraints and timing" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">5–10 total models including one Tactical Support Sergeant; {"special_per_model": 1, "sergeant_special_allowed": true, "no_other_heavy_support": true}. Per-model costs and allowances apply; native cross-model constraints pending actual New Recruit import/verification. Use the listed homebrew statistics; no battle simulations.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="00c8-bd22-7f4a-16cb" name="Tactical Support Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="24"/></costs><constraints><constraint id="478c-933e-6b3d-bc5e" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="1051-8712-bc49-2457" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="3764-da3e-670f-a97d" name="Armor pattern" hidden="false" defaultSelectionEntryId="5eeb-ada3-bbcd-2615"><constraints><constraint id="cf3a-7533-b18f-e58e" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="c3af-ed26-d9d9-e0b4" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="5eeb-ada3-bbcd-2615" name="Mk II" type="upgrade" hidden="false"/><selectionEntry id="c9e8-c4f6-1b89-ee6c" name="Mk III" type="upgrade" hidden="false"/><selectionEntry id="c94a-f112-0c22-10f6" name="Mk IV" type="upgrade" hidden="false"/><selectionEntry id="a666-0675-6f5b-750d" name="Mk V" type="upgrade" hidden="false"/><selectionEntry id="993e-fe34-d04d-365d" name="Mk VI" type="upgrade" hidden="false"/><selectionEntry id="cd34-c74b-8ce6-1e75" name="Mk VII" type="upgrade" hidden="false"/><selectionEntry id="f275-8ac2-1afc-3c8b" name="Mk VIII" type="upgrade" hidden="false"/></selectionEntries></selectionEntryGroup><selectionEntryGroup id="f91a-adba-481d-c5a2" name="Primary ranged weapon" hidden="false" defaultSelectionEntryId="b650-0009-6c33-9f7b"><constraints><constraint id="2943-fc95-881c-a2fc" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="d594-ac8f-796a-6636" type="max" value="1" field="selections" scope="pare