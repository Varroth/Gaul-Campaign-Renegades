pgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="9b20-0663-4787-99df" name="Selected configuration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll a Hit roll from a friendly vehicle within 6 inches </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="2a89-21b8-ef23-5b07" name="Frozen Cogs Land Raider Achilles" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="d1ff-0d30-0589-eece" name="Armored Transports" targetId="5b89-f231-abc9-9294" hidden="false" primary="true"/><categoryLink id="a2fb-c604-53c1-0dda" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="13fe-1d25-13c2-8e92" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="a6d7-cb0e-3f4b-fe90" name="Frozen Cogs Land Raider Achilles" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">9"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">13</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">18</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">5</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="8244-ff58-47e4-1044" name="Assault Ramp" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Passengers may charge after disembarking following this model’s Normal Move (homebrew).</characteristic></characteristics></profile><profile id="c0c4-6418-c242-b6d0" name="Achilles Bastion" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">While holding an objective and stationary, improve cover against ranged attacks .</characteristic></characteristics></profile><profile id="9ebb-505d-905b-97c2" name="Transport capacity and permitted passengers" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Carry up to 6 infantry spaces. A standard non-Jump Pack Firstborn infantry model occupies 1 space. A Terminator-armored model occupies 2 spaces. Every attached Leader occupies space as appropriate. Dreadnoughts, vehicles, automata, jetbikes, aircraft, non-Frozen-Cogs allies unless separate alliance transport rule permits them. Capacity counts every carried model, including attached Leaders. No dedicated transport carries enemy units.</characteristic></characteristics></profile><profile id="16bb-ccb1-861f-53e6" name="Chassis role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Armored siege assault and close artillery; assignment: 5th Boarding / Sacred Forge guarded expeditions</characteristic></characteristics></profile><profile id="0bd5-0d4d-c47d-7910" name="Roster status" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">New weapon profiles, transport limits and special rules are homebrew homebrew design, not verified official datasheet. No balance simulations or native New Recruit import verification.</characteristic></characteristics></profile></profiles><selectionEntries><se