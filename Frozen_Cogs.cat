cteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per turn repair 1 lost wound to nearby FROSTBOUND AUXILIA VEHICLE only .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="eed4-966e-18e8-358e" name="Sacred Forge towing rig" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="ec38-0565-ad6f-afbf" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle a nearby FROZEN COGS VEHICLE may reroll an Advance roll, excluding AIRCRAFT and TITANIC </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="de7a-92d8-ca8b-c6e9" name="Vehicle support kit" hidden="false" defaultSelectionEntryId="f29b-31eb-8d9d-7a97"><constraints><constraint id="97d4-312e-b3d6-4e5c" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="e838-4a83-a6bc-1cb6" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="f29b-31eb-8d9d-7a97" name="Standard engineering suite" type="upgrade" hidden="false"><profiles><profile id="ceeb-b095-c294-27b9" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No extra benefit</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7f70-3eef-561f-cb58" name="Smoke projection battery" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="8"/></costs><profiles><profile id="0e36-eaf3-b465-7163" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">O