roup id="9470-2e1e-b9ec-b0c3" name="Enslaved essence and governor (unit-wide)" hidden="false" defaultSelectionEntryId="5010-c9c5-dc69-8e4d"><constraints><constraint id="8cd5-6efe-446e-7856" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="0453-eea5-22d0-bd7b" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="5010-c9c5-dc69-8e4d" name="Khorne captive / kinetic governor" type="upgrade" hidden="false"><profiles><profile id="5284-dc8d-0b95-b9f4" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Fight phase, one melee weapon gains +1 Attack this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8fa6-c7e2-5959-3d71" name="Tzeentch captive / predictive governor" type="upgrade" hidden="false"><profiles><profile id="acb1-4e38-46c8-7e01" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Shooting phase, choose one ranged weapon; it gains Ignores Cover this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="38ff-243f-34db-ef4d" name="Nurgle captive / dampening governor" type="upgrade" hidden="false"><profiles><profile id="c104-842d-b794-7ebe" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle, when an attack is allocated to this unit, reduce that attack’s Damage by 1 (min. 1; homebrew).</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="262b-2871-57be-3459" name="Slaanesh captive / resonant governor" type="upgrade" hidden="false"><profiles><profile id="967c-bfa2-6ec1-744f" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle one ranged weapon gains +1 Attack during Shooting .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="0f64-7f6f-641f-5406" name="Unaligned captive / neutral governor" type="upgrade" hidden="false"><profiles><profile id="482d-2b05-5cc2-ced0" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one Hit roll for this engine .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="f5e8-5ba2-2321-4778" name="Containment safeguard (unit-wide)" hidden="false" defaultSelectionEntryId="2322-5db2-f5b1-cd55"><constraints><constraint id="f1f6-9bf0-7af0-a630" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="484a-7167-8b63-507b" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="2322-5db2-f5b1-cd55" name="Triple-lock containment lattice" type="upgrade" hidden="false"><profiles><profile id="29c0-ba8b-caef-2e69" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Sacred Forge hard seals, neural-lace Iron Firewall, and independent kill-switch governors.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="e45b-f28b-f804-a5f6" name="Iron Firewall fail-closed gate" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="9d4b-57c1-a43a-c5fa" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, ignore one enemy rule that would force this unit to take a Battle-shock test .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="0014-6850-cdf8-b633" name="Exhaust and pressure vents" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="f75c-aecd-b41f-f227" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle in your Command phase, remove all Pressure counters without forfeiting its option to Charge .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="cc8d-339c-750b-e55e" name="Redundant mechanical binders" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="87ce-9b5a-bb0b-531c" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, reroll one failed saving throw; cannot stack with another save reroll .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="1bd4-6d84-838f-18be" name="Contained engine 2" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="120"/></costs><constraints><constraint id="7a9c-0be0-3027-2100" type="min" value="0" field="selections" scope="parent" shared="true"/><constraint id="ba5c-169f-5e76-f470" type="ma