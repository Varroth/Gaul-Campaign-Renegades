><categoryLinks><categoryLink id="0295-a226-f8d0-5efa" name="Armored Transports" targetId="5b89-f231-abc9-9294" hidden="false" primary="true"/><categoryLink id="dce2-35db-171b-eb30" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="b21f-db04-69f7-6315" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="18f6-c37e-0de1-9c19" name="Frozen Cogs Land Raider Crusader" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">10"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">12</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">16</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">5</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="cb93-2241-3e0c-fa6a" name="Assault Ramp" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Passengers may charge after disembarking following this model’s Normal Move (homebrew).</characteristic></characteristics></profile><profile id="e727-6b53-2097-bd3f" name="Crusader Deployment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At end of its Normal Move, one embarked unit may disembark; it cannot shoot if it used this extra disembark opportunity .</characteristic></characteristics></profile><profile id="6e98-5ae4-53e5-51ae" name="Transport capacity and permitted passengers" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Carry up to 16 infantry spaces. A standard non-Jump Pack Firstborn infantry model occupies 1 space. A Terminator-armored model occupies 2 spaces. Every attached Leader occupies space as appropriate. Dreadnoughts, vehicles, automata, jetbikes, aircraft, non-Frozen-Cogs allies unless separate alliance transport rule permits them. Capacity counts every carried model, including attached Leaders. No dedicated transport carries enemy units.</characteristic></characteristics></profile><profile id="761b-4085-b7f2-b494" name="Chassis role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Capacity-focused armored assault carrier; assignment: 4th mechanized / 2nd Siege Assault</characteristic></characteristics></profile><profile id="fa0e-1b1d-e904-4433" name="Roster status" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">New weapon profiles, transport limits and special rules are homebrew homebrew design, not verified official datasheet. No balance simulations or native New Recruit import verification.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="fdb9-e632-5dd3-c2ca" name="Land Raider Crusader" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="250"/></costs><constraints><constraint id="c35e-937a-12da-194d" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="de40-6794-11e6-3b49" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="2eda-337f-ef5e-b786" name="Hurricane bolter arrays" hidden="false" defaultSelectionEntryId="3b56-6ca9-611b-5ce0"><constraints><constraint id="1739-aadc-f03d-353f" type="min" value="1" field="selections" scope="par