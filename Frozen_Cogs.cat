name="Harmonic Conclave" targetId="1186-3015-8b1c-a8a3" hidden="false" primary="true"/><categoryLink id="7dc0-f200-d165-f0dd" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="ec1a-eebb-84f3-5d52" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="f656-1848-ea11-146f" name="Hushglass Disruptors" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="8559-565e-03b7-05d4" name="Kill the Echo" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, after this unit ends a Normal Move, choose one enemy within 12 inches: it cannot target this unit with Overwatch until end of turn .</characteristic></characteristics></profile><profile id="c555-0e50-c782-0894" name="Quiet Machines" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This is a neural-lace counter-signals unit, not a psychic null field.</characteristic></characteristics></profile><profile id="b4dd-849b-e128-975f" name="Role and formation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Signal suppression and silent interference; 7th Recon / Harmonic Conclave</characteristic></characteristics></profile><profile id="e0fe-7080-8ee7-b7ba" name="Equipment guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew. Costs, stats and new abilities are homebrew. Not balanced or New Recruit import-tested. Specialist allocation is independently checked in offline editor; native New Recruit cross-model enforcement requires an in-app check.</characteristic></characteristics></profile><profile id="e091-f1f9-2621-042c" name="Specialist allocation: carbine" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">1 permitted per FULL 5 models among options: Screamglass dissonator; checked in offline editor, native XML may not enforce the shared squad cap.</characteristic></characteristics></profile><profile id="4677-4490-aab6-7b09" name="Squad complement" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Exactly one squad lead/controller plus 4–9 squad members.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="5942-59f5-1b8b-3464" name="Lead Artisan / Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="27"/></costs><constraints><constraint id="1a07-d7a3-a9b1-60b3" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="72ac-1777-7e37-ea39" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="9c6a-7a60-b28c-cb94" name="Low-signature sonic arm" hidden="false" defaultSelectionEntryId="3f77-c057-1df4-55a0"><constraints><constraint id="40fb-7d56-0706-3293" type="min" value="1" field="selections" scope="parent" shared="true"/><c