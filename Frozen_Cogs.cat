" shared="true" id="f525-0942-f56f-faf6"/></constraints><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="25"/></costs><profiles><profile id="f067-1038-b6a6-fdac" name="Forge lascannon" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">48"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">1</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">12</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">D6+1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a1f6-4c76-b875-7fdb" name="Sacred Forge conversion beamer" type="upgrade" hidden="false"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="03c2-705f-57a6-e967"/></constraints><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="30"/></costs><profiles><profile id="1dfa-97f5-f26c-9b4f" name="Sacred Forge conversion beamer" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">48"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">1</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">7/10/12</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1/-2/-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2/3/4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy; distance bands 0–18", &gt;18–36", &gt;36–48"</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id