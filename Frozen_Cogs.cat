characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile><profile id="bfb8-b5bd-6357-572f" name="Firing note — Frosthammer siege breaker" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Frostforged oversized siege hammer; cannot equip paired claws alongside mandatory shield.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="f6d3-045f-62ca-6d17" name="Optional Frosthammer impact field" hidden="false"><constraints><constraint type="min" value="0" field="selections" scope="parent" shared="true" id="a1f3-df0a-5acd-3eaa"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b1dc-9e02-3ca8-99db"/></constraints><selectionEntries><selectionEntry id="8e12-9455-be2e-d8f8" name="Frosthammer impact field" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="def6-20aa-fc01-e3f7" name="Frosthammer impact field" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle per bearer, when this unit completes a Charge, choose one enemy unit it charged; the next time that bearer fights it this turn, improve the Armour Penetration characteristic of that bearer’s melee weapon by 1. Duplicate field effects cannot stack.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="2a31-33b0-7ca5-591b" name="Winterguard Terminators" type="unit" hidden="false" import="true"><constraints><constraint id="3af1-ec90-da93-5ad2" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><categoryLinks><categoryLink id="1b69-3d02-2ef6-1577" targetId="9198-67a8-0931-f114" name="Elite Wardens" hidden="false" primary="true"/><categoryLink id="c49d-6b20-d0a4-9d43" targetId="e5e4-dd08-6ce4-34b7" name="Frozen Cogs" hidden="false" primary="false"/><categoryLink id="46c3-a978-dd59-3231" targetId="d640-7a85-a199-c350" name="Infantry" hidden="false" primary="false"/><categoryLink id="e641-0ade-f182-a26d" targetId="0a66-2bc3-4792-5c78" name="Terminator" hidden="false"/></categoryLinks><profiles><profile id="a7ba-27b6-ff1b-4d48" name="Winterguard Terminators" typeId="0cb1-7394-fb88-5322" typeName="Unit" hidden="false"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">5"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">6</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">4+</characteristic></characteristics></profile><profile id="5e71-113d-433a-b450" name="Mandatory Winterguard ward-shield" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Mandatory; 4+ invulnerable save included; may carry a one-handed approved firearm and one-handed melee weapon via Sacred Forge mounts; no additional inherent save bonus.</characteristic></characteristics></profile><profile id="368d-c9eb-9a87-1918" name="Ward Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This unit is a protective escort, not a breaching or heavy missile squad. Mandatory shields remain equipped. It gains no Wintergrave Bastion, IceBreaker Momentum, or Frosthammer Onslaught rules.</characteristic></characteristics></profile><profile id="a053-b035-4853-7c81" name="Winterguard Ward Protocol" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of your Command phase, choose ONE stance until your next Command phase: (1) Holdfast — if this unit controls an objective, its models have OC 2; (2) Escort — select one friendly Frozen Cogs INFANTRY unit within 6"; while it stays within 6", that unit has the Benefit of Cover against ranged attacks, with no cumulative duplicate; (3) Iron Guard — once per battle round, reduce the Damage characteristic of one successful attack allocated to this unit by 1 (minimum 1). Only one stance at a time.</characteristic></characteristics></profile><profile id="f0f5-fece-580d-96e9" name="Unbroken Escort" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle round, if an enemy unit ends a Charge move within Engagement Range of an escorted unit, Winterguard models may re-roll one melee Hit roll when fighting that charging unit this turn. This does not grant any free movement or additional attack.</characteristic></characteristics></profile><profile id="e203-5b0e-83df-da78" name="Roster and equipment restrictions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">5–10 models, including one Winterguard Shield-Sergeant.  Detailed cross-model quotas validated with bundled roster validator; native New Recruit app integration not yet verified. Use the listed homebrew statistics and points.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="9404-776f-0c6b-56f6" name="Winterguard Shield-Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="57"/></costs><constraints><constraint id="c142-0f06-43b8-98d4" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="3079-2073-5a84-8f42" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><profiles><profile id="9866-23e1-2fea-60fa" name="Mandatory fittings" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Winterguard ward-shield</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="ac55-7acc-f46e-396b" name="Armor pattern" hidden="false" defaultSelectionEntryId="714b-14c5-1329-651c"><constraints><constraint id="d08d-ad97-6810-d473" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="e211-571e-72a8-c691" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="714b-14c5-1329-651c" name="Cataphractii" type="upgrade" hidden="false"/><selectionEntry id="6d56-e13a-fc8c-6fcc" name="Indomitus" type="upgrade" hidden="false"/><selectionEntry id="8f1b-7558-bdac-fa7e" name="Tartaros" type="upgrade" hidden="false"/></selectionEntries></selectionEntryGroup><selectionEntryGroup id="60b6-0b0a-b580-039f" name="Primary ranged weapon" hidden="false" defaultSelectionEntryId="660f-e8ac-06e7-2dd4"><constraints><constraint id="d97b-6259-0154-876e" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="db4c-7ebc-2c1c-e7ce" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="660f-e8ac-06e7-2dd4" name="Storm bolter" type="upgrade" hidden="false"><profiles><profile id="5391-b461-6162-028b" name="Storm bolter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><c