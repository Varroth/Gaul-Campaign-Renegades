 id="c803-6fc4-e4f1-56c1" name="Module effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, impose a defensive Hit penalty against one targeted ranged attack .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="2ff4-ff9f-b740-c80a" name="Frozen Cogs Venerable Dreadnought" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="3258-7604-5af1-ca70" name="Dreadnoughts &amp; Living Masters" targetId="a75f-1881-2e1a-697a" hidden="false" primary="true"/><categoryLink id="27bb-8411-d540-2e49" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="aa90-e4f5-a151-770c" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="f908-622a-74f2-c40b" name="Frozen Cogs Venerable Dreadnought" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">10</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">11</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">3</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="caad-c3e0-bdcd-8d86" name="Ancient Counsel" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per turn one friendly infantry unit within 6" may re-roll one Battle-shock or Wound roll (choose on use; homebrew).</characteristic></characteristics></profile><profile id="b067-ff38-baff-2052" name="Venerated Interment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">May not be commanded by a mandatory attached Techmarine; Techmarines can still repair this walker.</characteristic></characteristics></profile><profile id="f0a9-d60c-2e01-7d8d" name="Squad size / designation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">1–1 model(s) per unit. Base 200 points/model; selected options are additional. Living Astartes remains part of the fixed inducted 1,200.</characteristic></characteristics></profile><profile id="3048-62bd-0616-a7e2" name="Engineering and command compatibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No mandatory Techmarine. Friendly tech specialists may interact via explicitly stated repair abilities. No ordinary attached Infantry Leader. Not an Infernal Warrior; no serum FNP, healing or extra wound.</characteristic></characteristics></profile><profile id="00cd-7eef-72ed-8b72" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All unapproved points, weapon profiles, new titles and numeric abilities remain homebrew until full faction roster is built and balance tested. New Recruit native import not yet verified.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="4962-3a6a-ce62-970d" name="Venerable Dreadnought" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="200"/></costs><constraints><constraint id="41cb-5db2-12b8-dec8" type="min" value="1" field="selections" scope="parent"