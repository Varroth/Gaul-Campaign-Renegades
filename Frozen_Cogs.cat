1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Torrent, Ignores Cover</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="47c5-dddc-00a9-fa48" name="Crew layout" hidden="false" defaultSelectionEntryId="2302-d7df-ea62-8feb"><constraints><constraint id="4f12-7804-da6f-e3fe" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="97e9-28b0-d032-d162" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="2302-d7df-ea62-8feb" name="Ten-seat assault bay" type="upgrade" hidden="false"><profiles><profile id="7d50-0f9e-b055-a5c6" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Transport 10 MORTAL INFANTRY</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a240-7bd0-bc47-e071" name="Siege workbay" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="8"/></costs><profiles><profile id="b3f1-9961-ca94-9f34" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Transport 6 MORTAL INFANTRY; engineers get one reroll on a demolition Hit after Disembarking </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="d886-dd5a-0941-5e4a" name="Vehicle support kit" hidden="false" defaultSelectionEntryId="044a-fbcb-cad8-bf6e"><constraints><constraint id="0ff5-0a0d-5b35-2ed0" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="d0d4-ce5a-9a31-cef5" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="044a-fbcb-cad8-bf6e" name="Standard engineering suite" type="upgrade" hidden="false"><profiles><profile id="331e-e509-5929-332f" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No extra benefit</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7b50-9d2d-d289-3a4f" name="Smoke projection battery" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="8"/></costs><profiles><profile id="ec4d-3943-911b-afa7" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, gain Benefit of Cover until end of enemy Shooting phase </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8c9c-5a9a-cea5-737e" name="Secure relay aerial" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="5efc-558a-477b-c8c0" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle one nearby MORTAL unit rerolls a failed Battle-shock test </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="4eb8-f6ed-23cc-d973" name="Frostbound Recon Walkers" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="6f61-9d05-0603-2d78" name="Frostbound Auxilia" targetId="ba92-31ee-3264-a18e" hidden="false" primary="true"/><categoryLink id="8bf4-3864-0099-a906" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="1c61-3067-78e2-273b" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="af09-cc2f-b3a6-91b3" name="Frostbound Recon Walkers" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">10"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">7</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="5af2-d183-a220-41b5" name="One Frozen Cogs Army" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROSTBOUND AUXILIA are mortal fighting elements of a Frozen Cogs detachment, not a separate Guard faction. They share FROZEN COGS faction allegiance. Their datasheets do not unlock Astra Militarum Orders, Platoon detachments, Guard stratagems or detachment abilities. </characteristic></characteristics></profile><profile id="7493-c714-4b6f-c504" name="Mortal Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Models with FROSTBOUND AUXILIA MORTAL keywords do NOT gain Astartes serum healing, Chapter-level Astartes Feel No Pain, neural-lace mastery, an Obliterator Masterwork, or the special armor abilities of inducted Marines. A unit receives its own printed abilities only. </characteristic></characteristics></profile><profile id="2aa9-dd3b-2b18-21ef" name="Direct Support, Not Orders" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attached optional Frostbound Characters provide only their datasheet abilities. No compulsory officer chain and no separate recurring Orders resource. </characteristic></characteristics></profile><profile id="e26f-62ec-bf0f-ca07" name="Workshop Repair Cap" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each VEHICLE may have lost Wounds restored by only one Frozen Cogs repair source in each friendly turn; mortal medicae can affect only named eligible MORTAL INFANTRY. </characteristic></characteristics></profile><profile id="a71c-6f69-e105-4bd0" name="Transport Eligibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Auxilia transports may carry FROSTBOUND AUXILIA INFANTRY (including eligible CHARACTERS) only. They never carry Astartes or Terminators unless a future datasheet expressly says so. </characteristic></characteristics></profile><profile id="6079-9901-f773-2333" name="Forward Survey" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Scout 6" . Models are mortal-crewed vehicles, not Rimeguard Automata or Chapter-level sacred engines.</characteristic></characteristics></profile><profile id="5262-e647-f787-19ef" name="Roster notice" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew — not official Warhammer 40,000 rules; all profiles and costs homebrew. Native New Recruit combined caps requires an in-app check. Ratio limits are checked in the offline editor; native importer not tested.</characteristic></characteristics></profile><profile id="23af-3df8-391a-616e" name="Force allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Auxilia reconnaissance and border scouts — Light non-daemonic scouting walkers</characteristic></characteristics></profile><profile id="f660-31a7-b7ed-6026" name="Keywords" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROZEN COGS, FROSTBOUND AUXILIA, MORTAL, CHAOS, VEHICLE</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="303a-fe67-ff20-295b" name="Auxilia member 1" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="95"/></costs><constraints><constraint id="204f-88fb-9c5a-12f1" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="bc6b-8cae-d954-51c3" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="9456-f343-892b-6b8c" name="Recon walker weapon" hidden="false" defaultSelectionEntryId="1cc5-c186-6c51-e5ea"><constraints><constraint id="e695-d188-c3db-8aff" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="e0c6-e1f4-8b4b-9e0e" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="1cc5-c186-6c51-e5ea" name="Coldforged autocannon" type="upgrade" hidden="false"><profiles><profile id="6b7c-eb36-ab67-94cc" name="Coldforged autocannon" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">48"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><char