" primary="true"/><categoryLink id="faef-c200-88bd-0396" name="Character" targetId="2e98-8db1-b592-bebd" hidden="false" primary="false"/><categoryLink id="85c5-8330-337b-fd45" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/><categoryLink id="e6b4-f0c2-3326-ce15" name="Infantry" targetId="d640-7a85-a199-c350" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="bd9a-ea4c-e2f5-aa6f" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="9a2d-b620-240e-1fa5" name="Frozen Cogs Chapter Ancient" typeId="0cb1-7394-fb88-5322" typeName="Unit" hidden="false"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">4</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">4+</characteristic></characteristics></profile><profile id="ae2e-9264-a390-8abf" name="Standard of the Old Oath" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">While leading a unit within 3" of an objective, add 1 to its total OC (not each model).</characteristic></characteristics></profile><profile id="12f3-0808-f1e0-754d" name="Honor of the Original Hundred" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">A historical reference only; does not make the Chapter Ancient a member of the historical hundred.</characteristic></characteristics></profile><profile id="6214-bba7-742f-6205" name="Leader attachment authorization" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">May lead ONLY these bodyguard unit types: Frozen Cogs Tactical Squad, Frozen Cogs Sternguard Veterans, Frozen Cogs Vanguard Veterans, IceBreaker Breachers. One attached Leader per bodyguard by default; designated character must be separately included in army roster, no free attached model or extra equipment quotas. Cross-check attachments in offline editor.</characteristic></characteristics></profile><profile id="a5c5-1e51-a848-fe7b" name="Equipment and compatibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">homebrew character points, abilities and weapon profiles; no battle testing performed. Fixed signature weapons remain mandatory; mixed pre-Primaris Firstborn armor patterns supported within each appropriate class.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="4590-c799-50e0-1e39" name="Frozen Cogs Chapter Ancient" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="70"/></costs><constraints><constraint id="26ef-4cff-5658-75d8" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="a87e-067e-9396-d620" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="5395-3c95-fbf9-5207" name="Armor / pattern" hidden="false" defaultSelectionEntryId="a502-1407-ac07-913d"><constraints><constraint id="24c1-7c87-883a-5fea" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="5656-223b-5c08-9885" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="a502-1407-ac07-913d" name="Mk II" type="upgrade" hidden="false"/><selectionEntry id="2741-f598-b1f