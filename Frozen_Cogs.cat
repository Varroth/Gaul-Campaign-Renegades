="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="0f1b-75f1-ec42-c712" name="Thunder hammer" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">10</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="2236-31ce-71d9-8c4f" name="Frostforged breaching maul" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="2b23-3320-c9d0-1f63" name="Frostforged breaching maul" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="b3e0-e94f-e215-319e" name="Optional Terminator breaching charge" hidden="false"><constraints><constraint type="min" value="0" field="selections" scope="parent" shared="true" id="f1af-7b7a-f79e-f0f4"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c011-9ce0-e754-1c0f"/></constraints><selectionEntries><selectionEntry id="6a80-0399-4096-22df" name="Terminator breaching charge" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="b8cc-265a-0b16-ec8c" name="Terminator breaching charge" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle per bearer, after this unit successfully Charges an enemy on an objective or Fortification, that bearer’s melee attacks gain +1 AP against that target for the next Fight phase (not stacking).</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="e5d1-083a-5523-e63b" name="Frosthammer Terminators" type="unit" hidden="false" import="true"><constraints><constraint id="c52b-0bd3-eacb-5cf5" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><categoryLinks><categoryLink id="d55f-b78c-fa16-a17d" targetId="7a83-5343-b20a-173e" name="Melee Shock" hidden="false" primary="true"/><categoryLink id="82b2-f042-457c-a0e9" targetId="e5e4-dd08-6ce4-34b7" name="Frozen Cogs" hidden="false" primary="false"/><categoryLink id="9fea-9441-1597-ffc2" targetId="d640-7a85-a199-c350" name="Infantry" hidden="false" primary="false"/><categoryLink id="74fd-3285-f752-f0b4" targetId="0a66-2bc3-4792-5c78" name="Terminator" hidden="false"/></categoryLinks><profiles><profile id="f132-2027-f30a-e21c" name="Frosthammer Terminators" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">5"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">6</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">4+</characteristic></characteristics></profile><profile id="970f-1ffe-24a9-c3ec" name="Mandatory Frosthammer assault shield" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Every model carries a mandatory assault shield; the 4+ invulnerable save is already represented by the unit statline. No firearm replaces it.</characteristic></characteristics></profile><profile id="7a42-9a4f-8983-11e4" name="Frosthammer Onslaught" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">After this unit completes a Charge, choose one enemy unit it charged. Until the end of this turn, melee attacks made by models in this unit against that enemy gain +1 to Hit, respecting modifier caps. If that target has VEHICLE or MONSTER, one Wound roll made by this unit against it in this phase may be re-rolled. This unit does not gain the IceBreaker Iron Breach or Breach Momentum abilities.</characteristic></characteristics></profile><profile id="e50c-a824-e429-59be" name="Hammerwall Advance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle round, after this unit destroys an enemy unit in the Fight phase, it may make a Consolidation move permitted by the standard rules toward the closest objective. This does not grant extra movement beyond the normal allowed Consolidation distance, and it must obey Engagement Range restrictions.</characteristic></characteristics></profile><profile id="9381-50d4-11c3-9d13" name="Shield and Hammer Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Every model carries a Frosthammer assault shield and selects precisely one melee weapon; no paired lightning claws, no ordinary bolter or shotgun weapons on this dedicated melee squad.</characteristic></characteristics></profile><profile id="247f-6e4e-6b99-be5f" name="Squad legality" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">5–10 models including exactly one Frosthammer Strike-Sergeant; complete five-model groups set all per-five allowances. Cross-model caps and all role validation should be checked using included Python validator until native import testing is completed. Strike-Sergeant uses the same shield and selectable melee weapons; no additional model or extra melee weapon. Future named character attachments require express permission.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="c4a1-22a9-97b3-f23b" name="Frosthammer Strike-Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="60"/></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="aac6-cee5-869d-255c"/><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="9df4-c878-aaca-ccdf"/></constraints><profiles><profile id="848e-1d28-2d00-2747" name="Issued mandatory shield" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Frosthammer assault shield. Cannot be replaced or removed; its effect is already included in the unit characteristic profile.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="423f-abe5-16d4-be12" name="Armor pattern" hidden="false" defaultSelectionEntryId="a4ef-c1f3-2c9a-4c5e"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="34db-11f0-ddc7-da36"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="73f4-b36a-fa96-1307"/></constraints><selectionEntries><selectionEntry id="a4ef-c1f3-2c9a-4c5e" name="Cataphractii" type="upgrade" hidden="false"/><selectionEntry id="8b39-609e-72db-4cf1" name="Indomitus" type="upgrade" hidden="false"/><selectionEntry id="b224-86be-0d39-6cfe" name="Tartaros" type="upgrade" hidden="false"/></selectionEntries></selectionEntryGroup><selectionEntryGroup id="5f25-b0d5-4329-bdaf" name="Melee weapon" hidden="false" defaultSelectionEntryId="5417-8d64-a1c5-eb1f"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="ad38-6cab-4424-80b8"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d92f-e4ba-8cd1-5a29"/></constraints><selectionEntries><selectionEntry id="5417-8d64-a1c5-eb1f" name="Thunder hammer" type="upgrade" hidden="false"><profiles><profile id="b822-94a0-3837-1cd2" name="Thunder hammer" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">10</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="2be5-9a79-b7b0-e393" name="Frostforged power maul" type="upgrade" hidden="