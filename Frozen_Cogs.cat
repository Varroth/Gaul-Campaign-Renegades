" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="906e-7dbc-8b32-5395" name="Shield the Composer" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">While within 3 inches of a friendly Harmonic Character or installation, once per battle round this unit can reroll one failed saving throw .</characteristic></characteristics></profile><profile id="6554-3de8-9315-5e48" name="Measured Counterstroke" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If charged this turn, one model may reroll one melee Hit .</characteristic></characteristics></profile><profile id="7eac-f9fd-460c-621c" name="Role and formation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Melee escorts for sonic composers and installations; 1st Ancient Brotherhood / Harmonic Conclave</characteristic></characteristics></profile><profile id="c512-f84b-f5b4-d4ec" name="Equipment guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew. Costs, stats and new abilities are homebrew. Not balanced or New Recruit import-tested. Specialist allocation is independently checked in offline editor; native New Recruit cross-model enforcement requires an in-app check.</characteristic></characteristics></profile><profile id="dbb9-d75c-e963-84a0" name="Squad complement" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Exactly one squad lead/controller plus 4–9 squad members.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="2116-5701-cbc2-7e74" name="Lead Artisan / Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="35"/></costs><constraints><constraint id="7b78-1b8c-1b4f-2206" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="e5d6-a540-f23b-b089" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="d2eb-a4a3-f8c6-d463" name="Close-combat arm" hidden="false" defaultSelectionEntryId="c312-765b-2ec7-91c8"><constraints><constraint id="63fc-e956-533c-1c0f" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="782c-268d-cd1e-422a" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="c312-765b-2ec7-91c8" name="Power weapon" type="upgrade" hidden="false"><profiles><profile id="edda-a30c-df0d-b5b0" name="Power weapon" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">5</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="4f1d-85ca-ef38-4755" name="Resonance maul" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="12"/></costs><profiles><profile id="e460-78f4-3bed-0853" name="Resonance maul" hidden="false" typeId="a4f5-4674-0