 per battle per charge bearer, after this unit ends a successful Charge move, designate one enemy unit it charged. During the next Fight phase, improve AP by 1 for this unit’s melee attacks against that target; repeated charges cannot stack on one target.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="4fc3-1106-631c-c745" name="IceBreaker Breacher 6" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="25"/></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b16f-236f-6b54-5852"/></constraints><profiles><profile id="0a29-6403-92ad-187c" name="Issued mandatory shield" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Reinforced IceBreaker boarding shield. Cannot be replaced or removed; its effect is already included in the unit characteristic profile.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="e2e2-e664-9c26-0340" name="Armor pattern" hidden="false" defaultSelectionEntryId="96c0-6be4-7139-93de"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="2194-b496-c82b-6137"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a254-f692-1573-e071"/></constraints><selectionEntries><selectionEntry id="96c0-6be4-7139-93de" name="Mk III" type="upgrade" hidden="false"/><selectionEntry id="97d4-90a6-1e51-19d9" name="Mk IV" type="upgrade" hidden="false"/><selectionEntry id="e77c-9955-0f04-7775" name="Mk V" type="upgrade" hidden="false"/><selectionEntry id="b06c-b612-904c-625c" name="Mk VI" type="upgrade" hidden="false"/><selectionEntry id="85e3-ac79-bb94-e40f" name="Mk VII" type="upgrade" hidden="false"/><selectionEntry id="cbac-4981-fce9-7919"