acteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reduce the Damage of one attack allocated to this vehicle by 1, minimum 1 .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c00e-c839-f2df-26e5" name="Additional tracked armor" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="8a51-9923-244d-b830" name="Selected configuration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reduce one unsaved attack Damage by 1, minimum 1 .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="d96d-f69d-8f8c-1d89" name="Frozen Cogs Thunderhawk Gunship" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="47a3-b707-b449-a504" name="Aircraft &amp; Gunships" targetId="237f-1a28-dc2b-753b" hidden="false" primary="true"/><categoryLink id="6d3b-c1a5-6162-e9e9" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="dd37-1a6f-b2e0-bb02" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="e883-2825-0a6f-7631" name="Frozen Cogs Thunderhawk Gunship" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">20–60"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">12</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">22</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">0</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="ddfa-4ca7-1663-4a8b" name="Heavy Aerial Lift" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">When this model disembarks Firstborn models while Hovering, one eligible disembarking unit may reroll one Advance roll that turn .</characteristic></characteristics></profile><profile id="d139-75b8-2b90-4241" name="Flight Profile" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At deployment select Airborne or Hover if agreed in the battle pack; Airborne uses the event’s normal aircraft limitations. No free invulnerability.</characteristic></characteristics></profile><profile id="8ff4-39ba-15a3-c4bc" name="Role and doctrine" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Heavy gunship and Terminator insertion; allocation: Fleet Operators / 4th Mechanized</characteristic></characteristics></profile><profile id="f3c6-f043-78a0-4943" name="Transport restrictions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Capacity 30 infantry spaces. Terminator models consume 2 spaces. No Jump Packs, automata, allied factions or embarked vehicles except stated external vehicle gantries. May carry up to 30 spaces of Firstborn infantry; each Terminator uses 2. Hover timing follows homebrew aircraft rules.</characteristic></characteristics></profile><profile id="efc4-7dd8-cb11-bd42" name="Homebrew development status" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All new weapons, points, capacities, arrival rules and effects are preliminary homebrew and not verified against current official 40k or native New Recruit importing.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="6495-ff0f-42fe-9f96" name="Thunderhawk Gunship" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="405"/></costs><constraints><constraint id="baab-c3ef-73d0-7619" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="9d1a-1d60-4fff-2417" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="8fb0-d78c-a01f-badf" name="Principal armament" hidden="false" defaultSelectionEntryId="f0ee-d49a-c935-07e7"><constraints><constraint id="04c0-e101-f605-1623" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="221a-9c16-addb-c167" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="f0ee-d49a-c935-07e7" name="Thunderhawk battle cannon" type="upgrade" hidden="false"><profiles><profile id="1e6b-0a52-6d7e-bc08" name="Thunderhawk battle cannon" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">72"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">D6+3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">15</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Blast</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="3f32-49be-e4dc-d7df" name="Thunderhawk turbo-laser" type="upgrade" hid