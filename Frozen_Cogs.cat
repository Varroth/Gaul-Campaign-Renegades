pts" typeId="0246-3343-a75c-5ffa" value="5"/></costs><profiles><profile id="a387-8318-bdc2-529d" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle this squad may reroll a failed Battle-shock test </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="4ad5-4137-ed07-c77f" name="Auxilia member 2" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="12"/></costs><constraints><constraint id="c175-c16a-55a7-5def" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="5622-b584-e65a-872d" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="ef06-ddc9-aa76-0a87" name="Recon weapon" hidden="false" defaultSelectionEntryId="3c56-b4b4-19ff-b4d5"><constraints><constraint id="ad81-54a0-ce8a-c300" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="22b5-7a9f-d010-661e" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="3c56-b4b4-19ff-b4d5" name="Coldline autogun" type="upgrade" hidden="false"><profiles><profile id="beab-f98c-1504-36b5" name="Coldline autogun" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">3</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic