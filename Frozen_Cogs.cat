="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reduce one unsaved attack Damage by 1, minimum 1 .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="1862-563d-e7f6-bec9" name="Fire plan" hidden="false" defaultSelectionEntryId="38ae-f36f-ed46-25cc"><constraints><constraint id="e798-1f8e-4f1d-1d62" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="3367-03f2-e9e5-d82e" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="38ae-f36f-ed46-25cc" name="Area Suppression" type="upgrade" hidden="false"><profiles><profile id="fb68-c22d-ddd0-67ab" name="Selected configuration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Reduce movement of one hit infantry target by 1 inch until next enemy Movement </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1e01-19ee-90e7-2404" name="Counterbattery Plot" type="upgrade" hidden="false"><profiles><profile id="493f-93ca-ae74-8ac9" name="Selected configuration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Re-roll one shot count die against enemy artillery target </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="6374-72a7-024d-19db" name="Frozen Cogs Land Raider" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="c27a-9ee7-a488-e812" name="Armored Transports" targetId="5b89-f231-abc9-9294" hidden="false" primary="true"/><categoryLink id="f0b1-d63d-ed7e-8c15" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="41b3-060b-f686-684b" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="3e4c-1a99-d5f8-ff26" name="Frozen Cogs Land Raider" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">10"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">12</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">16</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">5</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="4609-ef88-1b26-6aba" name="Assault Ramp" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Passengers may charge in the same turn they disembark after this model makes a Normal Move; all other transport restrictions still apply (homebrew).</characteristic></characteristics></profile><profile id="e5fe-c828-7991-9767" name="Transport capacity and permitted passengers" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Carry up to 12 infantry spaces. A standard non-Jump Pack Firstborn infantry model occupies 1 space. A Terminator-armored model occupies 2 spaces. Every attached Leader occupies space as appropriate. Dreadnoughts, vehicles, automata, jetbikes, aircraft, non-Frozen-Cogs allies unless separate alliance transport rule permits them. Capacity counts every carried model, including attached Leaders. No dedicated transport carries enemy units.</characteristic></characteristics></profile><profile id="9305-752d-0036-c48b" name="Chassis role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Armored breakthrough and assault deployment; assignment: 4th mechanized / 1st Ancient Brotherhood</characteristic></characteristics></profile><profile id="8c55-a230-43a5-90d1" name="Roster status" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">New weapon profiles, transport limits and special rules are homebrew homebrew design, not verified official datasheet. No balance simulations or native New Recruit import verification.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="6164-7cd3-31ea-ceee" name="Land Raider" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="240"/></costs><constraints><constraint id="77ac-a4ac-c341-b76d" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="5e64-ffeb-546a-370b" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="98e8-e8d0-253e-41e0" name="Paired anti-tank arrays" hidden="false" defaultSelectionEntryId="b233-83ed-5064-709d"><constraints><constraint id="94f1-34aa-f7c7-4cb9" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="360e-b123-5bec-a92f" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="b233-83ed-5064-709d" name="Two twin lascannon arrays" type="upgrade" hidden="false"><profiles><profile id="81ee-67ac-2622-0706" name="Two twin lascannon arrays" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">