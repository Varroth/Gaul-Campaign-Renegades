ue"/><categoryLink id="b45a-0c19-96f6-8fd8" name="Character" targetId="2e98-8db1-b592-bebd" hidden="false" primary="false"/><categoryLink id="106d-8971-bddd-cdc5" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/><categoryLink id="8382-5b95-10c2-af40" name="Infantry" targetId="d640-7a85-a199-c350" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="dfa4-579e-1971-ffbf" type="max" value="1" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="b63c-a5f1-2f5d-c725" name="Sythral the Broken Blade" typeId="0cb1-7394-fb88-5322" typeName="Unit" hidden="false"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">6</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">4+</characteristic></characteristics></profile><profile id="c1b1-dd8f-f413-3740" name="Iron Column" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle round, one friendly Frozen Cogs VEHICLE within 6" may re-roll a single Hit roll.</characteristic></characteristics></profile><profile id="a9dc-73f8-2200-5b2e" name="Mechanized Commander" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">May be assigned to a vehicle escort formation; transport/embark restrictions follow the chosen vehicle.</characteristic></characteristics></profile><profile id="9295-301d-2eb2-9332" name="Leader attachment authorization" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">May lead ONLY these bodyguard unit types: Frozen Cogs Tactical Squad, Frostline Combat Engineers, IceBreaker Breachers, Sacred Forge Tactical Support Squad. One attached Leader per bodyguard by default; designated character must be separately included in army roster, no free attached model or extra equipment quotas. Cross-check attachments in offline editor.</characteristic></characteristics></profile><profile id="dfe6-e676-acf1-a788" name="Equipment and compatibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">homebrew character points, abilities and weapon profiles; no battle testing performed. Fixed signature weapons remain mandatory; mixed pre-Primaris Firstborn armor patterns supported within each appropriate class.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="ef37-797f-35df-4c19" name="Sythral the Broken Blade" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="155"/></costs><constraints><constraint id="2fbe-849a-2cfd-4b65" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="7335-2e32-945f-60ee" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="f4d5-9bb1-81fa-63f3" name="Armor / pattern" hidden="false" defaultSelectionEntryId="f31f-6e21-0dc9-13e5"><constraints><constraint id="0469-d468-2a02-96ad" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="eb3e-eff1-2246-505a" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="f31f-6e21-0dc9-13e5" name="Mk II" type="upgrade" hidden="false"/><selectionEntry id="7588-22c5-c21b-52b7" name="Mk III" typ