istic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Torrent, Ignores Cover</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="6f4d-4d79-521c-ec93" name="Auxilia melta gun" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="0f77-5492-ed4b-18de" name="Auxilia melta gun" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">1</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-4</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">D6</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Melta 2 </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="e255-850e-5d3a-e537" name="Auxilia plasma gun" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="ccd0-49d1-bfe9-c097" name="Auxilia plasma gun" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">8</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Hazardous </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1d49-ed8f-806b-3e6b" name="Powered breaching axe" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="a98f-f32c-13a5-d2a2" name="Powered breaching axe" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">5</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="2f99-965b-43db-1700" name="Standard boarding shield" hidden="false" defaultSelectionEntryId="43d7-2e34-4ebc-d405"><constraints><constraint id="e0f6-085e-1d84-ba0e" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="8d0a-8508-a279-3c3d" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="43d7-2e34-4ebc-d405" name="Auxilia boarding shield" type="upgrade" hidden="false"><profiles><profile id="2ba8-4bec-0794-32e2" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">+1 to unmodified Armor saving throws vs ranged attacks, to max 3+ ; not a Space Marine storm shield</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="dbb9-8634-aa13-ebe7" name="Breaching kit" hidden="false" defaultSelectionEntryId="541c-d85b-36d5-4d44"><constraints><constraint id="1dc7-b352-f8ce-5efd" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="bfae-eacb-3cb8-382f" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="541c-d85b-36d5-4d44" name="Hardened field kit" type="upgrade" hidden="false"><profiles><profile id="958c-7c62-c136-99c2" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No added ability; typical armour/kit issued for task</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="cb35-39ef-6819-dd4e" name="Demolition kit" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="8"/></costs><profiles><profile id="7f2e-545e-0714-70ef" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One-use demolition charge in the Shooting phase: 6" D3 S8 AP-2 D2 Blast </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="b7e3-c8a4-aac2-55ca" name="Squad breach drill" hidden="false" defaultSelectionEntryId="bdb2-300e-2fef-a1fc"><constraints><constraint id="91a3-dd7a-894b-f58c" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="4e58-f26b-77a5-d320" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="bdb2-300e-2fef-a1fc" name="Stack and Clear" type="upgrade" hidden="false"><profiles><profile id="4e26-0b9b-6152-366f" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">After disembarking, one model can reroll a ranged Hit roll .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="9567-02fb-0f9c-2234" name="Shield Lock" type="upgrade" hidden="false"><profiles><profile id="cbc0-3435-6d2a-ab05" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If Remained Stationary, one model rerolls one save against ranged attacks this phase .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="aec2-3da4-d0df-4afc" name="Internal squad NCO" hidden="false" defaultSelectionEntryId="8362-33df-10bd-7f90"><constraints><constraint id="f203-1dd0-328a-c1d2" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="90c1-6aa5-b428-2b4c" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="8362-33df-10bd-7f90" name="Squad leader comm bead" type="upgrade" hidden="false"><profiles><profile id="a892-b858-c357-e3d5" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One per section, issued to first model; no separate officer-chain or Orders system</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="55a6-3688-a5de-6ddc" name="Veteran section leader" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="5"/></costs><profiles><profile id="41b5-c070-5686-677b" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle this squad may reroll a failed Battle