" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="1abe-ad80-9d90-c32a" name="Scimitar plasma cannon" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">D3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">8</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Blast, Hazardous</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="2621-53d3-2f8d-7f16" name="Jetbike reactor casing" hidden="false" defaultSelectionEntryId="0cba-3523-0f5f-79e5"><constraints><constraint id="36c3-309e-f928-d935" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="b5a3-742c-865e-57a2" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="0cba-3523-0f5f-79e5" name="Standard grav shielding" type="upgrade" hidden="false"><profiles><profile id="a104-1e59-2ab8-31a3" name="Equipment detail" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Approved mechanical fitting</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="160f-734b-9851-bd50" name="Reinforced lift shielding" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="b56d-b4d0-e137-5da3" name="Equipment detail" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one failed saving throw for the unit .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="8c22-e279-ccd9-7759" name="Sacred Forge Reclaimer Marines" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="4322-b640-fe42-7118" name="Sacred Forge Support" targetId="fcb6-2503-af40-5e72" hidden="false" primary="true"/><categoryLink id="3982-d149-1d87-43fd" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="2484-feec-6661-9da7" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="0688-cb20-d043-92f7" name="Sacred Forge Reclaimer Marines" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="20d6-623d-8045-3365" name="Battlefield Recovery" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At end of your Movement phase, if this unit is not within Engagement Range, choose one friendly non-Titanic VEHICLE within 3 inches: restore 1 lost Wound. A vehicle can receive only one Frozen Cogs repair in a turn, regardless of source .</characteristic></characteristics></profile><profile id="0235-1b2f-a74c-8219" name="Salvage Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">When controlling an objective, one model can make one ranged Hit reroll per friendly Shooting phase .</characteristic></characteristics></profile><profile id="e10f-8058-d35d-0829" name="Role and formation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Armored recovery and battlefield repairs; 36 Forge / 7th Recon Engineering</characteristic></characteristics></profile><profile id="84a6-90ee-08c2-2723" name="Equipment guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew. Costs, stats and new abilities are homebrew. Not balanced or New Recruit import-tested. Specialist allocation is independently checked in offline editor; native New Recruit cross-model enforcement requires an in-app check.</characteristic></characteristics></profile><profile id="9d2a-f910-0de1-34a0" name="Specialist allocation: gun" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">1 permitted per FULL 5 models among options: Plasma gun, Meltagun; checked in offline editor, native XML may not enforce the shared squad cap.</characteristic></characteristics></profile><profile id="194a-93f7-e4af-1455" name="Lore safeguards" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Unlike Frostline Combat Engineers, this squad specializes in hull recovery rather than fortification or construction.</characteristic></characteristics></profile><profile id="760c-df64-2ba0-c1bf" name="Squad complement" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Exactly one squad lead/controller plus 4–9 squad members.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="bc97-309c-8f57-caff" name="Lead Artisan / Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="26"/></costs><constraints><constraint id="bc23-5fe7-63bf-1d28" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="884b-a53a-a23c-6396" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="531d-931e-126b-ae15" name="Reclaimer firearm" hidden="false" defaultSelectionEntryId="b3c9-e8e5-20eb-0664"><constraints><constraint id="9fd5-1205-c99d-2818" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="10cc-a1b3-c31f-62d6" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="b3c9-e8e5-20eb-0664" name="Forge-pattern boltgun" type="upgrade" hidden="false"><profiles><profile id="4644-4506-ebf1-d8b6" name="Forge-pattern boltgun" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Rapid Fire 1</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="fd44-a8d7-776a-780e" name="Siege pattern sh