"pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="7651-ed9f-b55a-522d" name="Power fist" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">8</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="e2f8-1343-459c-83cb" name="Breach hammer" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="6f2d-c735-a833-98ef" name="Breach hammer" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="fce9-5768-53ed-8898" name="Optional IceBreaker breaching charge" hidden="false"><constraints><constraint type="min" value="0" field="selections" scope="parent" shared="true" id="0e5b-f901-8b4f-b78e"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="48f2-19e2-0054-3bc0"/></constraints><selectionEntries><selectionEntry id="cb8d-3e91-815c-a654" name="IceBreaker breaching charge" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="cd80-97e2-e291-2c99" name="IceBreaker breaching charge" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle per charge bearer, after this unit ends a successful Charge move, designate one enemy unit it charged. During the next Fight phase, improve AP by 1 for this unit’s melee attacks against that target; repeated charges cannot stack on one target.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="5820-cdb5-cb63-f9a4" name="IceBreaker Terminators" type="unit" hidden="false" import="true"><constraints><constraint id="c9b8-5dca-e895-57ab" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><categoryLinks><categoryLink id="b555-8330-dda2-d866" targetId="92bc-f579-7dc3-c5db" name="Siege Assault" hidden="false" primary="true"/><categoryLink id="f564-61c0-1eb7-d873" targetId="e5e4-dd08-6ce4-34b7" name="Frozen Cogs" hidden="false" primary="false"/><categoryLink id="4884-b2db-0c81-331b" targetId="d640-7a85-a199-c350" name="Infantry" hidden="false" primary="false"/><categoryLink id="2ba9-6a92-d2b2-4180" targetId="0a66-2bc3-4792-5c78" name="Terminator" hidden="false"/></categoryLinks><profiles><profile id="60a0-5319-ea91-59fa" name="IceBreaker Terminators" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">5"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">6</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">4+</characteristic></characteristics></profile><profile id="7a7e-25e4-bb12-4646" name="Mandatory IceBreaker Terminator breaching shield" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Mandatory 4+ invulnerable defense (already included in profile), reinforced impact edge and shield/weapon integrated mounts. No shield is lost when choosing a gun or melee option.</characteristic></characteristics></profile><profile id="5e90-046d-77f0-f7a0" name="Iron Breach" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">After this unit completes a successful Charge move, if an enemy it charged is contesting an objective or has the FORTIFICATION keyword, designate one such enemy. Until the end of that Fight phase, improve the AP characteristic of this unit’s melee weapons by 1 against that enemy. Does not stack with duplicate AP-improvement effects.</characteristic></characteristics></profile><profile id="aa89-58ce-8421-f468" name="Breach Shield Lock" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle round, while this unit is within 6" of an objective, one failed saving throw made for this unit against a melee attack may be re-rolled. It may not be re-rolled more than once.</characteristic></characteristics></profile><profile id="eb2c-badd-5697-b6fd" name="Heavy Breaching Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each model keeps its Terminator breaching shield, one ranged weapon (a heavy replacement consumes that firearm slot) and one melee weapon. One selected firing mode per combi-weapon; no universal extra missile launchers, and this unit does not inherit Wintergrave Unrestricted Arsenal.</characteristic></characteristics></profile><profile id="5ab3-8b35-59a2-dac4" name="Terminator Breach Load" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Frostforged Terminator siege shotguns make +1 Attack against an INFANTRY target within 6".</characteristic></characteristics></profile><profile id="396d-24b1-eb8a-ec5c" name="Squad legality" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">5–10 models including exactly one IceBreaker Siege-Sergeant; complete five-model groups set all per-five allowances. Cross-model caps and all role validation should be checked using included Python validator until native import testing is completed. Siege-Sergeant has the same weapons and charge eligibility as an ordinary IceBreaker Terminator; squad allowances include him. No separate targeting coordinator, no automatic named Leader attachments.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="2b00-4e27-fe5b-1eb3" name="IceBreaker Siege-Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="58"/></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="efba-dfae-1d02-b8f1"/><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="d3ec-bcb1-e3cb-4fc1"/></constraints><profiles><profile id="0166-7184-c3de-817b" name="Issued mandatory shield" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">IceBreaker Terminator breaching shield. Cannot be replaced or removed; its effect is already included in the unit characteristic profile.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="f51e-e4a6-b305-2a50" name="Armor pattern" hidden="false" defaultSelectionEntryId="95b4-0acc-8eb4-69c2"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="1299-1fc4-814c-1f15"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="053a-c774-e3a2-2e56"/></constraints><selectionEntries><selectionEntry id="95b4-0acc-8eb4-69c2" name="Cataphractii" type="upgrade" hidden="false"/><selectionEntry id="62f0-d10a-57d7-615c" name="Indomitus" type="upgrade" hidden="false"/><selectionEntry id="9387-b717-4a66-9227" name="Tartaros" type="upgrade" hidden="false"/></selectionEntries></selectionEntryGroup><selectionEntryGroup id="c8c0-571d-1cc5-63ae" name="Primary ranged weapon" hidden="false" defaultSelectionEntryId="440b-e1c5-990d-2067"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="a4fb-ea9b-2026-a11b"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6bb4-7131-d9a8-07ed"/></constraints><selectionEntries><selectionEntry id="440b-e1c5-990d-2067" name="Combi-bolter" type="upgrade" hidden="false"><profiles><profile id="a013-4d72-3469-7967" name="Combi-bolter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic>