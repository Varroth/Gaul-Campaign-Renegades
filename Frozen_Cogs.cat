eld="selections" scope="roster" shared="true"/></constraints><profiles><profile id="3fbf-21ae-ffcd-c78d" name="Frozen Cogs Siege Officer" typeId="0cb1-7394-fb88-5322" typeName="Unit" hidden="false"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">5</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="5ca9-6881-e2b9-6b5a" name="Surveyed Breach" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle round, while leading a unit that controls an objective, one member may ignore one hit penalty when firing at an enemy contesting it.</characteristic></characteristics></profile><profile id="f582-b529-9aed-8002" name="Foothold Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">While leading Breachers, may select their Breach Momentum stance normally; does not grant an extra stance.</characteristic></characteristics></profile><profile id="2607-a089-5cc3-b771" name="Leader attachment authorization" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">May lead ONLY these bodyguard unit types: IceBreaker Breachers, Frostline Combat Engineers, Frozen Cogs Tactical Squad, Frozen Cogs Devastator Squad. One attached Leader per bodyguard by default; designated character must be separately included in army roster, no free attached model or extra equipment quotas. Cross-check attachments in offline editor.</characteristic></characteristics></profile><profile id="c396-0d57-63f5-6e1e" name="Equipment and compatibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">homebrew character points, abilities and weapon profiles; no battle testing performed. Fixed signature weapons remain mandatory; mixed pre-Primaris Firstborn armor patterns supported within each appropriate class.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="56c9-7e4f-8709-b9db" name="Frozen Cogs Siege Officer" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="80"/></costs><constraints><constraint id="8a77-c914-3df5-7a97" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="88a8-5250-2f77-ebdd" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="2947-dd3e-0125-4c69" name="Armor / pattern" hidden="false" defaultSelectionEntryId="e5a7-dbbb-8075-4e98"><constraints><constraint id="fdbe-54fc-81f7-418e" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="8d6f-8ad1-2b9f-6913" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="e5a7-dbbb-8075-4e98" name="Mk II" type="upgrade" hidden="false"/><selectionEntry id="fcd0-c4ad-cc48-2f90" name="Mk III" type="upgrade" hidden="false"/><selectionEntry id="b70a-3062-4de7-38ea" name="Mk IV" type="upgrade" hidden="false"/><selectionEntry id="cf4a-9fa8-56ab-0035" name="Mk V" type="upgrade" hidden="false"/><selectionEntry id="c195-4f91-034f-f3b7" name="Mk VI" type="upgrade" hidden="false"/><selectionEntry id="8e5e-0900-4be6-1e3e" name="Mk VII" type="upgrade" hidden="false"/><selectionEntry id="448b-9f71-e1