cteristic name="Traits" typeId="0f05-4353-204c-511f">Torrent, Ignores Cover</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="12d7-a807-8071-9f97" name="Auxilia plasma gun" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="12ea-4849-58bd-28b2" name="Auxilia plasma gun" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">8</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Hazardous </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="857f-9fbe-4a61-3c45" name="Auxilia melta gun" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="1bcc-6dae-f983-b438" name="Auxilia melta gun" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">1</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-4</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">D6</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Melta 2 </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="8569-ac95-94a0-d784" name="Engineer gear" hidden="false" defaultSelectionEntryId="43d0-dd1c-b014-6b53"><constraints><constraint id="9d53-6379-5fec-f5ac" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="0295-f143-75fc-f3bf" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="43d0-dd1c-b014-6b53" name="Hardened field kit" type="upgrade" hidden="false"><profiles><profile id="9196-3aa5-ee85-528a" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No added ability; typical armour/kit issued for task</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="02ba-526a-0394-03ac" name="Demolition kit" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="8"/></costs><profiles><profile id="e823-f5e8-c157-637f" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One-use demolition charge in the Shooting phase: 6" D3 S8 AP-2 D2 Blast </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="985d-0e8b-164c-363e" name="Charge-bearing demolition rig" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="12"/></costs><profiles><profile id="4c6a-e2bc-a10f-23e7" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle one model may place a breach marker within 1" of terrain. Terrain effects require mission permission </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="0532-89bc-1fc5-035b" name="Tool type" hidden="false" defaultSelectionEntryId="fe6a-86cc-7565-5be5"><constraints><constraint id="228c-f8c4-5f9b-5dde" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="d48e-0340-efcb-b560" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="fe6a-86cc-7565-5be5" name="Utility cutter" type="upgrade" hidden="false"><profiles><profile id="012e-57d0-f3c3-652d" name="Utility cutter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">3</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="f920-3c9d-0891-a7f8" name="Laser-cutter torch" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="7"/></costs><profiles><profile id="2910-5866-0dff-2ad2" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One model gains +1 S melee vs Fortifications </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="c41f-c688-b50c-9525" name="Frostbound Gun Teams" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="ba34-18bc-5e98-fdfd" name="Frostbound Auxilia" targetId="ba92-31ee-3264-a18e" hidden="false" primary="true"/><categoryLink id="a3d9-1a9d-3828-a88c" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="e11d-cdad-70a4-d812" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="53ed-d8f2-32b4-95be" name="Frostbound Gun Teams" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">5"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">5+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="3cd9-9490-68cf-ba73" name="One Frozen Cogs Army" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROSTBOUND AUXILIA are mortal fighting elements of a Frozen Cogs detachment, not a separate Guard faction. They share FROZEN COGS faction allegiance. Their datasheets do not unlock Astra Militarum Orders, Platoon detachments, Guard stratagems or detachment abilities. </characteristic></characteristics></profile><profile id="0472-c0b1-d939-f226" name="Mortal Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Models with FROSTBOUND AUXILIA MORTAL keywords do NOT gain Astartes serum healing, Chapter-level Astartes Feel No Pain, neural-lace mastery, an Obliterator Masterwork, or the special armor abilities of inducted Marines. A unit receives its own printed abilities only. </characteristic></characteristics></profile><profile id="e874-c804-f8cf-3371" name="Direct Support, Not Orders" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attached optional Frostbound Characters provide only their datasheet abilities. No compulsory officer chain and no separate recurring Orders resource. </characteristic></characteristics></profile><profile id="7bb3-a366-9a40-c0a8" name="Workshop Repair Cap" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each VEHICLE may have lost Wounds restored by only one Frozen Cogs repair source in each friendly turn; mortal medicae can affect only named eligible MORTAL INFANTRY. </characteristic></characteristics></profile><profile id="a84a-2971-f8dc-4f52" name="Transport Eligibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Auxilia transports may carry FROSTBOUND AUXILIA INFANTRY (including eligible CHARACTERS) only. They never carry Astartes or Terminators unless a future datasheet expressly says so. </characteristic></characteristics></profile><profile id="16ea-e1ee-3860-3b58" name="Crewed Gun Mount" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each selectable model represents one complete emplaced gun and its three mortal gunners. The weapon mount is the game model (W3); crew are not separate wound-bearing miniature entries.</characteristic></characteristics></profile><profile id="2548-f733-6766-4e5f" name="Pointed Fire" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One heavy weapon per squad may reroll one Hit against an enemy within 24" .</characteristic></characteristics></profile><profile id="6ed2-91b3-a185-e215" name="Roster notice" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew — not official Warhammer 40,000 rules; all profiles and costs homebrew. Native New Recruit combined caps requires an in-app check. Ratio limits are checked in the offline editor; native importer not tested.</characteristic></characteristics></profile><profile id="6b3d-08dc-d2ba-af9f" name="Force allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Fortress companies and field support — Mobile crew-served machine guns and anti-infantry fire</characteristic></characteristics></profile><profile id="f7cb-a935-7bcc-9de9" name="Keywords" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROZEN COGS, FROSTBOUND AUXILIA, MORTAL, CHAOS, INFANTRY</characteristic></characteristics></profile><profile id="6bb8-950b-da32-7fa5" name="Shared cap 1" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At most 2: Coldforged autocannon; checked offline.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="bf1c-a8f3-b871-e0ed" name="Auxilia member 1" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="52"/></costs><constraints><constraint id="af28-e135-a63f-cc82" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="71c7-bcef-dcf3-959a" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="6acb-bd3d-b2f3-2816" name="Crew-served weapon" hidden="false" defaultSelectionEntryId="d911-c044-4517-4726"><constraints><constraint id="fd91-6d57-6ba5-1614" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="cb13-27a0-3cb3-63a1" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="d911-c044-4517-4726" name="Tripod heavy bolter" type="upgrade" hidden="false"><profiles><profile id="ca27-8528-8ef4-3911" name="Tripod heavy bolter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">5</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="d9d4-4d7a-1f46-c035" name="Coldforged autocannon" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="fb5f-71f0-2430-6f53" name="Coldforged autocannon" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">48"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="0836-8285-d940-a871" name="Coldline suppression stubber" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="8"/></costs><profiles><profile id="92fe-823a-0834-baa8" name="Coldline suppression stubber" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Sustained Hits 1 </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="cb89-b858-3eb1-0d21" name="Twin tripod stubbers" type="upgrade" hidden="false"><profiles><profile id="24bd-f4b6-6c64-daa5" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">36" A8 BS4+ S4 AP0 D1 </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="ec09-3b1a-00ba-9668" name="Ammo support" hidden="false" defaultSelectionEntryId="6885-5833-3181-bb97"><constraints><constraint id="9aba-ee59-fec0-f517" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="26ed-8576-33b6-43c2" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="6885-5833-3181-bb97" name="Hardened field kit" type="upgrade" hidden="false"><profiles><profile id="ea70-b7d2-2dad-99e3" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No added ability; typical armour/kit issued for task</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5762-d787-d45e-3a61" name="Belt-feed sled" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="7"/></costs><profiles><profile id="50c3-af65-24af-51c6" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one shot-count dice </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="48bf-6643-2141-d28d" name="Crew fire drill" hidden="false" defaultSelectionEntryId="ae7e-885f-3ea9-3a9f"><constraints><constraint id="be15-b8b4-bcbc-33eb" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="8d31-adba-4e09-27cf" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="ae7e-885f-3ea9-3a9f" name="Fixed Emplacement" type="upgrade" hidden="false"><profiles><profile id="fd21-a623-70db-8ab3" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Heavy weapon gains Heavy if stationary .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="924f-fb76-7a7b-9625" name="Mobile Tripod" type="upgrade" hidden="false"><profiles><profile id="7c03-30fc-9e2e-1888" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Treat squad as able to Advance and still shoot standard firearm .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="bb57-4043-79bc-fae1" name="Internal squad NCO" hidden="false" defaultSelectionEntryId="bd86-3295-43a0-f871"><constraints><constraint id="8224-5e2a-9006-714c" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="fcdb-a621-ac8c-d88a" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="bd86-3295-43a0-f871" name="Squad leader comm bead" type="upgrade" hidden="false"><profiles><profile id="39f4-5fd1-8d06-1d5c" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One per section, issued to first model; no separate officer-chain or Orders system</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="49d0-27e5-59bc-0946" name="Veteran section leader" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="5"/></costs><profiles><profile id="399e-d0c7-10e9-a2a1" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle this squad may reroll a failed Battle-shock test </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="d957-ccc7-a1e3-4afc" name="Auxilia member 2" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="52"/></costs><constraints><constraint id="0a96-4629-8422-267b" type="min" value="0" field="selections" scope="parent" shared="true"/><constraint id="8a4c-2f39-170c-b594" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="02d4-e4eb-0dbe-dd3c" name="Crew-served weapon" hidden="false" defaultSelectionEntryId="ee4d-fa3d-52a0-1696"><constraints><constraint id="5c23-5acc-3290-55b9" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="fb80-bbc8-a3af-6024" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="ee4d-fa3d-52a0-1696" name="Tripod heavy bolter" type="upgrade" hidden="false"><profiles><profile id="ff81-1c80-8287-bfed" name="Tripod heavy bolter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">5</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8544-85c7-7142-951b" name="Coldforged autocannon" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="8196-f82a-5d41-6056" name="Coldforged autocannon" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">48"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy </ch