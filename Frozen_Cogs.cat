f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle at the start of your Movement phase, one eligible embarked Firstborn unit gains a reroll of one Battle-shock test until end of phase .</characteristic></characteristics></profile><profile id="3c99-0b3e-12f5-04fe" name="Role and doctrine" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Ancient heavy orbital insertion carrier; allocation: Fleet strategic reserve / First Company deployment</characteristic></characteristics></profile><profile id="6a76-4c5d-52f4-1569" name="Transport restrictions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Capacity 40 infantry spaces. Terminator models consume 2 spaces. No Jump Packs, automata, allied factions or embarked vehicles except stated external vehicle gantries. Strategic air carrier; up to forty infantry spaces. No automatic vehicle-bay or Dreadnought permission.</characteristic></characteristics></profile><profile id="f285-dc61-6fa1-7990" name="Homebrew development status" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All new weapons, points, capacities, arrival rules and effects are preliminary homebrew and not verified against current official 40k or native New Recruit importing.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="5d50-adfe-f428-6d44" name="Sokar-pattern Stormbird" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="600"/></costs><constraints><constraint id="d154-c75a-a6c5-9e45" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="b015-8a2e-b542-45c5" type="max" value="1" field="se