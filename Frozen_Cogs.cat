haracteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">5+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="37b0-1047-5bb9-3b4d" name="Icehook Recovery Servitors" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="0547-d0f6-0f09-987b" name="Sacred Forge Support" targetId="fcb6-2503-af40-5e72" hidden="false" primary="true"/><categoryLink id="0803-f4c8-a79d-4b5c" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="0b91-e218-43c5-f52d" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="dccd-9804-19ee-591b" name="Icehook Recovery Servitors" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">5"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">5+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">8+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="2dae-3cba-5b8d-380f" name="Wreck Extraction" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At end of your Movement phase choose one friendly non-Titanic VEHICLE within 3 inches: if it Remained Stationary this turn, it can reroll one saving throw before your next turn .</characteristic></characteristics></profile><profile id="3187-a299-d0e2-4a57" name="Unsung Labor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">These are civilian/servitor auxiliaries, not Chapter strength.</characteristic></characteristics></profile><profile id="d501-e880-561e-add9" name="Role and formation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Tow chains, ammunition recovery, casualty extraction; Forge workforce; non-Astartes</characteristic></characteristics></profile><profile id="63db-df19-1731-da51" name="Equipment guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew. Costs, stats and new abilities are homebrew. Not balanced or New Recruit import-tested. Specialist allocation is independently checked in offline editor; native New Recruit cross-model enforcement requires an in-app check.</characteristic></characteristics></profile><profile id="cff2-26b0-bab1-0422" name="Squad complement" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Exactly one squad lead/controller plus 3–7 squad members.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="7b9a-f393-b639-cf0a" name="Control Operator / Lead Platform" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="17"/></costs><constraint