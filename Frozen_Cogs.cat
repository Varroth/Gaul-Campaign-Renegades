acteristic name="Description" typeId="4c71-0d90-3b92-5cec">Approved mechanical fitting</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7d3d-8180-406a-5350" name="Cold-forge targeting logic" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="998c-3279-2ffd-c41c" name="Equipment detail" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one Hit roll with one selected ranged weapon .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="be0f-13c6-cb79-90ed" name="Frostglass augur sweep" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="6848-71a4-c298-02c8" name="Equipment detail" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At start of your Shooting phase designate one visible target within 18 inches; this vehicle can reroll one ranged Hit against it .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="4c0c-802f-8ece-7556" name="Frozen Cogs Storm Eagle Gunship" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="f157-0e05-8715-f285" name="Aircraft &amp; Gunships" targetId="237f-1a28-dc2b-753b" hidden="false" primary="true"/><categoryLink id="abdb-a5ff-aac5-9eb3" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="499c-4e37-ff1b-f01a" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="0b9d-a9b5-bd76-c641" name="Frozen Cogs Storm Eagle Gunship" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">20–60"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">10</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">16</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">0</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="d26a-9959-fd5b-c362" name="Storm Eagle Deployment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle one disembarking non-Terminator infantry unit may reroll one Charge roll if legally eligible to charge that turn .</characteristic></characteristics></profile><profile id="de97-0ffc-f976-08fd" name="Role and doctrine" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Relic Heresy-era aerial infantry delivery; allocation: 5th Boarding / Fleet Operators</characteristic></characteristics></profile><profile id="41a8-0757-6628-d336" name="Transport restrictions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Capacity 22 infantry spaces. Terminator models consume 2 spaces. No Jump Packs, automata, allied factions or embarked vehicles except stated external vehicle gantries. Passengers including attached Leaders each use capacity. Passengers must be separately purchased.</characteristic></characteristics></profile><profile id="a9c7-33f5-aaaf-6e2e" name="Homebrew development status" hidden="false" typeId="bd5c-f804-35b5-510d" ty