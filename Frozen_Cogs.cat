46d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Sustained Hits 1 </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="4cd4-847b-d243-65b8" name="Twin tripod stubbers" type="upgrade" hidden="false"><profiles><profile id="e27e-2eb4-204a-b747" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">36" A8 BS4+ S4 AP0 D1 </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="12a0-631a-9f68-1e1c" name="Ammo support" hidden="false" defaultSelectionEntryId="8051-f4ce-11f8-b66c"><constraints><constraint id="3b6a-4685-b976-2efc" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="3767-6aa6-5a5b-c0d2" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="8051-f4ce-11f8-b66c" name="Hardened field kit" type="upgrade" hidden="false"><profiles><profile id="f8d8-b9b6-0fd0-7c7c" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No added ability; typical armour/kit issued for task</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c010-0c98-08fb-e95f" name="Belt-feed sled" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="7"/></costs><profiles><profile id="d265-faf4-7d78-680d" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one shot-count dice </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="68e8-c0b9-afc2-6766" name="Frostbound Anti-Armor Section" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="0957-2953-16d1-7ef0" name="Frostbound Auxilia" targetId="ba92-31ee-3264-a18e" hidden="false" primary="true"/><categoryLink id="4a89-8d43-e21b-8031" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="4e9e-6f8e-a18d-0c60" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="00ef-9045-3593-26a3" name="Frostbound Anti-Armor Section" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">3</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">5+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">1</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="4c5d-1eb0-6055-f1a9" name="One Frozen Cogs Army" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROSTBOUND AUXILIA are mortal fighting elements of a Frozen Cogs detachment, not a separate Guard faction. They share FROZEN COGS faction allegiance. Their datasheets do not unlock Astra Militarum Orders, Platoon detachments, Guard stratagems or detachment abilities. </characteristic></characteristics></profile><profile id="6737-bcdb-d8d5-3bf5" name="Mortal Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Models with FROSTBOUND AUXILIA MORTAL keywords do NOT gain Astartes serum healing, Chapter-level Astartes Feel No Pain, neural-lace mastery, an Obliterator Masterwork, or the special armor abilities of inducted Marines. A unit receives its own printed abilities only. </characteristic></characteristics></profile><profile id="0fe2-5ef4-f030-baa1" name="Direct Support, Not Orders" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attached optional Frostbound Characters provide only their datasheet abilities. No compulsory officer chain and no separate recurring Orders resource. </characteristic></characteristics></profile><profile id="6a6d-3635-116d-37ce" name="Workshop Repair Cap" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each VEHICLE may have lost Wounds restored by only one Frozen Cogs repair source in each friendly turn; mortal medicae can affect only named eligible MORTAL INFANTRY. </characteristic></characteristics></profile><profile id="98f8-f5ff-4457-5080" name="Transport Eligibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Auxilia transports may carry FROSTBOUND AUXILIA INFANTRY (including eligible CHARACTERS) only. They never carry Astartes or Terminators unless a future datasheet expressly says so. </characteristic></characteristics></profile><profile id="6ded-55c5-be64-eefe" name="Precision Penetration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One model per shooting phase rerolls one Wound against a Vehicle or Monster .</characteristic></characteristics></profile><profile id="5b96-a070-0863-1ea1" name="Roster notice" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew — not official Warhammer 40,000 rules; all profiles and costs homebrew. Native New Recruit combined caps requires an in-app check. Ratio limits are checked in the offline editor; native importer not tested.</characteristic></characteristics></profile><profile id="967a-72a4-41d9-ed0d" name="Force allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Frostbound siege-support batteries — Hunter-killer infantry and portable thermal ordnance</characteristic></characteristics></profile><profile id="e416-1149-fd42-c0ec" name="Keywords" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROZEN COGS, FROSTBOUND AUXILIA, MORTAL, CHAOS, INFANTRY</characteristic></characteristics></profile><profile id="9d1d-3872-7418-01ef" name="Specialist cap 1" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At most 1 per full 5 models: Shoulder missile launcher, Auxilia lascannon, Coldspike recoilless gun; checked offline.</characteristic></characteristics></profile><profile id="9102-a279-948c-7098" name="Specialist cap 2" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At most 1 per full 5 models: Auxilia melta gun; checked offline.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="56d5-e497-21d8-80e7" name="Auxilia member 1" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="16"/></costs><constraints><constraint id="05f4-2dd0-2766-61a3" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="18bc-da0b-40c5-4b98" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="d6ba-e46d-70a7-5cdc" name="Anti-armor weapon" hidden="false" defaultSelectionEntryId="2c5c-ac19-ae6e-c57f"><constraints><constraint id="82aa-1627-7605-3088" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="8a4a-fe0d-6dd4-0ede" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="2c5c-ac19-ae6e-c57f" name="Frostbound pattern lascarbine" type="upgrade" hidden="false"><profiles><profile id="4b8a-c4be-260b-cae6" name="Frostbound pattern lascarbine" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">3</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Rapid Fire 1 </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="82ad-c0c7-a9ad-493a" name="Shoulder missile launcher" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="17"/></costs><profiles><profile id="a03d-53aa-bb3e-f28f" name="Shoulder missile launcher" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">1</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">D6</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy ; frag mode 36" D3 S4 Blast</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="283c-eb6e-cb23-e3cf" name="Auxilia lascannon" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="22"/></costs><profiles><profile id="81ab-a408-6be1-ff4e" name="Auxilia lascannon" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">48"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">1</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">12</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">D6+1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="9c33-4a27-d699-74b5" name="Auxilia melta gun" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="f5b5-3d35-7c20-1e74" name="Auxilia melta gun" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">1</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-4</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">D6</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Melta 2 </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="fdb1-8a04-eb4f-abe6" name="Coldspike recoilless gun" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="19"/></costs><profiles><profile id="3c8b-32de-6718-d325" name="Coldspike recoilless gun" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">1</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">11</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="2732-1b82-61b3-489b" name="Auxiliary gear" hidden="false" defaultSelectionEntryId="08b7-4c6f-21f8-7009"><constraints><constraint id="ad3a-3f8f-6c1d-482c" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="028e-d261-9057-297e" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="08b7-4c6f-21f8-7009" name="Hardened field kit" type="upgrade" hidden="false"><profiles><profile id="99f3-1ed2-029f-0098" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No added ability; typical armour/kit issued for task</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="f5f7-27d0-201d-455c" name="Survey beacon" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="12"/></costs><profiles><profile id="dec4-67a7-3ced-e037" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, one enemy in 24" can be marked for a friendly FROZEN COGS unit to ignore Cover against it for one attack </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="0cd0-ccf4-6ec0-ffad" name="Loader mantle" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="8"/></costs><profiles><profile id="3309-f1d0-d262-ae37" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle one model rerolls one ranged Wound against a Vehicle </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="99c7-4e72-a834-a6b3" name="Tank-hunter drill" hidden="false" defaultSelectionEntryId="1bd3-d861-244a-9ed8"><constraints><constraint id="9763-6c26-1fce-cb09" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="4cfb-5da6-a113-4da4" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="1bd3-d861-244a-9ed8" name="Track the Target" type="upgrade" hidden="false"><profiles><profile id="8074-f754-c248-b8c8" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">When stationary, one anti-armor attack can ignore Cover .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="f2d1-4fd6-5011-f11c" name="Bait the Flank" type="upgrade" hidden="false"><profiles><profile id="d67c-5103-9104-1308" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">After enemy Vehicle ends a move within 12", one member can Fire Overwatch once per battle for 0CP .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="5c63-a5c5-6e50-f00f" name="Internal squad NCO" hidden="false" defaultSelectionEntryId="5ebc-d3a4-a459-efc9"><constraints><constraint id="e9c0-9928-7702-63dc" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="f1f1-fab6-1b20-3f15" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="5ebc-d3a4-a459-efc9" name="Squad leader comm bead" type="upgrade" hidden="false"><profiles><profile id="3c0f-c5c3-d087-b334" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One per section, issued to first model; no separate officer-chain or Orders system</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="ddde-25f9-45ee-60e7" name="Veteran section leader" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="5"/></costs><profiles><profile id="87d9-75e0-bde2-70f1" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle this squad may reroll a failed Battle-shock test </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="ef1b-eae3-4b2f-c18b" name="Auxilia member 2" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="16"/></costs><constraints><constraint id="9b66-2750-0c5f-ea09" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="c9d5-3261-4e84-120c" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="ae50-da41-2a33-100a" name="Anti-armor weapon" hidden="false" defaultSelectionEntryId="1d55-de58-ee52-a4ff"><constraints><constraint id="612d-61a1-9ce7-99fc" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="b56e-fe0d-2b97-7ffb" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="1d55-de58-ee52-a4ff" name="Frostbound pattern lascarbine" type="upgrade" hidden="false"><profiles><profile id="65fd-05e5-60f9-6638" name="Frostbound pattern lascarbine" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">3</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Rapid Fire 1 </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="9ebf-1470-8323-ebfd" name="Shoulder missile launcher" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="17"/></costs><profiles><profile id="2688-3261-23e1-69fa" name="Shoulder missile launcher" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weap