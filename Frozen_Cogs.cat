 move, designate one enemy unit it charged. During the next Fight phase, improve AP by 1 for this unit’s melee attacks against that target; repeated charges cannot stack on one target.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="c0ac-4b90-a2f5-38e4" name="IceBreaker Breacher 3" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="25"/></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9deb-fbbe-5760-0f5f"/><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="d741-e960-2202-cb3e"/></constraints><profiles><profile id="456d-b5ee-4b1f-cef3" name="Issued mandatory shield" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Reinforced IceBreaker boarding shield. Cannot be replaced or removed; its effect is already included in the unit characteristic profile.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="0934-828b-0346-64cf" name="Armor pattern" hidden="false" defaultSelectionEntryId="6d84-9f9b-d97a-9518"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="97be-21b0-19e5-18a7"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="57b7-772e-872a-fcf1"/></constraints><selectionEntries><selectionEntry id="6d84-9f9b-d97a-9518" name="Mk III" type="upgrade" hidden="false"/><selectionEntry id="8ae2-dd93-2d69-9d8c" name="Mk IV" type="upgrade" hidden="false"/><selectionEntry id="ec75-3db9-5b37-291e" name="Mk V" type="upgrade" hidden="false"/><selectionEntry id="fb40-c1b3-26a3-e4f1" name="Mk VI" type="upgrade" hidden="false"/><selectionEntry id="a077-c9cd-da6e-6d05" name="Mk VII" type="upgrade" hidden="false"/><sel