><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Blast</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="6e33-9840-27b2-2ed4" name="Tactical circuit" hidden="false" defaultSelectionEntryId="0602-5eef-0f31-5c66"><constraints><constraint id="26d5-0501-7e57-e400" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="ab38-f583-e1c5-b7ba" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="0602-5eef-0f31-5c66" name="Survey Priority" type="upgrade" hidden="false"><profiles><profile id="2bd9-a155-007e-83f7" name="Selected configuration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Nominate one visible target within 24" at start of friendly Shooting phase; one friendly infantry unit may re-roll one Hit roll against it .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="d231-ca83-3f7b-9bce" name="Perimeter Security" type="upgrade" hidden="false"><profiles><profile id="c5db-fec1-debd-d223" name="Selected configuration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If stationary, once per turn ignore a negative Hit modifier on one ranged attack .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="4e53-459a-2a88-3bcc" name="Frozen Cogs Rhino" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="086b-5366-4743-f4f5" name="Armored Transports" targetId="5b89-f231-abc9-9294" hidden="false" primary="true"/><categoryLink id="2fb4-ddad-3b24-a901" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="c0ba-ac35-d88d-c9ab" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="e6e1-cc26-049c-7c3b" name="Frozen Cogs Rhino" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">12"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">9</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">10</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="faa0-9ca7-d5ed-7595" name="Armored Workhorse" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">After this vehicle makes a Normal Move, one disembarked eligible unit can reroll one Advance die that turn if it disembarked before the transport moved .</characteristic></characteristics></profile><profile id="3074-bf0e-e446-6011" name="Transport capacity and permitted passengers" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Carry up to 12 infantry spaces. A standard non-Jump Pack Firstborn infantry model occupies 1 space. Terminator models are not permitted. Every attached Leader occupies space as appropriate. Dreadnoughts, vehicles, automata, jetbikes, aircraft, non-Frozen-Cogs allies unless separate alliance transport rule permits them. Capacity counts every carried model, including attached Leaders. No dedicated transport carries enemy units.</characteristic></characteristics></profile><profile id="9bbf-12c4-6f50-22aa" name="Chassis role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Armored infantry deployment; assignment: 4th Mechanized and line-company transport pools</characteristic></characteristics></profile><profile id="901f-fd11-758c-6958" name="Roster status" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">New weapon profiles, transport limits and special rules are homebrew homebrew design, not verified official datasheet. No balance simulations or native New Recruit import verification.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="1d23-2b7f-0b03-ca14" name="Rhino" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="80"/></costs><constraints><constraint id="19b6-d966-7b71-221b" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="866e-c3d6-e3f9-3d7a" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="0578-fdcf-15cd-e758" name="Roof defense" hidden="false" defaultSelectionEntryId="700b-f36a-1cd4-52c0"><constraints><constraint id="939b-922c-4ca1-3d73" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="6567-a96c-59d3-161e" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="700b-f36a-1cd4-52c0" name="Pintle storm bolter" type="upgrade" hidden="false"><costs><cost n