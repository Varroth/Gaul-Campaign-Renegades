"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Fixed frequency repeater and local shielding; Harmonic Conclave / fortification</characteristic></characteristics></profile><profile id="2fb8-efdc-b15a-c401" name="Equipment guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew. Costs, stats and new abilities are homebrew. Not balanced or New Recruit import-tested. Specialist allocation is independently checked in offline editor; native New Recruit cross-model enforcement requires an in-app check.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="5e54-bb67-5caf-bbae" name="Canticle Relay Spire" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="95"/></costs><constraints><constraint id="a7c2-62fa-be73-54b5" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="20f6-abe9-ca35-61e2" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="e3dd-dbe6-2b6f-a61e" name="Relay configuration" hidden="false" defaultSelectionEntryId="1f38-62c9-bba2-ed99"><constraints><constraint id="df46-87a6-1d60-2a9f" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="c0be-1c75-43b3-35b8" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="1f38-62c9-bba2-ed99" name="Line-of-sight tuned repeater" type="upgrade" hidden="false"><profiles><profile id="a6e5-ff34-279b-4eaf" name="Equipment detail" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Standard equipment</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="46c4-2428-da26-9b6c" name="