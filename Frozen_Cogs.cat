ctionEntries><selectionEntry id="0dbe-37ae-675f-d6d8" name="Power fist" type="upgrade" hidden="false"><profiles><profile id="a50b-8da1-7202-7ebe" name="Power fist" typeId="a4f5-4674-06d7-5496" typeName="Weapon" hidden="false"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">2+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">8</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c3d2-93aa-93ba-5577" name="Power maul" type="upgrade" hidden="false"><profiles><profile id="482e-6d9c-fb4d-e4a0" name="Power maul" typeId="a4f5-4674-06d7-5496" typeName="Weapon" hidden="false"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">2+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">6</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="4ea6-4926-fbe7-4986" name="Verglas the Venerated" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="d68b-2e69-d339-2fdc" name="Dreadnoughts &amp; Living Masters" targetId="a75f-1881-2e1a-697a" hidden="false" primary="true"/><categoryLink id="c562-8779-84e8-c5fb" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="5284-7573-ae1c-381c" type="max" value="1" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="9c3d-c05b-5ea9-8045" name="Verglas the Venerated" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">7"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">11</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">14</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">4</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">4+</characteristic></characteristics></profile><profile id="f173-f74b-f8ba-f867" name="Eternal Warsmith" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of your Command phase, choose one nearby friendly Frozen Cogs VEHICLE or AUTOMATA: it may re-roll one failed Hit roll or one repair-related die before your next Command phase. One benefit per affected unit .</characteristic></characteristics></profile><profile id="0b9c-7ede-4ec8-aaa3" name="Adaptive Warsmith" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Verglas retains his personal siege claw but can exchange his modular ranged arm through the Sacred Forges between battles. This selection is made in the roster, not mid-turn.</characteristic></characteristics></profile><profile id="e8fa-8272-13ed-23c8" name="Living Master" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Verglas remains a sentient interred Astartes advisor, not a servitor, daemonic machine or an ordinary attached Leader.</characteristic></characteristics></profile><profile id="421c-c32d-290d-7a66" name="Squad size / designation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">1–1 model(s) per unit. Base 325 points/model; selected options are additional. Living Astartes remains part of the fixed inducted 1,200.</characteristic></characteristics></profile><profile id="fcc1-dc51-53d6-89b9" name="Engineering and command compatibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No mandatory Techmarine. Friendly tech specialists may interact via explicitly stated repair abilities. No ordinary attached Infantry Leader. Not an Infernal Warrior; no serum FNP, healing or extra wound.</characteristic></characteristics></profile><profile id="b36a-0ab1-2a18-4568" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All unapproved points, weapon profiles, new titles and numeric abilities remain homebrew until full faction roster is built and balance tested. New Recruit native import not yet verified.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="315f-e62c-5a92-9fee" name="Verglas the Venerated" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="325"/></costs><constraints><constraint id="e136-e2cc-2db5-9700" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="25f2-b92f-eb72-074e" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="44be-9b17-c01d-f8a9" name="Hybrid relic chassis" hidden="false" defaultSelectionEntryId="1059-90d4-d29c-4c5a"><constraints><constraint id="76e6-1ef8-9427-617f" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="6a79-34fd-3912-843e" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="1059-90d4-d29c-4c5a" name="Personalized Contemptor–Leviathan hybrid" type="upgrade" hidden="false"><profiles><profile id="00d6-e0c1-b5f1-cdb7" name="Selected configuration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Unique ancient hybrid internment; chassis cannot be replaced.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="7994-751c-928b-cc73" name="Signature left arm" hidden="false" defaultSelectionEntryId="30cd-bda8-627a-2098"><constraints><constraint id="78b8-ee58-a50b-85e0" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="d5e0-506d-a940-f38c" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="30cd-bda8-627a-2098" name="Contemptor siege claw" type="upgrade" hidden="false"><profiles><profile id="bdc7-64cb-fef4-73a7" name="Contemptor siege claw" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">12</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic>