 type="upgrade" hidden="false"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9cbb-2d6d-ac09-3fe1"/></constraints><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="ca19-146a-5f97-a4ca" name="Power fist (Sightmaster only)" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">8</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="95d7-925e-3704-d777" name="Frostglass Interdictor 1" type="model" hidden="false"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="d9ae-2773-0bff-3a74"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="abe3-6d91-55ca-2aa0"/></constraints><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="28"/></costs><selectionEntryGroups><selectionEntryGroup id="7217-8a52-8d6c-499d" name="Firstborn armor pattern" hidden="false" defaultSelectionEntryId="5b4e-0b20-a5a1-6912"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="b8b6-a6e8-9e44-5b56"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="dc4d-9b2a-02b4-2d4b"/></constraints><selectionEntries><selectionEntry id="5b4e-0b20-a5a1-6912" name="Mk III" type="upgrade" hidden="false"><constraints><constrai