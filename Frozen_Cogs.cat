><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">11</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">14</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">4</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="65dd-e293-3fce-1670" name="Siege Reduction" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per turn, one wound roll against a VEHICLE or FORTIFICATION may be re-rolled .</characteristic></characteristics></profile><profile id="b215-374e-5f24-7972" name="Unyielding Anchor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If the Dreadnought holds an objective and Remained Stationary, improve its total OC by 1 until its next Movement phase .</characteristic></characteristics></profile><profile id="b4e6-c7c6-eedc-1d64" name="Squad size / designation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">1–1 model(s) per unit. Base 255 points/model; selected options are additional. Living Astartes remains part of the fixed inducted 1,200.</characteristic></characteristics></profile><profile id="e536-fc89-b8b0-3739" name="Engineering and command compatibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No mandatory Techmarine. Friendly tech specialists may interact via explicitly stated repair abilities. No ordinary attached Infantry Leader. Not an Infernal Warrior; no serum FNP, healing or extra wound.</characteristic></characteristics></profile><profile id="2a6c-7738-4124-73a4" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All unapproved points, weapon profiles, new titles and numeric abilities remain homebrew until full faction roster is built and balance tested. New Recruit native import not yet verified.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="34b3-3747-db33-3f8d" name="Leviathan Siege Dreadnought" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="255"/></costs><constraints><constraint id="544b-ff19-9b1d-0f5c" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="d5ec-08f7-dd4b-f289" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="9ee8-c38d-7483-bf35" name="Leviathan forge certification" hidden="false" defaultSelectionEntryId="fb25-674c-448d-ce5b"><constraints><constraint id="8fb5-d5d0-994a-4221" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="8911-aae7-aff8-6833" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="fb25-674c-448d-ce5b" name="Ancient Leviathan siege hull" type="upgrade" hidden="false"><profiles><profile id="a7e4-c5b8-2450-21d4" name="Selected configuration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Maintained siege relic</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="22fe-944f-075d-dc50" name="Recovered and rebuilt Leviathan" type="upgrade" hidden="false"><profiles><profile id="5141-2ab0-fc40-9316" name="Selected configuration" hidden="false" typeId="bd5c-f804-35b5-510d" typeNa