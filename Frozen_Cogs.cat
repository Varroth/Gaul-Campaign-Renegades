e="Description" typeId="4c71-0d90-3b92-5cec">Standard equipment</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1dbd-2856-75ee-c996" name="Forge telemetry beacon" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="8181-d4e7-8311-4329" name="Equipment detail" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per friendly Shooting phase, one friendly vehicle within 6 inches can reroll one Hit roll; no stacking with an identical beacon .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b06e-847d-b146-841d" name="Recovery winch" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="12"/></costs><profiles><profile id="221b-4be7-67b4-71c2" name="Equipment detail" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, a friendly non-Titanic Vehicle within 3 inches restores 1 lost Wound; target cannot receive another repair this turn .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="ca94-e07b-312f-e0df" name="Artisan / Marine 2" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="26"/></costs><constraints><constraint id="7e2f-43f9-6239-4f9f" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="b353-e757-890f-7232" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="22c5-b10a-e886-fa38" name="Reclaimer firearm" hidden="false" defaultSelectionEntryId="935a-8abd-8476-1bc7"><constraints><constraint id="d46f-a9f9-e9