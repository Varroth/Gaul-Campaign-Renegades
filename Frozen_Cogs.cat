ionEntry id="2bd2-1e28-e6bf-156c" name="Resonance maul" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="12"/></costs><profiles><profile id="1c2a-c457-3988-a846" name="Resonance maul" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">6</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="05e6-fb4f-69e3-28f9" name="Artificer axe" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="8124-adb6-50fd-8635" name="Artificer axe" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">7</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="2dfc-87ac-046d-aabc" name="Ironbound Defiler" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="7bcf-7551-324c-75a7" name="Contained Daemon Engines" targetId="7855-099c-f53c-d1e7" hidden="false" primary="true"/><categoryLink id="8834-8689-605f-2af8" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="eeb9-29d9-7ea4-29cd" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="1e6a-3c65-c5a1-5fca" name="Ironbound Defiler" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">8"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">10</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">14</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">3</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="2cbe-8b7b-9463-044c" name="Bound Essence, Not Allegiance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Engine keyword SLAANESH denotes the Frozen Cogs army. A selectable captive Khorne/Tzeentch/Nurgle/Slaanesh/unaligned essence neither changes its Faction Keyword nor grants its owner allegiance to that daemon. Bound daemons are captives, never worshipped or allied commanders.</characteristic></characteristics></profile><profile id="b31a-e299-48b4-a5e8" name="Tri-Layer Containment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Every engine has physical warding, neural-lace Iron Firewall, and independently triggered hard shutdown. Enemy control, madness or friendly fire are never automatic. Engine destruction follows the agreed normal Destroyed/Deadly Demise rules .</characteristic></characteristics></profile><profile id="7627-d495-4c91-064d" name="Pressure Governor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of its own Shooting or Fight phase choose one directive for that phase: REGULATED: reroll one Hit roll with one engine weapon; SURGE: choose one weapon +1 Strength this phase, gain 1 Pressure (max 2); VENT: remove all Pressure and forgo Charge this turn. Cannot SURGE at 2 Pressure. Only one directive per phase; no free compound buffs .</characteristic></characteristics></profile><profile id="2149-54d9-a446-b9ff" name="Workmanship and Repairs" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">They are VEHICLES for Frozen Cogs repair rules targeting friendly VEHICLES unless that ability expressly excludes DAEMON ENGINES; at most one wound-restoring repair per engine per friendly turn. This repairs the machine chassis, not daemon flesh. No automatic serum healing or daemon regeneration .</characteristic></characteristics></profile><profile id="571e-a439-67b7-9725" name="Neural-Lace Kill Switch" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Operators can seal the containment engine; the bound daemon never becomes an independent attached Character. No Leader attachment to or from an engine .</characteristic></characteristics></profile><profile id="81a2-107f-c5cf-d820" name="Barricade Rupture" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per friendly Shooting phase, reroll one Wound roll for the main battery against a unit benefiting from Cover .</characteristic></characteristics></profile><profile id="e1f7-661c-3c8c-25e5" name="Mechanical Conquest" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">When this model destroys an enemy on an objective, it counts as OC +1 until end of your next Command phase .</characteristic></characteristics></profile><profile id="51ee-9091-fba9-a9b0" name="Chapter allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All-purpose siege walker with disciplined bombardment and counter-assault; Sacred Forge Siege Detachments</characteristic></characteristics></profile><profile id="0d20-babf-0396-fa4d" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew: all new profiles, abilities, costs and keywords homebrew. Native New Recruit selection checks requires an in-app check. Shared across-slot restrictions need native import testing; offline editor validates them.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="4ecb-92ae-8b62-5ecf" name="Ironbound Defiler" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="235"/></costs><constraints><constraint id="b595-5bbf-da77-b6b3" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="53ca-dee1-f08c-5a08" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="13ff-b27f-59cf-282e" name="Main battery" hidden="false" defaultSelectionEntryId="c889-a72d-b53f-b60f"><constraints><constraint id="d4f4-c9ae-806b-3653" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="177b-194c-25f8-6bd5" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="c889-a72d-b53f-b60f" name="Containment battle cannon" type="upgrade" hidden="false"><profiles><profile id="d357-4404-2653-1f83" name="Containment battle cannon" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">48"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">D6+3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">10</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Blast </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a55d-edf4-1b22-d137" name="Icedust siege bombard" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="12"/></costs><profiles><profile id="16f9-72c5-0d1f-839f" name="Icedust siege bombard" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2D6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">7</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Blast, Ignores Cover </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="2815-aab7-d18b-0e56" name="Frostcarver demolisher" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="af53-6009-76c1-05f9" name="Frostcarver demolisher" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">D6+2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">14</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">D6</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Blast </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="0d88-e083-823f-4014" name="Support armament" hidden="false" defaultSelectionEntryId="73cb-e086-4dd8-1b1e"><constraints><constraint id="b222-0dfc-32ac-be13" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="19c3-db01-5452-941c" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="73cb-e086-4dd8-1b1e" name="Reaper bolt array" type="upgrade" hidden="false"><profiles><profile id="8e1a-4f8b-2332-869f" name="Reaper bolt array" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">5</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Sustained Hits 1</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b666-8c22-dd78-513a" name="Twin autocannon bank" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="dc69-5864-a979-f205" name="Twin autocannon bank" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">48"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Twin-linked </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c4f2-d399-add5-c79d" name="Balefire projector" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="8f2d-deb2-b9cb-608d" name="Balefire projector" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">18"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2D6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">—</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">6</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Torrent, Ignores Cover</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="ae2b-b7a6-330c-6445" name="Hellforge melta lance" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="25"/></costs><profiles><profile id="f259-1974-90c9-ce81" name="Hellforge melta lance" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">18"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">12</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-4</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">D6</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Melta 2 </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="4388-2db5-7897-c9af" name="Siege limbs" hidden="false" defaultSelectionEntryId="b03b-bb0d-b456-30f6"><constraints><constraint id="b6b1-dff6-40de-2308" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="d1b0-4389-6859-64b7" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="b03b-bb0d-b456-30f6" name="Hellforged siege claw" type="upgrade" hidden="false"><profiles><profile id="352d-0136-58b5-9aec" name="Hellforged siege claw" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">14</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="0c33-0cae-28cb-a322" name="Engine chainfists" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="b100-63c0-6483-d0b5" name="Engine chainfists" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">12</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Vehicle 4+ </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1f98-0b68-2d68-7e0b" name="Frostshatter siege hammer" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="b91e-64d1-4a78-ede0" name="Frostshatter siege hammer" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">16</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">5</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Fortification 3+ </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="e1f0-e77f-99b6-5c15" name="Enslaved essence and governor (unit-wide)" hidden="false" defaultSelectionEntryId="19a8-fa01-a83c-00d0"><constraints><constraint id="3f45-2148-c487-6f5e" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="09b3-77d1-71bc-d8ff" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="19a8-fa01-a83c-00d0" name="Khorne captive / kinetic governor" type="upgrade" hidden="false"><profiles><profile id="fd6c-8376-ec81-408c" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Fight phase, one melee weapon gains +1 Attack this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="58f1-2116-1ae9-328c" name="Tzeentch captive / predictive governor" type="upgrade" hidden="false"><profiles><profile id="1b3e-d5ee-a61a-fcbd" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Shooting phase, choose one ranged weapon; it gains Ignores Cover this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="afbe-2ad7-6aba-d63c" name="Nurgle captive / dampening governor" type="upgrade" hidden="false"><profiles><profile id="ad71-6cd8-10a7-8956" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle, when an attack is allocated to this unit, reduce that attack’s Damage by 1 (min. 1; homebrew).</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="44ff-333e-26b5-2ebf" name="Slaanesh captive / resonant governor" type="upgrade" hidden="false"><profiles><profile id="52f5-1f8c-d3b5-ebbb" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle one ranged weapon gains +1 Attack during Shooting .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="e211-4d34-1438-d56f" name="Unaligned captive / neutral governor" type="upgrade" hidden="false"><profiles><profile id="291e-4b72-1486-178b" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one Hit roll for this engine .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="1b1a-d1b0-428c-4166" name="Containment safeguard (unit-wide)" hidden="false" defaultSelectionEntryId="26f7-4a9c-d3d9-ce99"><constraints><constraint id="f2a1-e5ca-7aa6-bdb1" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="7e6c-1392-c8ae-77e6" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="26f7-4a9c-d3d9-ce99" name="Triple-lock containment lattice" type="upgrade" hidden="false"><profiles><profile id="3ab7-40fe-b29c-7c41" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Sacred Forge hard seals, neural-lace Iron Firewall, and independent kill-switch governors.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="f2d4-736f-5a25-71f3" name="Iron Firewall fail-closed gate" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="6f07-ef90-6969-0852" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, ignore one enemy rule that would force this unit to take a Battle-shock test .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="22d9-5bf0-21f3-b9ce" name="Exhaust and pressure vents" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="e086-e5b9-3abf-4f59" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle in your Command phase, remove all Pressure counters without forfeiting its option to Charge .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="cd32-3ba2-f156-3102" name="Redundant mechanical binders" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="3851-ef11-b348-fafe" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, reroll one failed saving throw; cannot stack with another save reroll .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="b2f7-95e6-536f-448e" name="Ironbound Forgefiend" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="9028-32b6-bdb4-83bf" name="Contained Daemon Engines" targetId="7855-099c-f53c-d1e7" hidden="false" primary="true"/><categoryLink id="d3c0-4673-0769-a087" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="5370-0f81-3675-6de2" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="955a-c8cc-787c-6a6d" name="Ironbound Forgefiend" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">9"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">10</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">12</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">3</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="0abb-ee91-ed39-139b" name="Bound Essence, Not Allegiance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Engine keyword SLAANESH denotes the Frozen Cogs army. A selectable captive Khorne/Tzeentch/Nurgle/Slaanesh/unaligned essence neither changes its Faction Keyword nor grants its owner allegiance to that daemon. Bound daemons are captives, never worshipped or allied commanders.</characteristic></characteristics></profile><profile id="32f8-de3f-0880-ccbe" name="Tri-Layer Containment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Every engine has physical warding, neural-lace Iron Firewall, and independently triggered hard shutdown. Enemy control, madness or friendly fire are never automatic. Engine destruction follows the agreed normal Destroyed/Deadly Demise rules .</characteristic></characteristics></profile><profile id="95a8-fc7e-1ac8-d463" name="Pressure Governor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of its own Shooting or Fight phase choose one directive for that phase: REGULATED: reroll one Hit roll with one engine weapon; SURGE: choose one weapon +1 Strength this phase, gain 1 Pressure (max 2); VENT: remove all Pressure and forgo Charge this turn. Cannot SURGE at 2 Pressure. Only one directive per phase; no free compound buffs .</characteristic></characteristics></profile><profile id="09f3-f2a3-5636-ba41" name="Workmanship and Repairs" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">They are VEHICLES for Frozen Cogs repair rules targeting friendly VEHICLES unless that ability expressly excludes DAEMON ENGINES; at most one wound-restoring repair per engine per friendly turn. This repairs the machine chassis, not daemon flesh. No automatic serum healing or daemon regeneration .</characteristic></characteristics></profile><profile id="669d-7864-f393-da40" name="Neural-Lace Kill Switch" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Operators can seal the containment engine; the bound daemon never becomes an independent attached Character. No Leader attachment to or from an engine .</characteristic></characteristics></profile><profile id="b526-15ff-f03b-2d1b" name="Matched Calibration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If both selected main weapons are the same type, once per Shooting phase reroll one Hit roll from either one .</characteristic></characteristics></profile><profile id="f4d7-982e-295c-1b18" name="Chapter allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Modular twin-gun heavy fire support; Sacred Forge gun batteries</characteristic></characteristics></profile><profile id="ff0f-c7e7-a20f-482d" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew: all new profiles, abilities, costs and keywords homebrew. Native New Recruit selection checks requires an in-app check. Shared across-slot restrictions need native import testing; offline editor validates them.</characteristic></characteristics></profile><profile id="e523-d4c4-9922-68ae" name="Quantity restriction" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At most 1 selections from Siege conversion beamer across left and right in the unit; checked in offline editor.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="abbc-d980-cb62-96fe" name="Ironbound Forgefiend" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="200"/></costs><constraints><constraint id="d60e-debd-557e-d1e2" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="3379-bc4a-74d6-9a4e" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="3f75-4f59-597a-d412" name="Left main cannon" hidden="false" defaultSelectionEntryId="e519-bdbb-0aee-5449"><constraints><constraint id="3d99-df3a-3ea6-898b" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="18f0-769f-e8df-1604" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="e519-bdbb-0aee-5449" name="Forgefiend autocannon" type="upgrade" hidden="false"><profiles><profile id="b53e-dfd8-c6f1-b2c6" name="Forgefiend autocannon" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">10</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1f0b-335b-0d3f-20cf" name="Ectoplasma cannon" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="8275-26f5-c763-1372" name="Ectoplasma cannon" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">D3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Blast, Hazardous</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5632-1d04-05d0-88e7" name="Siege conversion beamer" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="35"/></costs><profiles><profile id="3748-6551-ada6-9a06" name="Siege conversion beamer" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">48"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">12</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy; &gt;24" range only for full Strength </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="fb05-98e3-f514-5ab2" name="Shardglass sonic emitter" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="0c9f-44d5-c0d1-e7f2" name="Shardglass sonic emitter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">30"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">7</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Ignores Cover </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="60fd-4ce4-3ef6-a68f" name="Right main cannon" hidden="false" defaultSelectionEntryId="3d63-bdf1-8e52-60f8"><constraints><constraint id="6932-8030-74fb-8b75" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="adae-b761-dd71-5916" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="3d63-bdf1-8e52-60f8" name="Forgefiend autocannon (right)" type="upgrade" hidden="false"><profiles><profile id="f2aa-bc7b-781f-a16a" name="Forgefiend autocannon (right)" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">10</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c66e-15ef-e618-16d9" name="Ectoplasma cannon" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="2768-ace8-f011-7279" name="Ectoplasma cannon" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">D3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Blast, Hazardous</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="26c3-a06f-b8bd-2f7a" name="Siege conversion beamer" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="35"/></costs><profiles><profile id="014d-9e87-7d4e-d386" name="Siege conversion beamer" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">48"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">12</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy; &gt;24" range only for full Strength </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="bea4-4b40-dba1-b777" name="Shardglass sonic emitter" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="ac85-f440-bcf0-fbad" name="Shardglass sonic emitter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">30"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">7</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Ignores Cover </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="4989-d4d5-4d66-4815" name="Secondary vent" hidden="false" defaultSelectionEntryId="9a56-62d6-9bda-55e0"><constraints><constraint id="5571-0d88-d493-567f" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="0f33-9851-83c7-f1a4" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="9a56-62d6-9bda-55e0" name="Standard cooling vents" type="upgrade" hidden="false"><profiles><profile id="4885-f906-7d81-c249" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No optional effect.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="26ec-5969-239e-690a" name="Harmonic flash screen" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="12"/></costs><profiles><profile id="8b62-1eaf-97a3-d84d" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reduce one incoming ranged Damage by 1 (min 1; homebrew).</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="c256-34fe-ec81-ad2d" name="Enslaved essence and governor (unit-wide)" hidden="false" defaultSelectionEntryId="d907-02f5-1a6c-5238"><constraints><constraint id="1c95-02ad-08ca-3e3e" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="4b06-07b0-d179-c885" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="d907-02f5-1a6c-5238" name="Khorne captive / kinetic governor" type="upgrade" hidden="false"><profiles><profile id="10ac-13e4-1d58-6896" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Fight phase, one melee weapon gains +1 Attack this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5d36-b313-7447-14bf" name="Tzeentch captive / predictive governor" type="upgrade" hidden="false"><profiles><profile id="f619-d671-0f61-6865" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Shooting phase, choose one ranged weapon; it gains Ignores Cover this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b58a-073c-317f-f27d" name="Nurgle captive / dampening governor" type="upgrade" hidden="false"><profiles><profile id="0a8a-c7c6-d6f6-a380" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle, when an attack is allocated to this unit, reduce that attack’s Damage by 1 (min. 1; homebrew).</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="4809-6271-b9c8-36c8" name="Slaanesh captive / resonant governor" type="upgrade" hidden="false"><profiles><profile id="45bc-1573-443d-5663" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle one ranged weapon gains +1 Attack during Shooting .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7516-6f0c-c295-90e6" name="Unaligned captive / neutral governor" type="upgrade" hidden="false"><profiles><profile id="accd-4352-50ca-9384" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one Hit roll for this engine .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="de83-e383-9a32-1fc9" name="Containment safeguard (unit-wide)" hidden="false" defaultSelectionEntryId="5958-63c7-1885-b770"><constraints><constraint id="49fe-eed7-3193-bb1b" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="3aa2-b45f-b6b7-a4ae" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="5958-63c7-1885-b770" name="Triple-lock containment lattice" type="upgrade" hidden="false"><profiles><profile id="2925-93cc-436a-b293" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Sacred Forge hard seals, neural-lace Iron Firewall, and independent kill-switch governors.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="33ca-c2ef-d1bf-993c" name="Iron Firewall fail-closed gate" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="07f4-88d3-f4c8-bdf5" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, ignore one enemy rule that would force this unit to take a Battle-shock test .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="0985-db45-2419-dc18" name="Exhaust and pressure vents" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="5ae5-ac83-6010-744b" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle in your Command phase, remove all Pressure counters without forfeiting its option to Charge .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b8a7-e139-028e-07d5" name="Redundant mechanical binders" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="2d86-e799-3713-1556" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, reroll one failed saving throw; cannot stack with another save reroll .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="d430-c310-bec1-d382" name="Ironbound Maulerfiend" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="2e9b-ed82-df8c-d0b1" name="Contained Daemon Engines" targetId="7855-099c-f53c-d1e7" hidden="false" primary="true"/><categoryLink id="5ce8-c962-8dc9-7a6c" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="9716-90bc-9cad-65b4" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="bdaa-88e1-c13e-f328" name="Ironbound Maulerfiend" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">10"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">10</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">12</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">3</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="d7c2-5ac3-7061-1819" name="Bound Essence, Not Allegiance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Engine keyword SLAANESH denotes the Frozen Cogs army. A selectable captive Khorne/Tzeentch/Nurgle/Slaanesh/unaligned essence neither changes its Faction Keyword nor grants its owner allegiance to that daemon. Bound daemons are captives, never worshipped or allied commanders.</characteristic></characteristics></profile><profile id="491d-3a3b-d4d2-2002" name="Tri-Layer Containment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Every engine has physical warding, neural-lace Iron Firewall, and independently triggered hard shutdown. Enemy control, madness or friendly fire are never automatic. Engine destruction follows the agreed normal Destroyed/Deadly Demise rules .</characteristic></characteristics></profile><profile id="a129-212b-1371-0299" name="Pressure Governor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of its own Shooting or Fight phase choose one directive for that phase: REGULATED: reroll one Hit roll with one engine weapon; SURGE: choose one weapon +1 Strength this phase, gain 1 Pressure (max 2); VENT: remove all Pressure and forgo Charge this turn. Cannot SURGE at 2 Pressure. Only one directive per phase; no free compound buffs .</characteristic></characteristics></profile><profile id="6560-8afb-3e14-9b1a" name="Workmanship and Repairs" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">They are VEHICLES for Frozen Cogs repair rules targeting friendly VEHICLES unless that ability expressly excludes DAEMON ENGINES; at most one wound-restoring repair per engine per friendly turn. This repairs the machine chassis, not daemon flesh. No automatic serum healing or daemon regeneration .</characteristic></characteristics></profile><profile id="8fe5-3372-aac1-51b8" name="Neural-Lace Kill Switch" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Operators can seal the containment engine; the bound daemon never becomes an independent attached Character. No Leader attachment to or from an engine .</characteristic></characteristics></profile><profile id="ed96-e861-ce99-f561" name="Calculated Impact" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">After completing a Charge against a Vehicle or Fortification, reroll one melee Wound roll .</characteristic></characteristics></profile><profile id="7fc8-1eb1-482d-3009" name="Siege Footing" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">While in range of an objective controlled by enemy, this model gains +1 OC .</characteristic></characteristics></profile><profile id="fdc0-9ab2-418b-f6ec" name="Chapter allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Melee siege assault and counter-breakthrough; 2nd Siege Assault / 5th Boarding</characteristic></characteristics></profile><profile id="34bf-5f8d-ad4f-8530" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew: all new profiles, abilities, costs and keywords homebrew. Native New Recruit selection checks requires an in-app check. Shared across-slot restrictions need native import testing; offline editor validates them.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="4ce2-28c7-7f0d-bc95" name="Ironbound Maulerfiend" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="185"/></costs><constraints><constraint id="c39c-c980-1aaa-0254" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="7cbc-6276-0537-d7b6" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="4990-846a-db1e-2e95" name="Principal assault frame" hidden="false" defaultSelectionEntryId="9385-7da6-437c-c127"><constraints><constraint id="d8e9-6097-4af3-6fd8" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="b49a-150c-2d20-dc04" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="9385-7da6-437c-c127" name="Hellforged siege claw" type="upgrade" hidden="false"><profiles><profile id="01aa-dc70-6b19-aa32" name="Hellforged siege claw" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">14</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5f1a-852f-2d15-6d3a" name="Excavator auger and steel maw" type="upgrade" hidden="false"><profiles><profile id="c4cf-6baa-63ad-19bb" name="Excavator auger and steel maw" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">15</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Vehicle 3+ </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5813-4904-81ed-2db7" name="Frostshatter siege hammer" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="968a-ffac-b4fb-7af3" name="Frostshatter siege hammer" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">16</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">5</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Fortification 3+ </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="0509-7528-247c-d40b" name="Breach appendage" hidden="false" defaultSelectionEntryId="069f-b6a9-4dff-c332"><constraints><constraint id="7fe5-e77d-02da-c621" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="a0b8-71ca-3aa0-e14c" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="069f-b6a9-4dff-c332" name="Binding tendrils" type="upgrade" hidden="false"><profiles><profile id="5ef2-e674-e464-79fd" name="Binding tendrils" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">8</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">7</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Sustained Hits 1 </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7822-d89e-099e-9299" name="Magma cutters" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="d6a7-d990-74b9-94c4" name="Magma cutters" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">12</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Vehicle 4+ </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="ff64-44e6-4270-5586" name="Close-breach meltagun" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="12"/></costs><profiles><profile id="90cb-c1ef-43cd-525b" name="Close-breach meltagun" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">10</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-4</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">D6</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Melta 2 </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="de3a-54b8-0d1c-ad22" name="Enslaved essence and governor (unit-wide)" hidden="false" defaultSelectionEntryId="15a6-2519-d61d-9159"><constraints><constraint id="3fa5-6854-26b2-1f1d" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="6915-79be-83d5-4706" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="15a6-2519-d61d-9159" name="Khorne captive / kinetic governor" type="upgrade" hidden="false"><profiles><profile id="41fc-fc7c-1a34-b4e1" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Fight phase, one melee weapon gains +1 Attack this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="3647-540f-26fb-012e" name="Tzeentch captive / predictive governor" type="upgrade" hidden="false"><profiles><profile id="49c2-5be3-bd7c-7336" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Shooting phase, choose one ranged weapon; it gains Ignores Cover this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="fee3-bbae-0a6a-b519" name="Nurgle captive / dampening governor" type="upgrade" hidden="false"><profiles><profile id="4cac-92a3-c3e4-1919" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle, when an attack is allocated to this unit, reduce that attack’s Damage by 1 (min. 1; homebrew).</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="e45e-3d42-081a-4321" name="Slaanesh captive / resonant governor" type="upgrade" hidden="false"><profiles><profile id="fe76-5188-86ed-d8a6" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle one ranged weapon gains +1 Attack during Shooting .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="0371-7757-0ace-7ca0" name="Unaligned captive / neutral governor" type="upgrade" hidden="false"><profiles><profile id="074b-cada-a8d4-d1c7" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one Hit roll for this engine .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="2eee-453d-c6f7-41ed" name="Containment safeguard (unit-wide)" hidden="false" defaultSelectionEntryId="7915-d140-8954-3af7"><constraints><constraint id="5894-615c-7116-d241" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="86c5-de60-7766-c97f" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="7915-d140-8954-3af7" name="Triple-lock containment lattice" type="upgrade" hidden="false"><profiles><profile id="8b1c-58fe-9d1f-ab45" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Sacred Forge hard seals, neural-lace Iron Firewall, and independent kill-switch governors.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="fd08-52b3-ecf2-60eb" name="Iron Firewall fail-closed gate" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="7d08-1ae6-2e2c-2715" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, ignore one enemy rule that would force this unit to take a Battle-shock test .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="880f-0fd3-6159-7db6" name="Exhaust and pressure vents" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="d300-0069-ba8a-ac00" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle in your Command phase, remove all Pressure counters without forfeiting its option to Charge .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="ce13-8aba-57a5-b9f2" name="Redundant mechanical binders" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="6363-b237-7617-9658" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, reroll one failed saving throw; cannot stack with another save reroll .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="8d9d-cbaf-d625-5d35" name="Ironbound Venomcrawler" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="a5c3-38ff-5b71-ef3f" name="Contained Daemon Engines" targetId="7855-099c-f53c-d1e7" hidden="false" primary="true"/><categoryLink id="8ab1-01ed-9b61-c3f4" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="b6b8-b5d2-59c7-70e3" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="412a-f7a1-dca0-a62c" name="Ironbound Venomcrawler" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">12"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">9</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">9</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="1f9c-a386-2266-c7ef" name="Bound Essence, Not Allegiance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Engine keyword SLAANESH denotes the Frozen Cogs army. A selectable captive Khorne/Tzeentch/Nurgle/Slaanesh/unaligned essence neither changes its Faction Keyword nor grants its owner allegiance to that daemon. Bound daemons are captives, never worshipped or allied commanders.</characteristic></characteristics></profile><profile id="29b1-6a11-02c0-4553" name="Tri-Layer Containment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Every engine has physical warding, neural-lace Iron Firewall, and independently triggered hard shutdown. Enemy control, madness or friendly fire are never automatic. Engine destruction follows the agreed normal Destroyed/Deadly Demise rules .</characteristic></characteristics></profile><profile id="b5f9-0669-9665-1784" name="Pressure Governor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of its own Shooting or Fight phase choose one directive for that phase: REGULATED: reroll one Hit roll with one engine weapon; SURGE: choose one weapon +1 Strength this phase, gain 1 Pressure (max 2); VENT: remove all Pressure and forgo Charge this turn. Cannot SURGE at 2 Pressure. Only one directive per phase; no free compound buffs .</characteristic></characteristics></profile><profile id="d676-24de-69ac-cb50" name="Workmanship and Repairs" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">They are VEHICLES for Frozen Cogs repair rules targeting friendly VEHICLES unless that ability expressly excludes DAEMON ENGINES; at most one wound-restoring repair per engine per friendly turn. This repairs the machine chassis, not daemon flesh. No automatic serum healing or daemon regeneration .</characteristic></characteristics></profile><profile id="f8b2-c62c-cd97-dd1c" name="Neural-Lace Kill Switch" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Operators can seal the containment engine; the bound daemon never becomes an independent attached Character. No Leader attachment to or from an engine .</characteristic></characteristics></profile><profile id="d1d3-7dd0-ccc0-a17d" name="Target Thread" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If an enemy unit was hit by this model earlier in the turn, this model may reroll one Charge roll die against that enemy .</characteristic></characteristics></profile><profile id="b14a-6b60-e916-43bc" name="Machine Skitter" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle this model may Fall Back and shoot .</characteristic></characteristics></profile><profile id="5c32-d0fa-281c-a3a3" name="Chapter allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Fast flanking harassment and target pursuit; 7th Recon / Forge skirmish units</characteristic></characteristics></profile><profile id="2206-411a-ba07-25db" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew: all new profiles, abilities, costs and keywords homebrew. Native New Recruit selection checks requires an in-app check. Shared across-slot restrictions need native import testing; offline editor validates them.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="d523-8425-fd38-2f5d" name="Ironbound Venomcrawler" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="145"/></costs><constraints><constraint id="cde9-abbb-0920-cf72" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="c48b-a74b-583c-ce30" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="7f04-d36e-9c7e-e9d3" name="Pursuit guns" hidden="false" defaultSelectionEntryId="6677-d318-1443-6354"><constraints><constraint id="8c0e-2134-0ef6-abd6" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="cea1-cefd-be56-ca31" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="6677-d318-1443-6354" name="Excruciator cannons" type="upgrade" hidden="false"><profiles><profile id="3512-049d-e08a-6a3f" name="Excruciator cannons" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">6</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Assault</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="91b3-abce-b8be-4e56" name="Shardglass sonic emitter" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="0e01-be4a-cb61-8b91" name="Shardglass sonic emitter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">30"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">7</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Ignores Cover </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="2121-c7fc-b8f3-4d25" name="Hades rotary autocannon" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="6ad6-937b-928e-7fe9" name="Hades rotary autocannon" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">8</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">8</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Sustained Hits 1 </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="e351-fe05-511b-0bec" name="Melee mandibles" hidden="false" defaultSelectionEntryId="084c-3dec-3df2-d49e"><constraints><constraint id="3cb6-9df3-f837-c7db" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="639e-ab49-9e3b-122a" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="084c-3dec-3df2-d49e" name="Rending servo talons" type="upgrade" hidden="false"><profiles><profile id="3f12-abd9-06d5-c546" name="Rending servo talons" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Twin-linked </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="9e65-78bc-8c77-6391" name="Engine chainfists" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="3412-b6a0-3901-8d81" name="Engine chainfists" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">12</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Vehicle 4+ </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="7f71-357b-01d7-4568" name="Enslaved essence and governor (unit-wide)" hidden="false" defaultSelectionEntryId="62d4-2dc7-649b-c384"><constraints><constraint id="01db-cb0a-b3dd-4dbe" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="a987-f0d9-5d7f-bbee" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="62d4-2dc7-649b-c384" name="Khorne captive / kinetic governor" type="upgrade" hidden="false"><profiles><profile id="8295-bdc6-6c00-7fde" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Fight phase, one melee weapon gains +1 Attack this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="cb11-8224-e4fa-4530" name="Tzeentch captive / predictive governor" type="upgrade" hidden="false"><profiles><profile id="2185-6abb-744d-0b40" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Shooting phase, choose one ranged weapon; it gains Ignores Cover this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="51d9-830b-a33c-407c" name="Nurgle captive / dampening governor" type="upgrade" hidden="false"><profiles><profile id="e424-2362-f90d-bb46" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle, when an attack is allocated to this unit, reduce that attack’s Damage by 1 (min. 1; homebrew).</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="ae13-2a7b-121a-cc0f" name="Slaanesh captive / resonant governor" type="upgrade" hidden="false"><profiles><profile id="83b6-9d9f-a2d8-0cb2" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle one ranged weapon gains +1 Attack during Shooting .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="f8e0-d2ef-bf38-5908" name="Unaligned captive / neutral governor" type="upgrade" hidden="false"><profiles><profile id="7c08-efe4-11b7-9162" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one Hit roll for this engine .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="6228-2527-444b-5eeb" name="Containment safeguard (unit-wide)" hidden="false" defaultSelectionEntryId="bae2-6c28-f325-64c0"><constraints><constraint id="6c98-2c2f-04c1-a4a1" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="7dbe-be20-657a-6a43" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="bae2-6c28-f325-64c0" name="Triple-lock containment lattice" type="upgrade" hidden="false"><profiles><profile id="a073-e071-96cd-faeb" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Sacred Forge hard seals, neural-lace Iron Firewall, and independent kill-switch governors.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="234f-d115-a9db-11b5" name="Iron Firewall fail-closed gate" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="d379-ea3f-f4b8-b88f" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, ignore one enemy rule that would force this unit to take a Battle-shock test .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="6816-d0fa-aa4b-2ea7" name="Exhaust and pressure vents" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="b0c8-45b4-e056-b1a1" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle in your Command phase, remove all Pressure counters without forfeiting its option to Charge .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="0935-fe83-5d4f-4084" name="Redundant mechanical binders" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="95a4-552a-4dd8-1c6f" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, reroll one failed saving throw; cannot stack with another save reroll .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="b88c-b417-72ff-c506" name="Ironbound Heldrake" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="43f7-5320-ebfc-bd2b" name="Contained Daemon Engines" targetId="7855-099c-f53c-d1e7" hidden="false" primary="true"/><categoryLink id="691d-e2fe-1493-dcbc" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="d712-c057-2f09-53b0" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="445f-d48a-ad04-fa6f" name="Ironbound Heldrake" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">20"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">9</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">12</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="cc0b-f932-24d7-573f" name="Bound Essence, Not Allegiance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Engine keyword SLAANESH denotes the Frozen Cogs army. A selectable captive Khorne/Tzeentch/Nurgle/Slaanesh/unaligned essence neither changes its Faction Keyword nor grants its owner allegiance to that daemon. Bound daemons are captives, never worshipped or allied commanders.</characteristic></characteristics></profile><profile id="6f99-eaca-985b-c3c0" name="Tri-Layer Containment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Every engine has physical warding, neural-lace Iron Firewall, and independently triggered hard shutdown. Enemy control, madness or friendly fire are never automatic. Engine destruction follows the agreed normal Destroyed/Deadly Demise rules .</characteristic></characteristics></profile><profile id="ff24-1344-e135-323d" name="Pressure Governor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of its own Shooting or Fight phase choose one directive for that phase: REGULATED: reroll one Hit roll with one engine weapon; SURGE: choose one weapon +1 Strength this phase, gain 1 Pressure (max 2); VENT: remove all Pressure and forgo Charge this turn. Cannot SURGE at 2 Pressure. Only one directive per phase; no free compound buffs .</characteristic></characteristics></profile><profile id="7385-bcfd-f4cf-6042" name="Workmanship and Repairs" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">They are VEHICLES for Frozen Cogs repair rules targeting friendly VEHICLES unless that ability expressly excludes DAEMON ENGINES; at most one wound-restoring repair per engine per friendly turn. This repairs the machine chassis, not daemon flesh. No automatic serum healing or daemon regeneration .</characteristic></characteristics></profile><profile id="a3bf-ab18-baac-4b8c" name="Neural-Lace Kill Switch" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Operators can seal the containment engine; the bound daemon never becomes an independent attached Character. No Leader attachment to or from an engine .</characteristic></characteristics></profile><profile id="457a-1ccd-1e90-3047" name="Intercept Window" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, when targeting an enemy that has FLY, one selected ranged weapon gains +1 to its Hit roll .</characteristic></characteristics></profile><profile id="20d2-1819-d546-70d6" name="Aircraft Handling" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Use the agreed battlepack Aircraft and Hover rules; no invented free midair deployment.</characteristic></characteristics></profile><profile id="cc63-2688-f3eb-84c7" name="Chapter allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Interceptor and ground attack in a bound daemon airframe; Fleet / Operators and Air Wing</characteristic></characteristics></profile><profile id="55e8-87c8-1888-a274" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew: all new profiles, abilities, costs and keywords homebrew. Native New Recruit selection checks requires an in-app check. Shared across-slot restrictions need native import testing; offline editor validates them.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="941a-b90c-26e7-bc41" name="Ironbound Heldrake" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="225"/></costs><constraints><constraint id="864d-cc41-c5bf-1c31" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="3ccc-d3e7-0a17-633e" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="9704-0818-fbd5-917a" name="Airframe weapon" hidden="false" defaultSelectionEntryId="3487-c27a-0191-827a"><constraints><constraint id="5457-9297-49fa-eb33" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="3490-5701-a550-c9c9" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="3487-c27a-0191-827a" name="Baleflamer" type="upgrade" hidden="false"><profiles><profile id="7799-e300-cb35-3827" name="Baleflamer" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">18"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">D6+3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">—</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">6</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Torrent, Ignores Cover</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="9f82-1c8e-938e-5a4e" name="Hades rotary autocannon" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="9514-53db-d82c-2699" name="Hades rotary autocannon" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">8</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">8</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Sustained Hits 1 </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="3c34-be0f-a557-13a7" name="Frostglass seeker missiles" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="ae48-20e1-aeda-a8c2" name="Frostglass seeker missiles" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">10</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Fly 4+ </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="1028-ba0e-9884-25db" name="Wing talons" hidden="false" defaultSelectionEntryId="724b-8469-a633-700d"><constraints><constraint id="7fbb-e21f-5fce-2d8d" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="c1d8-19dc-7b75-37c9" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="724b-8469-a633-700d" name="Hellforged wing talons" type="upgrade" hidden="false"><profiles><profile id="9e6f-21e6-2d60-7cb5" name="Hellforged wing talons" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Fly 4+ </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a90d-1997-1a5b-ee35" name="Rending servo talons" type="upgrade" hidden="false"><profiles><profile id="72ce-94eb-d18a-8d5e" name="Rending servo talons" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Twin-linked </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="8e8b-754f-9c55-e5f5" name="Enslaved essence and governor (unit-wide)" hidden="false" defaultSelectionEntryId="d542-1546-6c45-4dfb"><constraints><constraint id="2bbf-7de0-1ca5-e393" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="7cc2-a5cc-aff5-78ed" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="d542-1546-6c45-4dfb" name="Khorne captive / kinetic governor" type="upgrade" hidden="false"><profiles><profile id="da80-e710-e7dd-e98c" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Fight phase, one melee weapon gains +1 Attack this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="4fc9-db78-c27b-e9fa" name="Tzeentch captive / predictive governor" type="upgrade" hidden="false"><profiles><profile id="7d3d-3f05-ca06-6cf8" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Shooting phase, choose one ranged weapon; it gains Ignores Cover this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a25e-679d-39d2-ef55" name="Nurgle captive / dampening governor" type="upgrade" hidden="false"><profiles><profile id="d518-30fe-7003-b64d" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle, when an attack is allocated to this unit, reduce that attack’s Damage by 1 (min. 1; homebrew).</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="167e-78e0-aa50-ce09" name="Slaanesh captive / resonant governor" type="upgrade" hidden="false"><profiles><profile id="12bd-2d72-42c4-78db" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle one ranged weapon gains +1 Attack during Shooting .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="181b-ced8-0dc3-055f" name="Unaligned captive / neutral governor" type="upgrade" hidden="false"><profiles><profile id="2370-5c93-4c3b-06c8" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one Hit roll for this engine .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="5e56-d8a1-6706-09bd" name="Containment safeguard (unit-wide)" hidden="false" defaultSelectionEntryId="0c5a-157e-a264-3e6f"><constraints><constraint id="ef4a-a656-5dec-cdc5" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="2b4c-4817-3f79-b287" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="0c5a-157e-a264-3e6f" name="Triple-lock containment lattice" type="upgrade" hidden="false"><profiles><profile id="32be-4aeb-326a-aa92" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Sacred Forge hard seals, neural-lace Iron Firewall, and independent kill-switch governors.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="e89f-278b-208c-d169" name="Iron Firewall fail-closed gate" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="214e-7d56-f248-8f39" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, ignore one enemy rule that would force this unit to take a Battle-shock test .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a3d1-3697-4336-e7f5" name="Exhaust and pressure vents" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="9197-d6f6-19e8-a57a" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle in your Command phase, remove all Pressure counters without forfeiting its option to Charge .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="d69c-5497-f03a-c02b" name="Redundant mechanical binders" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="83ab-871c-c4d9-8fe2" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, reroll one failed saving throw; cannot stack with another save reroll .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="9cb0-7de6-451c-729d" name="Ironbound Decimator" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="5036-5b13-3b73-0704" name="Contained Daemon Engines" targetId="7855-099c-f53c-d1e7" hidden="false" primary="true"/><categoryLink id="e7fd-6e11-0c7b-4578" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="139b-62be-7dfd-a326" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="3995-4b2f-e1d3-9e80" name="Ironbound Decimator" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">8"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">10</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">12</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">3</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="a63a-3059-05fa-da8b" name="Bound Essence, Not Allegiance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Engine keyword SLAANESH denotes the Frozen Cogs army. A selectable captive Khorne/Tzeentch/Nurgle/Slaanesh/unaligned essence neither changes its Faction Keyword nor grants its owner allegiance to that daemon. Bound daemons are captives, never worshipped or allied commanders.</characteristic></characteristics></profile><profile id="c8cd-61f7-daa0-4ad7" name="Tri-Layer Containment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Every engine has physical warding, neural-lace Iron Firewall, and independently triggered hard shutdown. Enemy control, madness or friendly fire are never automatic. Engine destruction follows the agreed normal Destroyed/Deadly Demise rules .</characteristic></characteristics></profile><profile id="9ac5-2e69-83b6-b72c" name="Pressure Governor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of its own Shooting or Fight phase choose one directive for that phase: REGULATED: reroll one Hit roll with one engine weapon; SURGE: choose one weapon +1 Strength this phase, gain 1 Pressure (max 2); VENT: remove all Pressure and forgo Charge this turn. Cannot SURGE at 2 Pressure. Only one directive per phase; no free compound buffs .</characteristic></characteristics></profile><profile id="5d6b-10ab-08df-12c3" name="Workmanship and Repairs" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">They are VEHICLES for Frozen Cogs repair rules targeting friendly VEHICLES unless that ability expressly excludes DAEMON ENGINES; at most one wound-restoring repair per engine per friendly turn. This repairs the machine chassis, not daemon flesh. No automatic serum healing or daemon regeneration .</characteristic></characteristics></profile><profile id="07f3-e089-60dc-9cc0" name="Neural-Lace Kill Switch" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Operators can seal the containment engine; the bound daemon never becomes an independent attached Character. No Leader attachment to or from an engine .</characteristic></characteristics></profile><profile id="7fb5-dd8a-bf8e-2d5c" name="Precision Ruin" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per friendly phase reroll one Hit roll against the nominated target selected at start of your turn .</characteristic></characteristics></profile><profile id="820b-4c9e-12c4-55e8" name="Chapter allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Twin-arm selectable duel and hunter-killer walker; Sacred Forge containment veterans</characteristic></characteristics></profile><profile id="57df-b303-4277-46aa" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew: all new profiles, abilities, costs and keywords homebrew. Native New Recruit selection checks requires an in-app check. Shared across-slot restrictions need native import testing; offline editor validates them.</characteristic></characteristics></profile><profile id="dc66-c056-0cd0-61d0" name="Quantity restriction" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At most 1 selections from Siege conversion beamer across left and right in the unit; checked in offline editor.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="e040-8fac-6052-d220" name="Ironbound Decimator" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="215"/></costs><constraints><constraint id="12a9-a665-3b0d-8b33" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="25c5-818c-d96b-1429" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="d715-46c8-b974-0887" name="Left arm system" hidden="false" defaultSelectionEntryId="8202-72ba-bb35-4556"><constraints><constraint id="82a7-cfe5-5f42-bd5a" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="3c21-ef8b-9801-c808" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="8202-72ba-bb35-4556" name="Soulburner petard" type="upgrade" hidden="false"><profiles><profile id="ef26-d325-1ee3-d937" name="Soulburner petard" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">D3+2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">8</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Devastating Wounds </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="db70-1440-39e3-06d7" name="Siege conversion beamer" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="35"/></costs><profiles><profile id="9f7f-c3e0-2d83-a8ef" name="Siege conversion beamer" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">48"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">12</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy; &gt;24" range only for full Strength </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5978-1305-810d-4a2e" name="Twin autocannon bank" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="0869-6a7a-453d-78d6" name="Twin autocannon bank" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">48"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Twin-linked </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="fb3c-a335-daf5-9c4a" name="Hellforged siege claw" type="upgrade" hidden="false"><profiles><profile id="c994-0f2b-3637-eb94" name="Hellforged siege claw" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">14</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="a5c0-56aa-fb91-b438" name="Right arm system" hidden="false" defaultSelectionEntryId="a7e3-0c6e-d5cd-6c9f"><constraints><constraint id="5985-7959-ea37-a56e" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="c6e6-4946-c6c4-be6c" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="a7e3-0c6e-d5cd-6c9f" name="Soulburner petard (right)" type="upgrade" hidden="false"><profiles><profile id="78b9-8454-6cf0-5fc8" name="Soulburner petard (right)" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">D3+2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">8</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Devastating Wounds </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="de68-fd99-57a3-3edf" name="Siege conversion beamer" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="35"/></costs><profiles><profile id="f3c4-facb-ea75-c53a" name="Siege conversion beamer" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">48"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">12</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy; &gt;24" range only for full Strength </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="da98-b044-0e89-3a2e" name="Hellforge melta lance" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="25"/></costs><profiles><profile id="1b5b-7cf6-85b6-a5cd" name="Hellforge melta lance" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">18"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">12</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-4</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">D6</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Melta 2 </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="0d79-2bec-cc71-9808" name="Hellforged siege claw" type="upgrade" hidden="false"><profiles><profile id="66a1-06be-35a7-4fa5" name="Hellforged siege claw" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">14</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="beec-cba6-0f9a-bd53" name="Enslaved essence and governor (unit-wide)" hidden="false" defaultSelectionEntryId="b67d-c431-32a7-ddae"><constraints><constraint id="bd62-fa55-d363-4e3c" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="1df7-166e-5f07-0be2" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="b67d-c431-32a7-ddae" name="Khorne captive / kinetic governor" type="upgrade" hidden="false"><profiles><profile id="42aa-c060-b7d6-7e3c" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Fight phase, one melee weapon gains +1 Attack this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="18be-998c-1b75-483f" name="Tzeentch captive / predictive governor" type="upgrade" hidden="false"><profiles><profile id="6c89-9632-324c-8fa9" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Shooting phase, choose one ranged weapon; it gains Ignores Cover this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="2cbf-b6c7-8b58-6660" name="Nurgle captive / dampening governor" type="upgrade" hidden="false"><profiles><profile id="8be7-a59f-a668-6629" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle, when an attack is allocated to this unit, reduce that attack’s Damage by 1 (min. 1; homebrew).</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b44e-0db0-2dae-a8ad" name="Slaanesh captive / resonant governor" type="upgrade" hidden="false"><profiles><profile id="6d89-fe79-77a3-41da" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle one ranged weapon gains +1 Attack during Shooting .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="25b9-de0d-7faf-0143" name="Unaligned captive / neutral governor" type="upgrade" hidden="false"><profiles><profile id="cc38-ab4e-2e06-b27d" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one Hit roll for this engine .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="659e-268b-2989-d6ab" name="Containment safeguard (unit-wide)" hidden="false" defaultSelectionEntryId="0733-a4f8-ea76-7dc6"><constraints><constraint id="8133-e7d5-3269-abec" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="06de-3579-c5bf-205e" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="0733-a4f8-ea76-7dc6" name="Triple-lock containment lattice" type="upgrade" hidden="false"><profiles><profile id="76dd-c779-2ef8-2690" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Sacred Forge hard seals, neural-lace Iron Firewall, and independent kill-switch governors.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="f340-aa9e-451c-7719" name="Iron Firewall fail-closed gate" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="fb9d-6b67-8aeb-76e6" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, ignore one enemy rule that would force this unit to take a Battle-shock test .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="78dd-bdde-d1a1-4a03" name="Exhaust and pressure vents" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="fded-9144-0873-eaaa" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle in your Command phase, remove all Pressure counters without forfeiting its option to Charge .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="4805-e366-bfc9-2a65" name="Redundant mechanical binders" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="92a2-554f-43f2-60fe" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, reroll one failed saving throw; cannot stack with another save reroll .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="3d7c-bd9d-19a9-4afd" name="Ironbound Soul Grinder" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="5f20-c389-04f1-8999" name="Contained Daemon Engines" targetId="7855-099c-f53c-d1e7" hidden="false" primary="true"/><categoryLink id="1af8-979b-ccaa-f323" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="fa06-19f0-1ff6-2f54" type="max" value="2" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="03f8-0d98-b1bc-fc1d" name="Ironbound Soul Grinder" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">8"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">11</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">16</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">3</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="cd96-4dd2-1572-bebb" name="Bound Essence, Not Allegiance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Engine keyword SLAANESH denotes the Frozen Cogs army. A selectable captive Khorne/Tzeentch/Nurgle/Slaanesh/unaligned essence neither changes its Faction Keyword nor grants its owner allegiance to that daemon. Bound daemons are captives, never worshipped or allied commanders.</characteristic></characteristics></profile><profile id="7044-3936-0e7b-ceac" name="Tri-Layer Containment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Every engine has physical warding, neural-lace Iron Firewall, and independently triggered hard shutdown. Enemy control, madness or friendly fire are never automatic. Engine destruction follows the agreed normal Destroyed/Deadly Demise rules .</characteristic></characteristics></profile><profile id="7c99-233c-eec3-1b0d" name="Pressure Governor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of its own Shooting or Fight phase choose one directive for that phase: REGULATED: reroll one Hit roll with one engine weapon; SURGE: choose one weapon +1 Strength this phase, gain 1 Pressure (max 2); VENT: remove all Pressure and forgo Charge this turn. Cannot SURGE at 2 Pressure. Only one directive per phase; no free compound buffs .</characteristic></characteristics></profile><profile id="0b81-eecc-8b33-b8cc" name="Workmanship and Repairs" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">They are VEHICLES for Frozen Cogs repair rules targeting friendly VEHICLES unless that ability expressly excludes DAEMON ENGINES; at most one wound-restoring repair per engine per friendly turn. This repairs the machine chassis, not daemon flesh. No automatic serum healing or daemon regeneration .</characteristic></characteristics></profile><profile id="53bd-a407-7090-c2af" name="Neural-Lace Kill Switch" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Operators can seal the containment engine; the bound daemon never becomes an independent attached Character. No Leader attachment to or from an engine .</characteristic></characteristics></profile><profile id="0181-b0f8-95d3-141c" name="Bastion Crush" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Against units on objectives, this model can reroll one melee Wound roll per Fight phase .</characteristic></characteristics></profile><profile id="40e3-dfa8-c2ac-23e4" name="Caged Furnace" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The captured daemon cannot exercise command authority; no possession or rebellion table (lore and rules safeguard).</characteristic></characteristics></profile><profile id="3661-b6f6-6877-cbd4" name="Chapter allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Heavy siege anchor, living daemon core completely chained; Sacred Forge macro-engine cadres</characteristic></characteristics></profile><profile id="8794-b09f-2f1f-1233" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew: all new profiles, abilities, costs and keywords homebrew. Native New Recruit selection checks requires an in-app check. Shared across-slot restrictions need native import testing; offline editor validates them.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="c7b8-2a08-3fdd-68d5" name="Ironbound Soul Grinder" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="270"/></costs><constraints><constraint id="e161-84ac-1601-7fcd" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="cde6-cb36-dfd7-01cd" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="cd80-e109-4a2a-4d89" name="Main daemon engine gun" hidden="false" defaultSelectionEntryId="cda1-ecc5-cac9-1869"><constraints><constraint id="030b-d2ad-3c8d-d14b" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="6208-eece-90a0-6324" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="cda1-ecc5-cac9-1869" name="Phlegm bombard" type="upgrade" hidden="false"><profiles><profile id="bac6-1bdd-3d98-1b04" name="Phlegm bombard" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">D6+3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">10</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Blast </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="ddf6-0d41-2c5d-e282" name="Glacierglass lance" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="30"/></costs><profiles><profile id="3a53-c8d4-7dc9-25e6" name="Glacierglass lance" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">13</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="87dd-11ac-df0d-6a7f" name="Balefire projector" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="95df-8bc5-2c28-193d" name="Balefire projector" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">18"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2D6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">—</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">6</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Torrent, Ignores Cover</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="ca64-ed2d-5565-47e7" name="Second gun" hidden="false" defaultSelectionEntryId="eea6-d150-e2c9-2730"><constraints><constraint id="9092-717d-29df-3b50" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="dc95-dbf5-38d1-b98d" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="eea6-d150-e2c9-2730" name="Reaper bolt array" type="upgrade" hidden="false"><profiles><profile id="4778-6fc6-f9ff-3add" name="Reaper bolt array" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">5</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Sustained Hits 1</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="f2c9-a616-93dc-af8c" name="Twin autocannon bank" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="f8c2-5f2b-cb57-5db6" name="Twin autocannon bank" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">48"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Twin-linked </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="aa97-5565-74a4-492f" name="Shardglass sonic emitter" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="d5d2-3fc8-9745-00e1" name="Shardglass sonic emitter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">30"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">7</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Ignores Cover </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="5597-a18b-380b-dc98" name="Engagement armament" hidden="false" defaultSelectionEntryId="6552-d063-1350-9a82"><constraints><constraint id="5032-26a4-b298-9e89" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="c5a8-e68b-2940-8c71" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="6552-d063-1350-9a82" name="Hellforged siege claw" type="upgrade" hidden="false"><profiles><profile id="ec52-392c-597c-9f21" name="Hellforged siege claw" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">14</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="2cd3-3da2-65cd-d061" name="Frostshatter siege hammer" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="c165-1300-782b-5cb8" name="Frostshatter siege hammer" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">16</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">5</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Fortification 3+ </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="e0e4-7904-05cd-7159" name="Excavator auger and steel maw" type="upgrade" hidden="false"><profiles><profile id="7042-56f0-0d91-6f17" name="Excavator auger and steel maw" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">15</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Vehicle 3+ </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="7725-7e02-a106-e5f1" name="Enslaved essence and governor (unit-wide)" hidden="false" defaultSelectionEntryId="e188-5a01-54c3-7321"><constraints><constraint id="ae37-00da-b31b-7d19" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="0897-0bb3-50ff-4351" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="e188-5a01-54c3-7321" name="Khorne captive / kinetic governor" type="upgrade" hidden="false"><profiles><profile id="beee-7160-c7d2-258c" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Fight phase, one melee weapon gains +1 Attack this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5e82-f51e-93e9-a8eb" name="Tzeentch captive / predictive governor" type="upgrade" hidden="false"><profiles><profile id="a76d-752f-2636-b35e" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Shooting phase, choose one ranged weapon; it gains Ignores Cover this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="0d7c-d948-af27-cbca" name="Nurgle captive / dampening governor" type="upgrade" hidden="false"><profiles><profile id="946d-50a5-746b-f5dd" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle, when an attack is allocated to this unit, reduce that attack’s Damage by 1 (min. 1; homebrew).</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="4a83-19fd-a8f3-e3c7" name="Slaanesh captive / resonant governor" type="upgrade" hidden="false"><profiles><profile id="ef2a-2f76-0ca0-e6cc" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle one ranged weapon gains +1 Attack during Shooting .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="ba41-98fb-eac6-c6b2" name="Unaligned captive / neutral governor" type="upgrade" hidden="false"><profiles><profile id="f18d-40f3-83b9-40c8" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one Hit roll for this engine .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="2bbf-ad5e-2104-b589" name="Containment safeguard (unit-wide)" hidden="false" defaultSelectionEntryId="155d-1edf-da3e-063d"><constraints><constraint id="2cb7-f4f8-e3b3-0cdc" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="0b0e-c93f-81fd-30db" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="155d-1edf-da3e-063d" name="Triple-lock containment lattice" type="upgrade" hidden="false"><profiles><profile id="33db-faad-c409-59f1" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Sacred Forge hard seals, neural-lace Iron Firewall, and independent kill-switch governors.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8f74-c7f4-3e33-00ea" name="Iron Firewall fail-closed gate" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="fc3a-50ed-554d-be74" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, ignore one enemy rule that would force this unit to take a Battle-shock test .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="6081-47c9-9804-5ff5" name="Exhaust and pressure vents" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="2605-6f37-14a5-81ab" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle in your Command phase, remove all Pressure counters without forfeiting its option to Charge .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b71b-7c75-afbc-ac99" name="Redundant mechanical binders" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="1039-ebd1-c597-9551" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, reroll one failed saving throw; cannot stack with another save reroll .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="51fd-0f23-a82c-1fba" name="Frostcarver Siege Engine" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="a734-0d0b-a00d-4935" name="Contained Daemon Engines" targetId="7855-099c-f53c-d1e7" hidden="false" primary="true"/><categoryLink id="60f0-7b13-41d8-2a05" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="7758-56e9-0871-e4cf" type="max" value="2" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="018e-2ee5-887e-ab4f" name="Frostcarver Siege Engine" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">12</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">18</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">3</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="ff15-df74-5882-2cb0" name="Bound Essence, Not Allegiance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Engine keyword SLAANESH denotes the Frozen Cogs army. A selectable captive Khorne/Tzeentch/Nurgle/Slaanesh/unaligned essence neither changes its Faction Keyword nor grants its owner allegiance to that daemon. Bound daemons are captives, never worshipped or allied commanders.</characteristic></characteristics></profile><profile id="2a80-e951-3ec0-2910" name="Tri-Layer Containment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Every engine has physical warding, neural-lace Iron Firewall, and independently triggered hard shutdown. Enemy control, madness or friendly fire are never automatic. Engine destruction follows the agreed normal Destroyed/Deadly Demise rules .</characteristic></characteristics></profile><profile id="f516-cafe-5527-7ef4" name="Pressure Governor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of its own Shooting or Fight phase choose one directive for that phase: REGULATED: reroll one Hit roll with one engine weapon; SURGE: choose one weapon +1 Strength this phase, gain 1 Pressure (max 2); VENT: remove all Pressure and forgo Charge this turn. Cannot SURGE at 2 Pressure. Only one directive per phase; no free compound buffs .</characteristic></characteristics></profile><profile id="17cb-d374-f315-29f4" name="Workmanship and Repairs" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">They are VEHICLES for Frozen Cogs repair rules targeting friendly VEHICLES unless that ability expressly excludes DAEMON ENGINES; at most one wound-restoring repair per engine per friendly turn. This repairs the machine chassis, not daemon flesh. No automatic serum healing or daemon regeneration .</characteristic></characteristics></profile><profile id="67f1-7f09-c662-703a" name="Neural-Lace Kill Switch" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Operators can seal the containment engine; the bound daemon never becomes an independent attached Character. No Leader attachment to or from an engine .</characteristic></characteristics></profile><profile id="ff54-6803-5dc3-e2e7" name="Surveyed Breach" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Select one enemy Fortification, Vehicle or objective-holding unit visible to this model when it is selected to shoot: reroll one Wound roll against that target .</characteristic></characteristics></profile><profile id="c547-46f2-a1e3-70ed" name="Careful Traverse" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This model cannot Advance and shoot a Heavy weapon in the same turn without special permission .</characteristic></characteristics></profile><profile id="5e57-f746-3910-44dc" name="Chapter allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Oversized experimental demolition and hardened-target removal; 36 Forge / 9th Heavy Siege</characteristic></characteristics></profile><profile id="e6a2-699a-fcbd-41a2" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew: all new profiles, abilities, costs and keywords homebrew. Native New Recruit selection checks requires an in-app check. Shared across-slot restrictions need native import testing; offline editor validates them.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="a6b6-a999-809c-8609" name="Frostcarver Siege Engine" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="325"/></costs><constraints><constraint id="89a3-130c-78ad-e9a5" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="51e4-af26-70a6-7f32" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="67bb-3dcd-625a-2f0f" name="Primary siege cannon" hidden="false" defaultSelectionEntryId="b90b-9687-bd0e-9469"><constraints><constraint id="fee2-399b-58c1-f599" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="3713-e3fc-b4c8-f0fe" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="b90b-9687-bd0e-9469" name="Frostcarver demolisher" type="upgrade" hidden="false"><profiles><profile id="72a7-99e2-40ae-1611" name="Frostcarver demolisher" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">D6+2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">14</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">D6</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Blast </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b364-6381-e776-6aea" name="Glacierglass lance" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="30"/></costs><profiles><profile id="0b92-cf4e-8d80-ec33" name="Glacierglass lance" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">13</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="9352-b7a4-0e4e-dd4b" name="Glacierbreaker mass-driver" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="35"/></costs><profiles><profile id="08e3-dea4-6ec6-96b2" name="Glacierbreaker mass-driver" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">60"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">16</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-4</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">5</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="4bb5-4993-98d0-568b" name="Point defense" hidden="false" defaultSelectionEntryId="596d-5f79-0a69-2535"><constraints><constraint id="e56e-14ec-4806-654f" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="8e28-e00f-cfaa-f6bb" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="596d-5f79-0a69-2535" name="Reaper bolt array" type="upgrade" hidden="false"><profiles><profile id="be44-22de-16b8-8da9" name="Reaper bolt array" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">5</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Sustained Hits 1</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="2794-4048-d489-0fd8" name="Twin autocannon bank" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="a3bf-edff-b60f-7f48" name="Twin autocannon bank" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">48"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Twin-linked </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1b3d-40c9-54fd-d348" name="Balefire projector" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="bd7b-47f1-45da-0287" name="Balefire projector" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">18"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2D6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">—</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">6</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Torrent, Ignores Cover</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="51b1-bcc5-a7dd-9055" name="Excavation tool" hidden="false" defaultSelectionEntryId="6845-b4ca-7370-55e9"><constraints><constraint id="d79f-eeb9-81e2-a59f" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="90f8-c87d-f566-ed40" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="6845-b4ca-7370-55e9" name="Excavator auger and steel maw" type="upgrade" hidden="false"><profiles><profile id="ba23-1faf-6a3c-8197" name="Excavator auger and steel maw" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">15</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Vehicle 3+ </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="93dc-846a-9a6f-ee9d" name="Frostshatter siege hammer" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="cb60-d243-570c-402d" name="Frostshatter siege hammer" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">16</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">5</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Fortification 3+ </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="c606-8512-c061-13b0" name="Enslaved essence and governor (unit-wide)" hidden="false" defaultSelectionEntryId="8f2b-9518-2dbc-4575"><constraints><constraint id="fb7d-0af1-1f44-395d" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="f0e8-71fb-a10a-5b7e" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="8f2b-9518-2dbc-4575" name="Khorne captive / kinetic governor" type="upgrade" hidden="false"><profiles><profile id="017c-23b0-f6db-9db2" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Fight phase, one melee weapon gains +1 Attack this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="e76b-2415-6be3-7c6a" name="Tzeentch captive / predictive governor" type="upgrade" hidden="false"><profiles><profile id="0066-e487-109e-485e" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Shooting phase, choose one ranged weapon; it gains Ignores Cover this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7450-8d7d-ab3f-d27a" name="Nurgle captive / dampening governor" type="upgrade" hidden="false"><profiles><profile id="1ec1-852f-eb0b-5cf9" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle, when an attack is allocated to this unit, reduce that attack’s Damage by 1 (min. 1; homebrew).</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="9e8f-31a4-85b0-94c9" name="Slaanesh captive / resonant governor" type="upgrade" hidden="false"><profiles><profile id="c83f-a2a9-b41b-4a31" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle one ranged weapon gains +1 Attack during Shooting .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="cb7a-2ab5-f892-85d8" name="Unaligned captive / neutral governor" type="upgrade" hidden="false"><profiles><profile id="b335-14a9-4297-d939" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one Hit roll for this engine .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="732c-4531-623c-54c2" name="Containment safeguard (unit-wide)" hidden="false" defaultSelectionEntryId="e2ec-8909-d307-55b7"><constraints><constraint id="1362-af47-04d8-90f8" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="df1d-e86d-428f-17bd" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="e2ec-8909-d307-55b7" name="Triple-lock containment lattice" type="upgrade" hidden="false"><profiles><profile id="eee6-b74e-ba0a-c2be" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Sacred Forge hard seals, neural-lace Iron Firewall, and independent kill-switch governors.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1719-416f-0356-aeb9" name="Iron Firewall fail-closed gate" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="be32-66ba-abc0-ba80" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, ignore one enemy rule that would force this unit to take a Battle-shock test .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8d4f-7e5b-59d3-82ae" name="Exhaust and pressure vents" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="59ec-b504-d9f7-be39" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle in your Command phase, remove all Pressure counters without forfeiting its option to Charge .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="ec6d-606f-369c-5b72" name="Redundant mechanical binders" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="793a-11b9-3f98-6424" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, reroll one failed saving throw; cannot stack with another save reroll .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="45d1-20ee-8228-c976" name="Blackice Bulwark Engine" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="ad53-a65e-bdd7-d659" name="Contained Daemon Engines" targetId="7855-099c-f53c-d1e7" hidden="false" primary="true"/><categoryLink id="af4b-d514-f9e2-1ff7" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="793b-5563-d822-6972" type="max" value="2" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="7ff4-53a2-4e5b-9eba" name="Blackice Bulwark Engine" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">7"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">11</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">16</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">4</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="2f4e-b288-a012-cfae" name="Bound Essence, Not Allegiance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Engine keyword SLAANESH denotes the Frozen Cogs army. A selectable captive Khorne/Tzeentch/Nurgle/Slaanesh/unaligned essence neither changes its Faction Keyword nor grants its owner allegiance to that daemon. Bound daemons are captives, never worshipped or allied commanders.</characteristic></characteristics></profile><profile id="19fa-25b5-0bc0-f7b0" name="Tri-Layer Containment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Every engine has physical warding, neural-lace Iron Firewall, and independently triggered hard shutdown. Enemy control, madness or friendly fire are never automatic. Engine destruction follows the agreed normal Destroyed/Deadly Demise rules .</characteristic></characteristics></profile><profile id="a0e6-d805-b49b-7ce2" name="Pressure Governor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of its own Shooting or Fight phase choose one directive for that phase: REGULATED: reroll one Hit roll with one engine weapon; SURGE: choose one weapon +1 Strength this phase, gain 1 Pressure (max 2); VENT: remove all Pressure and forgo Charge this turn. Cannot SURGE at 2 Pressure. Only one directive per phase; no free compound buffs .</characteristic></characteristics></profile><profile id="3f7a-450f-7212-631f" name="Workmanship and Repairs" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">They are VEHICLES for Frozen Cogs repair rules targeting friendly VEHICLES unless that ability expressly excludes DAEMON ENGINES; at most one wound-restoring repair per engine per friendly turn. This repairs the machine chassis, not daemon flesh. No automatic serum healing or daemon regeneration .</characteristic></characteristics></profile><profile id="1f31-a832-d4d6-89ef" name="Neural-Lace Kill Switch" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Operators can seal the containment engine; the bound daemon never becomes an independent attached Character. No Leader attachment to or from an engine .</characteristic></characteristics></profile><profile id="adf5-22c5-2b94-55cf" name="Anchor of the Wall" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">In your Command phase if this model controls an objective, choose one friendly INFANTRY unit within 3": it may reroll one failed Battle-shock test this turn .</characteristic></characteristics></profile><profile id="166b-7e73-1aca-ba98" name="Bulwark Grounding" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Model may not be embarked in any TRANSPORT .</characteristic></characteristics></profile><profile id="4b78-8cbf-2341-e98c" name="Chapter allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Siege-shielded centerpiece defender and hardpoint keeper; 3rd Defense / Forge bastions</characteristic></characteristics></profile><profile id="0efa-74d2-abe6-8dae" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew: all new profiles, abilities, costs and keywords homebrew. Native New Recruit selection checks requires an in-app check. Shared across-slot restrictions need native import testing; offline editor validates them.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="c33a-e4f0-2663-3caf" name="Blackice Bulwark Engine" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="295"/></costs><constraints><constraint id="63d6-437f-2340-71dd" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="b9cc-1197-ddd5-5153" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="0f45-ce4c-8812-e75c" name="Shield-wall battery" hidden="false" defaultSelectionEntryId="74a8-ade8-ac2a-cfaa"><constraints><constraint id="6fe5-ea49-3aa3-34ce" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="5ebc-b59f-e9fe-3310" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="74a8-ade8-ac2a-cfaa" name="Twin autocannon bank" type="upgrade" hidden="false"><profiles><profile id="3c2b-5ec1-a983-4e87" name="Twin autocannon bank" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">48"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Twin-linked </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1e46-d65f-d9a1-a59f" name="Reaper bolt array" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="017c-472c-1f0a-4c90" name="Reaper bolt array" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">5</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Sustained Hits 1</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="e9e4-108a-eed2-635f" name="Glacierglass lance" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="30"/></costs><profiles><profile id="31a0-ffdd-e959-4ee4" name="Glacierglass lance" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">13</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="0375-c105-7d98-63e7" name="Shardglass sonic emitter" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="8434-829d-06ce-0f75" name="Shardglass sonic emitter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">30"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">7</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Ignores Cover </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="ab1b-dd65-a3e0-9272" name="Shield projector" hidden="false" defaultSelectionEntryId="7947-67b5-6f60-b695"><constraints><constraint id="d2ca-8f0d-f819-30ef" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="ff2c-8662-0ee9-612c" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="7947-67b5-6f60-b695" name="Blackice ward shield" type="upgrade" hidden="false"><profiles><profile id="9652-d161-ad8f-9a39" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">When this model controls an objective, it receives Benefit of Cover if it does not already have it .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="9f84-fa87-520b-9f1c" name="Layered Bastion baffles" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="6932-29a1-41a7-6601" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reduce one attack’s Damage by 2 (min 1; homebrew).</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="fadd-aaa0-c9a9-7f6b" name="Counter-attack armament" hidden="false" defaultSelectionEntryId="9101-d5f3-8dbb-f9c3"><constraints><constraint id="d784-0c32-71ab-24b6" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="edcd-3623-9400-88a2" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="9101-d5f3-8dbb-f9c3" name="Hellforged siege claw" type="upgrade" hidden="false"><profiles><profile id="ba1e-a5a1-70f9-2145" name="Hellforged siege claw" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">14</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b13d-e302-f79e-7493" name="Engine chainfists" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="f561-7e21-2fba-6d17" name="Engine chainfists" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">12</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Vehicle 4+ </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c32a-a003-305e-473e" name="Frostshatter siege hammer" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="40f4-4fb4-dcb0-51ff" name="Frostshatter siege hammer" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">16</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">5</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Fortification 3+ </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="9ce6-9621-b248-b15a" name="Enslaved essence and governor (unit-wide)" hidden="false" defaultSelectionEntryId="6686-ee8c-e90d-51ae"><constraints><constraint id="b512-ef38-0520-a5d2" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="3e27-2773-8ef3-3023" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="6686-ee8c-e90d-51ae" name="Khorne captive / kinetic governor" type="upgrade" hidden="false"><profiles><profile id="c509-f495-12e5-2cc3" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Fight phase, one melee weapon gains +1 Attack this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="da79-904f-53de-0ac7" name="Tzeentch captive / predictive governor" type="upgrade" hidden="false"><profiles><profile id="300e-bb9c-6054-d38d" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Shooting phase, choose one ranged weapon; it gains Ignores Cover this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="27b0-c5a0-cd48-effe" name="Nurgle captive / dampening governor" type="upgrade" hidden="false"><profiles><profile id="6539-226c-a598-810b" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle, when an attack is allocated to this unit, reduce that attack’s Damage by 1 (min. 1; homebrew).</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="17c8-a177-3137-1567" name="Slaanesh captive / resonant governor" type="upgrade" hidden="false"><profiles><profile id="d5e2-8ecb-bb97-bcbc" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle one ranged weapon gains +1 Attack during Shooting .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8ab9-ce22-0644-6982" name="Unaligned captive / neutral governor" type="upgrade" hidden="false"><profiles><profile id="51d8-b249-e57c-3794" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one Hit roll for this engine .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="41c3-86ee-3d83-03e5" name="Containment safeguard (unit-wide)" hidden="false" defaultSelectionEntryId="6d25-73e1-27ba-b3f5"><constraints><constraint id="9dc0-bf94-7377-9c58" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="284e-10ca-9f09-16d5" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="6d25-73e1-27ba-b3f5" name="Triple-lock containment lattice" type="upgrade" hidden="false"><profiles><profile id="9583-e315-dfd5-eafc" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Sacred Forge hard seals, neural-lace Iron Firewall, and independent kill-switch governors.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a9a8-c79f-bac2-efe6" name="Iron Firewall fail-closed gate" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="1cbd-186a-5939-2580" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, ignore one enemy rule that would force this unit to take a Battle-shock test .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5878-a93c-ca07-3d14" name="Exhaust and pressure vents" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="1672-ab12-6ca6-ff7b" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle in your Command phase, remove all Pressure counters without forfeiting its option to Charge .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c426-a0b9-5946-31eb" name="Redundant mechanical binders" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="c5ac-15f9-3afb-3061" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, reroll one failed saving throw; cannot stack with another save reroll .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="4c6f-30d0-0e12-7177" name="Glaciermaw Bore Engine" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="dd7a-24cc-ea4b-57b9" name="Contained Daemon Engines" targetId="7855-099c-f53c-d1e7" hidden="false" primary="true"/><categoryLink id="dedd-dc47-9c7e-6bde" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="b76c-2795-b5aa-68c5" type="max" value="2" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="db9f-6bae-814b-778a" name="Glaciermaw Bore Engine" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">8"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">11</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">17</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">3</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="e48f-a010-7c2a-3829" name="Bound Essence, Not Allegiance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Engine keyword SLAANESH denotes the Frozen Cogs army. A selectable captive Khorne/Tzeentch/Nurgle/Slaanesh/unaligned essence neither changes its Faction Keyword nor grants its owner allegiance to that daemon. Bound daemons are captives, never worshipped or allied commanders.</characteristic></characteristics></profile><profile id="5b79-663a-919b-5b53" name="Tri-Layer Containment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Every engine has physical warding, neural-lace Iron Firewall, and independently triggered hard shutdown. Enemy control, madness or friendly fire are never automatic. Engine destruction follows the agreed normal Destroyed/Deadly Demise rules .</characteristic></characteristics></profile><profile id="a570-cfab-e92f-2cdb" name="Pressure Governor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of its own Shooting or Fight phase choose one directive for that phase: REGULATED: reroll one Hit roll with one engine weapon; SURGE: choose one weapon +1 Strength this phase, gain 1 Pressure (max 2); VENT: remove all Pressure and forgo Charge this turn. Cannot SURGE at 2 Pressure. Only one directive per phase; no free compound buffs .</characteristic></characteristics></profile><profile id="e0b3-2f94-759c-ce65" name="Workmanship and Repairs" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">They are VEHICLES for Frozen Cogs repair rules targeting friendly VEHICLES unless that ability expressly excludes DAEMON ENGINES; at most one wound-restoring repair per engine per friendly turn. This repairs the machine chassis, not daemon flesh. No automatic serum healing or daemon regeneration .</characteristic></characteristics></profile><profile id="67ed-e4ff-8432-8032" name="Neural-Lace Kill Switch" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Operators can seal the containment engine; the bound daemon never becomes an independent attached Character. No Leader attachment to or from an engine .</characteristic></characteristics></profile><profile id="8c4a-e445-a847-e768" name="Choke Pointbreaker" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">After this model destroys a Fortification or Vehicle in melee, choose one friendly IceBreaker unit within 6": it gains +1 to one Advance roll in its next Movement phase .</characteristic></characteristics></profile><profile id="804f-f76f-1c27-62db" name="Passage Rules" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Narrative tunnel entry only by scenario permission; no automatic Deep Strike through terrain.</characteristic></characteristics></profile><profile id="58c0-7da9-3722-e57e" name="Chapter allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Fortification cutter and heavy breach machine; 2nd Siege Assault / 5th Boarding</characteristic></characteristics></profile><profile id="46db-4e55-5982-91cb" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew: all new profiles, abilities, costs and keywords homebrew. Native New Recruit selection checks requires an in-app check. Shared across-slot restrictions need native import testing; offline editor validates them.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="870f-fc15-06a2-e18c" name="Glaciermaw Bore Engine" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="300"/></costs><constraints><constraint id="ed0a-1965-955d-f6cd" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="d252-9c19-b668-987d" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="148c-1605-0089-2ffd" name="Principal excavator" hidden="false" defaultSelectionEntryId="104b-ba7a-2c14-63af"><constraints><constraint id="c13e-49c5-dfab-a51a" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="ca99-551c-ae4c-09f4" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="104b-ba7a-2c14-63af" name="Excavator auger and steel maw" type="upgrade" hidden="false"><profiles><profile id="d4e9-6b1a-c15e-3f2c" name="Excavator auger and steel maw" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">15</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Vehicle 3+ </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="067f-5dc3-1a65-730b" name="Frostshatter siege hammer" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="5f1b-5f13-61c0-e4e2" name="Frostshatter siege hammer" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">16</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">5</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Fortification 3+ </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b960-e487-f93f-a51b" name="Thermic abyss auger" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="25"/></costs><profiles><profile id="0336-7bf2-08ba-ffd9" name="Thermic abyss auger" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">17</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-4</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">5</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Fortification 2+ </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="70bc-744d-0e40-4273" name="Breaching firearm" hidden="false" defaultSelectionEntryId="d49d-f960-7529-6640"><constraints><constraint id="e30a-ad7e-554a-9121" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="4206-2a1a-b5c0-d020" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="d49d-f960-7529-6640" name="Balefire projector" type="upgrade" hidden="false"><profiles><profile id="a5cd-8891-b60d-9ba1" name="Balefire projector" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">18"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2D6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">—</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">6</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Torrent, Ignores Cover</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8cab-9adf-0ce5-1a80" name="Hellforge melta lance" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="25"/></costs><profiles><profile id="28b5-dc63-a072-1e33" name="Hellforge melta lance" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">18"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">12</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-4</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">D6</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Melta 2 </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="2736-83ae-b093-f0ec" name="Pressure-burst demolisher" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="2c5c-2c32-bbbe-1940" name="Pressure-burst demolisher" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">18"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">D6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">12</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Blast </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="8063-dfff-e5e8-cf33" name="Enslaved essence and governor (unit-wide)" hidden="false" defaultSelectionEntryId="f8f9-e6e6-d978-55aa"><constraints><constraint id="afa4-e4ef-a6a8-8dc4" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="2d48-5c19-9eac-4e3b" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="f8f9-e6e6-d978-55aa" name="Khorne captive / kinetic governor" type="upgrade" hidden="false"><profiles><profile id="7bb8-45a5-f372-ed69" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Fight phase, one melee weapon gains +1 Attack this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="df11-3681-0494-a5ac" name="Tzeentch captive / predictive governor" type="upgrade" hidden="false"><profiles><profile id="0800-071d-6869-605b" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Shooting phase, choose one ranged weapon; it gains Ignores Cover this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="082c-04e8-67d7-b1ff" name="Nurgle captive / dampening governor" type="upgrade" hidden="false"><profiles><profile id="8280-f952-47af-c4a2" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle, when an attack is allocated to this unit, reduce that attack’s Damage by 1 (min. 1; homebrew).</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b5a1-18dc-c0cf-07bc" name="Slaanesh captive / resonant governor" type="upgrade" hidden="false"><profiles><profile id="c012-fdc9-50e0-f5cd" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle one ranged weapon gains +1 Attack during Shooting .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="840c-0111-c357-b77d" name="Unaligned captive / neutral governor" type="upgrade" hidden="false"><profiles><profile id="3a1f-63f7-2499-3054" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one Hit roll for this engine .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="8f91-cb90-8271-04b5" name="Containment safeguard (unit-wide)" hidden="false" defaultSelectionEntryId="76c4-f083-3faa-3b06"><constraints><constraint id="22a7-4bb1-1959-8a9c" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="6527-cc1f-beb8-1016" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="76c4-f083-3faa-3b06" name="Triple-lock containment lattice" type="upgrade" hidden="false"><profiles><profile id="90a5-fb8c-4231-a6e0" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Sacred Forge hard seals, neural-lace Iron Firewall, and independent kill-switch governors.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="f3e5-f365-8c99-bae8" name="Iron Firewall fail-closed gate" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="b80b-13cb-438e-c3bb" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, ignore one enemy rule that would force this unit to take a Battle-shock test .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="64c2-4bbe-a757-187f" name="Exhaust and pressure vents" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="55fb-7166-00b9-a1ea" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle in your Command phase, remove all Pressure counters without forfeiting its option to Charge .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="4898-642f-5377-0c73" name="Redundant mechanical binders" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="debd-0fdf-c723-5f11" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, reroll one failed saving throw; cannot stack with another save reroll .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="44b9-af0e-91f3-7b43" name="Shardglass Resonance Engine" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="4f1f-d87f-853e-bd45" name="Contained Daemon Engines" targetId="7855-099c-f53c-d1e7" hidden="false" primary="true"/><categoryLink id="9e90-212b-f675-a250" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="5fda-44a8-a37e-a5f5" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="95dd-e5ce-04f5-7c19" name="Shardglass Resonance Engine" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">9"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">10</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">13</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">3</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="7e6e-fc57-2c87-0c19" name="Bound Essence, Not Allegiance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Engine keyword SLAANESH denotes the Frozen Cogs army. A selectable captive Khorne/Tzeentch/Nurgle/Slaanesh/unaligned essence neither changes its Faction Keyword nor grants its owner allegiance to that daemon. Bound daemons are captives, never worshipped or allied commanders.</characteristic></characteristics></profile><profile id="c3f4-8b64-43e7-bfd3" name="Tri-Layer Containment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Every engine has physical warding, neural-lace Iron Firewall, and independently triggered hard shutdown. Enemy control, madness or friendly fire are never automatic. Engine destruction follows the agreed normal Destroyed/Deadly Demise rules .</characteristic></characteristics></profile><profile id="1b5d-153e-bc31-daf2" name="Pressure Governor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of its own Shooting or Fight phase choose one directive for that phase: REGULATED: reroll one Hit roll with one engine weapon; SURGE: choose one weapon +1 Strength this phase, gain 1 Pressure (max 2); VENT: remove all Pressure and forgo Charge this turn. Cannot SURGE at 2 Pressure. Only one directive per phase; no free compound buffs .</characteristic></characteristics></profile><profile id="acba-d1c1-201e-e9ed" name="Workmanship and Repairs" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">They are VEHICLES for Frozen Cogs repair rules targeting friendly VEHICLES unless that ability expressly excludes DAEMON ENGINES; at most one wound-restoring repair per engine per friendly turn. This repairs the machine chassis, not daemon flesh. No automatic serum healing or daemon regeneration .</characteristic></characteristics></profile><profile id="fe1a-72a9-9632-e175" name="Neural-Lace Kill Switch" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Operators can seal the containment engine; the bound daemon never becomes an independent attached Character. No Leader attachment to or from an engine .</characteristic></characteristics></profile><profile id="a840-4d0c-a01f-d04d" name="Harmonic Precision" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per friendly Shooting phase, after this model hits a unit with a sonic weapon, one friendly Harmonic Infantry within 6" may reroll one Hit against that same target .</characteristic></characteristics></profile><profile id="2962-f3e7-f811-305e" name="Non-Idolatrous Cage" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Captive daemon drives an engineered resonator. The Forge remains its master; no freedom or worship.</characteristic></characteristics></profile><profile id="2c47-1115-2fe9-25a8" name="Chapter allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Contained daemon powers engineered acoustic artillery; Harmonic Conclave / Forge artists</characteristic></characteristics></profile><profile id="1497-0f1f-2ddc-8a8b" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew: all new profiles, abilities, costs and keywords homebrew. Native New Recruit selection checks requires an in-app check. Shared across-slot restrictions need native import testing; offline editor validates them.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="19aa-7cee-112f-9946" name="Shardglass Resonance Engine" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="235"/></costs><constraints><constraint id="fe11-e167-3fb9-a8e9" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="0047-1ca6-3627-316c" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="941a-1abb-d944-386d" name="Acoustic weapon" hidden="false" defaultSelectionEntryId="ee06-407f-8e5d-5693"><constraints><constraint id="e3fe-8020-2b58-f38e" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="496d-2cff-ea1e-680e" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="ee06-407f-8e5d-5693" name="Shardglass sonic emitter" type="upgrade" hidden="false"><profiles><profile id="aab7-8f3a-0bca-221f" name="Shardglass sonic emitter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">30"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">7</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Ignores Cover </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="e14d-a5d3-eb59-6558" name="Cathedral shock horn" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="12"/></costs><profiles><profile id="b56c-9f8b-7d85-de79" name="Cathedral shock horn" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">18"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2D6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">—</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">6</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Torrent, Ignores Cover</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="adcd-505f-9875-1b94" name="Phase-crack resonator" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="25"/></costs><profiles><profile id="d1b3-7277-231c-2e62" name="Phase-crack resonator" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">10</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy, Blast </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="cfa8-20ad-1ace-b9f2" name="Resonance arms" hidden="false" defaultSelectionEntryId="de30-4284-cf18-3419"><constraints><constraint id="7145-d0aa-c9e4-9c57" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="e1a0-7f66-3606-961e" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="de30-4284-cf18-3419" name="Rending servo talons" type="upgrade" hidden="false"><profiles><profile id="57aa-034f-97d8-acd3" name="Rending servo talons" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Twin-linked </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="b939-4dcb-9daa-73fd" name="Excavator auger and steel maw" type="upgrade" hidden="false"><profiles><profile id="9cd1-6fac-3428-bb5e" name="Excavator auger and steel maw" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">15</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Vehicle 3+ </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="4ea4-3e8f-f9a1-d594" name="Enslaved essence and governor (unit-wide)" hidden="false" defaultSelectionEntryId="49c2-c611-a556-7ecf"><constraints><constraint id="1300-f9a7-b0f0-1ff9" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="206a-d884-35ac-144f" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="49c2-c611-a556-7ecf" name="Khorne captive / kinetic governor" type="upgrade" hidden="false"><profiles><profile id="97f5-9080-29ca-a851" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Fight phase, one melee weapon gains +1 Attack this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="3cf3-658c-67af-24d8" name="Tzeentch captive / predictive governor" type="upgrade" hidden="false"><profiles><profile id="0fe1-eb07-e5a5-9774" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Shooting phase, choose one ranged weapon; it gains Ignores Cover this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1326-15e2-7e83-9faa" name="Nurgle captive / dampening governor" type="upgrade" hidden="false"><profiles><profile id="8d07-59e6-e842-fa8a" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle, when an attack is allocated to this unit, reduce that attack’s Damage by 1 (min. 1; homebrew).</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="391d-a49a-d3de-3578" name="Slaanesh captive / resonant governor" type="upgrade" hidden="false"><profiles><profile id="8c82-f140-786d-053b" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle one ranged weapon gains +1 Attack during Shooting .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="89a4-1dcb-fd0b-1c36" name="Unaligned captive / neutral governor" type="upgrade" hidden="false"><profiles><profile id="6fa0-88a8-a36d-96c9" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one Hit roll for this engine .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="ee74-a87f-1ed2-667e" name="Containment safeguard (unit-wide)" hidden="false" defaultSelectionEntryId="e99a-80c0-0a1d-6402"><constraints><constraint id="b353-4cec-ed41-272b" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="ca52-ffdd-63b3-4312" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="e99a-80c0-0a1d-6402" name="Triple-lock containment lattice" type="upgrade" hidden="false"><profiles><profile id="92a7-f1e2-706a-12e1" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Sacred Forge hard seals, neural-lace Iron Firewall, and independent kill-switch governors.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c924-dfef-6a41-04d3" name="Iron Firewall fail-closed gate" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="9f1f-7860-8f97-9786" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, ignore one enemy rule that would force this unit to take a Battle-shock test .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="6e0e-7ee5-c737-2326" name="Exhaust and pressure vents" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="68e1-c58f-06f1-5640" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle in your Command phase, remove all Pressure counters without forfeiting its option to Charge .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5492-5f8e-46ac-f388" name="Redundant mechanical binders" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="f6fb-107a-843f-48bb" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, reroll one failed saving throw; cannot stack with another save reroll .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="1a8b-ddb0-b61a-e881" name="Rimefang Pursuit Engines" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="06f6-0708-2c2f-75b6" name="Contained Daemon Engines" targetId="7855-099c-f53c-d1e7" hidden="false" primary="true"/><categoryLink id="1518-229e-c805-3c98" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="6965-7cb5-d761-8c87" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="615d-8f3d-e4d3-848f" name="Rimefang Pursuit Engines" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">12"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">8</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="2d53-ec63-2fe7-2734" name="Bound Essence, Not Allegiance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Engine keyword SLAANESH denotes the Frozen Cogs army. A selectable captive Khorne/Tzeentch/Nurgle/Slaanesh/unaligned essence neither changes its Faction Keyword nor grants its owner allegiance to that daemon. Bound daemons are captives, never worshipped or allied commanders.</characteristic></characteristics></profile><profile id="9c3d-ed4e-7b49-8902" name="Tri-Layer Containment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Every engine has physical warding, neural-lace Iron Firewall, and independently triggered hard shutdown. Enemy control, madness or friendly fire are never automatic. Engine destruction follows the agreed normal Destroyed/Deadly Demise rules .</characteristic></characteristics></profile><profile id="097a-df5b-5a4f-1f18" name="Pressure Governor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of its own Shooting or Fight phase choose one directive for that phase: REGULATED: reroll one Hit roll with one engine weapon; SURGE: choose one weapon +1 Strength this phase, gain 1 Pressure (max 2); VENT: remove all Pressure and forgo Charge this turn. Cannot SURGE at 2 Pressure. Only one directive per phase; no free compound buffs .</characteristic></characteristics></profile><profile id="bbaa-98f4-d5f1-ee2a" name="Workmanship and Repairs" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">They are VEHICLES for Frozen Cogs repair rules targeting friendly VEHICLES unless that ability expressly excludes DAEMON ENGINES; at most one wound-restoring repair per engine per friendly turn. This repairs the machine chassis, not daemon flesh. No automatic serum healing or daemon regeneration .</characteristic></characteristics></profile><profile id="c250-6cf8-c435-5357" name="Neural-Lace Kill Switch" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Operators can seal the containment engine; the bound daemon never becomes an independent attached Character. No Leader attachment to or from an engine .</characteristic></characteristics></profile><profile id="3fa2-f4df-8dd0-d626" name="Huntlock" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per unit activation nominate one visible enemy within 12"; reroll one Hit against that unit from a pack member .</characteristic></characteristics></profile><profile id="3903-e9cc-b1ca-da81" name="Pack Integrity" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If the pack controls an objective, one model in it counts +1 OC until next turn .</characteristic></characteristics></profile><profile id="dc51-dff2-1c6f-a2da" name="Chapter allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Small bound hunter pack; fast counter-infiltration; 7th Recon / Forge hunting section</characteristic></characteristics></profile><profile id="eea9-013e-451b-7d75" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew: all new profiles, abilities, costs and keywords homebrew. Native New Recruit selection checks requires an in-app check. Shared across-slot restrictions need native import testing; offline editor validates them.</characteristic></characteristics></profile><profile id="8ed8-2634-3e62-56a3" name="Quantity restriction" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At most 2 selections from Rimefang plasma spike across gun in the unit; checked in offline editor.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="8405-0fa6-7cf7-d4be" name="Contained engine 1" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="120"/></costs><constraints><constraint id="74c5-2b9a-221b-d20a" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="bf5c-325e-b28e-1d22" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="3318-5db1-11f7-ca10" name="Hunting weapon" hidden="false" defaultSelectionEntryId="b6d6-27e0-f6b9-8ed4"><constraints><constraint id="5095-7510-74ab-7113" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="9454-4454-7752-adfb" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="b6d6-27e0-f6b9-8ed4" name="Rimefang screamer" type="upgrade" hidden="false"><profiles><profile id="f9ab-eb37-0ba3-0f08" name="Rimefang screamer" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">18"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">6</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Assault</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="3e35-93a4-4483-7d15" name="Rimefang plasma spike" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="12"/></costs><profiles><profile id="50e3-e6bb-8526-a66b" name="Rimefang plasma spike" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">18"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">8</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Hazardous </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="83ce-6891-6b7c-7772" name="Shardglass sonic emitter" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="9d5b-6637-1fbe-4b99" name="Shardglass sonic emitter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">30"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">7</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Ignores Cover </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="5712-df2b-f75f-f63d" name="Pursuit claws" hidden="false" defaultSelectionEntryId="f58a-4a71-9e7f-a2fd"><constraints><constraint id="fa00-07d4-f6ca-bf01" type="min" value="1"