lectionEntry><selectionEntry id="b653-0598-1448-b440" name="Frozen Cogs Terminator Captain" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="76c2-5e74-ab57-c159" name="Chapter Command" targetId="a4bf-93d3-cebe-53ac" hidden="false" primary="true"/><categoryLink id="36be-6d9a-f68c-3354" name="Character" targetId="2e98-8db1-b592-bebd" hidden="false" primary="false"/><categoryLink id="5353-e306-7dbc-b319" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/><categoryLink id="089b-7cbc-81f0-54d1" name="Infantry" targetId="d640-7a85-a199-c350" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="dc13-92ac-9dc0-5ed4" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="a6c9-9cf5-33c7-2867" name="Frozen Cogs Terminator Captain" typeId="0cb1-7394-fb88-5322" typeName="Unit" hidden="false"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">5"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">6</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">6</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">4+</characteristic></characteristics></profile><profile id="6010-a537-b0a5-ec19" name="Armored Command" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">While leading a Terminator unit, once per battle round one failed Battle-shock test may be re-rolled.</characteristic></characteristics></profile><profile id="2b97-1843-d6b0-cf9a" name="Siege Reserve" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, on reaching an objective, the unit may ignore one enemy OC reducing effect until the next Command phase.</characteristic></characteristics></profile><profile id="9509-91a0-28f4-f3c7" name="Leader attachment authorization" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">May lead ONLY these bodyguard unit types: Wintergrave Siege Terminators, IceBreaker Terminators, Frosthammer Terminators, Winterguard Terminators. One attached Leader per bodyguard by default; designated character must be separately included in army roster, no free attached model or extra equipment quotas. Cross-check attachments in offline editor.</characteristic></characteristics></profile><profile id="96d5-ef41-04cf-e57b" name="Equipment and compatibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">homebrew character points, abilities and weapon profiles; no battle testing performed. Fixed signature weapons remain mandatory; mixed pre-Primaris Firstborn armor patterns supported within each appropriate class.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="be5f-33c1-3e89-06ea" name="Frozen Cogs Terminator Captain" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="115"/></costs><constraints><constraint id="b32b-c98f-36c2-d853" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="fe03-6590-5ea4-fd15" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="bbd5-6fc5-edd1-0e5f" name="Armor / pattern" hidden="false" defaultSelectionEntryId="6352-7ff5-c044-c949"><constraints><constraint id="5b7f-adff-53cd-b3da" type="min" value="1" field="selections" scope="parent" shared="