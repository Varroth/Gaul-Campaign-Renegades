f05-4353-204c-511f">Hazardous</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="765f-ab33-654b-879e" name="Combi-melta — bolt mode" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="da53-4a35-e468-2a1a" name="Combi-melta — bolt mode" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">One weapon; choose bolt OR special mode</characteristic></characteristics></profile><profile id="a9b0-0890-ebe8-e08b" name="Firing note — Combi-melta — bolt mode" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">special mode 12", A1, BS3+, S9, AP-4, D D6, Melta 2</characteristic></characteristics></profile><profile id="cee8-a57b-37c3-835b" name="Combi-melta — specialist mode" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">1</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-4</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">D6</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Melta 2</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="6463-3d89-0766-fe96" name="Melee weapon" hidden="false" defaultSelectionEntryId="8e47-c621-e149-4d18"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="c3dd-72a5-dd70-0b66"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="52ee-50d6-e574-baf5"/></constraints><selectionEntries><selectionEntry id="8e47-c621-e149-4d18" name="Combat blade" type="upgrade" hidden="false"><profiles><profile id="77c4-76ae-fd99-4ff5" name="Combat blade" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c5fb-a9eb-002a-8e5d" name="Chainsword" type="upgrade" hidden="false"><profiles><profile id="2d2f-7da4-fc39-4943" name="Chainsword" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteris