e per battle ignore one indirect-fire penalty for an allied FROSTBOUND artillery weapon </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="6a11-68e5-472a-799d" name="Auxilia member 9" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="19"/></costs><constraints><constraint id="1e61-bbb7-26b6-ad59" type="min" value="0" field="selections" scope="parent" shared="true"/><constraint id="3a41-a166-8cd5-4b87" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="fd4c-a0d9-5865-2a02" name="Technician weapon" hidden="false" defaultSelectionEntryId="dade-2f5a-27f5-73ff"><constraints><constraint id="ddc8-0e24-14be-da51" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="1215-fa7e-eec3-9717" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="dade-2f5a-27f5-73ff" name="Frostbound pattern lascarbine" type="upgrade" hidden="false"><profiles><profile id="dc52-3937-9249-8bfa" name="Frostbound pattern lascarbine" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">3</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Rapid Fire 1 </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="6a11-2686-437a-599c" name="Deck-clearing autopistol" type="up