Artificer Guard" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="c354-5e9f-7027-9f3b" name="Sacred Forge Support" targetId="fcb6-2503-af40-5e72" hidden="false" primary="true"/><categoryLink id="e36b-314c-07ba-7490" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="c634-dc65-4343-0d3d" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="2a8e-f131-5d60-47c3" name="Frostforged Artificer Guard" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">5"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="5d58-a0ec-2291-5815" name="Guard the Work" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">While within 3 inches of a friendly Forge Character or a Sacred Forge installation, this unit may reroll one failed saving throw per battle round .</characteristic></characteristics></profile><profile id="2110-0776-6d7e-d939" name="Artificer Muster" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This is a separate heavy Firstborn forge guard; not Terminators and not identical to Winterguard.</characteristic></characteristics></profile><profile id="deb8-9b98-c634-17a6" name="Role and formation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Artificer-armored forge vault and masterwork escort; 36 Forge / 1st veterans</characteristic></characteristics></profile><profile id="9868-9831-dfc5-878c" name="Equipment guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew. Costs, stats and new abilities are homebrew. Not balanced or New Recruit import-tested. Specialist allocation is independently checked in offline editor; native New Recruit cross-model enforcement requires an in-app check.</characteristic></characteristics></profile><profile id="7e08-42cc-af88-c8ed" name="Squad complement" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Exactly one squad lead/controller plus 4–9 squad members.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="f3ac-d40e-ee48-0eec" name="Lead Artisan / Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="39"/></costs><constraints><constraint id="d814-37de-0a8d-6539" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="1692-618a-c540-dc27" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="4fcc-2b8b-7b6c-a6cf" name="Vault guard firearm" hidden="false" defaultSelectionEntryId="ecda-c2d9-b119-4a28"><constraints><constraint id="7c2b-1264-32b7-a893" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="a582-be81-bb26-f2fd" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="ecda-c2d9-b119-4a28" name="Combi-bolter" type="upgrade" hidden="false"><profiles><profile id="7a0