characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="47f8-7912-ca96-fdf1" name="Caerus — Cold-Reactor Lieutenant" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="b756-5959-4410-358f" name="Named Characters" targetId="994c-8bb9-1d19-a104" hidden="false" primary="true"/><categoryLink id="e252-3769-87ed-0a23" name="Character" targetId="2e98-8db1-b592-bebd" hidden="false" primary="false"/><categoryLink id="432b-acca-b163-1360" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/><categoryLink id="730a-416c-5438-e8ef" name="Infantry" targetId="d640-7a85-a199-c350" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="c8bc-85a5-0594-dada" type="max" value="1" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="302a-6712-4663-25b9" name="Caerus — Cold-Reactor Lieutenant" typeId="0cb1-7394-fb88-5322" typeName="Unit" hidden="false"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">5"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">6</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">5</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">4+</characteristic></characteristics></profile><profile id="af7d-3b3e-ab42-288b" name="Measured Breach" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">While leading a Terminator unit, once per Fight phase re-roll one Wound roll.</characteristic></characteristics></profile><profile id="d8d3-4f7e-1f08-a650" name="Cold-Reactor Maul" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Signature freezing-power-unit maul remains mandatory; its tabletop effect is homebrew.</characteristic></characteristics></profile><profile id="f804-49db-1827-b7f0" name="Leader attachment authorization" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">May lead ONLY these bodyguard unit types: Wintergrave Siege Terminators, IceBreaker Terminators, Frosthammer Terminators, Winterguard Terminators. One attached Leader per bodyguard by default; designated character must be separately included in army roster, no free attached model or extra equipment quotas. Cross-check attachments in offline editor.</characteristic></characteristics></profile><profile id="9ddb-1bf4-6b83-2b8d" name="Equipment and compatibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">homebrew character points, abilities and weapon profiles; no battle testing performed. Fixed signature weapons remain mandatory; mixed pre-Primaris Firstborn armor patterns supported within each appropriate class.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="4f86-6837-079a-1ded" name="Caerus — Cold-Reactor Lieutenant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="135"/></costs><constraints><constraint id="7b1f-af77-0b8a-808a" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="9a71-aebb-9965-030b" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="43e3-234f-140d-27ec" name="Armor / pattern" hidden="false" defaultSelectionEntryId="56d0-20