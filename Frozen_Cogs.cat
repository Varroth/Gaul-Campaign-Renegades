1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">5</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="34d8-a066-003e-6c80" name="Standard boarding shield" hidden="false" defaultSelectionEntryId="b98f-19b3-23a7-ca38"><constraints><constraint id="4008-8c69-f0b5-0e68" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="e777-b2ba-c618-d590" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="b98f-19b3-23a7-ca38" name="Auxilia boarding shield" type="upgrade" hidden="false"><profiles><profile id="8ba6-3bb8-aed8-7edc" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">+1 to unmodified Armor saving throws vs ranged attacks, to max 3+ ; not a Space Marine storm shield</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="5205-1fc2-7b9d-9c9c" name="Breaching kit" hidden="false" defaultSelectionEntryId="97d4-7637-5ffd-b55b"><constraints><constraint id="cb76-b708-3f9c-eae1" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="4b83-a178-5b36-ab8e" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="97d4-7637-5ffd-b55b" name="Hardened field kit" type="upgrade" hidden="false"><profiles><profile id="a43b-b65b-67e6-e894" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No added ability; typical armour/kit issued for task</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="67a5-be14-8bb6-4797" name="Demolition kit" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="8"/></costs><profiles><profile id="cd6c-a031-d23d-0833" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One-use demolition charge in the Shooting phase: 6" D3 S8 AP-2 D2 Blast </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="80aa-26d1-bbb7-7e61" name="Frostbound Pathfinder Cell" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="c4b2-8e96-28bf-5937" name="Frostbound Auxilia" targetId="ba92-31ee-3264-a18e" hidden="false" primary="true"/><categoryLink id="6477-3b73-c05b-4117" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="3ac0-e9a4-4cd3-07d5" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="e8c5-1920-fa2c-0103" name="Frostbound Pathfinder Cell" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">3</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">5+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">1</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="f4ae-5c4d-d4a3-34d2" name="One Frozen Cogs Army" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROSTBOUND AUXILIA are mortal fighting elements of a Frozen Cogs detachment, not a separate Guard faction. They share FROZEN COGS faction allegiance. Their datasheets do not unlock Astra Militarum Orders, Platoon detachments, Guard stratagems or detachment abilities. </characteristic></characteristics></profile><profile id="a728-492f-5e4b-810b" name="Mortal Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Models with FROSTBOUND AUXILIA MORTAL keywords do NOT gain Astartes serum healing, Chapter-level Astartes Feel No Pain, neural-lace mastery, an Obliterator Masterwork, or the special armor abilities of inducted Marines. A unit receives its own printed abilities only. </characteristic></characteristics></profile><profile id="c363-eec3-052b-4b3d" name="Direct Support, Not Orders" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attached optional Frostbound Characters provide only their datasheet abilities. No compulsory officer chain and no separate recurring Orders resource. </characteristic></characteristics></profile><profile id="8517-e1ff-0ea6-ac02" name="Workshop Repair Cap" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each VEHICLE may have lost Wounds restored by only one Frozen Cogs repair source in each friendly turn; mortal medicae can affect only named eligible MORTAL INFANTRY. </characteristic></characteristics></profile><profile id="b249-9bca-fcd4-fa5e" name="Transport Eligibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Auxilia transports may carry FROSTBOUND AUXILIA INFANTRY (including eligible CHARACTERS) only. They never carry Astartes or Terminators unless a future datasheet expressly says so. </characteristic></characteristics></profile><profile id="9eca-1909-6082-2a1c" name="Routefinder" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Scout 6" . Once per friendly turn when this unit spots a target within 18", one friendly FROZEN COGS unit may reroll one Advance roll toward that objective .</characteristic></characteristics></profile><profile id="b19b-fad4-4f41-0732" name="Roster notice" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew — not official Warhammer 40,000 rules; all profiles and costs homebrew. Native New Recruit combined caps requires an in-app check. Ratio limits are checked in the offline editor; native importer not tested.</characteristic></characteristics></profile><profile id="9cce-5279-c5fb-2442" name="Force allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">7th Recon elements — Forward route reconnaissance and flank screening</characteristic></characteristics></profile><profile id="e352-bcce-d0de-9d30" name="Keywords" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROZEN COGS, FROSTBOUND AUXILIA, MORTAL, CHAOS, INFANTRY</characteristic></characteristics></profile><profile id="0cf5-a62a-9656-e60c" name="Specialist cap 1" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At most 1 per full 5 models: Frostsight long-las; checked offline.</characteristic></characteristics></profile><profile id="8e20-81d3-3bc9-4bbc" name="Specialist cap 2" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At most 1 per full 5 models: Survey beacon; checked offline.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="a4b2-b46a-5543-f178" name="Auxilia member 1" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="12"/></costs><constraints><constraint id="c2f3-80af-1e36-44c4" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="bf0e-8776-9e3a-c265" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="62b7-377a-d463-5b9a" name="Recon weapon" hidden="false" defaultSelectionEntryId="a207-eb01-c7bf-16cb"><constraints><constraint id="a13e-c7cd-3785-a01f" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="3903-280c-f979-9583" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="a207-eb01-c7bf-16cb" name="Coldline autogun" type="upgrade" hidden="false"><profiles><profile id="0e6e-7639-1fa5-e978" name="Coldline autogun" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">3</characteristic><characteristic name="AP" typeId="91f2-51a2-