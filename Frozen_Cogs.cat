4+ </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="0ed2-69dc-2aea-00d4" name="Balefire projector" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="7cd1-4a5d-c8f3-6966" name="Balefire projector" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">18"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2D6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">—</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">6</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Torrent, Ignores Cover</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="7627-ca63-7a75-c97a" name="Containment claw" hidden="false" defaultSelectionEntryId="eda6-3943-8826-c169"><constraints><constraint id="548c-4c74-b401-c398" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="6af9-6dfb-c45f-9224" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="eda6-3943-8826-c169" name="Hellforged siege claw" type="upgrade" hidden="false"><profiles><profile id="4864-0952-8be4-ee80" name="Hellforged siege claw" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">14</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7de9-8c88-2ba4-9197" name="Rending servo talons" type="upgrade" hidden="false"><profiles><profile id="9ca0-16e1-8ce4-9a47" name="Rending servo talons" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Twin-linked </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="fb53-074a-de73-dffd" name="Frostvein Interceptor Engine" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="d786-9d5b-de1e-2004" name="Contained Daemon Engines" targetId="7855-099c-f53c-d1e7" hidden="false" primary="true"/><categoryLink id="cf90-9045-7667-f177" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="afe5-4bb7-3bb1-b122" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="559e-437f-625f-1381" name="Frostvein Interceptor Engine" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">12"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">9</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">11</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="aafe-d701-eef2-190b" name="Bound Essence, Not Allegiance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Engine keyword SLAANESH denotes the Frozen Cogs army. A selectable captive Khorne/Tzeentch/Nurgle/Slaanesh/unaligned essence neither changes its Faction Keyword nor grants its owner allegiance to that daemon. Bound daemons are captives, never worshipped or allied commanders.</characteristic></characteristics></profile><profile id="a7d5-c535-e239-f6b7" name="Tri-Layer Containment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Every engine has physical warding, neural-lace Iron Firewall, and independently triggered hard shutdown. Enemy control, madness or friendly fire are never automatic. Engine destruction follows the agreed normal Destroyed/Deadly Demise rules .</characteristic></characteristics></profile><profile id="2ab0-712f-62ec-4205" name="Pressure Governor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of its own Shooting or Fight phase choose one directive for that phase: REGULATED: reroll one Hit roll with one engine weapon; SURGE: choose one weapon +1 Strength this phase, gain 1 Pressure (max 2); VENT: remove all Pressure and forgo Charge this turn. Cannot SURGE at 2 Pressure. Only one directive per phase; no free compound buffs .</characteristic></characteristics></profile><profile id="32a1-c420-7f6b-b539" name="Workmanship and Repairs" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">They are VEHICLES for Frozen Cogs repair rules targeting friendly VEHICLES unless that ability expressly excludes DAEMON ENGINES; at most one wound-restoring repair per engine per friendly turn. This repairs the machine chassis, not daemon flesh. No automatic serum healing or daemon regeneration .</characteristic></characteristics></profile><profile id="e093-f6de-1a36-e81c" name="Neural-Lace Kill Switch" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Operators can seal the containment engine; the bound daemon never becomes an independent attached Character. No Leader attachment to or from an engine .</characteristic></characteristics></profile><profile id="3739-84e2-dbda-be96" name="Sky Needle" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">When attacking a unit with FLY, one ranged weapon on this unit may reroll one Wound roll per Shooting phase .</characteristic></characteristics></profile><profile id="4760-790f-2a80-1e91" name="Chapter allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Ground-based aerial interdiction and rapid armored pursuit; Fleet Defense / 9th Heavy</characteristic></characteristics></profile><profile id="d4c3-c02e-fd68-c775" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew: all new profiles, abilities, costs and keywords homebrew. Native New Recruit selection checks requires an in-app check. Shared across-slot restrictions need native import testing; offline editor validates them.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="4a17-f626-033c-0b34" name="Frostvein Interceptor Engine" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="205"/></costs><constraints><constraint id="88b4-dcd9-f0f0-bd40" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="e214-c4fe-90d3-5031" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="771f-93ee-a3f2-8d1a" name="AA weapons" hidden="false" defaultSelectionEntryId="6c0c-ef44-d1f3-ef52"><constraints><constraint id="a7ae-78bb-6db2-4002" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="be37-bdd2-0a03-8987" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="6c0c-ef44-d1f3-ef52" name="Frostvein sky-lance" type="upgrade" hidden="false"><profiles><profile id="869e-292d-b061-96a4" name="Frostvein sky-lance" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">48"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">11</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Fly 3+ </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="71f4-4fe9-0935-5509" name="Hades rotary autocannon" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="d335-055a-1780-72db" name="Hades rotary autocannon" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">8</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">8</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Sustained Hits 1 </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="7865-a7f8-b44b-d5e0" name="Glacierglass lance" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="30"/></costs><profiles><profile id="47dd-912a-738f-c947" name="Glacierglass lance" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">13</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="e34f-cabd-a767-6476" name="Close-in security" hidden="false" defaultSelectionEntryId="2f51-b324-35e7-152c"><constraints><constraint id="f45a-59f2-4ab2-7faf" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="96e7-0ca3-a3b5-44a5" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="2f51-b324-35e7-152c" name="Reaper bolt array" type="upgrade" hidden="false"><profiles><profile id="391b-3de1-5279-5bd2" name="Reaper bolt array" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">5</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Sustained Hits 1</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="4de2-fba4-86bb-b1b1" name="Balefire projector" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="0049-27fa-c798-6928" name="Balefire projector" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">18"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2D6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">—</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">6</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Torrent, Ignores Cover</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="686a-1619-a11d-94da" name="Rending servo talons" type="upgrade" hidden="false"><profiles><profile id="14d8-8a7d-48eb-dc5d" name="Rending servo talons" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Twin-linked </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="13d8-9a6d-09e9-774f" name="Enslaved essence and governor (unit-wide)" hidden="false" defaultSelectionEntryId="e2d5-ecfe-c12c-9701"><constraints><constraint id="769f-368e-e16d-4a26" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="fe3c-5469-8387-2eaa" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="e2d5-ecfe-c12c-9701" name="Khorne captive / kinetic governor" type="upgrade" hidden="false"><profiles><profile id="d091-75e3-e2ac-6e57" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Fight phase, one melee weapon gains +1 Attack this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="899a-5e45-3d92-ee5a" name="Tzeentch captive / predictive governor" type="upgrade" hidden="false"><profiles><profile id="6ee2-b285-dec2-3823" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Shooting phase, choose one ranged weapon; it gains Ignores Cover this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="aebd-d5a5-3a24-dfc0" name="Nurgle captive / dampening governor" type="upgrade" hidden="false"><profiles><profile id="8031-0a05-299a-65bc" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle, when an attack is allocated to this unit, reduce that attack’s Damage by 1 (min. 1; homebrew).</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8656-e384-3c77-2c0e" name="Slaanesh captive / resonant governor" type="upgrade" hidden="false"><profiles><profile id="606a-b65c-0e27-05c2" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle one ranged weapon gains +1 Attack during Shooting .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="196d-1748-3df1-2ad0" name="Unaligned captive / neutral governor" type="upgrade" hidden="false"><profiles><profile id="9a13-73f1-ab59-25f7" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one Hit roll for this engine .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="d838-3ef2-1088-6d84" name="Containment safeguard (unit-wide)" hidden="false" defaultSelectionEntryId="9853-4882-4d90-b913"><constraints><constraint id="27b8-025a-7329-4973" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="eaf9-50fd-7981-5676" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="9853-4882-4d90-b913" name="Triple-lock containment lattice" type="upgrade" hidden="false"><profiles><profile id="4b22-dacd-dfd8-fe42" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Sacred Forge hard seals, neural-lace Iron Firewall, and independent kill-switch governors.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="e431-3816-3a3e-dd6b" name="Iron Firewall fail-closed gate" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="1d45-91c0-ac90-39ed" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, ignore one enemy rule that would force this unit to take a Battle-shock test .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="4cef-2702-0675-4339" name="Exhaust and pressure vents" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="fdc3-4c82-e43e-00d1" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle in your Command phase, remove all Pressure counters without forfeiting its option to Charge .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5920-77e3-5ac4-170b" name="Redundant mechanical binders" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="9617-3b02-27a5-7acb" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, reroll one failed saving throw; cannot stack with another save reroll .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="fe1b-73d6-605b-ae99" name="Pale Scorpion Siege Engine" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="c0c0-6812-af23-d149" name="Contained Daemon Engines" targetId="7855-099c-f53c-d1e7" hidden="false" primary="true"/><categoryLink id="716c-daf7-d0be-ef17" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="75fa-e6dc-b3fe-9893" type="max" value="1" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="1db4-41bf-c949-a50e" name="Pale Scorpion Siege Engine" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">10"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">13</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">22</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">5</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">4+</characteristic></characteristics></profile><profile id="a111-7807-e1ed-0371" name="Bound Essence, Not Allegiance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Engine keyword SLAANESH denotes the Frozen Cogs army. A selectable captive Khorne/Tzeentch/Nurgle/Slaanesh/unaligned essence neither changes its Faction Keyword nor grants its owner allegiance to that daemon. Bound daemons are captives, never worshipped or allied commanders.</characteristic></characteristics></profile><profile id="fffe-b957-6951-df57" name="Tri-Layer Containment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Every engine has physical warding, neural-lace Iron Firewall, and independently triggered hard shutdown. Enemy control, madness or friendly fire are never automatic. Engine destruction follows the agreed normal Destroyed/Deadly Demise rules .</characteristic></characteristics></profile><profile id="93a8-dcab-466a-7aa5" name="Pressure Governor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of its own Shooting or Fight phase choose one directive for that phase: REGULATED: reroll one Hit roll with one engine weapon; SURGE: choose one weapon +1 Strength this phase, gain 1 Pressure (max 2); VENT: remove all Pressure and forgo Charge this turn. Cannot SURGE at 2 Pressure. Only one directive per phase; no free compound buffs .</characteristic></characteristics></profile><profile id="dbf8-1f47-c21f-a4e5" name="Workmanship and Repairs" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">They are VEHICLES for Frozen Cogs repair rules targeting friendly VEHICLES unless that ability expressly excludes DAEMON ENGINES; at most one wound-restoring repair per engine per friendly turn. This repairs the machine chassis, not daemon flesh. No automatic serum healing or daemon regeneration .</characteristic></characteristics></profile><profile id="3d8e-0e81-b981-7aa5" name="Neural-Lace Kill Switch" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Operators can seal the containment engine; the bound daemon never becomes an independent attached Character. No Leader attachment to or from an engine .</characteristic></characteristics></profile><profile id="c96b-6a81-72f2-771c" name="Triangulated Siege" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per Shooting phase, one ranged weapon gains Ignores Cover when targeting a Vehicle or Fortification .</characteristic></characteristics></profile><profile id="ce9d-94fa-75e5-2806" name="Strategic Asset" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One per roster; requires opponent agreement for super-heavy missions if battlepack restricts them.</characteristic></characteristics></profile><profile id="e55d-1370-7ed6-6129" name="Chapter allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Singular colossal segmented breach and extermination engine; Chapter Forge strategic siege reserve</characteristic></characteristics></profile><profile id="6e8b-f36b-ce96-a47d" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew: all new profiles, abilities, costs and keywords homebrew. Native New Recruit selection checks requires an in-app check. Shared across-slot restrictions need native import testing; offline editor validates them.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="bef6-b4ed-9e2b-ebf3" name="Pale Scorpion Siege Engine" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="475"/></costs><constraints><constraint id="015a-29df-eed3-93d3" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="3397-a5e0-93d3-406d" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="d6c6-924b-5007-def9" name="Scorpion dorsal cannon" hidden="false" defaultSelectionEntryId="8d76-85d0-adc2-24db"><constraints><constraint id="2a37-a2b5-0c30-f536" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="65e3-6940-5a45-d3f9" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="8d76-85d0-adc2-24db" name="Cataclysm lance" type="upgrade" hidden="false"><profiles><profile id="a2fc-cc78-2a0a-e57f" name="Cataclysm lance" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">72"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">18</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-4</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">7</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8f65-9171-bfb9-7ec9" name="Pale fire battery" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="25"/></costs><profiles><profile id="5b27-3283-4e85-ff33" name="Pale fire battery" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">48"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2D6+4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">10</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Blast </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="935c-6a30-45ff-8bf7" name="Side batteries" hidden="false" defaultSelectionEntryId="805b-4274-e74f-871e"><constraints><constraint id="5416-2ef0-527a-111f" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="98df-a69e-7961-1cb4" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="805b-4274-e74f-871e" name="Twin autocannon bank" type="upgrade" hidden="false"><profiles><profile id="bd38-a68a-e1cf-e28b" name="Twin autocannon bank" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">48"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Twin-linked </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="4393-28e6-8e94-b500" name="Shardglass sonic emitter" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="98d8-6738-d2d0-6657" name="Shardglass sonic emitter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">30"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">7</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Ignores Cover </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="f7d4-582c-7e79-0a79" name="Glacierglass lance" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="30"/></costs><profiles><profile id="38a7-1044-4180-3558" name="Glacierglass lance" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">13</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="445c-8060-f510-70e9" name="Forelimbs" hidden="false" defaultSelectionEntryId="acc1-da22-6147-ade6"><constraints><constraint id="437c-4f63-19b5-3adc" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="65f4-8f7b-fa00-708f" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="acc1-da22-6147-ade6" name="Frostshatter siege hammer" type="upgrade" hidden="false"><profiles><profile id="64e5-16e3-8180-89ff" name="Frostshatter siege hammer" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">16</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">5</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Fortification 3+ </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8f73-00c9-886e-bf32" name="Excavator auger and steel maw" type="upgrade" hidden="false"><profiles><profile id="f8f2-d362-8921-2825" name="Excavator auger and steel maw" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">15</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Vehicle 3+ </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="0449-95fb-6264-676e" name="Enslaved essence and governor (unit-wide)" hidden="false" defaultSelectionEntryId="e4cb-bd47-119f-f926"><constraints><constraint id="8673-acd8-541f-646a" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="8b75-6900-6fd0-58de" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="e4cb-bd47-119f-f926" name="Khorne captive / kinetic governor" type="upgrade" hidden="false"><profiles><profile id="cf0f-7ca8-71ae-44ff" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Fight phase, one melee weapon gains +1 Attack this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="46c4-db01-48b7-75fb" name="Tzeentch captive / predictive governor" type="upgrade" hidden="false"><profiles><profile id="7125-1d18-a0ae-1ff9" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Shooting phase, choose one ranged weapon; it gains Ignores Cover this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="957c-0320-8d21-9f14" name="Nurgle captive / dampening governor" type="upgrade" hidden="false"><profiles><profile id="5195-d3ce-6fe8-0fcd" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle, when an attack is allocated to this unit, reduce that attack’s Damage by 1 (min. 1; homebrew).</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="85d5-d8bc-15f1-3636" name="Slaanesh captive / resonant governor" type="upgrade" hidden="false"><profiles><profile id="24d0-df61-0e77-857e" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle one ranged weapon gains +1 Attack during Shooting .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="89ee-9910-91bf-d032" name="Unaligned captive / neutral governor" type="upgrade" hidden="false"><profiles><profile id="e478-c929-0b8e-673d" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one Hit roll for this engine .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="14b8-8061-73aa-05d8" name="Containment safeguard (unit-wide)" hidden="false" defaultSelectionEntryId="1233-3cee-fe18-91fb"><constraints><constraint id="f4a9-4a65-f61d-b367" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="63f8-c57f-9468-3b75" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="1233-3cee-fe18-91fb" name="Triple-lock containment lattice" type="upgrade" hidden="false"><profiles><profile id="7b5a-29cd-2af1-4d36" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Sacred Forge hard seals, neural-lace Iron Firewall, and independent kill-switch governors.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="6fbb-d185-6c0c-0bb8" name="Iron Firewall fail-closed gate" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="68d3-d5e1-2549-be69" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, ignore one enemy rule that would force this unit to take a Battle-shock test .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8636-66bb-fcd3-d470" name="Exhaust and pressure vents" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="5927-c356-a21a-f113" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle in your Command phase, remove all Pressure counters without forfeiting its option to Charge .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="ff88-0dd2-850e-8923" name="Redundant mechanical binders" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="9e25-40eb-c4a7-a529" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, reroll one failed saving throw; cannot stack with another save reroll .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="2597-7aa0-c37a-38cb" name="Frostbound Line Section" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="0f53-760e-b7cf-ae52" name="Frostbound Auxilia" targetId="ba92-31ee-3264-a18e" hidden="false" primary="true"/><categoryLink id="535b-a6a5-0c17-1690" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="5abb-90f4-b254-fa53" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="e2ca-83a6-8cd9-ec82" name="Frostbound Line Section" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">3</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">5+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">1</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="7ef2-29e8-bb59-ad2d" name="One Frozen Cogs Army" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROSTBOUND AUXILIA are mortal fighting elements of a Frozen Cogs detachment, not a separate Guard faction. They share FROZEN COGS faction allegiance. Their datasheets do not unlock Astra Militarum Orders, Platoon detachments, Guard stratagems or detachment abilities. </characteristic></characteristics></profile><profile id="5d2c-dfe2-9bf1-d8bf" name="Mortal Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Models with FROSTBOUND AUXILIA MORTAL keywords do NOT gain Astartes serum healing, Chapter-level Astartes Feel No Pain, neural-lace mastery, an Obliterator Masterwork, or the special armor abilities of inducted Marines. A unit receives its own printed abilities only. </characteristic></characteristics></profile><profile id="ad10-ec13-d8d7-23c3" name="Direct Support, Not Orders" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attached optional Frostbound Characters provide only their datasheet abilities. No compulsory officer chain and no separate recurring Orders resource. </characteristic></characteristics></profile><profile id="d3b5-75c6-4b0c-1c58" name="Workshop Repair Cap" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each VEHICLE may have lost Wounds restored by only one Frozen Cogs repair source in each friendly turn; mortal medicae can affect only named eligible MORTAL INFANTRY. </characteristic></characteristics></profile><profile id="1928-264d-9bc2-dbe4" name="Transport Eligibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Auxilia transports may carry FROSTBOUND AUXILIA INFANTRY (including eligible CHARACTERS) only. They never carry Astartes or Terminators unless a future datasheet expressly says so. </characteristic></characteristics></profile><profile id="f464-7865-4257-067f" name="Disciplined Garrison" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">While controlling a defended objective, one model in this unit gains +1 OC .</characteristic></characteristics></profile><profile id="c88c-6af2-0862-ece3" name="Frostbound Steadfast" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, reroll this unit’s Battle-shock test .</characteristic></characteristics></profile><profile id="5967-82f0-9941-ca14" name="Roster notice" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew — not official Warhammer 40,000 rules; all profiles and costs homebrew. Native New Recruit combined caps requires an in-app check. Ratio limits are checked in the offline editor; native importer not tested.</characteristic></characteristics></profile><profile id="ad22-3a15-bb84-6cce" name="Force allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Frostbound expeditionary battalions — Professional infantry screens and objective holders</characteristic></characteristics></profile><profile id="d56f-8da8-a486-a41a" name="Keywords" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROZEN COGS, FROSTBOUND AUXILIA, MORTAL, CHAOS, INFANTRY</characteristic></characteristics></profile><profile id="a73d-1bcf-dba5-56ec" name="Specialist cap 1" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At most 1 per full 5 models: Auxilia plasma gun, Auxilia melta gun, Drum grenade launcher, Pattern-IX flamer; checked offline.</characteristic></characteristics></profile><profile id="f9eb-64aa-6a5b-edca" name="Specialist cap 2" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At most 1 per full 10 models: Tripod heavy bolter, Coldforged autocannon, Auxilia lascannon, Shoulder missile launcher; checked offline.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="8965-398d-22c2-7717" name="Auxilia member 1" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="8"/></costs><constraints><constraint id="42d1-7745-c632-d729" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="97b0-56ca-413b-e94c" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="e1d8-cfba-719c-2cd4" name="Primary firearm" hidden="false" defaultSelectionEnt