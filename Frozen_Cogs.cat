7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">5</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Twin-linked</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="206e-9ae8-7597-5256" name="Frosthammer siege breaker" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="5ee9-b630-c219-06df" name="Frosthammer siege breaker" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile><profile id="800d-8a6c-fcb6-2740" name="Firing note — Frosthammer siege breaker" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Frostforged oversized siege hammer; cannot equip paired claws alongside mandatory shield.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="f9d0-2573-15cb-26e9" name="Optional Frosthammer impact field" hidden="false"><constraints><constraint type="min" value="0" field="selections" scope="parent" shared="true" id="a459-5079-9719-be69"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4b1a-db78-e206-e058"/></constraints><selectionEntries><selectionEntry id="ac56-6a05-d646-175c" name="Frosthammer impact field" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="ce52-d7ac-a74f-5408" name="Frosthammer impact field" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle per bearer, when this unit completes a Charge, choose one enemy unit it charged; the next time that bearer fights it this turn, improve the Armour Penetration characteristic of that bearer’s melee weapon by 1. Duplicate field effects cannot stack.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="d87a-68c1-2db2-895f" name="Frosthammer Terminator 9" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="60"/></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="35e5-6159-10a6-f43e"/></constraints><profiles><profile id="6244-736f-7303-3a6a" name="Issued mandatory shield" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Frosthammer assault shield. Cannot be replaced or removed; its effect is already included in the unit characteristic profile.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="0136-8db7-4481-1864" name="Armor pattern" hidden="false" defaultSelectionEntryId="dd42-1c8c-5542-0c83"><constraints><constrai