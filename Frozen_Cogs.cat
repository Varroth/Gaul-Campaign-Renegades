  <selectionEntries>
    <selectionEntry id="1233-384e-6dfd-17f8" name="Wintergrave Siege Terminators" type="unit" hidden="false" import="true"><constraints><constraint id="f10d-e1d6-24f6-5cc8" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints>
      <categoryLinks>
        <categoryLink name="Elite Siege Infantry" targetId="4184-1d40-9d16-5a7a" id="c749-3c67-c8d3-96fc" primary="true" hidden="false"/>
