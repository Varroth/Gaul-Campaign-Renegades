typeId="0246-3343-a75c-5ffa" value="8"/></costs><profiles><profile id="debb-aaf5-f21b-3cbd" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, gain Benefit of Cover until end of enemy Shooting phase </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="2eec-a8cd-17d7-b083" name="Secure relay aerial" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="6ab6-85f0-29d7-b1cf" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle one nearby MORTAL unit rerolls a failed Battle-shock test </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="41b3-2f13-56da-06d5" name="Auxilia member 2" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="85"/></costs><constraints><constraint id="aeb3-c65b-61d1-c692" type="min" value="0" field="selections" scope="parent" shared="true"/><constraint id="bfba-e99e-6c58-14ad" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="6ded-2c22-5e6e-7ccb" name="Mortar tube" hidden="false" defaultSelectionEntryId="c27f-66dc-d2c7-01b0"><constraints><constraint id="b6b4-9639-e277-12e0" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="41b4-bcf7-a0dc-e07e" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="c27f-66dc-d2c7-01b0" name="Frostbound heavy mortar" type="upgrade" hidden="false"><profiles><profile id="b19e-c882-4a8e-6b58" name="Frostbound heavy 