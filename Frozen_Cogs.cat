haracteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="0810-161d-af6b-5158" name="Frostglass augur sweep" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="636d-a09a-62a2-0420" name="Equipment detail" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At start of your Shooting phase designate one visible target within 18 inches; this vehicle can reroll one ranged Hit against it .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="8dd1-56dc-e0e0-da2f" name="Frozen Cogs Land Speeder Storm" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="ee1e-8101-60ca-06fc" name="Speeders &amp; Reconnaissance" targetId="3ca8-5dea-f094-c6e9" hidden="false" primary="true"/><categoryLink id="b906-b5ef-8359-0369" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="ebcb-01ea-a0f9-b635" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="7be5-cb77-8571-761e" name="Frozen Cogs Land Speeder Storm" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">14"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">7</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">4+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="18df-a870-4e86-ffcd" name="Scout Fast Extraction" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">May carry only Frozen Cogs Scout infantry, not power-armored or Terminator troops .</characteristic></characteristics></profile><profile id="1bf4-4594-1276-96ba" name="Role and doctrine" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Scout insertion and forward extraction; allocation: 7th Recon / 10th Recruitment</characteristic></characteristics></profile><profile id="9c83-d65a-7bfe-6fa3" name="Transport restrictions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Capacity 5 infantry spaces. No Terminator passengers. SCOUT INFANTRY ONLY. No Jump Packs, automata, allied factions or embarked vehicles except stated external vehicle gantries. Exactly 5 Scout infantry spaces. No non-Scout passengers; plan Scouts in the separate roster.</characteristic></characteristics></profile><profile id="8546-a158-201b-b20e" name="Homebrew development status" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All new weapons, points, capacities, arrival rules and effects are preliminary homebrew and not verified against current official 40k or native New Recruit importing.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="8000-f0bb-9703-be27" name="Land Speeder Storm" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="105"/></costs><constraints><constraint id="95ae-b947-ae8e-42e7" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="c008-f684-68ac-ebd7" type=