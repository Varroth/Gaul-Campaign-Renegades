raint id="0c4a-7dd7-ffba-e5fc" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="39c3-9917-5a05-81a5" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="afe7-dc6e-97a1-25e8" name="Track and sensor suite" type="upgrade" hidden="false"><profiles><profile id="ed80-31a8-4961-6bc2" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Standard survey-grade equipment</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c96e-f59d-d7b2-769e" name="Ghostmesh weather cloak" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="5"/></costs><profiles><profile id="ca27-8662-f2c9-e4be" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Cover on deployment only if terrain already gives cover </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="96ca-db87-f6b5-b6a5" name="Survey beacon" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="12"/></costs><profiles><profile id="8682-1967-658d-3d49" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, one enemy in 24" can be marked for a friendly FROZEN COGS unit to ignore Cover against it for one attack </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="bf35-844d-e3fe-7268" name="Cell tactic" hidden="false" defaultSelectionEntryId="4702-5cae-9500-2baa"><constraints><constraint id="c7f7-5830-b96e-748b" type="min" value="1" field="selections"