st name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="8a70-8712-6be1-b37e" name="Chainfist" typeId="a4f5-4674-06d7-5496" typeName="Weapon" hidden="false"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">8</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Vehicle 3+</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="4f84-1a34-acfb-ca9e" name="Warsmith Bheulach" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="7218-3e8c-be61-56bb" name="Named Characters" targetId="994c-8bb9-1d19-a104" hidden="false" primary="true"/><categoryLink id="92aa-282a-5f57-8d84" name="Character" targetId="2e98-8db1-b592-bebd" hidden="false" primary="false"/><categoryLink id="f682-c311-88a9-6977" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/><categoryLink id="b897-23e4-abfd-6545" name="Infantry" targetId="d640-7a85-a199-c350" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="1f1d-42a4-9c5b-78c6" type="max" value="1" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="989a-8971-b9f4-4412" name="Warsmith Bheulach" typeId="0cb1-7394-fb88-5322" typeName="Unit" hidden="false"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">4+</characteristic></characteristics></profile><profile id="38a8-338a-94e4-9b95" name="Freedom Through Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">While leading an eligible squad, once per battle round choose one: re-roll one failed Hit roll, or ignore one Battle-shock-caused OC penalty until phase end.</characteristic></characteristics></profile><profile id="1993-7a09-5d1b-b90e" name="Master of the Sacred Forge" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Friendly FROZEN COGS engineers and automata within 6" may re-roll one repair or fortification die each battle round, maximum one re-roll per affected unit.</characteristic></characteristics></profile><profile id="74a8-62c3-b43d-e15e" name="Coalition Command" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The standing Unified Forces alliance is governed by its independent codex doctrine; Bheulach does not automatically grant free allied units.</characteristic></characteristics></profile><profile id="b292-6afc-90c2-1828" name="Leader attachment authorization" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">May lead ONLY these bodyguard unit types: Frozen Cogs Tactical Squad, IceBreaker Breachers, Frozen Cogs Sternguard Veterans, Frozen Cogs Vanguard Veterans, Frostline Combat Engineers. One attached Leader per bodyguard by default; designated character must be separately included in army roster, no free attached model or extra equipment quotas. Cross-check attachments in offline editor.</characteristic></characteristics></profile><profile id="9ed2-69f7-0dc7-4ccd" name="Equipment and compatibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">homebrew character points, abilities and weapon profiles; no battle testing performed. Fixed signature weapons remain mandatory; mixed pre-Primaris Firstborn armor patterns supported within each appropriate class.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="1582-d67d-f618-2303" name="Warsmith Bheulach" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="265"/></costs><constraints><constraint id="119f-da37-dc89-e1e6" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="6401-74d7-7c5f-7b55" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="211e-f794-9253-0c87" name="Armor / pattern" hidden="false" defaultSelectionEntryId="a78c-52a0-24a3-1026"><constraints><constraint id="49b9-0084-9696-38e9" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="8992-78e4-9980-26e4" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="a78c-52a0-24a3-1026" name="Mk II" type="upgrade" hidden="false"/><selectionEntry id="bab8-ddde-8269-c21f" name="Mk III" type="upgrade" hidden="false"/><selectionEntry id="cae7-4b4d-1953-62b9" name="Mk IV" type="upgrade" hidden="false"/><selectionEntry id="1ed1-5533-d146-014c" name="Mk V" type="upgrade" hidden="false"/><selectionEntry id="e46d-0db7-01e2-d41e" name="Mk VI" type="upgrade" hidden="false"/><selectionEntry id="a5b6-28