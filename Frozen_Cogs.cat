d5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per Shooting phase re-roll one Hit roll .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="4121-e20e-d9d0-b990" name="Frozen Cogs Ironclad Siege Dreadnought" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="09b4-c0c3-8584-ee9a" name="Dreadnoughts &amp; Living Masters" targetId="a75f-1881-2e1a-697a" hidden="false" primary="true"/><categoryLink id="4643-0fe4-39a1-70fc" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="fcb6-8b0d-183d-d082" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="d1a1-cf32-7cb7-2114" name="Frozen Cogs Ironclad Siege Dreadnought" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">10</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">12</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">4</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="bf3e-50b3-db6d-54fc" name="Breach Lock" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If this model declares a charge against a unit on an objective, it may re-roll one charge die once per turn .</characteristic></characteristics></profile><profile id="7c06-4ddf-2f40-5d71" name="Fortress Hammer" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Against a unit holding a fortification, re-roll one melee Wound roll once per Fight phase .</characteristic></characteristics></profile><profile id="dd1f-8f4e-1d82-e3e2" name="Squad size / designation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">1–1 model(s) per unit. Base 205 points/model; selected options are additional. Living Astartes remains part of the fixed inducted 1,200.</characteristic></characteristics></profile><profile id="14b1-af7b-ff7e-a28d" name="Engineering and command compatibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No mandatory Techmarine. Friendly tech specialists may interact via explicitly stated repair abilities. No ordinary attached Infantry Leader. Not an Infernal Warrior; no serum FNP, healing or extra wound.</characteristic></characteristics></profile><profile id="5545-dee3-b279-ef1f" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All unapproved points, weapon profiles, new titles and numeric abilities remain homebrew until full faction roster is built and balance tested. New Recruit native import not yet verified.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="8509-1d45-7624-8986" name="Ironclad Siege Dreadnought" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="205"/></costs><constraints><constraint id="8313-0159-e9c9-7916" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="0b64-8414-3b91-9e17" type="max" value="1" field="selections" scope="parent" shared="true