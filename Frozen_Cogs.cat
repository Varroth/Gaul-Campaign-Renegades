hared="true" id="6d25-a688-2640-d6df"/></constraints><selectionEntries><selectionEntry id="0e93-75cc-ce81-0276" name="IceBreaker breaching charge" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="90b1-32ea-921f-1a22" name="IceBreaker breaching charge" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle per charge bearer, after this unit ends a successful Charge move, designate one enemy unit it charged. During the next Fight phase, improve AP by 1 for this unit’s melee attacks against that target; repeated charges cannot stack on one target.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="5847-2427-2df1-86a7" name="IceBreaker Breacher 1" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="25"/></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2a92-5802-1cf3-c17e"/><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="5bdd-f736-e672-9f5c"/></constraints><profiles><profile id="1bd1-e21c-572c-4d4d" name="Issued mandatory shield" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Reinforced IceBreaker boarding shield. Cannot be replaced or removed; its effect is already included in the unit characteristic profile.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="54b8-ebd2-a4c3-c50c" name="Armor pattern" hidden="false" defaultSelectionEntryId="c8b2-8bc1-c18d-df25"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="0692-e81c-2bb7-e6fc"/><constraint type="max