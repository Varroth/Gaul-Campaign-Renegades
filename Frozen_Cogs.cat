Entry id="b12b-9379-104e-a4ba" name="Rimecoil Servo-Skull Flight" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="3e79-9166-5f5b-9d71" name="Sacred Forge Support" targetId="fcb6-2503-af40-5e72" hidden="false" primary="true"/><categoryLink id="dc5a-f920-87e1-e5d8" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="5f13-e14a-e915-7696" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="427e-45db-94b4-1b81" name="Rimecoil Servo-Skull Flight" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">10"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">3</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">5+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">1</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">8+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">0</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="7add-4758-e135-1b22" name="Scouting Lattice" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per friendly Shooting phase, nominate one enemy visible to this flight within 12 inches; one friendly artillery or ranged VEHICLE unit can reroll one Hit against that target .</characteristic></characteristics></profile><profile id="00e2-2296-cc18-cc23" name="Machine Flock" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No OC; not living Marines or daemon engines.</characteristic></characteristics></profile><profile id="0ad6-5c80-c231-6373" name="Role and formation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Airborne targeting telemetry and vault relay; Forge / Chapter Signals; servo-drones</characteristic></characteristics></profile><profile id="d456-55c0-3198-46f8" name="Equipment guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew. Costs, stats and new abilities are homebrew. Not balanced or New Recruit import-tested. Specialist allocation is independently checked in offline editor; native New Recruit cross-model enforcement requires an in-app check.</characteristic></characteristics></profile><profile id="a0a7-ec3b-ce89-fe8b" name="Squad complement" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Exactly one squad lead/controller plus 2–5 squad members.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="8d14-b60d-7036-19a1" name="Control Operator / Lead Platform" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="19"/></costs><constraints><constraint id="30f1-64aa-2f0a-4ba3" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="308c-3bff-be45-cac1" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="c424-f7ef-0246-9470" name="Per-skull system" hidden="false" defaultSelectionEntryId="c919-e274-19be-1b70"><constraints><constraint id="8376-6686-aace-9416" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="63df-ecd1-bc53-5a95" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="c919-e274-19be-1b70" name="Augur lens" type="upgrade" hi