2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Twin-linked </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="ac32-c334-4b49-986b" name="Engine chainfists" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="e3f2-e09e-02fb-fe39" name="Engine chainfists" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">12</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Vehicle 4+ </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="08ef-f6c8-6b61-b87f" name="Cold-Iron Ward Engines" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="1578-e836-ba91-6c38" name="Contained Daemon Engines" targetId="7855-099c-f53c-d1e7" hidden="false" primary="true"/><categoryLink id="097f-2da6-b21b-afd5" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="5975-66f1-47f9-cc7c" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="939b-f7d8-ec1c-60e7" name="Cold-Iron Ward Engines" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">8"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">9</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">8</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="d320-c6df-e61e-1aee" name="Bound Essence, Not Allegiance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Engine keyword SLAANESH denotes the Frozen Cogs army. A selectable captive Khorne/Tzeentch/Nurgle/Slaanesh/unaligned essence neither changes its Faction Keyword nor grants its owner allegiance to that daemon. Bound daemons are captives, never worshipped or allied commanders.</characteristic></characteristics></profile><profile id="6262-c721-1a0e-54f5" name="Tri-Layer Containment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Every engine has physical warding, neural-lace Iron Firewall, and independently triggered hard shutdown. Enemy control, madness or friendly fire are never automatic. Engine destruction follows the agreed normal Destroyed/Deadly Demise rules .</characteristic></characteristics></profile><profile id="36fe-1d05-5507-c7b1" name="Pressure Governor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of its own Shooting or Fight phase choose one directive for that phase: REGULATED: reroll one Hit roll with one engine weapon; SURGE: choose one weapon +1 Strength this phase, gain 1 Pressure (max 2); VENT: remove all Pressure and forgo Charge this turn. Cannot SURGE at 2 Pressure. Only one directive per phase; no free compound buffs .</characteristic></characteristics></profile><profile id="eab8-bd11-5f1c-473b" name="Workmanship and Repairs" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">They are VEHICLES for Frozen Cogs repair rules targeting friendly VEHICLES unless that ability expressly excludes DAEMON ENGINES; at most one wound-restoring repair per engine per friendly turn. This repairs the machine chassis, not daemon flesh. No automatic serum healing or daemon regeneration .</characteristic></characteristics></profile><profile id="e357-7794-53b7-4085" name="Neural-Lace Kill Switch" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Operators can seal the containment engine; the bound daemon never becomes an independent attached Character. No Leader attachment to or from an engine .</characteristic></characteristics></profile><profile id="ae2f-4845-4117-19bd" name="Iron Firewall Sentries" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per enemy Shooting phase, one friendly FORGE unit within 3" may reroll one saving throw against a psychic attack .</characteristic></characteristics></profile><profile id="1976-9d67-d293-4f2f" name="Ward Anchor" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">A pack cannot protect more than one friendly target with this rule per phase .</characteristic></characteristics></profile><profile id="da03-ed6e-eeca-ac21" name="Chapter allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound perimeter wardens and anti-psyker screening; 20 Signals / Forge containment</characteristic></characteristics></profile><profile id="a50f-34b6-d9fd-ed83" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew: all new profiles, abilities, costs and keywords homebrew. Native New Recruit selection checks requires an in-app check. Shared across-slot restrictions need native import testing; offline editor validates them.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="70d4-c331-db8f-bd7b" name="Contained engine 1" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="140"/></costs><constraints><constraint id="49bb-5f83-cfba-6b5f" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="9407-045b-55cb-59dd" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="92ee-e96a-b3bd-384c" name="Warden gun" hidden="false" defaultSelectionEntryId="b88f-0b2f-1597-5a24"><constraints><constraint id="7d17-d737-7fce-3df6" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="e6cb-f633-647c-8c81" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="b88f-0b2f-1597-5a24" name="Reaper bolt array" type="upgrade" hidden="false"><profiles><profile id="521f-40d8-2738-917c" name="Reaper bolt array" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">5</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Sustained Hits 1</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="9487-eff1-fee7-ef69" name="Null-harmonic pulse" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="dae9-6918-547e-0b4f" name="Null-harmonic pulse" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">7</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Anti-Psyker 4+ </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="4bc6-a392-07da-18b1" name="Balefire projector" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="aa68-6210-6716-442b" name="Balefire projector" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">18"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2D6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">—</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">6</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Torrent, Ignores Cover</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="c43e-9902-e46a-4fd5" name="Containment claw" hidden="false" defaultSelectionEntryId="3c17-3f84-8d27-3826"><constraints><constraint id="1c97-7c5e-75b7-2361" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="8cb7-3230-23b6-84cb" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="3c17-3f84-8d27-3826" name="Hellforged siege claw" type="upgrade" hidden="false"><profiles><profile id="778d-037c-6a9f-7a44" name="Hellforged siege claw" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">5</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">14</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">4</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="ebfe-b7e1-8573-16b8" name="Rending servo talons" type="upgrade" hidden="false"><profiles><profile id="74bd-5491-065f-c36e" name="Rending servo talons" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Twin-linked </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="97bc-ec2e-a404-4f62" name="Enslaved essence and governor (unit-wide)" hidden="false" defaultSelectionEntryId="8d43-40e2-aacf-1b87"><constraints><constraint id="18b4-255c-d51b-f697" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="f67e-c59b-93ce-ab05" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="8d43-40e2-aacf-1b87" name="Khorne captive / kinetic governor" type="upgrade" hidden="false"><profiles><profile id="0fb4-a845-78ce-1c43" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Fight phase, one melee weapon gains +1 Attack this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c071-9ce2-efff-cb6b" name="Tzeentch captive / predictive governor" type="upgrade" hidden="false"><profiles><profile id="1327-fc9d-8ed8-7250" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle in a Shooting phase, choose one ranged weapon; it gains Ignores Cover this phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8098-f9a8-511c-07d2" name="Nurgle captive / dampening governor" type="upgrade" hidden="false"><profiles><profile id="aed1-0063-21a1-f4d7" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle, when an attack is allocated to this unit, reduce that attack’s Damage by 1 (min. 1; homebrew).</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="cc06-0935-0e67-1e94" name="Slaanesh captive / resonant governor" type="upgrade" hidden="false"><profiles><profile id="6a60-6aa0-3f24-af77" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Bound by layered coercion, not worship. Once per battle one ranged weapon gains +1 Attack during Shooting .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="bb15-196a-2c77-2efc" name="Unaligned captive / neutral governor" type="upgrade" hidden="false"><profiles><profile id="d3b0-ca2c-50b6-9e11" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one Hit roll for this engine .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="3729-cd91-b8f3-ece5" name="Containment safeguard (unit-wide)" hidden="false" defaultSelectionEntryId="7f71-cb68-0caa-8137"><constraints><constraint id="878c-4ec7-e209-4157" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="bfd0-0571-b143-56f0" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="7f71-cb68-0caa-8137" name="Triple-lock containment lattice" type="upgrade" hidden="false"><profiles><profile id="8574-812b-0ae7-0d46" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Sacred Forge hard seals, neural-lace Iron Firewall, and independent kill-switch governors.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="f466-5680-d789-14de" name="Iron Firewall fail-closed gate" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="57b3-c6d1-8a80-37ac" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, ignore one enemy rule that would force this unit to take a Battle-shock test .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="d0e8-8ceb-a242-b6e8" name="Exhaust and pressure vents" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="63bf-f76e-367a-b395" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle in your Command phase, remove all Pressure counters without forfeiting its option to Charge .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="4e6c-a0bf-96de-0766" name="Redundant mechanical binders" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="c7d6-f19b-5473-29ce" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, reroll one failed saving throw; cannot stack with another save reroll .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="0083-0576-64a1-fcc7" name="Contained engine 2" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="140"/></costs><constraints><constraint id="82e6-2bcb-ac24-243c" type="min" value="0" field="selections" scope="parent" shared="true"/><constraint id="1d1e-e343-b3b0-b760" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="12d1-a42a-179b-8988" name="Warden gun" hidden="false" defaultSelectionEntryId="1123-47a6-594b-9db7"><constraints><constraint id="1304-537e-c3ef-a896" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="9004-2782-6454-ddf0" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="1123-47a6-594b-9db7" name="Reaper bolt array" type="upgrade" hidden="false"><profiles><profile id="af34-59be-a28f-3704" name="Reaper bolt array" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">5</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Sustained Hits 1</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="774a-b098-6eb7-2572" name="Null-harmonic pulse" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="bbfc-b7e2-9660-0ae1" name="Null-harmonic pulse" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="