5">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="9f71-5999-f9a7-f67a" name="Ballistic instrument" hidden="false" defaultSelectionEntryId="5321-ff70-5c18-2030"><constraints><constraint id="7c61-96c2-da2a-7696" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="f16f-8094-97ba-2786" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="5321-ff70-5c18-2030" name="Track and sensor suite" type="upgrade" hidden="false"><profiles><profile id="32d8-b7f9-f6d2-cfc7" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Standard survey-grade equipment</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8220-5eb9-0749-10d6" name="Windglass rangefinder" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="8"/></costs><profiles><profile id="dd87-6f21-3862-1f41" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One sniper attack per shooting gains Ignores Cover </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="17f4-ee0d-c231-e3a6" name="Sharpshooter tasking" hidden="false" defaultSelectionEntryId="4de7-ab8e-b1d3-c53b"><constraints><constraint id="bdc3-39b7-9777-b88d" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="8917-ca84-e6b0-16d4" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="4de7-ab8e-b1d3-c53b" name="Counter-Battery" type="upgrade" hidden="false"><profiles><profile id="8a28-ebdf-a435-0b8c" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Reroll one Hit against a visible enemy support unit each Shooting phase .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="fad6-3325-b87f-7c13" name="Overwatch Arc" type="upgrade" hidden="false"><profiles><profile id="346a-7eeb-d83f-65e5" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One model gains +1 BS on Fire Overwatch once per battle .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="464d-f77b-f262-74a7" name="Internal squad NCO" hidden="false" defaultSelectionEntryId="5c5c-243c-cb1b-1f24"><constraints><constraint id="aebd-ea92-9dcd-25fb" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="f76c-2d97-e1d0-2475" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="5c5c-243c-cb1b-1f24" name="Squad leader comm bead" type="upgrade" hidden="false"><profiles><profile id="f53f-32ca-a861-5bbe" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One per section, issued to first model; no separate officer-chain or Orders system</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5785-61e5-fc10-682a" name="Veteran section leader" type="upgrade" hidden="false"><costs><cost