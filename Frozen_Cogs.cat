<characteristic name="S" typeId="846d-1dce-303c-5c75">8</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Hazardous; plus bolt mode 24", A2, BS3+, S4, AP0, D1</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="67f7-5366-afd0-ec1d" name="Sightmaster combi-melta" type="upgrade" hidden="false"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5c8d-80c9-a620-092c"/></constraints><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="2642-d519-f9c7-4418" name="Sightmaster combi-melta" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">1</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-4</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">D6</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Melta 2; plus bolt mode 24", A2, BS3+, S4, AP0, D1</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="1a86-5335-f374-672b" name="Melee weapon" hidden="false" defaultSelectionEntryId="0937-35cb-8896-5b83"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="bfcf-c1b2-2cb3-082c"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6475-56fa-947c-58f6"/></constraints><selectionEntries><selectionEntry id="0937-35cb-8896-5b83" name="Combat blade" type="upgrade" hidd