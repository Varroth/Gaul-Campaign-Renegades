90-3b92-5cec">Once per battle reroll a single weapon Damage roll in Shooting .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="90ad-3b6b-db4e-e4d9" name="Siege dozer blade" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="c579-f5a4-b4fc-6ee7" name="Selected configuration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Ignore one terrain-caused Movement reduction per turn; not permission to move through impassable terrain .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="770a-2e98-ced0-be22" name="Frozen Cogs Damocles Command Rhino" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="f5a8-63b0-cdca-c791" name="Armored Transports" targetId="5b89-f231-abc9-9294" hidden="false" primary="true"/><categoryLink id="22c4-f4f1-61c8-1fc4" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="90d4-df1f-6d3e-868d" type="max" value="1" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="13ec-92dd-0113-0bc3" name="Frozen Cogs Damocles Command Rhino" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">12"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">9</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">11</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="0f66-2194-f37d-949a" name="Damocles Siege-Net" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of your Shooting phase nominate one visible enemy within 24"; one friendly Frozen Cogs infantry unit within 9" may reroll one Hit roll versus it this phase .</characteristic></characteristics></profile><profile id="37cb-3fa9-c7b2-ee04" name="Transport capacity and permitted passengers" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Carry up to 6 infantry spaces. A standard non-Jump Pack Firstborn infantry model occupies 1 space. Terminator models are not permitted. Every attached Leader occupies space as appropriate. Dreadnoughts, vehicles, automata, jetbikes, aircraft, non-Frozen-Cogs allies unless separate alliance transport rule permits them. Carries a small command team; passenger capacity includes any embarked officers.</characteristic></characteristics></profile><profile id="0161-2d04-81e0-9583" name="Chassis role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Mobile neural-lace command and survey hub; assignment: Signals vault / company command</characteristic></characteristics></profile><profile id="7a39-7c62-3039-06d0" name="Roster status" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">New weapon profiles, transport limits and special rules are homebrew homebrew design, not verified official datasheet. No balance simulations or native New Recruit import verification.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="ce3f-1444-7678-3eb3" name="Damocles Command Rhino" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="125"/></costs><constraints><constraint id="b948-0f5d-8602-c1d2" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="5b69-16de-45e4-b69d" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="337a-e5b3-138b-6fe2" name="Command vehicle roof mount" hidden="false" defaultSelectionEntryId="b17a-6aef-4408-7041"><constraints><constraint id="c9e9-9e65-c88c-0ead" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="f22a-12b1-559c-d436" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="b17a-6aef-4408-7041" name="Pintle storm bolter" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="5"/></costs><profiles><profile id="d287-bbbe-2dd4-4de6" name="Pintle storm bolter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Rapid Fire 2</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1dca-5b7d-7c7b-e0de" name="Pintle heavy bolter" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="9910-60c9-80ee-c546" name="Pintle heavy bolter" hidden="false" typeId="a4f5-4674-06d7-5496" typeNa