ght" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="cdb7-6f5e-60ad-ee0b" name="Dreadnoughts &amp; Living Masters" targetId="a75f-1881-2e1a-697a" hidden="false" primary="true"/><categoryLink id="1b76-b1f4-2c14-396e" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="7248-3cb8-6a16-ebde" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="7956-ed56-f7a7-6ad7" name="Frostwrought Modular Siege Dreadnought" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">7"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">10</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">12</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">4</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="0b9b-a00c-eec4-0f30" name="Certified Modular Internment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All primary arm options are compatible certified Sacred Forge designs, including mixed ballistic and melee arms. Choose one melee profile when fighting.</characteristic></characteristics></profile><profile id="5ff0-beb9-23db-25ed" name="Iron Firewall" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No enemy daemon controls this machine; this is a piloted Dreadnought, not a daemon engine.</characteristic></characteristics></profile><profile id="b6e5-3614-f175-68f7" name="Squad size / designation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">1–1 model(s) per unit. Base 240 points/model; selected options are additional. Living Astartes remains part of the fixed inducted 1,200.</characteristic></characteristics></profile><profile id="16ba-fe8d-04cc-1080" name="Engineering and command compatibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No mandatory Techmarine. Friendly tech specialists may interact via explicitly stated repair abilities. No ordinary attached Infantry Leader. Not an Infernal Warrior; no serum FNP, healing or extra wound.</characteristic></characteristics></profile><profile id="3fd1-0823-21c1-2388" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All unapproved points, weapon profiles, new titles and numeric abilities remain homebrew until full faction roster is built and balance tested. New Recruit native import not yet verified.</characteristic></characteristics></profile><profile id="214b-c73a-65ea-e08f" name="Special restrictions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">max_conversions = 1. Local editor enforces combined-arm restrictions; New Recruit native cross-arm enforcement requires an in-app check.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="58a9-fcfc-054f-15f9" name="Frostwrought Modular Siege Dreadnought" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="240"/></costs><constraints><constraint id="8437-d375-557f-49a7" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="10e4-86f1-57d5-6ec5" type