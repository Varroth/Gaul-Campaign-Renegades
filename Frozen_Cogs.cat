+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Blast</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><selectionEntries><selectionEntry id="8d20-1e56-a50c-4e7e" name="Reinforced masterwork plating" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><constraints><constraint id="5b95-27eb-a423-ee5b" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><profiles><profile id="f1de-d8f0-5403-1dc2" name="Module effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reduce the damage of one allocated attack by 1, to a minimum of 1 .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8eee-3e0f-48cc-e60d" name="Ancient targeting reliquary" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><constraints><constraint id="73fd-f65c-215c-b47a" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><profiles><profile id="2186-6c7f-8dc3-724f" name="Module effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per turn re-roll one ranged Hit roll .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="668f-6135-be0b-77ad" name="Frozen Cogs Contemptor Dreadnought" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="8482-022e-ed7b-4a1b" name="Dreadnoughts &amp; Living Masters" targetId="a75f-1881-2e1a-697a" hidden="false" primary="true"/><categoryLink id="547a-95e5-f513-ffe0" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="c2b1-9fe0-b73b-ef7e" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="35e9-b8dd-9e28-7f4f" name="Frozen Cogs Contemptor Dreadnought" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">8"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">9</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">10</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">3</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="fb4d-62ef-7ca6-3287" name="Interlocking Attack Patterns" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If this unit did not Advance, it may re-roll one ranged Hit roll or melee Wound roll this turn .</characteristic></characteristics></profile><profile id="b470-207c-7d72-5e8d" name="Living Master" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Pilot can contribute battle experience to Chapter data archives; no resurrection of preserved consciousness.</characteristic></characteristics></profile><profile id="67a2-359a-8170-e38f" name="Squad size / designation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">1–1 model(s) per unit. Base 190 points/model; selected options are additional. Living Astartes remains part of the fixed inducted 1,200.</characteristic></characteristics></profile><profile id="23d0-366e-1958-6ab9" name="Engineering and command compatibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No mandatory Techmarine. Friendly tech specialists may interact via explicitly stated repair abilities. No ordinary attached Infantry Leader. Not an Infernal Warrior; no serum FNP, healing or extra wound.</characteristic></characteristics></profile><profile id="60b3-f895-6d95-5820" name="Roster guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All unapproved points, weapon profiles, new titles and numeric abilities remain homebrew until full faction roster is built and balance tested. New Recruit native import not yet verified.</characteristic></characteristics></profile><profile id="c6ec-e33b-01d6-da89" name="Special restrictions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">max_conversions = 1. Local editor enforces combined-arm restrictions; New Recruit native cross-arm enforcement requires an in-app check.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="410c-a8eb-ad78-70cc" name="Contemptor Dreadnought" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="190"/></costs><constraints><constraint id="cbbc-7ab5-f808-e350" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="c584-0fac-f13b-0db4" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="e56f-e129-