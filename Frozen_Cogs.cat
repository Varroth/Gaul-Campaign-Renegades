es><selectionEntry id="bd42-5967-7103-7c8d" name="Iron Firewall receiver (read-only)" type="upgrade" hidden="false"><profiles><profile id="1762-c9c7-8518-0005" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">A secured tactical feed; cannot issue neuro-lace commands or access Sacred Forge master controls</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1cb6-9476-ac4a-1da1" name="Survey beacon" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="12"/></costs><profiles><profile id="3230-72eb-50af-01e7" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, one enemy in 24" can be marked for a friendly FROZEN COGS unit to ignore Cover against it for one attack </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="2c3f-d409-922a-a624" name="Close weapon" hidden="false" defaultSelectionEntryId="988d-cb2c-be15-b669"><constraints><constraint id="2418-6c83-5507-2f02" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="1987-8d6c-eeba-6bcc" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="988d-cb2c-be15-b669" name="Utility cutter" type="upgrade" hidden="false"><profiles><profile id="d9b3-8686-7f7d-7fa6" name="Utility cutter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">3</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="d71e-da09-8452-41e1" name="Trench blade" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="3"/></costs><profiles><profile id="1a22-f60a-9e7d-5e06" name="Trench blade" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="f201-8251-eea1-806e" name="Frostbound Armored Carrier" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="9119-e6a7-bc32-fbda" name="Frostbound Auxilia" targetId="ba92-31ee-3264-a18e" hidden="false" primary="true"/><categoryLink id="2e09-c1ed-1841-49b7" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="0390-c479-5c5d-073b" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="9602-42fe-9764-8865" name="Frostbound Armored Carrier" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">12"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">8</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">10</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="6a1a-a3b3-c2e0-b048" name="One Frozen Cogs Army" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROSTBOUND AUXILIA are mortal fighting elements of a Frozen Cogs detachment, not a separate Guard faction. They share FROZEN COGS faction allegiance. Their datasheets do not unlock Astra Militarum Orders, Platoon detachments, Guard stratagems or detachment abilities. </characteristic></characteristics></profile><profile id="bda7-98c6-25f0-f393" name="Mortal Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Models with FROSTBOUND AUXILIA MORTAL keywords do NOT gain Astartes serum healing, Chapter-level Astartes Feel No Pain, neural-lace mastery, an Obliterator Masterwork, or the special armor abilities of inducted Marines. A unit receives its own printed abilities only. </characteristic></characteristics></profile><profile id="4b6c-3777-fc80-e9e3" name="Direct Support, Not Orders" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attached optional Frostbound Characters provide only their datasheet abilities. No compulsory officer chain and no separate recurring Orders resource. </characteristic></characteristics></profile><profile id="009e-df85-f3f2-cffa" name="Workshop Repair Cap" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each VEHICLE may have lost Wounds restored by only one Frozen Cogs repair source in each friendly turn; mortal medicae can affect only named eligible MORTAL INFANTRY. </characteristic></characteristics></profile><profile id="e7e1-22b2-dc7f-5af5" name="Transport Eligibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Auxilia transports may carry FROSTBOUND AUXILIA INFANTRY (including eligible CHARACTERS) only. They never carry Astartes or Terminators unless a future datasheet expressly says so. </characteristic></characteristics></profile><profile id="be27-029a-738b-41d8" name="Mortal Transport" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Transport 10 eligible FROSTBOUND AUXILIA INFANTRY models normally. A CHARACTER consumes one seat. Capacity 8 with Protected Compartment. Cannot embark ASTARTES, TERMINATORS or DAEMON ENGINES.</characteristic></characteristics></profile><profile id="c74b-f39b-f8b0-31e5" name="Roster notice" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew — not official Warhammer 40,000 rules; all profiles and costs homebrew. Native New Recruit combined caps requires an in-app check. Ratio limits are checked in the offline editor; native importer not tested.</characteristic></characteristics></profile><profile id="971e-f9e7-bf31-71fe" name="Force allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Expeditionary Auxilia motor pools — Ten-seat mortal troop transport and mobile shelter</characteristic></characteristics></profile><profile id="8f1b-070c-2c0f-6e65" name="Keywords" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROZEN COGS, FROSTBOUND AUXILIA, MORTAL, CHAOS, VEHICLE</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="0fe8-3a8b-ddd5-2774" name="Auxilia operator" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="90"/></costs><constraints><constraint id="e4db-3497-927f-6067" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="d838-80cf-d292-75c0" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="f3d2-1816-92db-5b40" name="Carrier weapon" hidden="false" defaultSelectionEntryId="93e3-6b5d-570c-7af9"><constraints><constraint id="848c-1c53-48e7-e44f" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="b943-8fd5-07b7-b71a" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="93e3-6b5d-570c-7af9" name="Coaxial heavy stubber" type="upgrade" hidden="false"><profiles><profile id="726e-e9c6-995c-ce78" name="Coaxial heavy stubber" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteris