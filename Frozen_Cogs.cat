istic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="3688-4ca1-b765-a1ea" name="Optional IceBreaker breaching charge" hidden="false"><constraints><constraint type="min" value="0" field="selections" scope="parent" shared="true" id="bf07-95aa-9caa-e46c"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1d65-6314-13d5-2a82"/></constraints><selectionEntries><selectionEntry id="8b16-578b-0694-a851" name="IceBreaker breaching charge" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="dc62-ae13-80b8-242f" name="IceBreaker breaching charge" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle per charge bearer, after this unit ends a successful Charge move, designate one enemy unit it charged. During the next Fight phase, improve AP by 1 for this unit’s melee attacks against that target; repeated charges cannot stack on one target.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="0d2b-88d3-3e9e-0d88" name="IceBreaker Breacher 5" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="25"/></costs><constraints><constraint type="max" val