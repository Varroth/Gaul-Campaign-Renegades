ogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="7e06-a545-fb33-d065" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="4ad7-7858-c811-d20a" name="Winter Requiem Sonic Marines" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="4e46-b4a9-04ca-c103" name="Perfect Pitch" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per friendly Shooting phase, one sonic-armed model may reroll a ranged Hit roll .</characteristic></characteristics></profile><profile id="b042-f026-58f9-7a51" name="Ear-Shattering Advance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">After a successful Charge, one eligible enemy unit within Engagement Range subtracts 1 from its next Battle-shock test until end of turn .</characteristic></characteristics></profile><profile id="2fd3-719c-e549-2957" name="Role and formation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Disciplined sonic fire and assault support; Harmonic Conclave / fleet detachments</characteristic></characteristics></profile><profile id="e2e9-fdda-c49b-fe23" name="Equipment guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew. Costs, stats and new abilities are homebrew. Not balanced or New Recruit import-tested. Specialist allocation is independently checked in offline editor; native New Recruit cross-model enforcement requires an in-app check.</characteristic></characteristics></profile><profile id="9394-5eef-af47-508f" name="Specialist allocation: weapon" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">1 permitted per FULL 5 models among options: Sonic blastmaster; checked in offline editor, native XML may not enforce the shared squad cap.</characteristic></characteristics></profile><profile id="d70f-5b1d-01be-e5ae" name="Squad complement" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Exactly one squad lead/controller plus 4–9 squad members.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="ad4c-9c85-6db4-48d3" name="Lead Artisan / Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="29"/></costs><constraints><constraint id="ff4a-f5f3-5dc2-5441" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="e273-c41a-6dc8-147f" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="b1c2-f503-2818-d15f" name="Sonic firearm" hidden="false" defaultSelectionEntryId="7404-47ea-1080-3ae5"><constraints><constraint id="7a51-c1a1-157e-9e4f" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="929d-e698-245a-55a9" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><select