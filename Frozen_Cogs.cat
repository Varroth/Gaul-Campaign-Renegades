ts><constraint type="min" value="0" field="selections" scope="parent" shared="true" id="68ce-0667-0efc-3df7"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="62fb-23ab-98a5-079b"/></constraints><selectionEntries><selectionEntry id="633f-c390-b64a-91e7" name="IceBreaker breaching charge" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="1fa1-f882-7819-35d3" name="IceBreaker breaching charge" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle per charge bearer, after this unit ends a successful Charge move, designate one enemy unit it charged. During the next Fight phase, improve AP by 1 for this unit’s melee attacks against that target; repeated charges cannot stack on one target.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="afa7-0321-4495-5f68" name="IceBreaker Breacher 4" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="25"/></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="17f4-641f-5d03-8538"/><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="a4e5-d124-17fe-4593"/></constraints><profiles><profile id="a101-88e9-9e19-cec1" name="Issued mandatory shield" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Reinforced IceBreaker boarding shield. Cannot be replaced or removed; its effect is already included in the unit characteristic profile.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="17d5-d204-9f35-4450" name="Armor pattern" hidden="false" defaultSe