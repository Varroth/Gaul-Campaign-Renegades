eId="ecdc-11e1-15d1-5780">2</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="9211-23dd-76f2-8d36" name="Exploitation Assault" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">After this unit completes a Charge against an enemy that was wounded by another friendly Frozen Cogs unit during your Shooting phase, this unit may re-roll one melee Wound roll during its first Fight activation that turn.</characteristic></characteristics></profile><profile id="a9bf-58c0-bc1f-6cce" name="Relentless Veterans" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One model in this unit can re-roll a failed Battle-shock test once per battle.</characteristic></characteristics></profile><profile id="ddcf-830a-2ebd-7a0e" name="Roster constraints and timing" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">5–10 total models including one Vanguard Veteran Sergeant; {"special_per_five": 1, "unit_wide_mobility": true}. Per-model costs and allowances apply; native cross-model constraints pending actual New Recruit import/verification. Use the listed homebrew statistics; no battle simulations.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="d33f-b09d-a5fc-a362" name="Vanguard Veteran Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="29"/></costs><constraints><constraint id="e4c4-685f-fbca-c866" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="e67e-c075-3