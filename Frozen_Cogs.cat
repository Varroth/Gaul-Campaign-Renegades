stic></characteristics></profile><profile id="bebf-6235-ae19-e622" name="Restricted specialist allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Up to one specialist rider_gun choice per full 3 models. Specialist options: Scout grenade launcher. Native catalogue cross-model enforcement requires a New Recruit check.</characteristic></characteristics></profile><profile id="1026-6781-37c0-7c6a" name="Homebrew development status" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All new weapons, points, capacities, arrival rules and effects are preliminary homebrew and not verified against current official 40k or native New Recruit importing.</characteristic></characteristics></profile><profile id="f45e-5260-9199-4d77" name="Squad complement" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">3–6 riders. Exactly one Sergeant.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="d7c9-368e-614d-9453" name="Frozen Cogs Scout Bike Cadre Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="24"/></costs><constraints><constraint id="4a12-a016-49b0-9259" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="9163-d731-5d3c-1e26" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="b689-486b-d546-4344" name="Per-rider scout weapon" hidden="false" defaultSelectionEntryId="4870-21a6-a6a0-2ae0"><constraints><constraint id="69dd-27c5-b29a-d88c" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="2f77-0676-8461-e4be" type="max" value="1" field="selections" scope="parent" s