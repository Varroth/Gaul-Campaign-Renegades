se" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle force one enemy attacking unit to subtract 1 from Hit rolls targeting this model .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="1511-fb6f-a788-e85a" name="Active reconnaissance uplink" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="87e0-d84e-556c-c7ea" name="Equipment detail" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per turn nominate one enemy visible within 18 inches; a friendly artillery unit may reroll one Hit against it .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="721b-bc8b-5d72-e7a3" name="Frozen Cogs Bike Squad" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="0985-f50a-8e20-da9a" name="Bikes &amp; Jetbikes" targetId="70f4-8323-e145-4b4b" hidden="false" primary="true"/><categoryLink id="284c-6f56-3bec-2887" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="ae0d-fc89-cb77-007e" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="31de-deb8-8b89-d8d4" name="Frozen Cogs Bike Squad" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">12"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="8ca1-021d-156f-b504" name="Ride the Flank" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If the unit made a Normal Move, once per Shooting phase it can reroll one Hit roll against a target within 12 inches .</characteristic></characteristics></profile><profile id="d421-d2ac-8cd5-631e" name="Role and doctrine" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Firstborn rapid assault and flanking fire; allocation: 8th Rapid Assault / 6th Reserve</characteristic></characteristics></profile><profile id="bbb2-71ea-01b8-bfe7" name="Restricted specialist allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Up to one specialist rider_gun choice per full 3 models. Specialist options: Rider flamer, Rider meltagun, Rider plasma gun. Native catalogue cross-model enforcement requires a New Recruit check.</characteristic></characteristics></profile><profile id="d20c-7cdd-0bb2-212a" name="Homebrew development status" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All new weapons, points, capacities, arrival rules and effects are preliminary homebrew and not verified against current official 40k or native New Recruit importing.</characteristic></characteristics></profile><profile id="3170-4d7a-aac3-7187" name="Squad complement" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">3–6 riders. Exactly one Sergeant.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="2997-946e-1a7c-2a3f" name="Frozen Cogs Bike Squad Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="33"/></costs><constraints><constraint id="c249-ae78-9c5b-6c77" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="ef01-9cb9-3159-61c3" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="46a1-49f4-b676-1da5" name="Per-rider weapon" hidden="false" defaultSelectionEntryId="7e3f-9c8f-f5d8-e4f8"><constraints><constraint id="6ea0-f179-b195-3e47" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="38cc-28e2-9dce-9f6c" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="7e3f-9c8f-f5d8-e4f8" name="Twin-linked bolter" type="upgrade" hidden="false"><profiles><profile id="c56a-c343-0569-160e" name="Twin-linked bolter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Rapid Fire 2, Twin-linked</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="2668-f603-8955-d34d" name="Rider flamer" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="8"/></costs><profiles><profile id="f220-93ba-1941-