b021-ea39-4b91-fe3d" name="Shatterglass Resonators" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="6532-2d55-8876-f25a" name="Harmonic Conclave" targetId="1186-3015-8b1c-a8a3" hidden="false" primary="true"/><categoryLink id="0994-8893-9ee1-4ea2" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="9442-7db6-ce25-2603" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="205b-553b-47c0-3e05" name="Shatterglass Resonators" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="61c2-9a96-bbde-d313" name="Resonance Fracture" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">When this unit selects a FORTIFICATION or VEHICLE with sonic ranged weapons, it may reroll one Wound roll for its attacks that phase .</characteristic></characteristics></profile><profile id="643d-5e4c-bd03-5616" name="Harmonic Breach" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">After this unit disembarks from a transport, one model can reroll one ranged Hit this turn .</characteristic></characteristics></profile><profile id="a9ee-b4d9-554c-4540" name="Role and formation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Sonic demolition and fortified-position cracking; 2nd Siege Assault / Harmonic Conclave</characteristic></characteristics></profile><profile id="a1b3-6575-eca4-7f03" name="Equipment guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew. Costs, stats and new abilities are homebrew. Not balanced or New Recruit import-tested. Specialist allocation is independently checked in offline editor; native New Recruit cross-model enforcement requires an in-app check.</characteristic></characteristics></profile><profile id="95dd-4648-12d5-2768" name="Specialist allocation: main" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">1 permitted per FULL 5 models among options: Sonic blastmaster; checked in offline editor, native XML may not enforce the shared squad cap.</characteristic></characteristics></profile><profile id="e58e-4652-8a66-0ebc" name="Squad complement" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Exactly one squad lead/controller plus 4–9 squad members.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="30cf-b6ac-5d14-10fa" name="Lead Artisan / Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="31"/></costs><constraints><constraint id="d92e-3e45-284d-607a" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="6bbb-6269-d348-82d7" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="e709-55b3-085f-c2fc" name="Sonic breaching gun" hidden="false" de