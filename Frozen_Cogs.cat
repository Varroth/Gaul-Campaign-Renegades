</selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="1320-4592-99a0-2171" name="Frostline Combat Engineers" type="unit" hidden="false" import="true"><constraints><constraint id="a9ee-235c-ead1-5525" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><categoryLinks><categoryLink id="b35f-64b6-1d95-9c9e" name="Combat Engineers" targetId="7d07-115c-5f16-4c3b" hidden="false" primary="true"/><categoryLink id="7126-50df-492c-9b10" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/><categoryLink id="a210-e0a7-4f42-de6a" name="Infantry" targetId="d640-7a85-a199-c350" hidden="false" primary="false"/></categoryLinks><profiles><profile id="2c63-1cfc-1e99-b317" name="Frostline Combat Engineers" typeId="0cb1-7394-fb88-5322" typeName="Unit" hidden="false"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="194e-8272-5f31-aba2" name="Fieldwork Orders" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the end of your Movement phase, if this unit is not within Engagement Range of an enemy and did not Advance, choose one: (1) Prepare Cover — until your next Movement phase a single friendly Frozen Cogs INFANTRY unit wholly within 3" of this squad has Benefit of Cover; (2) Lay Tripwires — until your next Movement phase the first enemy unit that declares a charge against this squad suffers -1 to its Charge roll. These effects do not stack from multiple Frostline units.</characteristic></characteristics></profile><profile id="2567-bf40-3110-9407" name="Combat Repairs" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle round at the end of your Movement phase, if this unit is within 3" of a friendly Frozen Cogs VEHICLE or WALKER and did not Advance, that model regains 1 lost wound. A model can benefit from Combat Repairs only once per round across all Frostline units.</characteristic></characteristics></profile><profile id="5e26-c7b8-a1ba-9df2" name="Roster constraints and timing" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">5–10 total models including one Frostline Engineer-Sergeant; {"special_per_five": 1, "heavy_per_ten": 1, "gear_per_five": 1}. Per-model costs and allowances apply; native cross-model constraints pending actual New Recruit import/verification. Use the listed homebrew statistics; no battle simulations.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="7646-e404-ffc5-a0db" name="Frostline Engineer-Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="26"/></costs><constraints><constraint id="f598-07d4-46b2-86ca" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="b8ba-5d6c-73ad-ce35" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="2760-cbec-8c4a-fb27" name="Armor pattern" hidden="false" defaultSelectionEntryId="5357-aaee-1b22-e9c9"><constraints><constraint id="82a1-9b8a-23c7-abff" type="min" val