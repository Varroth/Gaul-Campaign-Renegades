pe="max" value="1" field="selections" scope="parent" shared="true" id="1c34-09db-77ad-8013"/></constraints><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="aafc-5b07-94cd-5547" name="Heavy bolter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">5</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Sustained Hits 1</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="f9a6-71dc-1d7e-91fd" name="Rotary suppressor" type="upgrade" hidden="false"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ec6f-f370-ab50-61d5"/></constraints><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="20"/></costs><profiles><profile id="9c37-c7d6-c063-384c" name="Rotary suppressor" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">30"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">5</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Sustained Hits 1</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="7b25-4af6-4717-6061" name="Melee weapon" hidden="false" defaultSelectionEntryId="6bd9-894b-f1c2-4e68"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="6b8e-51de-b51a-135d"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9c19-7dde-c0b6-274e"/></constraints><selectionEntries><selectionEntry id="6bd9-894b-f1c2-4e68" name="Combat blade" type="upgrade" hidden="false"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="eb1c-2741-8139-21df"/></constraints><profiles><profile id="c272-64b9-3f3b-ea81" name="Combat blade" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="10b1-c3c0-fd70-1205" name="Frostglass observer equipment" hidden="false"><constraints><constraint type="min" value="0" field="selections" scope="parent" shared="true" id="689d-e009-efd8-5f3b"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c9b3-3509-9dab-9526"/></constraints><selectionEntries><selectionEntry id="6067-da3e-41ef-da89" name="Frostglass Observer optic suite" type="upgrade" hidden="false"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5493-3142-f128-92fe"/></constraints><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="f807-21bc-995e-6592" name="IceBreaker Breachers" type="unit" hidden="false" import="true"><constraints><constraint id="c718-e354-3d59-5414" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><categoryLinks><categoryLink id="e253-b096-001b-921d" targetId="92bc-f579-7dc3-c5db" name="Siege Assault" hidden="false" primary="true"/><categoryLink id="5b6f-475d-6e12-9c5a" targetId="e5e4-dd08-6ce4-34b7" name="Frozen Cogs" hidden="false" primary="false"/><categoryLink id="107f-6d60-f6ea-6977" targetId="d640-7a85-a199-c350" name="Infantry" hidden="false" primary="false"/></categoryLinks><profiles><profile id="91b6-d497-dfbf-aa98" name="IceBreaker Breachers" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="5a52-ebdf-2521-1c74" name="Mandatory Reinforced IceBreaker boarding shield" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Mandatory on every model; included 5+ invulnerable save; cannot be exchanged for an extra gun or melee weapon. Shields and firearms are mounted/handled by Chapter-certified forearm assemblies.</characteristic></characteristics></profile><profile id="588b-8916-2078-5027" name="Breach Momentum" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Maintain 0–2 Momentum counters. Once per battle round, gain 1 counter when the unit ends a Normal/Advance move within 6" of an objective controlled by the opponent at the start of that phase, or completes a Charge move against an enemy within 6" of an objective. A unit cannot gain two counters in one battle round from these events. Counters are lost if this unit is destroyed.</characteristic></characteristics></profile><profile id="4618-e6e6-bec2-4c48" name="Shield Drive" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of your Shooting phase spend 1 Momentum: this unit’s non-Pistol bolt weapons gain Assault until end of phase; attacks against enemy units within 6" of an objective Ignore Cover. Does not give another shot from a single weapon.</characteristic></characteristics></profile><profile id="4783-cfef-3338-ff13" name="Breach &amp; Clear" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of the Fight phase spend 1 Momentum: improve Wound rolls by 1 for this unit’s melee attacks against enemies contesting an objective this phase (respect modifier cap).</characteristic></characteristics></profile><profile id="924d-6d1e-6234-6642" name="Secure the Foothold" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of your Command phase spend 1 Momentum, if this unit controls an objective: its models have OC 2 until your next Command phase or it ceases to control that objective. This is not a permanent defensive bonus.</characteristic></characteristics></profile><profile id="fb6a-98f4-7eec-5d2d" name="Shield Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">IceBreaker boarding shields are mandatory; they provide the Invulnerable characteristic in the unit profile. This unit may fire its equipped primary weapon while retaining its shield; one primary firearm and one melee weapon per model. It may fire only one profile of any combi-weapon each time that weapon shoots.</characteristic></characteristics></profile><profile id="eda7-4b0b-c3c0-e68d" name="Breach Load" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each Frostforged Breaching Shotgun makes 1 additional attack when its target is INFANTRY within 6"; unchanged from the user-approved design direction.</characteristic></characteristics></profile><profile id="0b97-a2d6-ea05-2830" name="Breaching Charges" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each purchased charge can be used only once per battle. Multiple charges on one enemy do not stack their Armor Penetration effect.</characteristic></characteristics></profile><profile id="b699-9fd3-e75a-9648" name="Squad legality" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">5–10 models including exactly one IceBreaker Breach-Sergeant; complete five-model groups set all per-five allowances. Cross-model caps and all role validation should be checked using included Python validator until native import testing is completed. Breach-Sergeant uses same primary gun, melee and optional charge choices; his inclusion does not increase per-five allowances. No named Leader attachment is authorized until those character datasheets explicitly grant permission.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="d6bb-d3e3-b5c3-709c" name="IceBreaker Breach-Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="25"/></costs><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="266a-2d57-cfa4-2aa2"/><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="e525-c819-0315-9bfd"/></constraints><profiles><profile id="e476-0a5e-2018-4f47" name="Issued mandatory shield" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Reinforced IceBreaker boarding shield. Cannot be replaced or removed; its effect is already included in the unit characteristic profile.</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="e756-f086-f72b-fb7f" name="Armor pattern" hidden="false" defaultSelectionEntryId="bcca-a19e-b02c-3e08"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="b098-f521-3957-2eb5"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c6de-272f-3b0c-2a97"/></constraints><selectionEntries><selectionEntry id="bcca-a19e-b02c-3e08" name="Mk III" type="upgrade" hidden="false"/><selectionEntry id="5727-865c-73ae-0a1e" name="Mk IV" type="upgrade" hidden="false"/><selectionEntry id="7795-d885-0c78-6d16" name="Mk V" type="upgrade" hidden="false"/><selectionEntry id="4174-ff38-bb3b-aae8" name="Mk VI" type="upgrade" hidden="false"/><selectionEntry id="f4cf-0f30-7442-900e" name="Mk VII" type="upgrade" hidden="false"/><selectionEntry id="f25b-f2b4-85bb-b82f" name="Mk VIII" type="upgrade" hidden="false"/></selectionEntries></selectionEntryGroup><selectionEntryGroup id="c036-568d-54a4-8716" name="Primary ranged weapon" hidden="false" defaultSelectionEntryId="d95f-2e25-32df-29f4"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="c28f-6626-49fe-518f"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f7ad-a0de-4594-a67b"/></constraints><selectionEntries><selectionEntry id="d95f-2e25-32df-29f4" name="Boltgun" type="upgrade" hidden="false"><profiles><profile id="3029-93c3-993e-447b" name="Boltgun" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Rapid Fire 1</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="6602-18bd-888c-a342" name="Combi-bolter" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="5"/></costs><profiles><profile id="0918-bbe2-5a53-868d" name="Combi-bolter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Twin-linked</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="f3c1-714f-b529-72df" name="Frostforged Breaching Shotgun" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="5"/></costs><profiles><profile id="b1d0-05db-03d5-6b9f" name="Frostforged Breaching Shotgun" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">5</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Assault; Breach Load</characteristic></characteristics></profile><profile id="ebbc-e2e3-3d41-acd2" name="Firing note — Frostforged Breaching Shotgun" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Breach Load: +1 attack against INFANTRY within 6", not +1 attack per model in target.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="3707-98de-0c4c-93d1" name="Bolt pistol" type="upgrade" hidden="false"><profiles><profile id="fccd-b78b-be09-e4a9" name="Bolt pistol" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">1</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Pistol</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="9646-1c1a-3cb5-e50e" name="Combi-flamer — bolt mode" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="3582-f808-5888-31f6" name="Combi-flamer — bolt mode" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">One weapon; choose bolt OR special mode</characteristic></characteristics></profile><profile id="49c1-b67f-b02d-1d0c" name="Firing note — Combi-flamer — bolt mode" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">special mode 12", A D3, BS —, S4, AP0, D1, Torrent</characteristic></characteristics></profile><profile id="46cb-4629-24e6-46ec" name="Combi-flamer — specialist mode" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">D3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">—</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteris