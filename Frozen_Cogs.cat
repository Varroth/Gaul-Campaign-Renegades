 primary="false"/><categoryLink id="8c44-353b-039d-e73f" name="Infantry" targetId="d640-7a85-a199-c350" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="ee58-64a7-f801-3e03" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="4e22-6402-2d5e-e914" name="Frozen Cogs Company Champion" typeId="0cb1-7394-fb88-5322" typeName="Unit" hidden="false"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">4</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="d336-20ef-08ea-aa54" name="Challenge in Iron" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">While leading a unit, once per Fight phase re-roll one Hit roll against an enemy CHARACTER unit.</characteristic></characteristics></profile><profile id="b593-7eb1-62b6-0cfa" name="Company Shield" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Cannot attach to a unit that already has a Leader.</characteristic></characteristics></profile><profile id="4a91-f0ec-6a57-7ca7" name="Leader attachment authorization" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">May lead ONLY these bodyguard unit types: Frozen Cogs Assault Squad, Frozen Cogs Vanguard Veterans, IceBreaker Breachers, Frozen Cogs Sternguard Veterans. One attached Leader per bodyguard by default; designated character must be separately included in army roster, no free attached model or extra equipment quotas. Cross-check attachments in offline editor.</characteristic></characteristics></profile><profile id="e1f8-1511-a826-2696" name="Equipment and compatibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">homebrew character points, abilities and weapon profiles; no battle testing performed. Fixed signature weapons remain mandatory; mixed pre-Primaris Firstborn armor patterns supported within each appropriate class.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="a336-b27d-c467-e600" name="Frozen Cogs Company Champion" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="65"/></costs><constraints><constraint id="b378-5886-a90b-6ea9" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="5ebd-10bd-e7ce-461d" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="a561-71ad-c909-b358" name="Armor / pattern" hidden="false" defaultSelectionEntryId="92d9-a8e6-4c90-ff44"><constraints><constraint id="e013-2254-6717-a5a7" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="bfbf-6897-cb67-10f0" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="92d9-a8e6-4c90-ff44" name="Mk II" type="upgrade" hidden="false"/><selectionEntry id="c1b1-c03a-5592-a0a3" name="Mk III" type="upgrade" hidden="false"/><selectionEntry id="9fa6-dc3f-4a43-585a" name="Mk IV" type="upgrade" hidden="false"/><selectionEntry id="d053-3dc1-d3a8-ee2c" name="Mk V" type="upgrade" hidden="false"/><selectionEntry id="e7c6-18d0-0e50-3c7c" name="Mk VI" type="upgrade" hidden="f