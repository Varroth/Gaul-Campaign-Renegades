haracteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">11</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-3</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="1f73-35c1-d6d8-b449" name="Auxiliary gear" hidden="false" defaultSelectionEntryId="6e59-d20b-8129-1d5f"><constraints><constraint id="d515-8967-da6c-a4fb" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="bad1-34db-711c-5439" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="6e59-d20b-8129-1d5f" name="Hardened field kit" type="upgrade" hidden="false"><profiles><profile id="7413-5ee4-20ec-007e" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">No added ability; typical armour/kit issued for task</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="271f-ae2c-3d35-432f" name="Survey beacon" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="12"/></costs><profiles><profile id="0bad-1f1a-9bcc-7d2b" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, one enemy in 24" can be marked for a friendly FROZEN COGS unit to ignore Cover against it for one attack </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="352e-156f-2c8c-dc32" name="Loader mantle" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="8"/></costs><profiles><profile id="dd3f-0599-f696-6b89" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle one model rerolls one ranged Wound against a Vehicle </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="c965-57bf-c333-5242" name="Frostbound Heavy Support Section" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="1ddb-6994-2c62-fd35" name="Frostbound Auxilia" targetId="ba92-31ee-3264-a18e" hidden="false" primary="true"/><categoryLink id="08bf-77db-3823-b313" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="c2a0-615c-f7ba-7a5c" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="719e-0284-fd43-f859" name="Frostbound Heavy Support Section" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">3</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">5+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">1</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="825a-6237-31e6-b68c" name="One Frozen Cogs Army" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROSTBOUND AUXILIA are mortal fighting elements of a Frozen Cogs detachment, not a separate Guard faction. They share FROZEN COGS faction allegiance. Their datasheets do not unlock Astra Militarum Orders, Platoon detachments, Guard stratagems or detachment abilities. </characteristic></characteristics></profile><profile id="fdb2-fc0c-b1ea-9f11" name="Mortal Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Models with FROSTBOUND AUXILIA MORTAL keywords do NOT gain Astartes serum healing, Chapter-level Astartes Feel No Pain, neural-lace mastery, an Obliterator Masterwork, or the special armor abilities of inducted Marines. A unit receives its own printed abilities only. </characteristic></characteristics></profile><profile id="ae60-c518-e0d3-939a" name="Direct Support, Not Orders" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attached optional Frostbound Characters provide only their datasheet abilities. No compulsory officer chain and no separate recurring Orders resource. </characteristic></characteristics></profile><profile id="0607-0837-aec3-a14e" name="Workshop Repair Cap" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each VEHICLE may have lost Wounds restored by only one Frozen Cogs repair source in each friendly turn; mortal medicae can affect only named eligible MORTAL INFANTRY. </characteristic></characteristics></profile><profile id="723e-a574-b957-c0ba" name="Transport Eligibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Auxilia transports may carry FROSTBOUND AUXILIA INFANTRY (including eligible CHARACTERS) only. They never carry Astartes or Terminators unless a future datasheet expressly says so. </characteristic></characteristics></profile><profile id="488b-e3a5-b5ae-30bf" name="Calibrated Barrage" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per Shooting phase a single member rerolls one Hit when Remained Stationary .</characteristic></characteristics></profile><profile id="b629-5165-decb-2f79" name="Roster notice" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew — not official Warhammer 40,000 rules; all profiles and costs homebrew. Native New Recruit combined caps requires an in-app check. Ratio limits are checked in the offline editor; native importer not tested.</characteristic></characteristics></profile><profile id="f146-e375-b43b-d702" name="Force allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Frostbound garrison heavy weapons — Long-range supporting fire, suppressors and specialist guns</characteristic></characteristics></profile><profile id="8f3f-e19b-a31e-e1b5" name="Keywords" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROZEN COGS, FROSTBOUND AUXILIA, MORTAL, CHAOS, INFANTRY</characteristic></characteristics></profile><profile id="1d9c-2739-d344-3395" name="Specialist cap 1" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At most 1 per full 5 models: Tripod heavy bolter, Coldforged autocannon, Auxilia lascannon, Coldline suppression stubber, Rime-pattern heavy flamer; checked offline.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="1510-ef5d-edaa-3827" name="Auxilia member 1" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><constraints><constraint id="9f46-f781-1da5-6b0a" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="40c5-b5cc-84b1-9545" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="193e-7b4d-9ab3-39dd" name="Fire support armament" hidden="false" defaultSelectionEntryId="d75a-a161-b84f-d349"><constraints><constraint id="3274-f92e-31e3-813e" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="904d-cc31-1f34-3213" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="d75a-a161-b84f-d349" name="Frostbound pattern lascarbine" type="upgrade" hidden="false"><profiles><profile id="ce60-0135-f4d8-4d5e" name="Frostbound pattern lascarbine" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">3</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Rapid Fire 1 </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="3a8c-6f5c-5bf5-9e79" name="Tripod heavy bolter" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="12"/></costs><profiles><profile id="829d-ac9a-215a-e2c2" name="Tripod heavy bolter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><