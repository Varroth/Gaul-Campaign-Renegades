nEntry id="02a6-eb81-d1e4-5a83" name="Frostbound Breach Section" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="7c7b-c326-da12-6bb2" name="Frostbound Auxilia" targetId="ba92-31ee-3264-a18e" hidden="false" primary="true"/><categoryLink id="3d26-1857-a444-4cec" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="1704-8beb-f883-97ae" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="5887-20af-9e52-9a8b" name="Frostbound Breach Section" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">3</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">4+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">1</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="7bb1-fc95-d61b-1eb7" name="One Frozen Cogs Army" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROSTBOUND AUXILIA are mortal fighting elements of a Frozen Cogs detachment, not a separate Guard faction. They share FROZEN COGS faction allegiance. Their datasheets do not unlock Astra Militarum Orders, Platoon detachments, Guard stratagems or detachment abilities. </characteristic></characteristics></profile><profile id="56ee-aa8d-03ef-30a2" name="Mortal Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Models with FROSTBOUND AUXILIA MORTAL keywords do NOT gain Astartes serum healing, Chapter-level Astartes Feel No Pain, neural-lace mastery, an Obliterator Masterwork, or the special armor abilities of inducted Marines. A unit receives its own printed abilities only. </characteristic></characteristics></profile><profile id="f43c-9209-92cc-fbd6" name="Direct Support, Not Orders" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attached optional Frostbound Characters provide only their datasheet abilities. No compulsory officer chain and no separate recurring Orders resource. </characteristic></characteristics></profile><profile id="bba8-57fa-40c7-1b00" name="Workshop Repair Cap" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each VEHICLE may have lost Wounds restored by only one Frozen Cogs repair source in each friendly turn; mortal medicae can affect only named eligible MORTAL INFANTRY. </characteristic></characteristics></profile><profile id="e5b5-35d3-70c1-b94a" name="Transport Eligibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Auxilia transports may carry FROSTBOUND AUXILIA INFANTRY (including eligible CHARACTERS) only. They never carry Astartes or Terminators unless a future datasheet expressly says so. </characteristic></characteristics></profile><profile id="378a-fd24-553d-ea2a" name="Controlled Entry" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">After Disembarking from a friendly transport, one member can reroll one Wound roll against an enemy within 12" this turn .</characteristic></characteristics></profile><profile id="50cf-4ff3-8237-e9bc" name="Shield Advance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">This unit retains shields with any chosen weapon. No storm-shield invulnerable save.</characteristic></characteristics></profile><profile id="f1c0-9bae-e917-c061" name="Roster notice" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew — not official Warhammer 40,000 rules; all profiles and costs homebrew. Native New Recruit combined caps requires an in-app check. Ratio limits are checked in the offline editor; native importer not tested.</characteristic></characteristics></profile><profile id="2f22-955c-d10c-31e1" name="Force allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">5th Boarding / Fortress assault auxiliaries — Shielded mortal trench and corridor clearance</characteristic></characteristics></profile><profile id="d7c5-ad76-bd3e-adea" name="Keywords" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROZEN COGS, FROSTBOUND AUXILIA, MORTAL, CHAOS, INFANTRY</characteristic></characteristics></profile><profile id="2710-dd3d-dd3a-7d8a" name="Specialist cap 1" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At most 1 per full 5 models: Pattern-IX flamer, Auxilia melta gun, Auxilia plasma gun; checked offline.</characteristic></characteristics></profile><profile id="9f71-af76-2f45-6233" name="Specialist cap 2" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At most 1 per full 5 models: Demolition kit; checked offline.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="b76e-3d56-854f-a1b4" name="Auxilia member 1" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="13"/></costs><constraints><constraint id="b788-711a-e09d-0b92" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="6674-2cc0-ad48-b630" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="de11-083f-bc55-c55f" name="Breacher weapon" hidden="false" defaultSelectionEntryId="3b81-8656-9a16-6e52"><constraints><constraint id="5577-8752-322f-fa73" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="28e0-d68e-81fe-f941" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="3b81-8656-9a16-6e52" name="Frostbound boarding shotgun" type="upgrade" hidden="false"><profiles><profile id="6175-7549-7f02-f7aa" name="Frostbound boarding shotgun" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Assault; +1 A against INFANTRY within 6" </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a941-f162-faa1-0d01" name="Frostbound pattern lascarbine" type="upgrade" hidden="false"><profiles><profile id="d95d-75b9-60a3-1ecf" name="Frostbound pattern lascarbine" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa