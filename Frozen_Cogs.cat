ral lace" type="upgrade" hidden="false"><profiles><profile id="2dab-bfb9-cb43-39b8" name="Equipment detail" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Approved mechanical fitting</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="4c69-1468-977a-bed0" name="Cold-forge targeting logic" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="cd4b-7df3-d74d-d828" name="Equipment detail" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one Hit roll with one selected ranged weapon .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="066a-3a51-ccd9-1369" name="Frostglass augur sweep" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="8a24-41f7-9a55-5a9d" name="Equipment detail" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At start of your Shooting phase designate one visible target within 18 inches; this vehicle can reroll one ranged Hit against it .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="3dd9-3a67-a5f4-8e0d" name="Frozen Cogs Stormraven Gunship" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="f537-300f-ff62-264f" name="Aircraft &amp; Gunships" targetId="237f-1a28-dc2b-753b" hidden="false" primary="true"/><categoryLink id="1cd2-31be-783a-4df8" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="96cb-826d-6b42-1f92" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="963d-5e08-0e39-ce86" name="Frozen Cogs Stormraven Gunship" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">20–60"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">10</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">16</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">0</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="3f83-16a6-4382-ef6b" name="External Dreadnought Sling" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">May carry one *separately purchased* Frozen Cogs Dreadnought on an external sling, independently of infantry capacity. No automata or walkers; cannot sling a second Dreadnought .</characteristic></characteristics></profile><profile id="586f-b10c-df01-70b5" name="Role and doctrine" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Gunship and Dreadnought external-lift carrier; allocation: Fleet Operators / 1st Ancient Brotherhood</characteristic></characteristics></profile><profile id="3979-3a0d-b511-597f" name="Transport restrictions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Capacity 12 infantry spaces. Terminator models consume 2 spaces. External Dreadnought limit: 1. No Jump Packs, automata, allied factions or embarked vehicles except stated external vehicle gantries. 12 infantry spaces AND up to one external eligible Dreadnought; a Dreadnought cannot be an infantry-space passenger.</characteristic></characteristics></profile><profile id="b189-33d9-37de-9315" name="Homebrew development status" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All new weapons, points, capacities, arrival rules and effects are preliminary homebrew and not verified against current official 40k or native New Recruit importing.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="16eb-d884-2907-d52d" name="Stormraven Gunship" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="270"/></costs><constraints><constraint id="3160-a555-f911-40d5" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="5e26-d45d-2590-c6a5" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="d1ce-51ad-c738-af5c" name="Forward turret" hidden="false" defaultSelectionEntryId="03c7-0745-d1a8-9616"><constraints><constraint id="8c36-1ee2-bf15-6d3a" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="1d90-874a-4acd-e3e5" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="03c7-0745-d1a8-9616" name="Twin assault cannon" type="upgrade" hidden="false"><profiles><profile id="6b47-c61e-2400-87e0" name="Twin assault cannon" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">6</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">6</ch