/characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">8</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Hazardous </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5bfd-c40e-258d-f1ac" name="Auxilia melta gun" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="18"/></costs><profiles><profile id="6fc1-a3c1-e2f4-9638" name="Auxilia melta gun" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">1</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">9</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-4</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">D6</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Melta 2 </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="228a-2dd5-e771-3613" name="Vacuum-rig equipment" hidden="false" defaultSelectionEntryId="233e-b3b0-f290-9a62"><constraints><constraint id="c67b-4853-2a5e-f473" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="044d-1992-ddea-b408" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="233e-b3b0-f290-9a62" name="Sealed void suit" type="upgrade" hidden="false"><profiles><profile id="369e-bc43-6072-c136" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" ty