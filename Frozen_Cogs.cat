><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">The fleet vessel bears its established name and supports sonic troops. This roster is a Frozen Cogs-aligned contingent, not an automatic Emperor’s Children detachment.</characteristic></characteristics></profile><profile id="7d79-5dcf-0c9c-c9f4" name="Rising Crescendo" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per game, during this unit’s Shooting phase, one sonic weapon gains +1 Attack .</characteristic></characteristics></profile><profile id="bc9e-73e1-6ffe-ac05" name="Role and formation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Fleet-associated heavy sonic assault ensemble; Sublime Requim fleet contingent / Conclave</characteristic></characteristics></profile><profile id="c95d-a2c1-786e-9084" name="Equipment guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew. Costs, stats and new abilities are homebrew. Not balanced or New Recruit import-tested. Specialist allocation is independently checked in offline editor; native New Recruit cross-model enforcement requires an in-app check.</characteristic></characteristics></profile><profile id="3e0d-fb57-b05a-eab4" name="Specialist allocation: gun" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">1 permitted per FULL 5 models among options: Sonic blastmaster, Doom siren; checked in offline editor, native XML may not enforce the shared squad cap.</characteristic></characteristics></profile><profile id="1262-7864-e330-0354" name="Lore safeguards" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Confirm any separate non-Chapter allied Noise Marines roster attribution before counting them as additional inducted Astartes.</characteristic></characteristics></profile><profile id="f7a5-33dd-4286-8f94" name="Squad complement" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Exactly one squad lead/controller plus 4–9 squad members.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="95a3-cc7a-e338-1d53" name="Lead Artisan / Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="30"/></costs><constraints><constraint id="ad80-bedc-a29a-ae4b" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="cf57-11d4-e505-2217" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="9a48-5e55-f65c-05c8" name="Noise Marine armament" hidden="false" defaultSelectionEntryId="c715-5663-8c11-90be"><constraints><constraint id="5269-d7ae-3d88-3e16" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="6930-ec74-27d2-5e61" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="c715-5663-8c11-90be" name="Sonic blaster" type="upgrade" hidden="false"><profiles><profile id="6be3-fb6f-c593-fb41" name="Sonic blaster" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">5</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name