aracteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">D6</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Melta 2</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="7732-2e5f-20c9-f4a7" name="Pilot crew" hidden="false" defaultSelectionEntryId="e92c-8a3d-ce8b-2752"><constraints><constraint id="0c32-8287-b2b0-3df6" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="0069-3a35-10ed-86a6" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="e92c-8a3d-ce8b-2752" name="Gudryn — sole aircraft commander" type="upgrade" hidden="false"><profiles><profile id="4280-9faa-d4a6-77e4" name="Equipment detail" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Gudryn is the unique named pilot; no other Gudryn datasheet or duplicate permitted.</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="0de6-58a1-0682-b5df" name="Gudryn + Eligos co-pilot" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="1bd5-66e6-5034-ef21" name="Equipment detail" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Eligos enhances navigation and communications; once per battle reroll one aircraft saving throw .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="2984-c12e-68f0-2780" name="Aerial defensive system" hidden="false" defaultSelectionEntryId="f3ef-c318-74b3-6c81"><constraints><constraint id="9106-06aa-12ea-e3cb" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id