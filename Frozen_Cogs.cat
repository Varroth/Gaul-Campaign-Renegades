aracteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">3</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Pistol </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="2963-c487-e170-3353" name="Frostbound boarding shotgun" type="upgrade" hidden="false"><profiles><profile id="0a4f-5ba6-346b-3a09" name="Frostbound boarding shotgun" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Assault; +1 A against INFANTRY within 6" </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="4c83-1033-926e-d0b1" name="Frostbound Signal &amp; Survey Cell" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="cfd1-8efe-b9e0-a6a0" name="Frostbound Auxilia" targetId="ba92-31ee-3264-a18e" hidden="false" primary="true"/><categoryLink id="4d8a-90a9-b381-be91" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="0ffa-0c63-7522-d9bf" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="2445-b674-981a-f52c" name="Frostbound Signal &amp; Survey Cell" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">3</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">5+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">1</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="19e4-d642-7e2f-0fb0" name="One Frozen Cogs Army" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROSTBOUND AUXILIA are mortal fighting elements of a Frozen Cogs detachment, not a separate Guard faction. They share FROZEN COGS faction allegiance. Their datasheets do not unlock Astra Militarum Orders, Platoon detachments, Guard stratagems or detachment abilities. </characteristic></characteristics></profile><profile id="643b-ae57-5e47-3e44" name="Mortal Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Models with FROSTBOUND AUXILIA MORTAL keywords do NOT gain Astartes serum healing, Chapter-level Astartes Feel No Pain, neural-lace mastery, an Obliterator Masterwork, or the special armor abilities of inducted Marines. A unit receives its own printed abilities only. </characteristic></characteristics></profile><profile id="cd7e-0a67-1347-ebf1" name="Direct Support, Not Orders" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attached optional Frostbound Characters provide only their datasheet abilities. No compulsory officer chain and no separate recurring Orders resource. </characteristic></characteristics></profile><profile id="0b74-5267-5f05-891e" name="Workshop Repair Cap" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each VEHICLE may have lost Wounds restored by only one Frozen Cogs repair source in each friendly turn; mortal medicae can affect only named eligible MORTAL INFANTRY. </characteristic></characteristics></profile><profile id="dead-889e-2b8b-8756" name="Transport Eligibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Auxilia transports may carry FROSTBOUND AUXILIA INFANTRY (including eligible CHARACTERS) only. They never carry Astartes or Terminators unless a future datasheet expressly says so. </characteristic></characteristics></profile><profile id="a975-c062-2f6a-38bb" name="Bounded Support" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per friendly Shooting phase choose one visible enemy within 24". One friendly FROSTBOUND AUXILIA unit rerolls one ranged Hit against that target .</characteristic></characteristics></profile><profile id="1b8c-c267-e239-4cbe" name="Roster notice" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew — not official Warhammer 40,000 rules; all profiles and costs homebrew. Native New Recruit combined caps requires an in-app check. Ratio limits are checked in the offline editor; native importer not tested.</characteristic></characteristics></profile><profile id="121c-a16f-aa76-4378" name="Force allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Signal vault and expeditionary columns — Artillery spotting, target confirmation and vox relay</characteristic></characteristics></profile><profile id="7e6a-5775-2961-8fef" name="Keywords" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROZEN COGS, FROSTBOUND AUXILIA, MORTAL, CHAOS, INFANTRY</characteristic></characteristics></profile><profile id="72b9-12c5-e18a-910a" name="Specialist cap 1" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At most 1 per full 5 models: Survey beacon, Triangulated firefinder; checked offline.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="052a-01d1-faee-6f56" name="Auxilia member 1" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="19"/></costs><constraints><constraint id="5d9d-9e64-ae9c-87b9" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="b07d-a71f-7660-6e6d" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="0353-9ad0-621f-9c22" name="Technician weapon" hidden="false" defaultSelectionEntryId="8d53-a4cb-5460-7553"><constraints><constraint id="6601-2653-54cb-e629" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="3088-ab1a-8bcd-079c" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="8d53-a4cb-5460-7553" name="Frostbound pattern lascarbine" type="upgrade" hidden="false"><profiles><profile id="d8c3-da44-3ea4-4005" name="Frostbound pattern lascarbine" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">3</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Rapid Fire 1 </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="5dae-9aee-0cea-efa2" name="Deck-clearing autopistol" type="upgrade" hidden="false"><profiles><profile id="394b-8115-4ed2-4c73" name="Deck-clearing autopistol" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">12"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">3</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Pistol </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c6f7-ad68-23d5-11ab" name="Coldline autogun" type="upgrade" hidden="false"><profiles><profile id="3f54-6935-dc4f-d589" name="Coldline autogun" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">3</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Assault </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="a20d-4fc1-e11b-ed11" name="Survey marksman rifle" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="5"/></costs><profiles><profile id="7eee-82ce-75e9-8f74" name="Survey marksman rifle" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">30"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">4</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Heavy, Precision </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="7d3e-0174-e2cd-182a" name="Survey appliance" hidden="false" defaultSelectionEntryId="8271-08d6-f14e-8582"><constraints><constraint id="dc16-8757-805b-e309" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="2499-a3dd-bb99-6261" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="8271-08d6-f14e-8582" name="Track and sensor suite" type="upgrade" hidden="false"><profiles><profile id="dd78-761a-6449-55aa" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Standard survey-grade equipment</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="e772-09c0-82e6-4f5a" name="Survey beacon" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="12"/></costs><profiles><profile id="6b70-f2eb-4550-0433" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, one enemy in 24" can be marked for a friendly FROZEN COGS unit to ignore Cover against it for one attack </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="c653-9d11-100b-c1b9" name="Triangulated firefinder" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="71eb-fcd0-88c0-9f8b" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle ignore one indirect-fire penalty for an allied FROSTBOUND artillery weapon </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="576a-b405-ff05-1069" name="Comms drill" hidden="false" defaultSelectionEntryId="2221-6962-ff94-e9ce"><constraints><constraint id="a355-e216-66cc-34cc" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="1c36-b9f7-20e8-5947" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="2221-6962-ff94-e9ce" name="Coded Relay" type="upgrade" hidden="false"><profiles><profile id="741f-0fcd-3c61-3b08" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reroll one failed Battle-shock test within 6" for a MORTAL unit .</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="f804-83ef-93e7-799c" name="Silent Vox" type="upgrade" hidden="false"><profiles><profile id="7e52-cb06-f2c3-50a6" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle one member counts as Stealth for an enemy Shooting phase .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="e646-36fa-9b7a-d406" name="Internal squad NCO" hidden="false" defaultSelectionEntryId="22e4-ba93-fbc1-23a3"><constraints><constraint id="fc97-ca2c-46c4-110c" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="87c6-fafe-9d6c-572e" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="22e4-ba93-fbc1-23a3" name="Squad leader comm bead" type="upgrade" hidden="false"><profiles><profile id="fcf3-be5a-f5e1-ffa6" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">One per section, issued to first model; no separate officer-chain or Orders system</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="aead-5b86-1980-c597" name="Veteran section leader" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="5"/></costs><profiles><profile id="61e7-e686-2ab1-b166" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle this squad may reroll a failed Battle-shock test </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="84c9-80d6-68fb-820d" name="Auxilia member 2" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="19"/></costs><constraints><constraint id="b28f-19b5-9c1d-6990" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="5023-5a9f-eca6-a714" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="948a-2421-da32-6add" name="Technician weapon" hidden="false" defaultSelectionEntryId="fef6-8211-038e-2f75"><constraints><constraint id="9db5-e1c5-f8f6-cf5a" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="86bf-e41e-d8d0-79fe" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="fef6-8211-038e-2f75" name="Frostbound pattern lascarbine" type="upgrade" hidden="false"><profiles><profile id="4c63-ca13-8822-838e" name="Frostbound pattern lascarbine" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">24"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">2</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">3</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">0</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Rapid Fire 1 </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="8b3c-49ba-6746-2140" name="Deck-clearing autopistol" type="upgrade" hidden="false"><profiles><profile id="6ec2-7ef6-4e47-58a5" name="Deck-clearing autopistol" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name=