ty"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Anti-infantry barrage; physical shrapnel and airburst, not a supernatural blizzard.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="a87f-6a95-4b69-8555" name="Frozen Cogs Tactical Squad" type="unit" hidden="false" import="true"><constraints><constraint id="fc90-de36-0665-534d" type="max" field="selections" scope="roster" value="6" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><categoryLinks><categoryLink id="7326-566e-c507-968a" name="Battleline" targetId="6d1a-80e9-0be4-0c2e" hidden="false" primary="true"/><categoryLink id="923e-384c-e1e2-1734" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/><categoryLink id="78f7-f831-7af3-447c" name="Infantry" targetId="d640-7a85-a199-c350" hidden="false" primary="false"/></categoryLinks><profiles><profile id="8b90-5aff-0664-1220" name="Frozen Cogs Tactical Squad" typeId="0cb1-7394-fb88-5322" typeName="Unit" hidden="false"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="e91f-a281-a87d-d930" name="Layered Fire Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of the Shooting phase choose one visible target within 24" of an eligible squad member. Once during that phase, re-roll one Hit roll for a ranged attack targeting that unit. If the squad controls an objective, re-roll one Wound roll instead; these choices are mutually exclusive.</characteristic></characteristics></profile><profile id="0cf5-29d3-46b0-b1be" name="Hold the Line" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">While this unit controls an objective, it may ignore one enemy effect that would worsen its Objective Control characteristic once per battle round; does not confer immunity to Battle-shock.</characteristic></characteristics></profile><profile id="503c-539b-4595-eb55" name="Roster constraints and timing" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">5–10 total models including one Tactical Sergeant; {"special_per_five": 1, "heavy_per_ten": 1, "no_sergeant_special_or_heavy": true}. Per-model costs and allowances apply; native cross-model constraints pending actual New Recruit import/verification. Use the listed homebrew statistics; no battle simulations.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="239e-d40d-cfa7-b621" name="Tactical Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="21"/></costs><constraints><constraint id="c1b5-0f2b-6890-6833" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="a76e-bf00-8980-0045" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="4930-7278-85c2-3513" name="Armor pattern" hidden="false" defaultSelectionEntryId="c61b-ed9a-0de9-a58e"><constraints><constraint id="6655-0407-bcb0-70de" type="min" value="1" field="selections" scope="parent" shared="true"/><c