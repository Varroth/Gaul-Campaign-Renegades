8-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">4</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="0bd2-4f91-fa21-9a90" name="Field-Grown Adaptation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle round, while leading Combat Engineers, a friendly vehicle repair attempt may re-roll one die.</characteristic></characteristics></profile><profile id="e20d-7b69-b11d-0eb1" name="Under Instruction" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Technical expertise does not place Tarrax above the established senior Forge leadership.</characteristic></characteristics></profile><profile id="8d5d-82c9-6c47-95d1" name="Leader attachment authorization" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">May lead ONLY these bodyguard unit types: Frostline Combat Engineers, Sacred Forge Tactical Support Squad. One attached Leader per bodyguard by default; designated character must be separately included in army roster, no free attached model or extra equipment quotas. Cross-check attachments in offline editor.</characteristic></characteristics></profile><profile id="c766-a690-0a6d-8d9c" name="Equipment and compatibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">homebrew character points, abilities and weapon profiles; no battle testing performed. Fixed signature weapons remain mandatory; mixed pre-Primaris Firstborn armor patterns supported within each appropriate class.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="318e-def6-462e-7dc5" name="Tarrax Taclimor — Green Thumb" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="85"/></costs><constraints><constraint id="870a-03d8-ee61-4b52" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="5c20-378d-1d69-0c8a" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="1722-e7f8-5246-86b6" name="Armor / pattern" hidden="false" defaultSelectionEntryId="8a1b-ae41-4f39-8fed"><constraints><constraint id="0e33-a26e-c5ff-9478" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="966c-f276-98e2-fed2" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="8a1b-ae41-4f39-8fed" name="Mk II" type="upgrade" hidden="false"/><selectionEntry id="aedd-5ea3-686c-7a3e" name="Mk III" type="upgrade" hidden="false"/><selectionEntry id="d6de-8a12-0ef3-c600" name="Mk IV" type="upgrade" hidden="false"/><selectionEntry id="6804-2a27-172e-c602" name="Mk V" type="upgrade" hidden="false"/><selectionEntry id="d77d-2e1f-a101-2d59" name="Mk VI" type="upgrade" hidden="false"/><selectionEntry id="249f-9d28-b6da-5ec3" name="Mk VII" type="upgrade" hidden="false"/><selectionEntry id="8964-d13b-c578-0ae3" name="Mk VIII" type="upgrade" hidden="false"/></selectionEntries></selectionEntryGroup><selectionEntryGroup id="dc3c-cb4a-fec5-2f4b" name="Ranged weapon" hidden="false" defaultSelectionEntryId="5ad6-6fe4-8606-3215"><constraints><constraint id="e9db-b49d-e53e-f5c4" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="5b45-7538-672b-f4cd" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><sele