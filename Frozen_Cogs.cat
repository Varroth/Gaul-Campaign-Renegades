ion" typeId="4c71-0d90-3b92-5cec">No extra benefit</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="bfb2-10b0-b74f-12b0" name="Smoke projection battery" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="8"/></costs><profiles><profile id="9d4c-f283-603e-f51e" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle, gain Benefit of Cover until end of enemy Shooting phase </characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="99cd-6f8c-154e-fa92" name="Secure relay aerial" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="6343-2f86-865d-0af1" name="Equipment effect" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle one nearby MORTAL unit rerolls a failed Battle-shock test </characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="f6e4-e2de-d986-7c1b" name="Frostbound Siege Carrier" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="dc1a-5aa5-6727-5f46" name="Frostbound Auxilia" targetId="ba92-31ee-3264-a18e" hidden="false" primary="true"/><categoryLink id="9b0d-7e9c-e80b-53bc" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="c7ce-8121-a77e-d5af" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="2a28-5c1a-f962-85d3" name="Frostbound Siege Carrier" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic n