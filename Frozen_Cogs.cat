ectionEntries></selectionEntry><selectionEntry id="f4c8-c4af-c4f1-1d80" name="Frostbound Mortar Battery" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="553e-fba7-365a-320e" name="Frostbound Auxilia" targetId="ba92-31ee-3264-a18e" hidden="false" primary="true"/><categoryLink id="f14e-96de-efaa-2668" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="dd10-46a2-4a6f-2388" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="bb34-1d87-b948-1d01" name="Frostbound Mortar Battery" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">4"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">7</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">4+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">7</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="f71a-ae60-dd8c-0199" name="One Frozen Cogs Army" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROSTBOUND AUXILIA are mortal fighting elements of a Frozen Cogs detachment, not a separate Guard faction. They share FROZEN COGS faction allegiance. Their datasheets do not unlock Astra Militarum Orders, Platoon detachments, Guard stratagems or detachment abilities. </characteristic></characteristics></profile><profile id="6636-0951-86e0-7f68" name="Mortal Discipline" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Models with FROSTBOUND AUXILIA MORTAL keywords do NOT gain Astartes serum healing, Chapter-level Astartes Feel No Pain, neural-lace mastery, an Obliterator Masterwork, or the special armor abilities of inducted Marines. A unit receives its own printed abilities only. </characteristic></characteristics></profile><profile id="3a9f-2921-eabf-b63d" name="Direct Support, Not Orders" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Attached optional Frostbound Characters provide only their datasheet abilities. No compulsory officer chain and no separate recurring Orders resource. </characteristic></characteristics></profile><profile id="330c-c0a7-9a3a-3eb7" name="Workshop Repair Cap" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Each VEHICLE may have lost Wounds restored by only one Frozen Cogs repair source in each friendly turn; mortal medicae can affect only named eligible MORTAL INFANTRY. </characteristic></characteristics></profile><profile id="bf99-9427-dd1b-dc89" name="Transport Eligibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Auxilia transports may carry FROSTBOUND AUXILIA INFANTRY (including eligible CHARACTERS) only. They never carry Astartes or Terminators unless a future datasheet expressly says so. </characteristic></characteristics></profile><profile id="ca57-5be8-ca1a-9052" name="Registered Fire" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If friendly Signal &amp; Survey Cell has spotted target this turn, once per battle reroll one Attack-count dice for this battery .</characteristic></characteristics></profile><profile id="260b-bf04-a85a-5a63" name="Roster notice" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew — not official Warhammer 40,000 rules; all profiles and costs homebrew. Native New Recruit combined caps requires an in-app check. Ratio limits are checked in the offline editor; native importer not tested.</characteristic></characteristics></profile><profile id="cc26-6931-8b32-3624" name="Force allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Auxilia siege artillery — Indirect fire support for objective sieges</characteristic></characteristics></profile><profile id="d26c-9ccb-abd3-f8fb" name="Keywords" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">FROZEN COGS, FROSTBOUND AUXILIA, MORTAL, CHAOS, ARTILLERY</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="4d8b-bf36-9344-7aa9" name="Auxilia member 1" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="85"/></costs><constraints><constraint id="fcdd-4833-f9b9-b7c9" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="e529-fa84-980f-4e38" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="32dc-3d15-c24e-ab90" name="Mortar tube" hidden="false" defaultSelectionEntryId="61fa-af17-5268-a2e3"><constraints><constraint id="2560-87c4-4844-55c7" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="7bae-c58a-09e5-a5ad" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="61fa-af17-5268-a2e3" name="Frostbound heavy mortar" type="upgrade" hidden="false"><profiles><profile id="6ee6-6eb5-bbd1-a8b2" name="Fros