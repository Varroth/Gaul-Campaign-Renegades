iguration" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle reduce one unsaved attack Damage by 1, minimum 1 .</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="703e-fa11-e330-9452" name="Frozen Cogs Mastodon Heavy Assault Carrier" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="7004-137c-1867-1b3c" name="Relic Super-heavy Vehicles" targetId="875f-19bf-1f26-b617" hidden="false" primary="true"/><categoryLink id="9b53-3588-6b13-b97e" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="5a56-3803-7cb4-56eb" type="max" value="1" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="a507-0865-5551-9225" name="Frozen Cogs Mastodon Heavy Assault Carrier" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">8"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">14</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">30</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">8</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="c8ae-776e-ac27-300f" name="Grand Assault Ramps" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Passengers may charge after disembarking after this model makes a Normal Move (homebrew).</characteristic></characteristics></profile><profile id="ed28-ac78-ae5d-9aad" name="Mass Siege Deployment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per battle up to two embarked units may disembark at the end of a Normal Move; neither may shoot that turn .</characteristic></characteristics></profile><profile id="7faf-5f77-8a8c-4eda" name="Transport capacity and permitted passengers" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Carry up to 40 infantry spaces. A standard non-Jump Pack Firstborn infantry model occupies 1 space. A Terminator-armored model occupies 2 spaces. Every attached Leader occupies space as appropriate. Dreadnoughts, vehicles, automata, jetbikes, aircraft, non-Frozen-Cogs allies unless separate alliance transport rule permits them. Carries only eligible infantry; no Dreadnought transport in this homebrew.</characteristic></characteristics></profile><profile id="8969-8c6d-526a-868d" name="Chassis role" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Ultra-heavy Firstborn mass-assault carrier; assignment: Chapter-level siegebreaker transport pool</characteristic></characteristics></profile><profile id="c226-bb6d-c083-5ec7" name="Roster status" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">New weapon profiles, transport limits and special rules are homebrew homebrew design, not verified official datasheet. No balance simulations or native New Recruit import verification.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="9d06-5842-f68d-0fcb" name="Mastodon Heavy Assault Carrier" type="model" hidden="false"><costs><cost name="pts" type