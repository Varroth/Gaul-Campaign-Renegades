ammer" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="00ea-985d-e759-36f9" name="Wardbreaker thunder hammer" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">4+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">10</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">3</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry><selectionEntry id="799a-bac8-25ff-1fbd" name="Guardian power glaive" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="10"/></costs><profiles><profile id="9266-77b2-249f-1859" name="Guardian power glaive" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">Melee</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">4</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">6</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">Precision</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="a704-50f2-af46-648a" name="Optional Winterguard shieldlink relay" hidden="false" defaultSelectionEntryId="3593-94fd-6cf4-1933"><constraints><constraint id="2efa-7353-79d9-777f" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="0b2e-7c11-9859-4d09" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="3593-94fd-6cf4-1933" name="None" type="upgrade" hidden="false"/><selectionEntry id="81d1-dafa-18f4-e6c5" name="Winterguard shieldlink relay" type="upgrade" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="15"/></costs><profiles><profile id="0fd0-2848-a268-2052" name="Winterguard shieldlink relay — equipment" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Optional ward-lattice extension; increases Escort stance ally selection range from 6" to 9" for one declared allied unit, without stacking multiple relays.</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="6ed3-497f-2cf0-11ae" name="Rimeguard Automata" type="unit" hidden="false" import="true"><constraints><constraint id="e800-1e6a-b6e0-533f" type="max" field="selections" scope="roster" value="3" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="true"/></constraints><categoryLinks><categoryLink id="8b15-67fa-072d-7f47" targetId="468e-98fe-33b9-74ff" name="Automata" hidden="false" primary="true"/><categoryLink id="3b17-c8e1-a4a5-75ed" targetId="e5e4-dd08-6ce4-34b7" name="Frozen Cogs" hidden="false" primary="false"/></categoryLinks><profiles><profile id="1bca-4eee-f2b7-d14d" name="Rimeguard Automata" typeId="0cb1-7394-fb88-5322" typeName="Unit" hidden="false"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">9</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">2+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">8</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">7+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">5+</characteristic></characteristics></profile><profile id="d03c-03d6-0e9c-d26e" name="Mandatory Integrated ward plating" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Mandatory reinforced ward plating; its 5+ invulnerable save is built into the profile. Not a removable shield.</characteristic></characteristics></profile><profile id="dd16-da63-a173-cf77" name="Iron Firewall" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Rimeguard Automata operate autonomously through the Frozen Cogs iron firewall; no attached character is required to use the unit. They are automata, not daemon engines, and do not receive Astartes-only Infantry or biological serum abilities.</characteristic></characteristics></profile><profile id="7acc-4ab7-68f9-8f96" name="Sentinel Circuit" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At the start of your Command phase choose one stance until your next Command phase: Sentry — one Rimeguard ranged Hit roll against an enemy near a friendly-controlled objective may be re-rolled; Anchor — if this unit controls an objective, each model gains +1 OC (no stacking); or Watchtower — a selected friendly Frozen Cogs INFANTRY unit within 3" of this unit gains Benefit of Cover against ranged attacks while it remains within 3". Only one stance active.</characteristic></characteristics></profile><profile id="c851-ff53-f359-3a29" name="Industrial Relic" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Rimeguard Prime is the master control node in a multi-frame squad, but losing it does not cause automatic friendly-fire, battleshock, or shutdown. Remaining automata retain Sentinel Circuit.</characteristic></characteristics></profile><profile id="66b6-347b-16ff-05d2" name="Roster and equipment restrictions" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">1–3 models, including one Rimeguard Prime Automaton.  Detailed cross-model quotas validated with bundled roster validator; native New Recruit app integration not yet verified. Use the listed homebrew statistics and points.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="ac64-1ddf-3379-89cc" name="Rimeguard Prime Automaton" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="125"/></costs><constraints><constraint id="74e5-57fe-9530-107a" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="5986-bbcf-bdd4-25f9" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><profiles><profile id="47d8-c961-3902-43a2" name="Mandatory fittings" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Integrated ward plating</characteristic></characteristics></profile></profiles><selectionEntryGroups><selectionEntryGroup id="46c8-a04f-c5ce-932a" name="Armor pattern" hidden="false" defaultSelectionEntryId="ad38-933e-957e-dc42"><constraints><constraint id="458f-e2ce-054c-96ca" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="2cd3-3263-6367-0bcf" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id=