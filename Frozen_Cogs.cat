e="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">5</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-2</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">1</characteristic><characteristic name="Traits" typeId="0f05-4353-204c-511f">—</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry><selectionEntry id="b95b-8bdc-ec5f-b772" name="Frozen Cogs Company Captain" type="unit" hidden="false" import="true"><categoryLinks><categoryLink id="1504-9668-9d88-ea90" name="Chapter Command" targetId="a4bf-93d3-cebe-53ac" hidden="false" primary="true"/><categoryLink id="a80b-1b56-d14d-d696" name="Character" targetId="2e98-8db1-b592-bebd" hidden="false" primary="false"/><categoryLink id="1cad-98ee-9d20-85de" name="Frozen Cogs" targetId="e5e4-dd08-6ce4-34b7" hidden="false" primary="false"/><categoryLink id="dede-69e8-3737-9f7a" name="Infantry" targetId="d640-7a85-a199-c350" hidden="false" primary="false"/></categoryLinks><constraints><constraint id="fe7d-251b-3558-be3f" type="max" value="3" field="selections" scope="roster" shared="true"/></constraints><profiles><profile id="2af8-e59c-c569-396a" name="Frozen Cogs Company Captain" typeId="0cb1-7394-fb88-5322" typeName="Unit" hidden="false"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">5</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">4+</characteristic></characteristics></profile><profile id="3ec5-1512-df8d-9698" name="Layered Command" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">While this model leads a unit, once per battle round that unit may re-roll one Hit roll or saving throw; choose when rolling.</characteristic></characteristics></profile><profile id="cea7-b0cb-d2fd-ea54" name="Tactical Allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">At battle start, choose siege assault, defense, or maneuver. This selection is a narrative/doctrine tag pending detachments.</characteristic></characteristics></profile><profile id="838d-bfc4-8b8f-3a00" name="Leader attachment authorization" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">May lead ONLY these bodyguard unit types: Frozen Cogs Tactical Squad, Frozen Cogs Assault Squad, Frozen Cogs Devastator Squad, Frostline Combat Engineers, Frozen Cogs Sternguard Veterans, Frozen Cogs Vanguard Veterans, Sacred Forge Tactical Support Squad, IceBreaker Breachers. One attached Leader per bodyguard by default; designated character must be separately included in army roster, no free attached model or extra equipment quotas. Cross-check attachments in offline editor.</characteristic></characteristics></profile><profile id="1388-4371-333d-e181" name="Equipment and compatibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">homebrew character points, abilities and weapon profiles; no battle testing performed. Fixed signature weapons remain mandatory; mixed pre-Primaris Firstborn armor patterns supported within each appropriate class.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="2219-4441-cb76-1661" name="Frozen Cogs Company Captain" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="90"/></costs><constraints><constraint id="d082-0d26-1110-a5c4" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="d9e9-4ba8-a63f-4eb5" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="02ea-14e1-f4fd-e828" name="Armor / pattern" hidden="false" defaultSelectionEntryId="f498-390e-0508-0372"><constraints><constraint id="c4bc-110a-9e3e-46db" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="952f-0fca-816d-a6f7" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="f498-390e-0508-0372" name="Mk II" type="upgrade" hidden="false"/><selectionEntry id="5ec3-20e7-0395-373d" name="Mk III" type="upgrade" hidden="false"/><selectionEntry id="f2a2-45f4-d7d1-a313" name="Mk IV" type="upgrade" hidden="false"/><selectionEntry id="0e65-5a87-73e5-a685" name="Mk V" type="upgrade" hidden="false"/><selectionEntry id="4414-457e-b2c3-cc60" name="Mk VI" type="upgrade" hidden="false"/><selectionEntry id="6ce5-2ba0-50d1-ef4b" name="Mk VII" type="upgrade" hidden="false"/><selectionEntry id="abcf-6956-cbd8-fd99" name="Mk VIII" type="upgrade" hidden="false"/></selectionEntries></selectionEntryGroup><selectionEntryGroup id="8f93-036e-7d16-bdf8" name="Ranged weapon" hidden="false" defaultSelectionEntryId="a485-70ed-349c-f4fe"><constraints><constraint id="88d8-510b-d570-8615" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="9d27-2ef2-f13c-16a4" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="a485-70ed-349c-f4fe" name="Boltgun" type="upgrade" hidden="false"><profiles><profile id="65b0-fee3-4bb8-73ee" name="Boltgun" typeId="a4f5-467