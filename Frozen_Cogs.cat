aracteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">5</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">1</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">4+</characteristic></characteristics></profile><profile id="7d16-676b-edb5-1bce" name="Master and Apprentice" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If Nickar leads Veterans, once per round one melee attack can re-roll one Wound roll.</characteristic></characteristics></profile><profile id="57c1-ee35-75db-8aa1" name="Challenge the Wall" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If Nickar is within 3" of an enemy objective when his unit destroys enemy models, once per battle add 1 to unit total OC until turn end.</characteristic></characteristics></profile><profile id="eea5-113d-4c96-2c4e" name="Leader attachment authorization" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">May lead ONLY these bodyguard unit types: Frozen Cogs Vanguard Veterans, Frozen Cogs Sternguard Veterans, IceBreaker Breachers. One attached Leader per bodyguard by default; designated character must be separately included in army roster, no free attached model or extra equipment quotas. Cross-check attachments in offline editor.</characteristic></characteristics></profile><profile id="b919-ce6f-71d2-eb32" name="Equipment and compatibility" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">homebrew character points, abilities and weapon profiles; no battle testing performed. Fixed signature weapons remain mandatory; mixed pre-Primaris Firstborn armor patterns supported within each appropriate class.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="0832-24cc-fee5-1bee" name="Nickar — Forge Champion" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="125"/></costs><constraints><constraint id="a018-8cc3-d8fa-3067" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="765b-3254-529f-1436" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="64f0-d676-e150-acf5" name="Armor / pattern" hidden="false" defaultSelectionEntryId="5499-b9eb-cddd-26af"><constraints><constraint id="6770-aaa0-4d20-b9c3" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="678d-acd1-a78d-0977" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="5499-b9eb-cddd-26af" name="Mk II" type="upgrade" hidden="false"/><selectionEntry id="dbeb-2ca5-c1b2-e394" name="Mk III" type="upgrade" hidden="false"/><selectionEntry id="270e-1ea2-e101-1e64" name="Mk IV" type="upgrade" hidden="false"/><selectionEntry id="ab1d-2469-3112-0cbe" name="Mk V" type="upgrade" hidden="false"/><selectionEntry id="41c8-a248-7481-35c7" name="Mk VI" type="upgrade" hidden="false"/><selectionEntry id="9ca7-cafd-6b65-e9f7" name="Mk VII" type="upgrade" hidden="false"/><selectionEntry id="3289-34bb-e866-0886" name="Mk VIII" type="upgrade" hidden="false"/></selectionEntries></selectionEntryGroup><selectionEntryGroup id="990e-e473-011c-4146" name="Ranged weapon" hidden="false" defaultSelectionEntryId="a4c9-a667-2f66-9d97"><constraints><constraint id="c3e5-2670-e70e-3a35" type="min" value="1" field="selections" scope="paren