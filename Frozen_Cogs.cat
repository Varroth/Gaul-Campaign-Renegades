7d-5b01" name="Iron Firewall Signal Wardens" hidden="false" typeId="0cb1-7394-fb88-5322" typeName="Unit"><characteristics><characteristic name="M" typeId="8ffa-8367-2184-5557">6"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">4</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">2</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="d12d-8c6c-8094-09b3" name="Iron Firewall Lattice" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Once per enemy Shooting phase, after an enemy declares attacks against one friendly Infantry unit within 6 inches of these Wardens, that target may reroll one saving throw against that attack sequence .</characteristic></characteristics></profile><profile id="1f38-0440-001c-7a3c" name="Compartmentalized Commands" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Enemy rules cannot benefit from capturing any neural-lace intelligence carried by a slain model (narrative only).</characteristic></characteristics></profile><profile id="3e23-e5a5-3740-e49d" name="Role and formation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Data-vault defense, jamming countermeasures; 20 Signals/Data Vault/Containment / 7th</characteristic></characteristics></profile><profile id="71d9-844d-8f07-a730" name="Equipment guidance" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Homebrew. Costs, stats and new abilities are homebrew. Not balanced or New Recruit import-tested. Specialist allocation is independently checked in offline editor; native New Recruit cross-model enforcement requires an in-app check.</characteristic></characteristics></profile><profile id="8916-d311-8b84-e3bc" name="Specialist allocation: gun" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">1 permitted per FULL 5 models among options: Plasma gun; checked in offline editor, native XML may not enforce the shared squad cap.</characteristic></characteristics></profile><profile id="0b32-3cb3-8ded-552d" name="Squad complement" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Exactly one squad lead/controller plus 4–9 squad members.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="d28b-917b-bac1-804c" name="Lead Artisan / Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="25"/></costs><constraints><constraint id="b096-55d4-f675-aa2e" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="a25e-a3ab-4557-a04c" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="c52c-0f0d-adf2-9353" name="Cipher carbine" hidden="false" defaultSelectionEntryId="9377-1ccd-71ee-836e"><constraints><constraint id="d1cd-6204-5176-7223" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="bba6-c30d-e9f0-371f" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="9377-1ccd-71ee-836e" name="Forge-pattern boltgun" type="upgrade" hidden="false"><profiles><profile id="4f33-d261-5cd9-537d" n