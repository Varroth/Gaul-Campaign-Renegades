 typeId="8ffa-8367-2184-5557">14"</characteristic><characteristic name="T" typeId="c2bc-ad63-c63b-5cea">5</characteristic><characteristic name="Sv" typeId="f078-5176-43c6-5f6a">3+</characteristic><characteristic name="W" typeId="ecdc-11e1-15d1-5780">3</characteristic><characteristic name="Ld" typeId="2bb6-cceb-9d3f-5f47">6+</characteristic><characteristic name="OC" typeId="6bb9-f7e0-3ec4-5517">2</characteristic><characteristic name="Invulnerable" typeId="fcc9-7d25-7e12-9146">—</characteristic></characteristics></profile><profile id="a1ee-6339-a35f-53f3" name="Legacy Grav Sweep" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">If the unit moved this turn, one selected ranged attack can ignore Cover against an eligible visible target .</characteristic></characteristics></profile><profile id="7088-7172-79ea-56b5" name="Role and doctrine" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Relic Heresy fast flank and precision strikes; allocation: 8th Rapid Assault / 1st veterans</characteristic></characteristics></profile><profile id="f476-2e34-4148-07e7" name="Restricted specialist allocation" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">Up to one specialist rider_gun choice per full 3 models. Specialist options: Scimitar volkite culverin, Scimitar multi-melta, Scimitar plasma cannon. Native catalogue cross-model enforcement requires a New Recruit check.</characteristic></characteristics></profile><profile id="6b5c-29b8-26b0-76bc" name="Homebrew development status" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">All new weapons, points, capacities, arrival rules and effects are preliminary homebrew and not verified against current official 40k or native New Recruit importing.</characteristic></characteristics></profile><profile id="4c23-e4cc-fd97-00a8" name="Squad complement" hidden="false" typeId="bd5c-f804-35b5-510d" typeName="Ability"><characteristics><characteristic name="Description" typeId="4c71-0d90-3b92-5cec">3–6 riders. Exactly one Sergeant.</characteristic></characteristics></profile></profiles><selectionEntries><selectionEntry id="f7ac-c3b0-34a9-e6c8" name="Frozen Cogs Scimitar Jetbike Squadron Sergeant" type="model" hidden="false"><costs><cost name="pts" typeId="0246-3343-a75c-5ffa" value="48"/></costs><constraints><constraint id="a3c3-97a4-4723-d94a" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="b68b-d17e-0e79-40d0" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntryGroups><selectionEntryGroup id="3774-e470-1cf8-4eb8" name="Scimitar main mount" hidden="false" defaultSelectionEntryId="1246-1bc2-e3f9-f631"><constraints><constraint id="1436-8752-4f39-aff5" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="8ee0-f30c-ccdd-9369" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="1246-1bc2-e3f9-f631" name="Scimitar heavy bolter" type="upgrade" hidden="false"><profiles><profile id="a052-4c33-93ec-7900" name="Scimitar heavy bolter" hidden="false" typeId="a4f5-4674-06d7-5496" typeName="Weapon"><characteristics><characteristic name="Range" typeId="8aa7-21a6-b6c1-50e6">36"</characteristic><characteristic name="A" typeId="1df3-e803-7074-57ce">3</characteristic><characteristic name="BS/WS" typeId="a16c-0b6c-2681-5f8f">3+</characteristic><characteristic name="S" typeId="846d-1dce-303c-5c75">5</characteristic><characteristic name="AP" typeId="91f2-51a2-9429-5a60">-1</characteristic><characteristic name="D" typeId="14cd-2ade-2ccc-5c11">2</characteristic><characterist